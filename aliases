# vim:ft=zsh:

# NOTE: Prefix aliased commands with a single space so they are
# automatically excluded from the command history.

# Shell and OTE configuration editing {{{

alias vv=" vim $HOME/.config/nvim/init.vim"
alias zz=" vim -p $ZDOTDIR/.zshrc $ZDOTDIR/.zshenv $ZDOTDIR/aliases"

alias zshrc="vim /Users/mike/.config/zsh/.zshrc"
alias zshenv="vim /Users/mike/.config/zsh/.zshenv"

alias vali="vim $ZDOTDIR/aliases"

alias alg="alias | grep -i"

alias xdots=" ~xdots" # TODO: Lump these in with nocorrect loop
alias vdots=" ~vdots"
alias zdots=" ~zdots"

# }}}

# OTE {{{

for ote in "ote" "vi" "e" "emacs"
do
  alias $ote="vim"
done
alias mvim=gvim

# }}}

# Ignore from history {{{

for cmd in "cd" "exit" "mkdir" "rm" "rvm" "source"
do
  alias $cmd=" $cmd"
done

# }}}

# Default action aliases {{{

# Associate these filetypes with Vim as their
# default action.
for ftype in coffee css erb haml html markdown md ru lock txt vim
do
  alias -s $ftype=vim
done

# }}}

# Exclude for auto-correction {{{

# Prefix these commands with `nocorrect` to silence annoying
# warnings from the correct option.
for cmd in "rspec" "mv" "~zdots" "~api" "~xdots" "~vdots"
do
  alias $cmd="nocorrect $cmd"
done

# }}}

# Git {{{

alias g=" git"
# git pull
alias gpr="git pull --rebase --autostash"
# git commit
alias gc=" git commit --verbose"
alias gcm" git commit -m"
alias gcA=" git add -A"
alias gcam=" git commit --verbose --amend"
# git add
alias ga=" git add"
alias gaa=" git add --all"
alias gapa=" git add --patch"
# git branch
alias gb=" git branch"
# --all List both remote-tracking branches and local branches.
alias gba=" git branch --all"
# git clone
alias gcl=" git clone"
# git fetch
alias gfa=" git fetch --all --prune"
# git status
alias gss=" git status --short"
# git diff
alias gwd=" git diff --word-diff"
# git checkout
alias gco=" git checkout"
# -b create and checkout a new branch
alias gcb=" git checkout -b"
alias branch\?="git rev-parse --abbrev-ref HEAD"

# }}}

# ls {{{

# -A List all entries except for . and ...
# -G Enable colorized output. This option is equivalent to defining CLICOLOR in the environment.
# -p Write a slash (`/') after each filename if that file is a directory.
# -B Force printing of non-printable characters (as defined by ctype(3) and current locale settings) in file names as \xxx, where xxx is the numeric value of the character in octal.
# alias ls=" ls -G -p"
# alias ls=" ls"
alias l=" ls"
# -C Force multi-column output; this is the default when output is to a terminal.
alias la=" ls -A -C"
# -o List in long format, but omit the group id.
alias ll=" ls -A -o -h"

# }}}

# dirs {{{

# -v number the directories in the stack when printing.
# -l print directory names in full instead of using of using ~ expressions
alias dh='dirs -v -l'

# }}}

# Homebrew {{{

alias bls=" brew services list"
alias bstart=" brew services start"
alias bstop=" brew services stop"

# }}}

# ! aliases {{{

alias reload!="clobber ; recompile ; bounce"
alias clear!="klear"

# }}}

# Global Aliases {{{

alias -g gi=" | grep -i "

# }}}

# Uncategorized

alias -- -="cd -"
alias -g ...='../..'
alias api=" ~api"
alias be="bundle exec"
alias dbx=" ~dbx"
alias ext="exit"
alias rmed="rm -d ./**/*(/^F)"
alias ttr='bundle exec passenger-config restart-app $(pwd) --ignore-app-not-running'
alias xx="atool -x"
alias gfp="git format-patch HEAD~1 --no-color --stdout"
alias chrome="open -a \"Google Chrome\""
alias spotify="open -a \"Spotify\""
alias safari="open -a \"Safari\""
alias firefox="open -a \"FirefoxDeveloperEdition\""
alias marked="open -a \"Marked 2\""
alias vcsi='vcs_info command; vcs_info_lastmsg'
alias vup="vim +PlugUpdate"
alias fl="functions | grep -i \"^\w\+\s\+()\""

alias zerologs='sudo gtruncate -s 0 **.log'
alias tailogs='tail -F **.log'
alias iso8601="date -u +\"%Y-%m-%dT%H:%M:%SZ\""
alias bpad="bp-all-do"

alias -g uniquelines=' | uniq -c | sort -n'
alias reload="clobber ; bounce"
alias realias="source $ZDOTDIR/aliases"
