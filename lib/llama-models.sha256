# lib/llama-models.sha256 — Trusted SHA256 hashes for llama.cpp model files.
#
# Format: <sha256>  <filename>
# Matches shasum -a 256 output — one entry per model file, filename only (no path).
#
# Add a new entry when downloading a new model:
#   shasum -a 256 "$ZDOTS_AI_MODELS_DIR/<file>.gguf" | awk '{print $1 "  " $2}' >> lib/llama-models.sha256
#
# This file is tracked in git. Any mismatch causes a hard failure — the model
# is not used until it is verified or the manifest is updated.

509287f78cb4d4cf6b3843734733b914b2c158e43e22a7f4bf5e963800894d3c  qwen2.5-coder-7b-instruct-q4_k_m.gguf
