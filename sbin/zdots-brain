#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/zdots"
require_relative "../lib/zdots/models/job"
require_relative "../lib/zdots/models/lesson"
require_relative "../lib/zdots/models/methodology"
require_relative "../lib/zdots/models/session_residue"
require_relative "../lib/zdots/jobs/base"
require_relative "../lib/zdots/jobs/transcription"
require_relative "../lib/zdots/jobs/distill"
require_relative "../lib/zdots/jobs/embed"
require_relative "../lib/zdots/jobs/docs_sync"

require "optparse"
require "json"
require "digest"
require "yaml"

module Zdots
  class CLI
    def initialize
      @options = { format: "text", semantic: false }
      parse_options
    end

    def run(args)
      command = args.shift
      case command
      when "status"
        cmd_status
      when "worker"
        cmd_worker(args)
      when "add-methodology"
        cmd_add_methodology(args)
      when "add-lesson"
        cmd_add_lesson(args)
      when "save-capture"
        cmd_save_capture
      when "seed-methodology-file"
        cmd_seed_methodology_file(args)
      when "query"
        cmd_query(args)
      when "hydrate"
        cmd_hydrate(args)
      when "enqueue"
        cmd_enqueue(args)
      when "jobs"
        cmd_jobs
      when "ingest"
        cmd_ingest(args)
      when "sync-history"
        cmd_sync_history(args)
      when "rekey"
        cmd_rekey(args)
      else
        puts "Unknown command: #{command}"
        exit 1
      end
    end

    private

    def parse_options
      @options[:type] = nil
      @options[:dry_run] = false
      @options[:all] = false
      OptionParser.new do |opts|
        opts.on("--json", "Output as JSON") { @options[:format] = "json" }
        opts.on("--semantic", "Perform semantic search") { @options[:semantic] = true }
        opts.on("--type TYPE", "Filter by job type") { |t| @options[:type] = t }
        opts.on("--dry-run", "Scan without writing changes") { @options[:dry_run] = true }
        opts.on("--all", "Ingest full Knowledge Vault") { @options[:all] = true }
      end.parse!
    end

    def cmd_worker(_args)
      # Zdots.init_otel("zdots-worker")

      puts "zdots-brain: starting worker..."
      puts "  filter by type: #{@options[:type]}" if @options[:type]

      idle_notified = false

      loop do
        job = Zdots::Models::Job.claim(@options[:type], ENV["ZDOTS_TRACE_ID"])

        if job.nil?
          unless idle_notified
            puts "zdots-brain: queue empty, waiting for jobs..."
            idle_notified = true
          end
          sleep 5
          next
        end

        idle_notified = false
        pending_count = Zdots::Models::Job.pending_count(@options[:type])

        puts ""
        puts "\e[1;34m==> [JOB #{job.id.to_s[0..7]}] Starting #{job.type} (#{pending_count} remaining in queue)\e[0m"

        begin
          job_class = Zdots::Jobs.for(job.type)
          job_class.perform(job)
          puts "\e[1;32m==> [JOB #{job.id.to_s[0..7]}] SUCCESS\e[0m"
        rescue StandardError => e
          puts "\e[1;31m==> [JOB #{job.id.to_s[0..7]}] FAILED: #{e.message}\e[0m"
          # Error handling is also inside JobBase#perform_with_otel
        end
      end
    end

    def cmd_add_methodology(args)
      slug = args.shift
      title = args.shift
      content = args.shift
      tags = args

      if slug.nil? || title.nil? || content.nil?
        puts "usage: zdots-brain add-methodology <slug> <title> <content> [tags...]"
        exit 1
      end

      m = Zdots::Models::Methodology.first(slug: slug) || Zdots::Models::Methodology.new(slug: slug)
      m.title = title
      m.content = content
      m.tags = Sequel.pg_array(tags)
      m.save

      puts "zdots-brain: methodology '#{slug}' saved."

      # Enqueue embedding
      Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
        type: "embed",
        payload: Sequel.pg_jsonb({ table: "methodologies", id: m.id, text: content }),
        priority: 10,
        fingerprint: Digest::MD5.hexdigest("embed-methodologies-#{m.id}")
      )
    end

    def cmd_add_lesson(args)
      content = args.shift
      context = args.shift
      tags = args

      if content.nil?
        puts "usage: zdots-brain add-lesson <content> [context] [tags...]"
        exit 1
      end

      l = Zdots::Models::Lesson.create(
        content: content,
        context: context,
        tags: Sequel.pg_array(tags)
      )

      puts "zdots-brain: lesson saved."

      # Enqueue embedding
      Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
        type: "embed",
        payload: Sequel.pg_jsonb({ table: "lessons", id: l.id, text: content }),
        priority: 10,
        fingerprint: Digest::MD5.hexdigest("embed-lessons-#{l.id}")
      )
    end

    # save-capture — reads JSON from stdin, writes session_residue + lesson via model layer.
    # Called by zdots-ctx cmd_capture after AI distillation, so the key is available.
    # JSON keys: trace_id, intent, result, lesson (content), tags (array), metadata (object)
    def cmd_save_capture
      input = $stdin.read
      data = JSON.parse(input)

      trace_id = data["trace_id"] or raise ArgumentError, "save-capture: trace_id required"
      lesson_text = data["lesson"] or raise ArgumentError, "save-capture: lesson required"
      intent_text = data.fetch("intent", "")
      result_text = data.fetch("result", "")
      tags = Array(data["tags"])
      metadata = data.fetch("metadata", {})

      Zdots.db.transaction do
        residue = Zdots::Models::SessionResidue.find_or_new(trace_id: trace_id)
        residue.intent   = intent_text
        residue.result   = result_text
        residue.summary  = lesson_text
        residue.metadata = Sequel.pg_jsonb(metadata)
        residue.save

        lesson = Zdots::Models::Lesson.create(
          content: lesson_text,
          context: intent_text,
          tags: Sequel.pg_array(tags),
          source_trace_id: trace_id
        )

        Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
          type: "embed",
          payload: Sequel.pg_jsonb({ table: "lessons", id: lesson.id, text: lesson_text }),
          priority: 10,
          fingerprint: Digest::MD5.hexdigest("embed-lessons-#{lesson.id}")
        )

        puts lesson.id
      end
    end

    # seed-methodology-file — reads content from a file, upserts via model layer.
    # Usage: zdots-brain seed-methodology-file <slug> <title> <file_path>
    def cmd_seed_methodology_file(args)
      slug, title, file_path = args
      if slug.nil? || title.nil? || file_path.nil?
        puts "usage: zdots-brain seed-methodology-file <slug> <title> <file_path>"
        exit 1
      end
      unless File.exist?(file_path)
        puts "zdots-brain: file not found: #{file_path}"
        exit 1
      end
      content = File.read(file_path)
      cmd_add_methodology([slug, title, content])
    end

    def cmd_query(args)
      term = args.join(" ")
      if term.empty?
        puts "usage: zdots-brain query [--semantic] <search-term>"
        exit 1
      end

      if @options[:semantic]
        puts "zdots-brain: generating embedding for query: '#{term}'..."
        embedding = Zdots::AI.embed_client.embed(model: "embed", input: term).vectors

        puts "\n### SEMANTIC MATCHES: METHODOLOGIES"
        matches = Zdots::Models::Methodology.where(Sequel.is_not(:embedding,
                                                                 nil)).order(Sequel.lit("embedding <=> ?",
                                                                                        Sequel.pg_array(embedding))).limit(5).all
        matches.each { |m| puts "#{m.slug.ljust(30)} | #{m.title.ljust(50)}" }

        puts "\n### SEMANTIC MATCHES: LESSONS"
        matches = Zdots::Models::Lesson.where(Sequel.is_not(:embedding,
                                                            nil)).order(Sequel.lit("embedding <=> ?",
                                                                                   Sequel.pg_array(embedding))).limit(5).all
        matches.each { |l| puts "#{l.created_at.to_date} | #{l.content[0..100]}..." }
      else
        puts "zdots-brain: searching methodologies (text)..."
        matches = Zdots::Models::Methodology.search(term).first(5)
        matches.each { |m| puts "#{m.slug.ljust(30)} | #{m.title.ljust(50)}" }

        puts "\nzdots-brain: searching lessons (text)..."
        matches = Zdots::Models::Lesson.search(term).first(5)
        matches.each { |l| puts "#{l.created_at.to_date} | #{l.content&.slice(0, 100) || '(encrypted)'}..." }
      end
    end

    def cmd_hydrate(args)
      tag = args.reject { |a| a == "--json" }.first
      limit = 5

      methodologies = if tag
                        Zdots::Models::Methodology.all.select do |m|
                          (m.tags || []).include?(tag) || m.slug.include?(tag)
                        end.first(limit)
                      else
                        Zdots::Models::Methodology.order(Sequel.desc(:updated_at)).limit(limit).all
                      end

      lessons = Zdots::Models::Lesson.order(Sequel.desc(:created_at)).limit(limit).all

      if @options[:format] == "json"
        puts JSON.pretty_generate({
                                    methodologies: methodologies.map do |m|
                                      { slug: m.slug, title: m.title, content: m.content, tags: m.tags }
                                    end,
                                    lessons: lessons.map do |l|
                                      { context: l.context, content: l.content, created_at: l.created_at&.iso8601 }
                                    end
                                  })
        return
      end

      puts "The following context has been retrieved from the Knowledge Layer:\n\n"
      puts "### PREFERRED METHODOLOGIES"
      if methodologies.any?
        methodologies.each do |m|
          puts "#### #{m.title}"
          puts m.content
          puts
        end
      else
        puts "None found.\n\n"
      end

      puts "### RECENT LESSONS LEARNT"
      if lessons.any?
        lessons.each do |l|
          puts "* **Context**: #{l.context}"
          puts "  **Lesson**: #{l.content}\n\n"
        end
      else
        puts "None found.\n\n"
      end
    end

    def cmd_enqueue(args)
      force = false
      if args.first == "--force"
        force = true
        args.shift
      end

      type = args.shift
      payload_json = args.shift
      priority = args.shift || 10

      if type.nil? || payload_json.nil?
        puts "usage: zdots-brain enqueue [--force] <type> <payload_json> [priority]"
        exit 1
      end

      payload = JSON.parse(payload_json)
      fingerprint = Digest::MD5.hexdigest("#{type}#{payload_json}")

      if force
        Zdots::Models::Job.dataset.insert_conflict(
          target: :fingerprint,
          update: { status: "pending", attempts: 0, error_message: nil, priority: priority,
                    updated_at: Sequel::CURRENT_TIMESTAMP, next_run_at: Sequel::CURRENT_TIMESTAMP }
        ).insert(type: type, payload: Sequel.pg_jsonb(payload), priority: priority, fingerprint: fingerprint)
        puts "zdots-brain: job reset to pending."
      else
        job_id = Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
          type: type, payload: Sequel.pg_jsonb(payload), priority: priority, fingerprint: fingerprint
        )
        if job_id
          puts "zdots-brain: job enqueued (ID: #{job_id})."
        else
          puts "zdots-brain: [!!] job already exists in queue (idempotent skip)."
        end
      end
    rescue JSON::ParserError
      puts "zdots-brain: [!!] error: invalid JSON payload"
      exit 1
    end

    def cmd_jobs
      jobs = Zdots::Models::Job.order(
        Sequel.desc(Sequel.case({ { status: "running" } => 2, { status: "pending" } => 1 },
                                0)), Sequel.desc(:priority), :created_at
      ).limit(20).all

      if @options[:format] == "json"
        puts JSON.pretty_generate(jobs.map(&:values))
      else
        printf "%-38s | %-13s | %-9s | %-8s | %-8s\n", "ID", "Type", "Status", "Priority", "Attempts"
        printf "%-38s-+-%-13s-+-%-9s-+-%-8s-+-%-8s\n", "-" * 38, "-" * 13, "-" * 9, "-" * 8, "-" * 8
        jobs.each do |j|
          printf "%-38s | %-13s | %-9s | %-8d | %-8d\n", j.id, j.type, j.status, j.priority, j.attempts
        end
      end
    end

    # ingest — read Knowledge Vault documents and upsert into the Knowledge Base.
    #
    # Usage:
    #   zdots-brain ingest <file.md>          — single file
    #   zdots-brain ingest <dir/>             — all .md files in directory (non-recursive)
    #   zdots-brain ingest --all              — full vault (ZDOTS_MY_ROOT/knowledge)
    #
    # Each file must have YAML frontmatter with: type, slug, title, tags[].
    # Files in inbox/ are skipped — they have no frontmatter and are not yet curated.
    # Idempotent: upserts by slug; re-ingesting a file updates the existing record.
    def cmd_ingest(args)
      dry_run = @options[:dry_run]
      vault_root = File.join(ENV.fetch("ZDOTS_MY_ROOT", File.expand_path("~/my")), "knowledge")

      targets = if @options[:all]
                  Dir.glob(File.join(vault_root, "{lessons,methodologies,references}", "*.md"))
                elsif args.empty?
                  puts "usage: zdots-brain ingest [--dry-run] <file.md | dir/> | --all"
                  exit 1
                else
                  path = args.first
                  if File.directory?(path)
                    Dir.glob(File.join(path, "*.md"))
                  else
                    [path]
                  end
                end

      ingested = 0
      skipped  = 0
      errors   = 0

      targets.each do |file|
        unless File.exist?(file)
          puts "  [skip] not found: #{file}"
          skipped += 1
          next
        end

        raw = File.read(file)
        fm, body = parse_frontmatter(raw)

        if fm.nil?
          puts "  [skip] no frontmatter: #{File.basename(file)}"
          skipped += 1
          next
        end

        type = fm["type"]
        slug = fm["slug"]
        title = fm["title"]
        tags = Array(fm["tags"])

        unless %w[lesson methodology reference].include?(type)
          puts "  [skip] unknown type '#{type}': #{File.basename(file)}"
          skipped += 1
          next
        end

        if slug.nil? || slug.empty?
          puts "  [skip] missing slug: #{File.basename(file)}"
          skipped += 1
          next
        end

        if dry_run
          puts "  [dry-run] would ingest #{type} '#{slug}': #{title}"
          ingested += 1
          next
        end

        begin
          case type
          when "methodology", "reference"
            title ||= slug
            m = Zdots::Models::Methodology.first(slug: slug) || Zdots::Models::Methodology.new(slug: slug)
            m.title   = title
            m.content = body.strip
            m.tags    = Sequel.pg_array(tags)
            m.save
            Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
              type: "embed",
              payload: Sequel.pg_jsonb({ table: "methodologies", id: m.id, text: body.strip }),
              priority: 10,
              fingerprint: Digest::MD5.hexdigest("embed-methodologies-#{m.id}")
            )
            puts "  [ok] #{type} '#{slug}'"
          when "lesson"
            Digest::MD5.hexdigest("ingest-lesson-#{slug}")
            existing = Zdots::Models::Lesson.where(source_trace_id: "ingest:#{slug}").first
            if existing
              existing.content = body.strip
              existing.context = title
              existing.tags    = Sequel.pg_array(tags)
              existing.save
              l = existing
              puts "  [updated] lesson '#{slug}'"
            else
              l = Zdots::Models::Lesson.create(
                content: body.strip,
                context: title,
                tags: Sequel.pg_array(tags),
                source_trace_id: "ingest:#{slug}"
              )
              puts "  [ok] lesson '#{slug}'"
            end
            Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
              type: "embed",
              payload: Sequel.pg_jsonb({ table: "lessons", id: l.id, text: body.strip }),
              priority: 10,
              fingerprint: Digest::MD5.hexdigest("embed-lessons-#{l.id}")
            )
          end
          ingested += 1
        rescue StandardError => e
          puts "  [error] #{File.basename(file)}: #{e.message}"
          errors += 1
        end
      end

      puts "\nzdots-brain ingest#{dry_run ? ' (dry run)' : ''}: #{ingested} ingested, #{skipped} skipped, #{errors} errors"
      exit(errors.positive? ? 1 : 0)
    end

    def sync_incremental_table(sqlite, select_sql, cursor_key, conflict_target, target_table, dry_run)
      cursor_row = Zdots.db[:sync_state].where(key: cursor_key).first
      last_id = cursor_row ? cursor_row[:value].to_i : 0

      rows = sqlite.execute(select_sql, last_id)
      return [0, last_id, last_id] if rows.empty?

      host = ENV.fetch("HOST", begin
        Socket.gethostname
      rescue StandardError
        "unknown"
      end)
      synced = 0
      new_cursor = last_id

      rows.each do |row|
        record = yield(row, host)

        unless dry_run
          Zdots.db[target_table]
               .insert_conflict(target: conflict_target, action: :nothing)
               .insert(record)
        end

        synced += 1
        new_cursor = row["id"]
      end

      unless dry_run
        Zdots.db[:sync_state]
             .insert_conflict(target: :key, action: :update,
                              update: { value: new_cursor.to_s,
                                        updated_at: Sequel::CURRENT_TIMESTAMP })
             .insert(key: cursor_key, value: new_cursor.to_s)
      end

      [synced, last_id, new_cursor]
    end

    def parse_frontmatter(raw)
      return [nil, raw] unless raw.start_with?("---\n")

      close = raw.index("\n---\n", 4)
      return [nil, raw] if close.nil?

      fm_text = raw[4...close]
      body    = raw[(close + 5)..]
      fm = YAML.safe_load(fm_text, permitted_classes: [Symbol])
      [fm, body]
    rescue StandardError
      [nil, raw]
    end

    def cmd_sync_history(args)
      require "sqlite3"

      dry_run  = args.include?("--dry-run")
      db_path  = args.find { |a| !a.start_with?("--") } ||
                 File.join(ENV.fetch("XDG_STATE_HOME", File.expand_path("~/.local/state")),
                           "zdots", "history.sqlite3")

      unless File.exist?(db_path)
        puts "sync-history: SQLite DB not found at #{db_path}"
        puts "  Enable ZDOTS_CMD_ANALYTICS=1 in .zdots.local and run a few commands first,"
        puts "  or let shell_hook_metrics create the buffer by crossing the hook threshold."
        exit 1
      end

      sqlite = SQLite3::Database.new(db_path, readonly: true)
      sqlite.results_as_hash = true
      shell_hook_metrics_exists = sqlite.get_first_value(
        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'shell_hook_metrics' LIMIT 1"
      )

      command_synced, command_last, command_new = sync_incremental_table(
        sqlite,
        "SELECT id, session_id, ts, cwd, cmd, args, exit_code, duration_ms, profile
           FROM command_runs
          WHERE id > ?
          ORDER BY id ASC
          LIMIT 5000",
        "command_runs_last_id",
        [:session_id, :ts, :cmd, Sequel.function(:coalesce, :args, "")],
        :command_runs,
        dry_run
      ) do |row, host|
        {
          session_id: row["session_id"],
          ts: row["ts"],
          cwd: row["cwd"],
          cmd: row["cmd"],
          args: row["args"],
          exit_code: row["exit_code"],
          duration_ms: row["duration_ms"],
          profile: row["profile"],
          host: host
        }
      end

      if shell_hook_metrics_exists
        hook_synced, hook_last, hook_new = sync_incremental_table(
          sqlite,
          "SELECT id, session_id, ts_ms, hook, status, elapsed_ms, threshold_ms, host
             FROM shell_hook_metrics
            WHERE id > ?
            ORDER BY id ASC
            LIMIT 5000",
          "shell_hook_metrics_last_id",
          %i[session_id ts_ms hook status elapsed_ms threshold_ms],
          :shell_hook_metrics,
          dry_run
        ) do |row, host|
          {
            session_id: row["session_id"],
            ts_ms: row["ts_ms"],
            hook: row["hook"],
            status: row["status"],
            elapsed_ms: row["elapsed_ms"],
            threshold_ms: row["threshold_ms"],
            host: row["host"] || host
          }
        end
      else
        hook_synced = 0
        hook_last   = 0
        hook_new    = 0
      end

      if command_synced.zero? && hook_synced.zero?
        puts "sync-history: nothing new (command_runs=#{command_last}, shell_hook_metrics=#{hook_last})"
        sqlite.close
        return
      end

      sqlite.close
      puts "sync-history: #{dry_run ? '[dry-run] would sync' : 'synced'} #{command_synced} command_runs (cursor #{command_last} → #{command_new})"
      puts "sync-history: #{dry_run ? '[dry-run] would sync' : 'synced'} #{hook_synced} shell_hook_metrics (cursor #{hook_last} → #{hook_new})"
    end

    def cmd_rekey(args)
      dry_run = @options[:dry_run]
      table = args.shift || "lessons"
      unless %w[lessons methodologies].include?(table)
        puts "usage: zdots-brain rekey [--dry-run] [lessons|methodologies]"
        exit 1
      end

      begin
        old_key, new_key = Zdots::Crypto::KeyStore.rotation_keys
      rescue KeyError => e
        puts "zdots-brain: #{e.message}"
        exit e.message.include?("identical") ? 0 : 1
      end

      puts "zdots-brain: re-keying #{table}#{dry_run ? ' (dry run)' : ''}..."

      rows = Zdots.db[table.to_sym].select(:id, :content_enc).all
      rekeyed = 0
      already_new = 0
      null_rows = 0
      errors = 0

      rows.each do |row|
        if row[:content_enc].nil?
          null_rows += 1
          next
        end

        begin
          plaintext = nil
          Zdots.db.transaction(savepoint: true) do
            plaintext = Zdots.db.get(
              Sequel.function(:pgp_sym_decrypt, Sequel.blob(row[:content_enc].to_s), old_key)
            )
          end

          unless dry_run
            new_enc = Zdots.db.get(Sequel.function(:pgp_sym_encrypt, plaintext, new_key))
            Zdots.db[table.to_sym].where(id: row[:id]).update(content_enc: new_enc)
          end

          rekeyed += 1
        rescue Sequel::DatabaseError
          # pgp_sym_decrypt failed with old key — row may already be on new key
          begin
            Zdots.db.transaction(savepoint: true) do
              Zdots.db.get(
                Sequel.function(:pgp_sym_decrypt, Sequel.blob(row[:content_enc].to_s), new_key)
              )
            end
            already_new += 1
          rescue Sequel::DatabaseError
            errors += 1
          end
        end
      end

      puts "zdots-brain: #{table} rekey #{dry_run ? 'scan' : 'complete'}:"
      puts "  rekeyed     : #{rekeyed}"
      puts "  already new : #{already_new}"
      puts "  null        : #{null_rows}"
      puts "  unreadable  : #{errors}"

      exit(errors.positive? ? 1 : 0)
    end

    def cmd_status
      # Zdots.init_otel("zdots-brain")
      db = Zdots.db
      connected = begin
        true
      rescue StandardError
        false
      end

      data = {
        connected: connected,
        database: db.opts[:database] || "unknown",
        counts: {
          methodologies: Zdots::Models::Methodology.count,
          lessons: Zdots::Models::Lesson.count,
          pending_jobs: Zdots::Models::Job.pending_count,
          dead_jobs: Zdots::Models::Job.dead_count
        },
        my_root: ENV["ZDOTS_MY_ROOT"]
      }

      if @options[:format] == "json"
        puts JSON.pretty_generate(data)
      else
        puts "zdots-brain: connected to database: #{data[:database]}"
        puts "  methodologies : #{data[:counts][:methodologies]}"
        puts "  lessons       : #{data[:counts][:lessons]}"
        puts "  pending jobs  : #{data[:counts][:pending_jobs]}"
        puts "  dead jobs     : #{data[:counts][:dead_jobs]}"
        puts "  my_root       : #{data[:my_root]}"
      end
    rescue StandardError => e
      if @options[:format] == "json"
        puts JSON.generate({ connected: false, error: e.message })
      else
        puts "zdots-brain: [!!] error: #{e.message}"
      end
      exit 1
    end
  end
end

Zdots::DB.validate!

Zdots::CLI.new.run(ARGV)
