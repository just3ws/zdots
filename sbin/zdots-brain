#!/usr/bin/env ruby
# frozen_string_literal: true

# launchd starts the worker with no LANG, so Ruby defaults to US-ASCII and any
# UTF-8 content (transcripts, model output) raises "invalid byte sequence".
# Everything this worker handles is UTF-8 — pin it process-wide.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

# Self-heal the Ruby toolchain. This script has a bare `#!/usr/bin/env ruby`
# shebang; invoked outside ~/.config/zsh (or from launchd/cron) `ruby` resolves
# to the global mise Ruby (e.g. 4.0.2), which lacks our bundled gems — every job
# requires opentelemetry via jobs/base.rb, so it dies with a LoadError before
# doing anything. Direct callers (zdots-ctx, zdots-ingest-media, zdots-debrief)
# all hit this. Re-exec once under the pinned Ruby (bin/zdots-ruby →
# etc/ruby-version) if the canary gem is absent; the sentinel makes a
# still-broken pin fail loud via the real require below, never loop.
# The worker runs us under `mise exec` (correct Ruby), so the canary passes and
# this is a no-op there.
unless ENV["ZDOTS_BRAIN_PINNED"]
  begin
    require "opentelemetry"
  rescue LoadError
    ENV["ZDOTS_BRAIN_PINNED"] = "1"
    exec File.expand_path("../bin/zdots-ruby", __dir__),
         File.expand_path(__FILE__), *ARGV
  end
end

require_relative "../lib/zdots"
require_relative "../lib/zdots/models/job"
require_relative "../lib/zdots/models/media_source"
require_relative "../lib/zdots/models/pipeline_run"
require_relative "../lib/zdots/models/lesson"
require_relative "../lib/zdots/models/lesson_intake"
require_relative "../lib/zdots/models/methodology"
require_relative "../lib/zdots/models/session_residue"
require_relative "../lib/zdots/models/concept"
require_relative "../lib/zdots/models/source_document"
require_relative "../lib/zdots/ingest/okf_adapter"
require_relative "../lib/zdots/jobs/base"
require_relative "../lib/zdots/jobs/transcription"
require_relative "../lib/zdots/jobs/ingest_media"
require_relative "../lib/zdots/jobs/transcribe_chunk"
require_relative "../lib/zdots/jobs/distill"
require_relative "../lib/zdots/jobs/transform"
require_relative "../lib/zdots/jobs/embed"
require_relative "../lib/zdots/jobs/docs_sync"
require_relative "../lib/zdots/jobs/extract_moment"

require "optparse"
require "json"
require "digest"
require "yaml"
require "date"

module Zdots
  class CLI
    # Tables and their encrypted columns — used by cmd_rekey and cmd_status.
    REKEY_TABLES = {
      "lessons"         => %i[content_enc context_enc],
      "methodologies"   => %i[content_enc],
      "session_residue" => %i[summary_enc intent_enc result_enc],
      "source_document" => %i[body_md_enc]
    }.freeze

    # ON CONFLICT update that re-arms an existing job: back to pending with a
    # clean retry slate. Shared by reprocess / ingest-media --force / enqueue
    # --force. (cmd_reindex_embeddings deliberately differs: it revives ONLY
    # dead jobs via update_where.)
    RESET_JOB = { status: "pending", attempts: 0, error_message: nil,
                  updated_at: Sequel::CURRENT_TIMESTAMP,
                  next_run_at: Sequel::CURRENT_TIMESTAMP }.freeze

    def initialize
      @options = { format: "text", semantic: false }
      parse_options
    end

    def run(args)
      command = args.shift
      case command
      when "status"
        cmd_status
      when "worker"
        cmd_worker(args)
      when "add-methodology"
        cmd_add_methodology(args)
      when "add-lesson"
        cmd_add_lesson(args)
      when "save-capture"
        cmd_save_capture
      when "seed-methodology-file"
        cmd_seed_methodology_file(args)
      when "query"
        cmd_query(args)
      when "hydrate"
        cmd_hydrate(args)
      when "enqueue"
        cmd_enqueue(args)
      when "ingest-media"
        cmd_ingest_media(args)
      when "jobs"
        cmd_jobs
      when "result"
        cmd_result(args)
      when "cancel"
        cmd_cancel(args)
      when "reprocess"
        cmd_reprocess(args)
      when "reprocess-series"
        cmd_reprocess_series(args)
      when "reindex-embeddings"
        cmd_reindex_embeddings
      when "ingest"
        cmd_ingest(args)
      when "concept"
        cmd_concept(args)
      when "sync-history"
        cmd_sync_history(args)
      when "rekey"
        cmd_rekey(args)
      else
        puts "Unknown command: #{command}"
        exit 1
      end
    end

    private

    def parse_options
      @options[:type] = nil
      @options[:dry_run] = false
      @options[:all] = false
      OptionParser.new do |opts|
        opts.on("--json", "Output as JSON") { @options[:format] = "json" }
        opts.on("--semantic", "Perform semantic search") { @options[:semantic] = true }
        opts.on("--type TYPE", "Filter by job type") { |t| @options[:type] = t }
        opts.on("--dry-run", "Scan without writing changes") { @options[:dry_run] = true }
        opts.on("--all", "Ingest full Knowledge Vault") { @options[:all] = true }
        opts.on("--transcribe", "reprocess: also re-run transcription (not just downstream stages)") { @options[:transcribe] = true }
      end.parse!
    rescue OptionParser::InvalidOption => e
      e.recover(ARGV) # leave unrecognized flags in ARGV for subcommands
    end

    def cmd_worker(_args)
      # Zdots.init_otel("zdots-worker")

      puts "zdots-brain: starting worker..."
      puts "  filter by type: #{@options[:type]}" if @options[:type]

      # Graceful shutdown (Unix signal best practice): SIGTERM/SIGINT only flip a
      # flag — never do work in a trap. The loop finishes the current job, then
      # stops BEFORE claiming the next, so a stop is clean and resumable (a
      # partly-done job picks up where it left off via pipeline_runs). A second
      # signal exits immediately (impatient operator). SIGKILL is untrappable,
      # but resumability means even a hard kill recovers. launchd sends SIGTERM
      # on `zsvc stop worker`, then SIGKILL after its ExitTimeOut — a job longer
      # than that window is cut short but resumes on next start.
      @stop = false
      %w[TERM INT].each do |sig|
        Signal.trap(sig) { @stop ? exit!(1) : (@stop = true) }
      end

      idle_notified = false

      until @stop
        job = Zdots::Models::Job.claim(@options[:type], ENV.fetch("ZDOTS_TRACE_ID", nil))

        if job.nil?
          unless idle_notified
            puts "zdots-brain: queue empty, waiting for jobs..."
            idle_notified = true
          end
          sleep 5 # interrupted early by a trapped signal; loop re-checks @stop
          next
        end

        idle_notified = false
        pending_count = Zdots::Models::Job.pending_count(@options[:type])

        puts ""
        puts "\e[1;34m==> [JOB #{job.id.to_s[0..7]}] Starting #{job.type} (#{pending_count} remaining in queue)\e[0m"

        begin
          job_class = Zdots::Jobs.for(job.type)
          job_class.perform(job)
          puts "\e[1;32m==> [JOB #{job.id.to_s[0..7]}] SUCCESS\e[0m"
        rescue StandardError => e
          puts "\e[1;31m==> [JOB #{job.id.to_s[0..7]}] FAILED: #{e.message}\e[0m"
          # Error handling is also inside JobBase#perform_with_otel
        end
      end

      remaining = Zdots::Models::Job.pending_count(@options[:type]) rescue "?"
      puts "zdots-brain: worker stopped gracefully (finished current job; #{remaining} pending remain, resumable)."
    end

    # Cancel a queued job so the worker never runs it again. Terminal by design
    # (marks 'dead'); only pending/failed jobs are cancellable — a running job
    # is left to the graceful worker stop, and completed/dead are already
    # terminal. Reversible with `requeue` if cancelled by mistake.
    def cmd_cancel(args)
      id = args.shift
      if id.nil?
        puts "usage: zdots-brain cancel <job_id>"
        exit 1
      end
      n = begin
        Zdots::Models::Job.where(id: id, status: %w[pending failed]).update(status: "dead")
      rescue Sequel::DatabaseError
        puts "zdots-brain: invalid job id #{id.inspect}"
        exit 1
      end
      if n.zero?
        puts "zdots-brain: no cancellable job #{id} (not found, running, or already terminal)."
        exit 1
      end
      puts "zdots-brain: job #{id[0..7]} cancelled (marked dead; will not be retried)."
    end

    # Reprocess an already-ingested media source through the pipeline, applying
    # the CURRENT known_terms corrections (and, with --transcribe, priming). The
    # default re-runs only the downstream stages (cleaned + distilled) from the
    # existing raw transcript — fast, no audio touched — since corrections flow to
    # both via apply_corrections. --transcribe additionally clears the raw stage so
    # whisper re-runs primed by the current vocabulary; chunked sources reuse the
    # retained WAV (no re-download), a short source re-downloads until first-
    # transcribe keeps its WAV (P1.5). Raw is never edited in place — corrections
    # are the edit mechanism, so a reprocess is deterministic and re-runnable.
    def cmd_reprocess(args)
      transcribe = @options[:transcribe] == true # parsed by OptionParser (see parse_options)
      token = args.shift
      if token.nil?
        puts "usage: zdots-brain reprocess <source_id|uri-or-title-substring> [--transcribe]"
        exit 1
      end
      src = resolve_media_source(token)

      if transcribe
        n = Zdots::Models::PipelineRun.where(media_source_id: src.id, stage: "raw").delete
        puts "zdots-brain: cleared #{n} raw run(s) — whisper will re-transcribe (primed by current known_terms)."
      end

      src.update(ingest_status: "queued", updated_at: Sequel::CURRENT_TIMESTAMP)
      Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint, update: RESET_JOB).insert(
        type: "ingest_media",
        payload: Sequel.pg_jsonb({ "media_source_id" => src.id, "profile" => "standard" }),
        priority: 10,
        fingerprint: Digest::MD5.hexdigest("ingest_media#{src.source_uri}")
      )
      puts "zdots-brain: reprocessing #{src.id} — #{src.title.to_s[0, 60].inspect}" \
           "#{transcribe ? ' (re-transcribe)' : ' (stages only)'}."
    end

    def cmd_reprocess_series(args)
      transcribe = @options[:transcribe] == true # parsed by OptionParser (see parse_options)
      tag = args.shift
      if tag.nil?
        puts "usage: zdots-brain reprocess-series <tag> [--transcribe]"
        exit 1
      end

      matches = Zdots::Models::MediaSource.where(Sequel.pg_array_op(:tags).contains([tag])).all
      if matches.empty?
        puts "zdots-brain: no media sources matching tag #{tag.inspect}"
        exit 1
      end

      enqueued = 0
      matches.each do |src|
        if transcribe
          Zdots::Models::PipelineRun.where(media_source_id: src.id, stage: "raw").delete
        end

        src.update(ingest_status: "queued", updated_at: Sequel::CURRENT_TIMESTAMP)
        Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint, update: RESET_JOB).insert(
          type: "ingest_media",
          payload: Sequel.pg_jsonb({ "media_source_id" => src.id, "profile" => "standard" }),
          priority: 10,
          fingerprint: Digest::MD5.hexdigest("ingest_media#{src.source_uri}")
        )
        enqueued += 1
      end
      puts "zdots-brain: reprocessed #{enqueued} sources matching tag #{tag.inspect}" \
           "#{transcribe ? ' (cleared raw transcripts)' : ''}."
    end

    # Resolve a media source by exact UUID, exact source_uri, or a unique
    # uri/title substring. Disambiguate loudly rather than guess.
    def resolve_media_source(token)
      src = (Zdots::Models::MediaSource[token] rescue nil)
      src ||= Zdots::Models::MediaSource.first(source_uri: token)
      return src if src

      # id prefix (ids surface as 8-char prefixes in jobs/status output), or a
      # uri/title substring.
      like = "%#{token}%"
      matches = Zdots::Models::MediaSource
                .where(Sequel.like(Sequel.cast(:id, String), "#{token}%") |
                       Sequel.like(:source_uri, like) |
                       Sequel.like(:title, like)).all
      if matches.empty?
        puts "zdots-brain: no media source matching #{token.inspect}"
        exit 1
      elsif matches.size > 1
        puts "zdots-brain: #{matches.size} sources match #{token.inspect} — be more specific:"
        matches.first(10).each { |m| puts "  #{m.id}  #{m.source_type}  #{m.title.to_s[0, 50]}" }
        exit 1
      end
      matches.first
    end

    def cmd_add_methodology(args)
      slug = args.shift
      title = args.shift
      content = args.shift
      tags = args

      if slug.nil? || title.nil? || content.nil?
        puts "usage: zdots-brain add-methodology <slug> <title> <content> [tags...]"
        exit 1
      end

      m = Zdots::Models::Methodology.first(slug: slug) || Zdots::Models::Methodology.new(slug: slug)
      m.title = title
      m.content = content
      m.tags = Sequel.pg_array(tags)
      m.save

      puts "zdots-brain: methodology '#{slug}' saved."

      # Enqueue embedding
      Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
        type: "embed",
        payload: Sequel.pg_jsonb({ table: "methodologies", id: m.id, text: content }),
        priority: 10,
        fingerprint: Digest::MD5.hexdigest("embed-methodologies-#{m.id}")
      )
    end

    def cmd_add_lesson(args)
      content = args.shift
      context = args.shift
      tags = args

      if content.nil?
        puts "usage: zdots-brain add-lesson <content> [context] [tags...]"
        exit 1
      end

      l = Zdots::Models::LessonIntake.create(
        content: content,
        context: context,
        tags: tags,
        source_type: "user"
      )

      puts "zdots-brain: lesson saved."

      # Enqueue embedding
      Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
        type: "embed",
        payload: Sequel.pg_jsonb({ table: "lessons", id: l.id, text: content }),
        priority: 10,
        fingerprint: Digest::MD5.hexdigest("embed-lessons-#{l.id}")
      )
    end

    # save-capture — reads JSON from stdin, writes session_residue + lesson via model layer.
    # Called by zdots-ctx cmd_capture after AI distillation, so the key is available.
    # JSON keys: trace_id, intent, result, lesson (content), tags (array), metadata (object)
    def cmd_save_capture
      input = $stdin.read
      data = JSON.parse(input)

      trace_id = data["trace_id"] or raise ArgumentError, "save-capture: trace_id required"
      lesson_text = data["lesson"] or raise ArgumentError, "save-capture: lesson required"
      intent_text = data.fetch("intent", "")
      result_text = data.fetch("result", "")
      tags = Array(data["tags"])
      metadata = data.fetch("metadata", {})

      Zdots.db.transaction do
        residue = Zdots::Models::SessionResidue.find_or_create(trace_id: trace_id)
        residue.intent   = intent_text
        residue.result   = result_text
        residue.summary  = lesson_text
        residue.metadata = Sequel.pg_jsonb(metadata)
        residue.save

        lesson = Zdots::Models::LessonIntake.create(
          content: lesson_text,
          context: intent_text,
          tags: tags,
          source_type: "capture",
          trace_id: trace_id
        )

        Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
          type: "embed",
          payload: Sequel.pg_jsonb({ table: "lessons", id: lesson.id, text: lesson_text }),
          priority: 10,
          fingerprint: Digest::MD5.hexdigest("embed-lessons-#{lesson.id}")
        )

        puts lesson.id
      end
    end

    # seed-methodology-file — reads content from a file, upserts via model layer.
    # Usage: zdots-brain seed-methodology-file <slug> <title> <file_path>
    def cmd_seed_methodology_file(args)
      slug, title, file_path = args
      if slug.nil? || title.nil? || file_path.nil?
        puts "usage: zdots-brain seed-methodology-file <slug> <title> <file_path>"
        exit 1
      end
      unless File.exist?(file_path)
        puts "zdots-brain: file not found: #{file_path}"
        exit 1
      end
      content = File.read(file_path)
      cmd_add_methodology([slug, title, content])
    end

    def cmd_query(args)
      term = args.join(" ")
      if term.empty?
        puts "usage: zdots-brain query [--semantic] <search-term>"
        exit 1
      end

      if @options[:semantic]
        puts "zdots-brain: semantic search for: '#{term}'..."

        puts "\n### SEMANTIC MATCHES: METHODOLOGIES"
        matches = Zdots::Models::Methodology.semantic_search(term).limit(5).all
        matches.each { |m| puts "#{m.slug.ljust(30)} | #{m.title.ljust(50)}" }

        puts "\n### SEMANTIC MATCHES: LESSONS"
        matches = Zdots::Models::Lesson.semantic_search(term).limit(5).all
        matches.each { |l| puts "#{l.created_at.to_date} | #{l.content[0..100]}..." }
      else
        puts "zdots-brain: searching methodologies (text)..."
        matches = Zdots::Models::Methodology.search(term).first(5)
        matches.each { |m| puts "#{m.slug.ljust(30)} | #{m.title.ljust(50)}" }

        puts "\nzdots-brain: searching lessons (text)..."
        matches = Zdots::Models::Lesson.search(term).first(5)
        matches.each { |l| puts "#{l.created_at.to_date} | #{l.content&.slice(0, 100) || '(encrypted)'}..." }
      end
    end

    def cmd_hydrate(args)
      tag = args.reject { |a| a == "--json" }.first
      limit = 5

      methodologies = if tag
                        Zdots::Models::Methodology.all.select do |m|
                          (m.tags || []).include?(tag) || m.slug.include?(tag)
                        end.first(limit)
                      else
                        Zdots::Models::Methodology.order(Sequel.desc(:updated_at)).limit(limit).all
                      end

      lessons = Zdots::Models::Lesson.order(Sequel.desc(:created_at)).limit(limit).all

      if @options[:format] == "json"
        puts JSON.pretty_generate({
                                    methodologies: methodologies.map do |m|
                                      { slug: m.slug, title: m.title, content: m.content, tags: m.tags }
                                    end,
                                    lessons: lessons.map do |l|
                                      { context: l.context, content: l.content, created_at: l.created_at&.iso8601 }
                                    end
                                  })
        return
      end

      puts "The following context has been retrieved from the Knowledge Layer:\n\n"
      puts "### PREFERRED METHODOLOGIES"
      if methodologies.any?
        methodologies.each do |m|
          puts "#### #{m.title}"
          puts m.content
          puts
        end
      else
        puts "None found.\n\n"
      end

      puts "### RECENT LESSONS LEARNT"
      if lessons.any?
        lessons.each do |l|
          puts "* **Context**: #{l.context}"
          puts "  **Lesson**: #{l.content}\n\n"
        end
      else
        puts "None found.\n\n"
      end
    end

    def cmd_enqueue(args)
      force = false
      if args.first == "--force"
        force = true
        args.shift
      end

      type = args.shift
      payload_json = args.shift
      priority = args.shift || 10

      if type.nil? || payload_json.nil?
        puts "usage: zdots-brain enqueue [--force] <type> <payload_json> [priority]"
        exit 1
      end

      payload = JSON.parse(payload_json)
      fingerprint = Digest::MD5.hexdigest("#{type}#{payload_json}")

      if force
        Zdots::Models::Job.dataset.insert_conflict(
          target: :fingerprint, update: RESET_JOB.merge(priority: priority)
        ).insert(type: type, payload: Sequel.pg_jsonb(payload), priority: priority, fingerprint: fingerprint)
        puts "zdots-brain: job reset to pending."
      else
        job_id = Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
          type: type, payload: Sequel.pg_jsonb(payload), priority: priority, fingerprint: fingerprint
        )
        if job_id
          puts "zdots-brain: job enqueued (ID: #{job_id})."
        else
          puts "zdots-brain: [!!] job already exists in queue (idempotent skip)."
        end
      end
    rescue JSON::ParserError
      puts "zdots-brain: [!!] error: invalid JSON payload"
      exit 1
    end

    # ingest-media — write the durable ledger row for a source (from metadata
    # JSON on stdin, captured by bin/zdots-ingest-media) and enqueue its job.
    # media_sources is the dedup anchor (unique source_uri); --force reprocesses.
    def cmd_ingest_media(_args)
      meta    = JSON.parse($stdin.read)
      uri     = meta.fetch("source_uri")
      force   = meta["force"] == true
      profile = meta["profile"] || "standard"
      existing = Zdots::Models::MediaSource.first(source_uri: uri)

      if existing && !force
        puts "zdots-ingest-media: [skip] already ingested (#{existing.id}); use --force to reprocess."
        return
      end

      Zdots.db.transaction do
        if existing
          existing.update(ingest_status: "queued", updated_at: Sequel::CURRENT_TIMESTAMP)
          media_source_id = existing.id
          puts "zdots-ingest-media: reprocessing #{media_source_id}."
        else
          # source_snapshot is write-once; never overwritten on reprocess.
          src = Zdots::Models::MediaSource.create(
            source_type:     meta["source_type"],
            source_uri:      uri,
            source_id:       meta["source_id"],
            title:           meta["title"],
            duration_sec:    meta["duration_sec"],
            ingest_status:   "queued",
            source_snapshot: Sequel.pg_jsonb(meta["source_snapshot"] || {})
          )
          media_source_id = src.id
          puts "zdots-ingest-media: ingested #{media_source_id} (#{meta['title']})."
        end

        payload     = { "media_source_id" => media_source_id, "profile" => profile }
        # Diarization speaker-count hint from the caller (site: interviewees + 1).
        # Tenant data — passed through, never computed here. Consumed by ingest_media#diarize_audio.
        ns = meta["num_speakers"]
        payload["num_speakers"] = ns if ns.is_a?(Integer) && ns.positive?
        pg_payload  = Sequel.pg_jsonb(payload)
        fingerprint = Digest::MD5.hexdigest("ingest_media#{uri}")
        ds = Zdots::Models::Job.dataset
        # empty ON CONFLICT update is invalid SQL — bare insert_conflict = DO NOTHING (cf. cmd_enqueue).
        # --force also refreshes payload: the fingerprint is URI-only, so a re-enqueue would
        # otherwise keep the previous payload and silently drop an updated num_speakers.
        ds = ds.insert_conflict(target: :fingerprint, update: RESET_JOB.merge(payload: pg_payload)) if force
        ds = ds.insert_conflict(target: :fingerprint) unless force
        job_id = ds.insert(type: "ingest_media", payload: pg_payload, priority: 10, fingerprint: fingerprint)
        puts "zdots-ingest-media: job #{job_id ? "enqueued (#{job_id})" : 'already queued (idempotent)'}."
      end
    rescue JSON::ParserError
      puts "zdots-ingest-media: [!!] invalid metadata JSON on stdin"
      exit 1
    end

    # Z-199: tenant-facing result fetch. metadata is the generic result slot —
    # any job type can write structured output there via Job#complete!(hash).
    def cmd_result(args)
      id = args.shift
      if id.nil?
        puts "usage: zdots-brain result <job_id>"
        exit 1
      end

      job = Zdots::Models::Job[id]
      unless job
        puts "zdots-brain: [!!] job not found: #{id}"
        exit 1
      end

      puts JSON.pretty_generate(
        id: job.id, type: job.type, status: job.status,
        result: job.metadata, error_message: job.error_message
      )
    end

    def cmd_jobs
      jobs = Zdots::Models::Job.order(
        Sequel.desc(Sequel.case({ { status: "running" } => 2, { status: "pending" } => 1 },
                                0)), Sequel.desc(:priority), :created_at
      ).limit(20).all

      if @options[:format] == "json"
        puts JSON.pretty_generate(jobs.map(&:values))
      else
        printf "%-38s | %-13s | %-9s | %-8s | %-8s\n", "ID", "Type", "Status", "Priority", "Attempts"
        printf "%-38s-+-%-13s-+-%-9s-+-%-8s-+-%-8s\n", "-" * 38, "-" * 13, "-" * 9, "-" * 8, "-" * 8
        jobs.each do |j|
          printf "%-38s | %-13s | %-9s | %-8d | %-8d\n", j.id, j.type, j.status, j.priority, j.attempts
        end
      end
    end

    # reindex-embeddings — enqueue embed jobs for lessons and methodologies that
    # are missing an embedding (e.g. rows whose content exceeded the old context
    # limit, now handled by the chunking embed job). Idempotent: the embed
    # fingerprint prevents duplicate pending jobs. Dead jobs (e.g. from a prior
    # embed service outage) are reset to pending so they are retried. The worker
    # does the work.
    def cmd_reindex_embeddings
      enqueued = 0
      {
        "lessons"       => Zdots::Models::Lesson,
        "methodologies" => Zdots::Models::Methodology
      }.each do |table, model|
        model.where(embedding: nil).each do |row|
          text = row.content.to_s
          next if text.strip.empty?

          Zdots::Models::Job.dataset.insert_conflict(
            target: :fingerprint,
            update_where: { Sequel[:jobs][:status] => "dead" },
            update: { status: "pending", attempts: 0, error_message: nil,
                      next_run_at: Sequel.function(:NOW) }
          ).insert(
            type: "embed",
            payload: Sequel.pg_jsonb({ table: table, id: row.id, text: text }),
            priority: 5,
            fingerprint: Digest::MD5.hexdigest("embed-#{table}-#{row.id}")
          )
          enqueued += 1
        end
      end
      puts "zdots-brain: enqueued #{enqueued} embed job(s) for rows missing embeddings."
    end

    # ingest — read Knowledge Vault documents and upsert into the Knowledge Base.
    #
    # Usage:
    #   zdots-brain ingest <file.md>          — single file
    #   zdots-brain ingest <dir/>             — all .md files in directory (non-recursive)
    #   zdots-brain ingest --all              — full vault (ZDOTS_MY_ROOT/knowledge)
    #
    # Each file must have YAML frontmatter with: type, slug, title, tags[].
    # Files in inbox/ are skipped — they have no frontmatter and are not yet curated.
    # Idempotent: upserts by slug; re-ingesting a file updates the existing record.
    def cmd_ingest(args)
      dry_run = @options[:dry_run]

      if @options[:type] == "okf"
        bundle = args.first
        unless bundle && File.directory?(bundle)
          puts "usage: zdots-brain ingest --type okf <bundle-dir>"
          exit 1
        end
        result = Zdots::Ingest::OkfAdapter.new(bundle, dry_run: dry_run).ingest
        if result[:unknown_types].any?
          puts "  [warn] unknown types (logged, not rejected): #{result[:unknown_types].join(', ')}"
        end
        puts "\nzdots-brain ingest --type okf#{' (dry run)' if dry_run}: #{result[:ingested]} ingested, #{result[:skipped]} skipped"
        return
      end

      vault_root = File.join(ENV.fetch("ZDOTS_MY_ROOT", File.expand_path("~/my")), "knowledge")

      targets = if @options[:all]
                  Dir.glob(File.join(vault_root, "{lessons,methodologies,references}", "*.md"))
                elsif args.empty?
                  puts "usage: zdots-brain ingest [--dry-run] <file.md | dir/> | --all"
                  exit 1
                else
                  path = args.first
                  if File.directory?(path)
                    Dir.glob(File.join(path, "*.md"))
                  else
                    [path]
                  end
                end

      ingested = 0
      skipped  = 0
      errors   = 0

      targets.each do |file|
        unless File.exist?(file)
          puts "  [skip] not found: #{file}"
          skipped += 1
          next
        end

        raw = File.read(file)
        fm, body = parse_frontmatter(raw)

        if fm.nil?
          puts "  [skip] no frontmatter: #{File.basename(file)}"
          skipped += 1
          next
        end

        type = fm["type"]
        slug = fm["slug"]
        title = fm["title"]
        tags = Array(fm["tags"])

        unless %w[lesson methodology reference].include?(type)
          puts "  [skip] unknown type '#{type}': #{File.basename(file)}"
          skipped += 1
          next
        end

        if slug.nil? || slug.empty?
          puts "  [skip] missing slug: #{File.basename(file)}"
          skipped += 1
          next
        end

        if dry_run
          puts "  [dry-run] would ingest #{type} '#{slug}': #{title}"
          ingested += 1
          next
        end

        begin
          case type
          when "methodology", "reference"
            title ||= slug
            m = Zdots::Models::Methodology.first(slug: slug) || Zdots::Models::Methodology.new(slug: slug)
            m.title   = title
            m.content = body.strip
            m.tags    = Sequel.pg_array(tags)
            m.save
            Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
              type: "embed",
              payload: Sequel.pg_jsonb({ table: "methodologies", id: m.id, text: body.strip }),
              priority: 10,
              fingerprint: Digest::MD5.hexdigest("embed-methodologies-#{m.id}")
            )
            puts "  [ok] #{type} '#{slug}'"
          when "lesson"
            Digest::MD5.hexdigest("ingest-lesson-#{slug}")
            existing = Zdots::Models::LessonIntake.find_ingested(slug)
            if existing
              existing.content = body.strip
              existing.context = title
              existing.tags    = Sequel.pg_array(tags)
              existing.save
              l = existing
              puts "  [updated] lesson '#{slug}'"
            else
              l = Zdots::Models::LessonIntake.create(
                content: body.strip,
                context: title,
                tags: tags,
                source_type: "ingest",
                slug: slug
              )
              puts "  [ok] lesson '#{slug}'"
            end
            Zdots::Models::Job.dataset.insert_conflict(target: :fingerprint).insert(
              type: "embed",
              payload: Sequel.pg_jsonb({ table: "lessons", id: l.id, text: body.strip }),
              priority: 10,
              fingerprint: Digest::MD5.hexdigest("embed-lessons-#{l.id}")
            )
          end
          ingested += 1
        rescue StandardError => e
          puts "  [error] #{File.basename(file)}: #{e.message}"
          errors += 1
        end
      end

      puts "\nzdots-brain ingest#{' (dry run)' if dry_run}: #{ingested} ingested, #{skipped} skipped, #{errors} errors"
      exit(errors.positive? ? 1 : 0)
    end

    def sync_incremental_table(sqlite, select_sql, cursor_key, conflict_target, target_table, dry_run)
      cursor_row = Zdots.db[:sync_state].where(key: cursor_key).first
      last_id = cursor_row ? cursor_row[:value].to_i : 0

      rows = sqlite.execute(select_sql, last_id)
      return [0, last_id, last_id] if rows.empty?

      host = ENV.fetch("HOST", begin
        Socket.gethostname
      rescue StandardError
        "unknown"
      end)
      synced = 0
      new_cursor = last_id

      rows.each do |row|
        record = yield(row, host)

        unless dry_run
          Zdots.db[target_table]
               .insert_conflict(target: conflict_target, action: :nothing)
               .insert(record)
        end

        synced += 1
        new_cursor = row["id"]
      end

      unless dry_run
        Zdots.db[:sync_state]
             .insert_conflict(target: :key, action: :update,
                              update: { value: new_cursor.to_s,
                                        updated_at: Sequel::CURRENT_TIMESTAMP })
             .insert(key: cursor_key, value: new_cursor.to_s)
      end

      [synced, last_id, new_cursor]
    end

    def parse_frontmatter(raw)
      return [nil, raw] unless raw.start_with?("---\n")

      close = raw.index("\n---\n", 4)
      return [nil, raw] if close.nil?

      fm_text = raw[4...close]
      body    = raw[(close + 5)..]
      fm = YAML.safe_load(fm_text, permitted_classes: [Symbol, Date, Time])
      [fm, body]
    rescue StandardError => e
      warn "  [warn] frontmatter parse failed (#{e.class}): #{e.message}"
      [nil, raw]
    end

    def cmd_concept(args)
      subcommand = args.shift
      json_out   = @options[:format] == "json"

      case subcommand
      when "add"
        slug = args.shift or abort "usage: concept add <slug> <term>"
        term = args.join(" ")
        term = term.empty? ? slug : term
        c = Models::Concept.add(slug: slug, term: term, source_ref: "user")
        output = json_out ? c.to_h.to_json : "added: #{c.slug} (#{c.term})"
        puts output

      when "alias"
        alias_text = args.shift or abort "usage: concept alias <alias> <slug> [--disallowed]"
        slug       = args.shift or abort "usage: concept alias <alias> <slug> [--disallowed]"
        disallowed = args.include?("--disallowed")
        Models::Concept.add_alias(alias_text, slug, disallowed: disallowed)
        puts json_out ? { alias: alias_text, concept: slug, disallowed: disallowed }.to_json \
                      : "alias '#{alias_text}' → #{slug} (disallowed=#{disallowed})"

      when "link"
        from = args.shift or abort "usage: concept link <from> <relation> <to>"
        rel  = args.shift or abort "usage: concept link <from> <relation> <to>"
        to   = args.shift or abort "usage: concept link <from> <relation> <to>"
        Models::Concept.link(from, rel, to)
        puts json_out ? { from: from, relation: rel, to: to }.to_json : "#{from} -[#{rel}]-> #{to}"

      when "resolve"
        word = args.join(" ")
        word = word.empty? ? (abort "usage: concept resolve <word>") : word
        c = Models::Concept.resolve(word)
        if c
          puts json_out ? c.to_h.to_json : "#{word} → #{c.slug} (#{c.term})"
        else
          puts json_out ? { slug: nil, word: word }.to_json : "not found: #{word}"
          exit 1
        end

      when "seed-canon"
        n = Models::Concept.seed_canon!
        puts json_out ? { seeded: n }.to_json : "seeded #{n} canon concepts"

      when nil, "--help", "-h"
        puts "usage: zdots-brain concept <add|alias|link|resolve|seed-canon> ..."
        exit 0

      else
        slug = subcommand
        c = Models::Concept.find(slug: slug)
        if c
          puts json_out ? c.to_h.to_json : "#{c.slug}: #{c.term}\n  #{c.definition}"
        else
          abort "concept not found: #{slug}"
        end
      end
    end

    def cmd_sync_history(args)
      require "sqlite3"

      dry_run  = args.include?("--dry-run")
      db_path  = args.find { |a| !a.start_with?("--") } ||
                 File.join(ENV.fetch("XDG_STATE_HOME", File.expand_path("~/.local/state")),
                           "zdots", "history.sqlite3")

      unless File.exist?(db_path)
        puts "sync-history: SQLite DB not found at #{db_path}"
        puts "  Enable ZDOTS_CMD_ANALYTICS=1 in .zdots.local and run a few commands first,"
        puts "  or let shell_hook_metrics create the buffer by crossing the hook threshold."
        exit 1
      end

      sqlite = SQLite3::Database.new(db_path, readonly: true)
      sqlite.results_as_hash = true
      shell_hook_metrics_exists = sqlite.get_first_value(
        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'shell_hook_metrics' LIMIT 1"
      )

      command_synced, command_last, command_new = sync_incremental_table(
        sqlite,
        "SELECT id, session_id, ts, cwd, cmd, args, exit_code, duration_ms, profile
           FROM command_runs
          WHERE id > ?
          ORDER BY id ASC
          LIMIT 5000",
        "command_runs_last_id",
        [:session_id, :ts, :cmd, Sequel.function(:coalesce, :args, "")],
        :command_runs,
        dry_run
      ) do |row, host|
        {
          session_id: row["session_id"],
          ts: row["ts"],
          cwd: row["cwd"],
          cmd: row["cmd"],
          args: row["args"],
          exit_code: row["exit_code"],
          duration_ms: row["duration_ms"],
          profile: row["profile"],
          host: host
        }
      end

      if shell_hook_metrics_exists
        hook_synced, hook_last, hook_new = sync_incremental_table(
          sqlite,
          "SELECT id, session_id, ts_ms, hook, status, elapsed_ms, threshold_ms, host
             FROM shell_hook_metrics
            WHERE id > ?
            ORDER BY id ASC
            LIMIT 5000",
          "shell_hook_metrics_last_id",
          %i[session_id ts_ms hook status elapsed_ms threshold_ms],
          :shell_hook_metrics,
          dry_run
        ) do |row, host|
          {
            session_id: row["session_id"],
            ts_ms: row["ts_ms"],
            hook: row["hook"],
            status: row["status"],
            elapsed_ms: row["elapsed_ms"],
            threshold_ms: row["threshold_ms"],
            host: row["host"] || host
          }
        end
      else
        hook_synced = 0
        hook_last   = 0
        hook_new    = 0
      end

      if command_synced.zero? && hook_synced.zero?
        puts "sync-history: nothing new (command_runs=#{command_last}, shell_hook_metrics=#{hook_last})"
        sqlite.close
        return
      end

      sqlite.close
      puts "sync-history: #{dry_run ? '[dry-run] would sync' : 'synced'} #{command_synced} command_runs (cursor #{command_last} → #{command_new})"
      puts "sync-history: #{dry_run ? '[dry-run] would sync' : 'synced'} #{hook_synced} shell_hook_metrics (cursor #{hook_last} → #{hook_new})"
    end

    def cmd_rekey(args)
      dry_run = @options[:dry_run]
      table = args.shift || "lessons"
      unless REKEY_TABLES.key?(table)
        puts "usage: zdots-brain rekey [--dry-run] [#{REKEY_TABLES.keys.join('|')}]"
        exit 1
      end

      begin
        old_key, new_key = Zdots::Crypto::KeyStore.rotation_keys
      rescue KeyError => e
        puts "zdots-brain: #{e.message}"
        exit e.message.include?("identical") ? 0 : 1
      end

      columns = REKEY_TABLES[table]
      puts "zdots-brain: re-keying #{table} (#{columns.join(', ')})#{' (dry run)' if dry_run}..."

      total_rekeyed = total_already_new = total_null = total_errors = 0

      columns.each do |col|
        rows = Zdots.db[table.to_sym].select(:id, col).all
        rekeyed = already_new = null_rows = errors = 0

        rows.each do |row|
          if row[col].nil?
            null_rows += 1
            next
          end

          begin
            plaintext = nil
            Zdots.db.transaction(savepoint: true) do
              plaintext = Zdots.db.get(
                Sequel.function(:pgp_sym_decrypt, Sequel.blob(row[col].to_s), old_key)
              )
            end

            unless dry_run
              new_enc = Zdots.db.get(Sequel.function(:pgp_sym_encrypt, plaintext, new_key))
              Zdots.db[table.to_sym].where(id: row[:id]).update(col => new_enc)
            end

            rekeyed += 1
          rescue Sequel::DatabaseError
            # pgp_sym_decrypt failed with old key — row may already be on new key
            begin
              Zdots.db.transaction(savepoint: true) do
                Zdots.db.get(
                  Sequel.function(:pgp_sym_decrypt, Sequel.blob(row[col].to_s), new_key)
                )
              end
              already_new += 1
            rescue Sequel::DatabaseError
              errors += 1
            end
          end
        end

        puts "    #{col}: rekeyed=#{rekeyed} already_new=#{already_new} null=#{null_rows} errors=#{errors}"
        total_rekeyed += rekeyed
        total_already_new += already_new
        total_null += null_rows
        total_errors += errors
      end

      puts "zdots-brain: #{table} rekey #{dry_run ? 'scan' : 'complete'}:"
      puts "  rekeyed     : #{total_rekeyed}"
      puts "  already new : #{total_already_new}"
      puts "  null        : #{total_null}"
      puts "  unreadable  : #{total_errors}"

      exit(total_errors.positive? ? 1 : 0)
    end

    def cmd_status
      # Zdots.init_otel("zdots-brain")
      db = Zdots.db
      connected = begin
        true
      rescue StandardError
        false
      end

      enc_coverage = REKEY_TABLES.flat_map do |tbl, cols|
        cols.filter_map do |col|
          schema_cols = db[tbl.to_sym].columns rescue []
          next unless schema_cols.include?(col)
          count = db[tbl.to_sym].exclude(col => nil).count rescue 0
          ["#{tbl}.#{col}", count]
        end
      end.to_h

      data = {
        connected: connected,
        database: db.opts[:database] || "unknown",
        counts: {
          methodologies: Zdots::Models::Methodology.count,
          lessons: Zdots::Models::Lesson.count,
          pending_jobs: Zdots::Models::Job.pending_count,
          dead_jobs: Zdots::Models::Job.dead_count
        },
        my_root: ENV.fetch("ZDOTS_MY_ROOT", nil),
        encryption_coverage: enc_coverage
      }

      if @options[:format] == "json"
        puts JSON.pretty_generate(data)
      else
        puts "zdots-brain: connected to database: #{data[:database]}"
        puts "  methodologies : #{data[:counts][:methodologies]}"
        puts "  lessons       : #{data[:counts][:lessons]}"
        puts "  pending jobs  : #{data[:counts][:pending_jobs]}"
        puts "  dead jobs     : #{data[:counts][:dead_jobs]}"
        puts "  my_root       : #{data[:my_root]}"
        puts "  encryption:"
        enc_coverage.each { |col, n| puts "    #{col.ljust(34)} #{n} rows" }
      end
    rescue StandardError => e
      if @options[:format] == "json"
        puts JSON.generate({ connected: false, error: e.message })
      else
        puts "zdots-brain: [!!] error: #{e.message}"
      end
      exit 1
    end
  end
end

Zdots::DB.validate!

Zdots::CLI.new.run(ARGV)
