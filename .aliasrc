hash -d desk="$HOME/Desktop"
hash -d xdots="$HOME/.config"
hash -d zdots="$ZDOTDIR"

hash -d projects="$HOME/projects"
alias projects='nocorrect ~projects'

alias desk='nocorrect ~desk'
alias xdots='nocorrect ~xdots'
alias zdots='nocorrect ~zdots'
alias vim="$EDITOR"
alias vi="$EDITOR"

if command -v gls >/dev/null 2>&1; then
  alias ls='command gls --color'
else
  # Nord-inspired fallback for BSD ls when GNU ls is unavailable.
  : "${LSCOLORS:=gxfxcxdxbxegedabagacad}"
  export LSCOLORS
  alias ls='command ls -G'
fi

alias -g gi='| grep -i'
alias -g lx='l -10'
alias -g lxx='l -20'
alias -g lxxx='l -30'
alias -g nv='--tls-no-verify'
alias -s gif=preview
alias -s jpeg=preview
alias -s jpg=preview
alias -s pdf=acrobat
alias -s png=preview
alias acrobat='open -a Adobe\ Acrobat\ Reader\ DC'
alias b="bundle"
alias be="b exec"
alias bounce='reload'
alias bsl='brew services list'
alias bu="b update"
alias chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome'
alias clear='clear'
alias clear\!='klear'
alias cwd='pwd | pbcopy'
alias firefox='/Applications/Firefox.app/Contents/MacOS/firefox'
alias gba='git branch --all'
alias gco='git checkout '
alias gfa='git fetch --all --prune'
alias gfp='git format-patch HEAD~1 --no-color --stdout'
alias gs='git status --short'
alias gss='git status --short'
alias gwd='git diff --word-diff'
alias listening-on='lsof -Pni4 | grep LISTEN'
alias ll='ls -alh'
alias marked='/Applications/Marked\ 2.app/Contents/MacOS/Marked\ 2'
alias preview='open -a Preview'
alias prunedirs='rm -d **/*(/^F)'
alias wip='git commit -am "WIP"'

if command -v gdate >/dev/null 2>&1; then
  _zdots_date_bin='gdate'
  _zdots_ts_fmt='%Y-%m-%dT%H.%M.%2N'
  _zdots_ts_dir_fmt='%Y-%m-%d/%H.%M.%2N'
else
  _zdots_date_bin='date'
  _zdots_ts_fmt='%Y-%m-%dT%H.%M.%S'
  _zdots_ts_dir_fmt='%Y-%m-%d/%H.%M.%S'
fi

alias iso8601-local="${_zdots_date_bin} +'%Y-%m-%dT%H:%M:%S%z'"
alias iso8601-utc="${_zdots_date_bin} -u +'%Y-%m-%dT%H:%M:%SZ'"
alias timestamp-dir-local="${_zdots_date_bin} +'${_zdots_ts_dir_fmt}'"
alias timestamp-dir-utc="${_zdots_date_bin} -u +'${_zdots_ts_dir_fmt}'"
alias timestamp-local="${_zdots_date_bin} +'${_zdots_ts_fmt}'"
alias timestamp-utc="${_zdots_date_bin} -u +'${_zdots_ts_fmt}'"

unset _zdots_date_bin _zdots_ts_fmt _zdots_ts_dir_fmt

[[ -r "${ZDOTDIR}/.aliasrc.claude" ]] && . "${ZDOTDIR}/.aliasrc.claude"
[[ -r "${ZDOTDIR}/.aliasrc.local" ]] && . "${ZDOTDIR}/.aliasrc.local"
