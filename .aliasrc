# .aliasrc — Master Alias Entry Point

# 1. Source Common Aliases (Bash & Zsh)
if [[ -r "${ZDOTDIR}/aliases.bash" ]]; then
  source "${ZDOTDIR}/aliases.bash"
fi

# 2. Source Zsh-specific Aliases (Zsh only)
if [[ -n "${ZSH_VERSION:-}" ]]; then
  if [[ -r "${ZDOTDIR}/aliases.zsh" ]]; then
    source "${ZDOTDIR}/aliases.zsh"
  fi
fi

# 3. Local & Private Overrides
if [[ -r "${ZDOTDIR}/.aliasrc.local" ]]; then
  source "${ZDOTDIR}/.aliasrc.local"
fi
