# Brewfile.common — shared package core for home and work machines.
#
# Do NOT install this file directly. It is included by Brewfile.home and
# Brewfile.work via instance_eval. Packages common to BOTH contexts live here;
# context-specific packages live in the respective Brewfile.
#
# Ordering: taps first (so tapped formulae resolve), then brews, then casks.

# ── Taps ──
tap "romkatv/powerlevel10k" # Powerlevel10k formula tap

# ── Formulae ──
brew "ack" # Search tool like grep, but optimized for programmers
brew "act" # Run your GitHub Actions locally
brew "shellcheck" # Static analysis and lint tool, for (ba)sh scripts
brew "actionlint" # Static checker for GitHub Actions workflow files
brew "ansifilter" # Strip or convert ANSI codes into HTML, (La)Tex, RTF, or BBCode
brew "aider"       # zaider / laid use the Homebrew-managed local coding CLI
brew "openssl@3" # Cryptography and SSL/TLS Toolkit
brew "tmux" # Terminal multiplexer
brew "aoe" # Terminal session manager for AI coding agents
brew "ast-grep" # Code searching, linting, rewriting
brew "atuin" # Improved shell history for zsh, bash, fish and nushell
brew "sqlite" # Command-line interface for SQLite
brew "node" # Open-source, cross-platform JavaScript runtime environment
brew "python"      # interpreter for history-intelligence (Seam ⑦) + analysis tooling
brew "backlog-md" # Markdown‑native Task Manager & Kanban visualizer for any Git repository
brew "bash" # Bourne-Again SHell, a UNIX command interpreter
brew "bat" # Clone of cat(1) with syntax highlighting and Git integration
brew "bats-core" # Bash Automated Testing System
brew "bandwhich"    # network traffic per process — verify AI local-only boundary at OS level
brew "bottom" # Yet another cross-platform graphical process/system monitor
brew "boxes" # Draw boxes around text
brew "broot" # New way to see and navigate directory trees
brew "btop" # Resource monitor. C++ version and continuation of bashtop and bpytop
brew "librsvg" # Library to render SVG files using Cairo
brew "chafa" # Versatile and fast Unicode/ASCII/ANSI graphics renderer
brew "cmake" # Cross-platform make
brew "colima"      # on-demand local container VM; bare-metal work is the default
brew "coreutils" # GNU File, Shell, and Text utilities
brew "csvlens" # Command-line csv viewer
brew "curl" # Get a file from an HTTP, HTTPS or FTP server
brew "dasel" # JSON, YAML, TOML, XML, and CSV query and modification tool
brew "dashing" # Generate Dash documentation from HTML files
brew "diff-so-fancy" # Good-lookin' diffs with diff-highlight and more
brew "difftastic"   # structural (AST-aware) diffs — easier for agents/humans to read
brew "direnv" # Load/unload environment variables based on $PWD
brew "docker" # Pack, ship and run any application as a lightweight container
brew "docker-buildx" # Docker CLI plugin for extended build capabilities with BuildKit
brew "docker-compose" # Isolated development environments using Docker
brew "docker-compose-langserver" # Language service for Docker Compose documents
brew "docker-credential-helper" # Platform keystore credential helper for Docker
brew "duckdb"       # embeddable OLAP SQL — fast local analytics (CSV/Parquet/SQLite)
brew "entr" # Run arbitrary commands when files change
brew "eza" # Modern, maintained replacement for ls
brew "fabric-ai" # Open-source framework for augmenting humans using AI
brew "fd" # Simple, fast and user-friendly alternative to find
brew "fdupes" # Identify or delete duplicate files
brew "ffmpeg"       # yt-transcribe: 16k mono conversion + ffprobe duration
brew "fish" # User-friendly command-line shell for UNIX-like operating systems
brew "fswatch" # Monitor a directory for changes and run a shell command
brew "fx" # Terminal JSON viewer
brew "fzf" # Command-line fuzzy finder written in Go
brew "fzf-tab"        # zsh completion menu via fzf — conf.d/74-fzf.zsh sources it; bin/check asserts its widget
brew "geoipupdate" # Automatic updates of GeoIP2 and GeoIP Legacy databases
brew "gh" # GitHub command-line tool
brew "github-keygen" # zdots-github-keys manages separate home/work identities
brew "git" # Distributed revision control system
brew "git-absorb" # Automatic git commit --fixup
brew "git-delta" # Syntax-highlighting pager for git and diff output
brew "git-lfs" # Git extension for versioning large files
brew "git-filter-repo" # local history maintenance; published history stays immutable
brew "gitleaks" # Audit git repos for secrets
brew "gitlint" # Linting for your git commit messages
brew "glow" # Render markdown on the CLI
brew "gnupg" # GNU Privacy Guard (OpenPGP)
brew "go" # Open source programming language to build simple/reliable/efficient software
brew "graphicsmagick" # Image processing tools collection
brew "graphviz" # Graph visualization software from AT&T and Bell Labs
brew "grep" # GNU grep, egrep and fgrep
brew "hadolint" # Smarter Dockerfile linter to validate best practices
brew "htop" # Improved top (interactive process viewer)
brew "hyperfine" # Command-line benchmarking tool
brew "imagemagick" # Tools and libraries to manipulate images in select formats
brew "jemalloc" # Implementation of malloc emphasizing fragmentation avoidance
brew "jless" # Command-line pager for JSON data
brew "jq" # Lightweight and flexible command-line JSON processor
brew "k6" # Modern load testing tool, using Go and JavaScript
brew "lazygit" # Simple terminal UI for git commands
brew "litecli"      # SQLite REPL with autocomplete — explore command_runs analytics DB
brew "llama.cpp" # LLM inference in C/C++
brew "lnav" # Curses-based tool for viewing and analyzing log files
# lua-language-server et al: editor-only LSP servers now come from Mason
# (vdots lua/editor/mason.lua). Brew keeps only tools the shell / CI also run.
brew "luacheck" # Tool for linting and static analysis of Lua code
brew "luarocks" # Package manager for the Lua programming language
brew "mactop" # Apple Silicon Monitor Top written in Go Lang
brew "mkcert" # Simple tool to make locally trusted development certificates
brew "mermaid-cli" # CLI for Mermaid library
brew "usage" # Tool for working with usage-spec CLIs
brew "mise" # Polyglot runtime manager (asdf rust clone)
brew "mmv" # Move, copy, append, and link multiple files
brew "ncdu" # NCurses Disk Usage
brew "ninja"        # common native build backend for CMake projects
brew "tree-sitter" # Incremental parsing library
brew "neovim" # Ambitious Vim-fork focused on extensibility and agility
brew "ghostscript"    # nvim (vdots) doc rendering — provides `gs` for PDF preview (snacks/image.nvim)
brew "tectonic"       # nvim (vdots) LaTeX math rendering in markdown preview
brew "nginx"          # local reverse proxy — the *.localhost vhosts (TLS via mkcert)
brew "nvtop" # Interactive GPU process monitor
brew "ollama" # Create, run, and share large language models (LLMs)
brew "openapi" # CLI tools for working with OpenAPI, Arazzo and Overlay specifications
brew "openjdk" # Development kit for the Java programming language
brew "openapi-diff" # Utility for comparing two OpenAPI specifications
brew "openapi-generator" # Generate clients, server & docs from an OpenAPI spec (v2, v3)
brew "openapi-tui" # TUI to list, browse and run APIs defined with openapi spec
brew "ossp-uuid" # ISO-C API and CLI for generating UUIDs
brew "otel-cli" # Tool for sending events from shell scripts & similar environments
brew "pandoc" # Swiss-army knife of markup format conversion
brew "pgcli"        # PostgreSQL REPL with autocomplete — replaces raw psql for zdots_ro exploration
brew "pgvector" # Open-source vector similarity search for Postgres
brew "pipx" # Execute binaries from Python packages in isolated environments
brew "pnpm" # Fast, disk space efficient package manager
brew "postgresql@18", restart_service: :changed # Object-relational database system
brew "powerlevel10k" # Theme for zsh
brew "pre-commit" # Framework for managing multi-language pre-commit hooks
brew "prettier" # Code formatter for JavaScript, CSS, JSON, GraphQL, Markdown, YAML
brew "pv" # Monitor data's progress through a pipe
brew "ranger" # File browser
brew "redis", restart_service: :changed # Persistent key-value database, with built-in net interface
brew "rename" # Perl-powered file rename script with many helpful built-ins
brew "repomix" # Pack repository contents into a single AI-friendly file
