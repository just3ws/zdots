brew "ruby-lsp" # Opinionated language server for Ruby
brew "rustup" # Rust toolchain installer
brew "sd" # Intuitive find & replace CLI
brew "sqlite-utils" # CLI analytics on SQLite — query command_runs, export JSON/CSV
brew "selene"      # vdots: strict Lua linter (test/lint.sh uses it when present)
brew "sesh" # Smart session manager for the terminal
brew "shfmt" # Autoformat shell script source code
brew "sponge" # Soak up standard input and write to a file
brew "ssh-copy-id" # Add a public key to a remote machine's authorized_keys file
brew "stylua" # Opinionated Lua code formatter
brew "svgo" # Nodejs-based tool for optimizing SVG vector graphics files
brew "swift-format" # Formatting technology for Swift source code
brew "swiftformat" # Formatting tool for reformatting Swift code
brew "swiftlint" # Tool to enforce Swift style and conventions
brew "syft" # CLI for generating a Software Bill of Materials from container images
brew "taplo" # TOML toolkit written in Rust
brew "tealdeer" # Very fast implementation of tldr in Rust
brew "television" # General purpose fuzzy finder TUI
brew "terminal-notifier" # Send macOS User Notifications from the command-line
brew "tokei" # Program that allows you to count code, quickly
brew "tree" # Display directories as trees (with optional color/HTML output)
brew "tree-sitter-cli" # Parser generator tool
brew "trivy" # Vulnerability scanner for container images, file systems, and Git repos
brew "trufflehog" # Find and verify credentials
brew "universal-ctags" # Maintained ctags implementation
brew "uv" # Extremely fast Python package installer and resolver, written in Rust
brew "visidata"     # TUI spreadsheet for SQLite/PostgreSQL — interactive command_runs analysis
brew "vivid" # Generator for LS_COLORS with support for multiple color themes
brew "vips" # Image processing library
brew "watch" # Executes a program periodically, showing output fullscreen
brew "watchexec"    # re-run bats on file change — tighter test feedback than entr
brew "wget" # Internet file retriever
brew "whisper.cpp" # local speech-to-text engine used by ztranscribe
brew "whisperkit-cli" # Swift native on-device speech recognition with Whisper for Apple Silicon
brew "xcodegen" # Generate your Xcode project from a spec file and your folder structure
