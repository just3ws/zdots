#!/usr/bin/env bash
# recipes/log-errors — Triage llama.cpp server errors with AI explanation.
#
# Scenario: Something's wrong with inference. The log is full of noise.
#           Extract the errors and get a plain-English explanation.
#
# What this does:
#   1. Reads the llama.cpp server log
#   2. Extracts lines containing error/warn/fail/exception patterns
#   3. Passes them to ai-query for triage and suggested fixes
#
# Usage:
#   recipes/log-errors                 # last 200 log lines → extract errors → explain
#   recipes/log-errors --lines 500     # scan more log history
#   recipes/log-errors --raw           # print extracted errors without AI explanation
#   recipes/log-errors --service otel  # triage otel-collector log instead
#   recipes/log-errors --service ci    # triage local-ci (LGTM) log instead

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
AI_QUERY="${ZDOTDIR}/bin/ai-query"

LINES=200
RAW=false
SERVICE="llama"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --lines)   LINES="$2"; shift ;;
    --raw)     RAW=true ;;
    --service) SERVICE="$2"; shift ;;
    --help)
      sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) printf 'log-errors: unknown option: %s\n' "$1" >&2; exit 1 ;;
  esac
  shift
done

# Locate log file for the requested service
case "$SERVICE" in
  llama|llama.cpp)
    # llama-ctl writes to the launchd log path
    LOG_FILE=$(defaults read /Library/LaunchAgents/com.zdots.llama-server 2>/dev/null \
      | grep StandardErrorPath | sed 's/.*= "\(.*\)";/\1/' 2>/dev/null || true)
    # Fallback: check common locations
    if [[ -z "$LOG_FILE" ]] || [[ ! -f "$LOG_FILE" ]]; then
      for candidate in \
        "$HOME/Library/Logs/llama-server.log" \
        "$HOME/.local/state/llama-server/llama-server.log" \
        "/tmp/llama-server.log"; do
        [[ -f "$candidate" ]] && { LOG_FILE="$candidate"; break; }
      done
    fi
    SERVICE_LABEL="llama.cpp"
    ;;
  otel|otel-collector)
    for candidate in \
      "$HOME/Library/Logs/otel-collector.log" \
      "$HOME/.local/state/otel-collector/otel-collector.log" \
      "/tmp/otel-collector.log"; do
      [[ -f "$candidate" ]] && { LOG_FILE="$candidate"; break; }
    done
    SERVICE_LABEL="OTel collector"
    ;;
  ci|lgtm|local-ci)
    LOG_FILE=""  # local-ci logs come from docker — use docker logs
    SERVICE_LABEL="LGTM stack"
    ;;
  *)
    printf 'log-errors: unknown service "%s". Use: llama, otel, ci\n' "$SERVICE" >&2
    exit 1
    ;;
esac

# Acquire log content
if [[ "$SERVICE" == "ci" || "$SERVICE" == "lgtm" || "$SERVICE" == "local-ci" ]]; then
  if ! command -v docker >/dev/null 2>&1; then
    printf 'log-errors: docker not found — is Colima running?\n' >&2; exit 1
  fi
  RAW_LOG=$(docker logs lgtm 2>&1 | tail -n "$LINES" || \
            docker compose -f "${ZDOTDIR}/etc/lgtm/docker-compose.yml" logs --tail "$LINES" 2>/dev/null || \
            printf '')
elif [[ -n "${LOG_FILE:-}" ]] && [[ -f "$LOG_FILE" ]]; then
  RAW_LOG=$(tail -n "$LINES" "$LOG_FILE")
else
  # Try reading via the ctl script's logs subcommand (non-blocking, captured)
  case "$SERVICE" in
    llama*) RAW_LOG=$(timeout 3 "${ZDOTDIR}/bin/llama-ctl" logs 2>/dev/null || true) ;;
    otel*)  RAW_LOG=$(timeout 3 "${ZDOTDIR}/bin/otel-collector" logs 2>/dev/null || true) ;;
  esac
fi

if [[ -z "${RAW_LOG:-}" ]]; then
  printf 'log-errors: could not read %s log.\n' "$SERVICE_LABEL"
  printf '  Try: zlogs  (or zlogs-otel / zlogs-ci)\n'
  exit 1
fi

# Extract error lines
ERRORS=$(printf '%s' "$RAW_LOG" \
  | grep -iE "error|warn|fail|exception|fatal|panic|oom|killed|abort|cannot|refused|timeout" \
  | grep -vE "^$" \
  || true)

printf '\033[1m── %s Log Errors (last %s lines) ──────────────\033[0m\n' "$SERVICE_LABEL" "$LINES"

if [[ -z "$ERRORS" ]]; then
  printf '  (no errors or warnings found — log looks clean)\n'
  exit 0
fi

printf '%s\n\n' "$ERRORS"
[[ "$RAW" == "true" ]] && exit 0

# AI explanation
if ! curl -sf -m 2 "${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:8080}/health" >/dev/null 2>&1; then
  printf '(AI explanation skipped — llama.cpp is not running)\n'
  exit 0
fi

PROMPT="Triage these log errors from a $SERVICE_LABEL process.
For each distinct error type:
- One line: what it means in plain English
- One line: most likely cause and fix
Group similar errors together. Be terse. Output as markdown bullets."

printf '\033[1m── Triage ──────────────────────────────────────\033[0m\n'
if command -v rtk >/dev/null 2>&1; then
  printf '%s' "$ERRORS" | rtk | "$AI_QUERY" --mode safe-extract "$PROMPT"
else
  printf '%s' "$ERRORS" | "$AI_QUERY" --mode safe-extract "$PROMPT"
fi
