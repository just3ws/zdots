#!/usr/bin/env bash
# recipes/morning — Morning shell intelligence briefing.
#
# Scenario: Start of day. Get a read on your shell patterns and alias gaps
#           without opening a browser or checking Slack.
#
# What this does:
#   1. Platform health snapshot (services up/down)
#   2. Top commands from atuin history (last 7 days)
#   3. AI-generated workflow suggestions
#   4. Alias candidates from repeated long commands
#
# Usage:
#   recipes/morning              # full briefing
#   recipes/morning --quick      # health + top commands only (no AI)

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
HISTORY_ANALYZE="${ZDOTDIR}/bin/history-analyze"
HISTORY_INTEL="${ZDOTDIR}/bin/history-intelligence"
ALIAS_SUGGEST="${ZDOTDIR}/bin/alias-suggest"

QUICK=false
for arg in "$@"; do
  case "$arg" in
    --quick) QUICK=true ;;
    --help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
done

_header() { printf '\n\033[1m── %s \033[0m\n' "$1"; }
_ok()     { printf '  \033[32m✓\033[0m %s\n' "$1"; }
_warn()   { printf '  \033[33m!\033[0m %s\n' "$1"; }
_err()    { printf '  \033[31m✗\033[0m %s\n' "$1"; }

AI_ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"
AI_UP=false
curl -sf -m 2 "${AI_ENDPOINT}/health" >/dev/null 2>&1 && AI_UP=true

# 1. Platform health
_header "Platform Health"

if $AI_UP; then
  MODEL=$(curl -sf -m 2 "${AI_ENDPOINT}/v1/models" 2>/dev/null \
    | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4 || echo "unknown")
  _ok "llama.cpp up — model: $MODEL"
else
  _err "llama.cpp down  (llama-ctl start)"
fi

if "${ZDOTDIR}/bin/otel-collector" health >/dev/null 2>&1; then
  _ok "OTel collector up"
else
  _warn "OTel collector down  (otel-collector start)"
fi

if curl -sf -m 3 "http://127.0.0.1:3000/api/health" >/dev/null 2>&1; then
  _ok "Grafana / LGTM up"
else
  _warn "Grafana / LGTM down  (local-ci start)"
fi

# 1.5 Knowledge Layer & Queue
if _ctx_status=$("${ZDOTDIR}/bin/zdots-ctx" status --json 2>/dev/null); then
  if echo "$_ctx_status" | grep -q '"connected": true'; then
    _pending=$(echo "$_ctx_status" | grep -o '"pending_jobs": [0-9]*' | awk '{print $2}')
    _dead=$(echo "$_ctx_status"    | grep -o '"dead_jobs": [0-9]*'    | awk '{print $2}')
    _pending=${_pending:-0}; _dead=${_dead:-0}
    _ok "Knowledge Layer connected"
    if [[ "$_pending" -gt 0 ]]; then
      _warn "$_pending jobs pending (zdots-ctx worker)"
    else
      _ok "0 jobs pending"
    fi
    if [[ "$_dead" -gt 0 ]]; then
      _err "$_dead dead jobs require triage (zdots-ctx triage)"
    else
      _ok "0 dead jobs"
    fi
  else
    _warn "Knowledge Layer disconnected"
  fi
fi

# Check for errant home dir zsh files
ERRANT=()
for f in .zshrc .zprofile .zlogin .zlogout; do
  [[ -f "$HOME/$f" ]] && ERRANT+=("$HOME/$f") || true
done
if (( ${#ERRANT[@]} > 0 )); then
  _warn "errant zsh files in \$HOME: ${ERRANT[*]}"
fi

# 1.7 History Intelligence — inferred interface signals (Seam ⑦)
# Reads shell_hook_metrics (hook health + PHI accountability) and command_runs.
# --quiet prints only the synthesized signals; we surface them under morning's
# own header for visual consistency.
_header "History Intelligence"
if [[ -x "$HISTORY_INTEL" ]]; then
  _signals=$("$HISTORY_INTEL" --quiet --no-color 2>/dev/null | grep '●' || true)
  if [[ -n "$_signals" ]]; then
    printf '%s\n' "$_signals" | while IFS= read -r _line; do
      case "$_line" in
        *'[high]'*) _err "${_line#*● }" ;;
        *'[medium]'*) _warn "${_line#*● }" ;;
        *) printf '  %s\n' "${_line#*● }" ;;
      esac
    done
  else
    _ok "no concerns in window"
  fi
else
  _warn "history-intelligence not found"
fi

# 2. Command frequency (always runs)
# Group by first word (command name) — strips bash history timestamp lines (#...)
# and blank entries before counting, so each command name tallies across all its args.
_header "Top Commands — last 500"
if command -v atuin >/dev/null 2>&1; then
  atuin search --limit 500 --cmd-only -- "" 2>/dev/null \
    | grep -v '^[[:space:]]*#' \
    | awk 'NF>0{print $1}' \
    | sort | uniq -c | sort -rn | head -12 \
    | awk '{printf "  %5d  %s\n", $1, $2}'
else
  _warn "atuin not found"
fi

$QUICK && exit 0

# AI sections require running model
if ! $AI_UP; then
  printf '\n(AI sections skipped — llama.cpp is down)\n'
  exit 0
fi

# 3. AI workflow suggestions
_header "Workflow Suggestions"
"$HISTORY_ANALYZE" --ai --limit 500 2>/dev/null | grep -v "^$" | grep "^-\|^\*" || true

# 4. Alias candidates
_header "Alias Candidates"
CANDIDATES=$("$ALIAS_SUGGEST" --limit 1000 --min-count 3 --min-len 28 2>/dev/null || true)
if [[ -n "$CANDIDATES" ]]; then
  printf '%s\n' "$CANDIDATES"
else
  printf '  (no strong candidates — history may be short or commands already aliased)\n'
fi
