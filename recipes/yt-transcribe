#!/usr/bin/env bash
# recipes/yt-transcribe — High-performance YouTube transcription pipeline.
#
# RATIONALE:
# Automates the extraction of maximum context from YouTube videos: high-quality
# audio, rich metadata, and absolute-max-accuracy transcription with optional
# speaker identification.
#
# DEPENDENCIES:
# - yt-dlp, ffmpeg, whisper.cpp (via selected Brewfile.home/work)
# - bin/whisper-ctl (for model management)
# - bin/diarize (for optional speaker labeling)

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
WHISPER_CTL="${ZDOTDIR}/bin/whisper-ctl"
DIARIZE="${ZDOTDIR}/bin/diarize"
AI_QUERY="${ZDOTDIR}/bin/ai-query"
OUT_BASE="${HOME}/Downloads/transcripts"

usage() {
  cat <<EOF
Usage: ztranscribe <youtube_url> [options]

High-performance YouTube transcription pipeline. Downloads best audio, 
captures full metadata, and transcribes using whisper.cpp.

Options:
  --keep-media   Keep the original .wav audio file (deleted by default).
  --diarize      Identify speakers (requires HUGGINGFACE_TOKEN).
  --summarize    Generate an AI summary/cleanup (requires llama-server).
  --profile <p>  Whisper profile: max-accuracy (default), standard, light.
  -h, --help     Show this help

Outputs:
  Saved to ~/Downloads/transcripts/<video_id>/ in 5+ formats:
  .txt, .json (structured), .srt, .vtt, .csv, .info.json, .summary.md
EOF
}

URL=""
KEEP_MEDIA=false
DIARIZE_FLAG=false
SUMMARIZE_FLAG=false
JSON_FULL=false
WHISPER_PROMPT=""
WHISPER_PROFILE="max-accuracy"
PREP_ONLY=false           # Z-169: download+convert to 16k wav, keep it, stop before whisper
FROM_WAV=""               # Z-169: transcribe a window of an existing 16k wav (skip download)
OFFSET_SEC=""             # Z-169: window start (seconds) for --from-wav
WINDOW_SEC=""             # Z-169: window length (seconds) for --from-wav
OUTPUT_BASE=""            # Z-169: whisper --output-file base (required with --from-wav)

while [[ $# -gt 0 ]]; do
  case "$1" in
    --keep-media)  KEEP_MEDIA=true; shift ;;
    --diarize)     DIARIZE_FLAG=true; shift ;;
    --summarize)   SUMMARIZE_FLAG=true; shift ;;
    --json-full)   JSON_FULL=true; shift ;;            # token-level confidence (doubt loop)
    --out-dir)     OUT_BASE="$2"; shift 2 ;;           # override retention dir (default ~/Downloads)
    --prompt)      WHISPER_PROMPT="$2"; shift 2 ;;     # bias whisper toward known vocabulary
    --profile)     WHISPER_PROFILE="$2"; shift 2 ;;
    --prep-only)   PREP_ONLY=true; shift ;;            # Z-169
    --from-wav)    FROM_WAV="$2"; shift 2 ;;           # Z-169
    --offset-sec)  OFFSET_SEC="$2"; shift 2 ;;         # Z-169
    --window-sec)  WINDOW_SEC="$2"; shift 2 ;;         # Z-169
    --output-base) OUTPUT_BASE="$2"; shift 2 ;;        # Z-169
    -h|--help)     usage; exit 0 ;;
    --*)           printf 'yt-transcribe: error: unknown flag: %s\n' "$1" >&2; usage >&2; exit 1 ;;
    *)             URL="$1"; shift ;;
  esac
done

# resolve_model: sets MODEL_PATH + WHISPER_BIN for the active profile. Shared by
# the full pipeline and the Z-169 --from-wav window path.
resolve_model() {
  ZDOTS_WHISPER_PROFILE="$WHISPER_PROFILE" "$WHISPER_CTL" model-download >&2
  local models_dir model_file
  models_dir="${ZDOTS_WHISPER_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/whisper-cpp/models}"
  model_file=$(ZDOTS_WHISPER_PROFILE="$WHISPER_PROFILE" "$WHISPER_CTL" config | jq -r '.model_file')
  MODEL_PATH="${models_dir}/${model_file}"
  WHISPER_BIN=$("$WHISPER_CTL" config | jq -r '.binary // empty')
  [[ -z "$WHISPER_BIN" || "$WHISPER_BIN" == "null" ]] && WHISPER_BIN="/opt/homebrew/bin/whisper-cli"
  if [[ ! -f "$MODEL_PATH" ]]; then
    printf 'yt-transcribe: error: model not found at %s\n' "$MODEL_PATH" >&2
    exit 1
  fi
}

# Z-169 window mode: transcribe one time window of an already-prepared 16k wav.
# No download/convert; outputs only .txt (+ json-full if asked) under --output-base.
MAX_CONTEXT=(--max-context 0)
if [[ -n "$WHISPER_PROMPT" ]]; then
  MAX_CONTEXT=()
fi

if [[ -n "$FROM_WAV" ]]; then

  [[ -f "$FROM_WAV" ]]    || { printf 'yt-transcribe: error: --from-wav not found: %s\n' "$FROM_WAV" >&2; exit 1; }
  [[ -n "$OUTPUT_BASE" ]] || { printf 'yt-transcribe: error: --from-wav requires --output-base\n' >&2; exit 1; }
  mkdir -p "$(dirname "$OUTPUT_BASE")"
  resolve_model
  WIN_ARGS=()
  [[ -n "$OFFSET_SEC" ]] && WIN_ARGS+=(--offset-t "$((OFFSET_SEC * 1000))")
  [[ -n "$WINDOW_SEC" ]] && WIN_ARGS+=(--duration "$((WINDOW_SEC * 1000))")
  PROMPT_ARGS=()
  [[ -n "$WHISPER_PROMPT" ]] && PROMPT_ARGS=(--prompt "$WHISPER_PROMPT")
  JSON_FLAG="--output-json"
  [[ "$JSON_FULL" == true ]] && JSON_FLAG="--output-json-full"
  # --max-context 0: don't seed each window with prior-text tokens. Default (-1)
  # lets large-v3-turbo feed its own output back in and spiral into a repetition
  # loop (a 20-min talk ballooned to 3x its words). Off = each window decodes clean.
  "$WHISPER_BIN" \
    --model "$MODEL_PATH" --file "$FROM_WAV" \
    ${MAX_CONTEXT[@]+"${MAX_CONTEXT[@]}"} \
    --max-len 60 \
    --output-txt "$JSON_FLAG" \
    "${WIN_ARGS[@]+"${WIN_ARGS[@]}"}" "${PROMPT_ARGS[@]+"${PROMPT_ARGS[@]}"}" \
    --output-file "$OUTPUT_BASE" >&2
  printf 'CHUNK_TXT=%s.txt\n' "$OUTPUT_BASE"
  exit 0
fi

if [[ -z "$URL" ]]; then
  usage; exit 1
fi

# 1. Staging & Metadata
# Get video ID for unique naming
VIDEO_ID=$(yt-dlp --get-id "$URL" 2>/dev/null || echo "unknown_$(date +%s)")
OUT_DIR="${OUT_BASE}/${VIDEO_ID}"
mkdir -p "$OUT_DIR"

printf '── Initializing pipeline for video: %s\n' "$VIDEO_ID" >&2
printf '── Output directory: %s\n' "$OUT_DIR" >&2

# Download metadata and best audio
printf '── Downloading audio and metadata ...\n' >&2
yt-dlp \
  --extract-audio \
  --audio-format wav \
  --audio-quality 0 \
  --write-info-json \
  --output "${OUT_DIR}/%(id)s.%(ext)s" \
  "$URL" > /dev/null

RAW_WAV="${OUT_DIR}/${VIDEO_ID}.wav"

if [[ ! -f "$RAW_WAV" ]]; then
  printf 'yt-transcribe: error: download failed.\n' >&2
  exit 1
fi

# 2. Preparation (16kHz Mono WAV required by whisper.cpp)
printf '── Converting audio to 16kHz mono WAV ...\n' >&2
CONVERTED_WAV="${OUT_DIR}/${VIDEO_ID}_16k.wav"
ffmpeg -y -i "$RAW_WAV" -ar 16000 -ac 1 -c:a pcm_s16le "$CONVERTED_WAV" > /dev/null 2>&1

# Z-169 prep-only: keep the 16k wav for windowed chunk jobs, report it, stop
# before whisper. The original download is removed to save space.
if [[ "$PREP_ONLY" == true ]]; then
  DURATION_SEC=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$CONVERTED_WAV" 2>/dev/null | cut -d. -f1)
  rm -f "$RAW_WAV"
  printf 'WAV=%s\n' "$CONVERTED_WAV"
  printf 'DURATION_SEC=%s\n' "${DURATION_SEC:-0}"
  exit 0
fi

# 3. Transcription
printf '── Transcribing with Whisper (%s) ...\n' "$WHISPER_PROFILE" >&2
resolve_model

# --output-json-full carries per-token confidence (the doubt loop's signal);
# plain --output-json is segment-only. Default stays segment-only for old callers.
JSON_FLAG="--output-json"
if [[ "$JSON_FULL" == true ]]; then JSON_FLAG="--output-json-full"; fi

# Optional priming prompt (known vocabulary). Build as an array so an empty
# prompt expands to nothing — guarded for bash 3.2 set -u.
PROMPT_ARGS=()
if [[ -n "$WHISPER_PROMPT" ]]; then PROMPT_ARGS=(--prompt "$WHISPER_PROMPT"); fi

# We run whisper-cli with live progress visible.
# --max-context 0 disables prior-text conditioning; see the window-mode note above
# (turbo loops on itself without it).
"$WHISPER_BIN" \
  --model "$MODEL_PATH" \
  --file "$CONVERTED_WAV" \
  ${MAX_CONTEXT[@]+"${MAX_CONTEXT[@]}"} \
  --max-len 60 \
  --output-txt --output-vtt --output-srt --output-csv "$JSON_FLAG" \
  "${PROMPT_ARGS[@]+"${PROMPT_ARGS[@]}"}" \
  --output-file "${OUT_DIR}/${VIDEO_ID}"

# 4. Optional Summarization & Cleanup
if $SUMMARIZE_FLAG; then
  printf '── Summarizing and cleaning up transcript ...\n' >&2
  RAW_TXT="${OUT_DIR}/${VIDEO_ID}.txt"
  SUMMARY_MD="${OUT_DIR}/${VIDEO_ID}.summary.md"
  
  if [[ -f "$RAW_TXT" ]]; then
    CONTEXT=$(zdots-ctx hydrate transcription --json 2>/dev/null || echo "")
    if cat "$RAW_TXT" | "$AI_QUERY" --system "$CONTEXT" "Clean up this transcript and provide a concise executive summary with action items." > "$SUMMARY_MD"; then
      printf '── Summary saved to: %s\n' "$SUMMARY_MD" >&2
    else
      printf 'yt-transcribe: warning: summarization failed.\n' >&2
    fi
  fi
fi

# 5. Optional Diarization
if $DIARIZE_FLAG; then
  printf '── Performing speaker diarization ...\n' >&2
  if ! "$DIARIZE" "$CONVERTED_WAV" "${OUT_DIR}/${VIDEO_ID}.json" --output "${OUT_DIR}/${VIDEO_ID}.speaker.json"; then
    printf 'yt-transcribe: warning: diarization failed (check HUGGINGFACE_TOKEN).\n' >&2
  fi
fi

# 5. Cleanup
rm -f "$CONVERTED_WAV"

if [[ "$KEEP_MEDIA" == "false" ]]; then
  printf '── Cleaning up media files ...\n' >&2
  rm -f "$RAW_WAV"
fi

printf '\n\033[32m✓\033[0m Pipeline complete.\n' >&2
printf 'Outputs saved to: %s\n' "$OUT_DIR" >&2
ls -F "$OUT_DIR"
