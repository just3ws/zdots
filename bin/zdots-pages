#!/usr/bin/env bash
# zdots-pages — reusable GitHub Pages + Wiki publisher for the just3ws systems.
#
# One framework, every repo: renders a repo's curated docs (docs/wiki/*.md) into
# a Jekyll site on a gh-pages worktree with a SHARED theme/nav (etc/pages/), and
# optionally syncs the same pages to the repo's GitHub Wiki. Proven on zdots,
# then applied to adots / vdots / my / phalanxduel / wwworkremote.
#
# Fail-closed, outward-action discipline (mirrors zdots PHI doctrine):
#   - Visibility guard: refuses to publish a PRIVATE repo to a PUBLIC Pages site
#     unless --allow-private is passed explicitly. Public exposure is one-way.
#   - `build`/`status` are local and reversible. `publish`/`wiki` only push the
#     outward branch when --push is given; without it they stage and report.
#
# Usage:
#   zdots-pages status              # repo, visibility, page count, wiki state
#   zdots-pages build               # render site into the gh-pages worktree (local)
#   zdots-pages publish [--push]    # commit gh-pages; push only with --push
#   zdots-pages wiki    [--push]    # sync docs/wiki → <repo>.wiki.git; push w/ --push
#   zdots-pages init                # create the orphan gh-pages branch + worktree
#
# Options:
#   --repo DIR        operate on another repo (default: current git toplevel)
#   --allow-private   permit publishing a private repo (you accept the exposure)
#   --push            perform the outward push (publish/wiki)
#   -h, --help        this help

set -euo pipefail

PAGES_DIRNAME=".gh-pages"
TEMPLATE_DIR="${ZDOTDIR:-$HOME/.config/zsh}/etc/pages"

die()  { printf 'zdots-pages: %s\n' "$*" >&2; exit 1; }
note() { printf 'zdots-pages: %s\n' "$*" >&2; }

usage() { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; }

# --- repo context ----------------------------------------------------------
REPO_DIR="" ALLOW_PRIVATE=0 DO_PUSH=0
CMD="${1:-}"; shift || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)          REPO_DIR="$2"; shift 2 ;;
    --allow-private) ALLOW_PRIVATE=1; shift ;;
    --push)          DO_PUSH=1; shift ;;
    -h|--help)       usage; exit 0 ;;
    *)               die "unknown option: $1" ;;
  esac
done

[[ "$CMD" == "-h" || "$CMD" == "--help" || -z "$CMD" ]] && { usage; exit 0; }

_resolve_repo() {
  if [[ -n "$REPO_DIR" ]]; then
    REPO_ROOT="$(git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null)" \
      || die "not a git repo: $REPO_DIR"
  else
    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
      || die "not inside a git repo (use --repo DIR)"
  fi
  local url; url="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null)" \
    || die "no 'origin' remote on $REPO_ROOT"
  # owner/repo from either SSH or HTTPS form.
  NWO="$(printf '%s' "$url" | sed -E 's#(git@|https://)github.com[:/]##; s#\.git$##')"
  OWNER="${NWO%%/*}"; REPO="${NWO##*/}"
  WORKTREE="$REPO_ROOT/$PAGES_DIRNAME"
  WIKI_SRC="$REPO_ROOT/docs/wiki"
}

_visibility() {
  # Echoes "private" or "public" (best-effort; defaults to private = safe).
  local p; p="$(gh repo view "$OWNER/$REPO" --json isPrivate -q '.isPrivate' 2>/dev/null || echo true)"
  [[ "$p" == "false" ]] && echo public || echo private
}

_guard_outward() {
  # Refuse private→public exposure unless explicitly allowed.
  local vis; vis="$(_visibility)"
  if [[ "$vis" == "private" && "$ALLOW_PRIVATE" -ne 1 ]]; then
    die "$OWNER/$REPO is PRIVATE — refusing to publish to a public surface. Re-run with --allow-private if you accept the exposure."
  fi
  if [[ "$vis" == "private" ]]; then
    note "WARNING: $OWNER/$REPO is private; publishing exposes its docs. (--allow-private given)"
  fi
}

# Title from a wiki filename: "AI-and-Knowledge-Layer.md" → "AI and Knowledge Layer"
_title_of() { basename "$1" .md | tr '-' ' '; }

# --- commands --------------------------------------------------------------
cmd_status() {
  _resolve_repo
  local vis pages wiki_on
  vis="$(_visibility)"
  pages=0; [[ -d "$WIKI_SRC" ]] && pages="$(find "$WIKI_SRC" -name '*.md' | wc -l | tr -d ' ')"
  wiki_on="$(gh repo view "$OWNER/$REPO" --json hasWikiEnabled -q '.hasWikiEnabled' 2>/dev/null || echo '?')"
  printf 'repo:        %s/%s\n' "$OWNER" "$REPO"
  printf 'root:        %s\n' "$REPO_ROOT"
  printf 'visibility:  %s\n' "$vis"
  printf 'site URL:    https://%s.github.io/%s\n' "$OWNER" "$REPO"
  printf 'wiki source: %s (%s pages)\n' "$WIKI_SRC" "$pages"
  printf 'wiki on GH:  %s\n' "$wiki_on"
  if git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/gh-pages; then
    printf 'gh-pages:    branch exists\n'
  else
    printf 'gh-pages:    not yet created (run: zdots-pages init)\n'
  fi
  [[ -d "$WORKTREE" ]] && printf 'worktree:    %s\n' "$WORKTREE" || printf 'worktree:    (none)\n'
}

cmd_init() {
  _resolve_repo
  [[ -d "$WIKI_SRC" ]] || die "no docs/wiki/ in $REPO_ROOT — nothing to publish yet"
  if git -C "$REPO_ROOT" show-ref --verify --quiet refs/heads/gh-pages; then
    note "gh-pages branch already exists"
  else
    git -C "$REPO_ROOT" worktree add --detach "$WORKTREE" >/dev/null 2>&1 || true
    git -C "$WORKTREE" checkout --orphan gh-pages
    git -C "$WORKTREE" rm -rf . >/dev/null 2>&1 || true
    note "created orphan gh-pages branch + worktree at $WORKTREE"
    return 0
  fi
  [[ -d "$WORKTREE" ]] || git -C "$REPO_ROOT" worktree add "$WORKTREE" gh-pages >/dev/null
  note "worktree ready at $WORKTREE"
}

cmd_build() {
  _resolve_repo
  [[ -d "$WIKI_SRC" ]] || die "no docs/wiki/ in $REPO_ROOT"
  [[ -d "$WORKTREE" ]] || die "no gh-pages worktree — run: zdots-pages init"
  [[ -f "$TEMPLATE_DIR/_config.yml.template" ]] || die "missing template: $TEMPLATE_DIR/_config.yml.template"

  # Render the shared _config.yml for this repo.
  local desc; desc="$(gh repo view "$OWNER/$REPO" --json description -q '.description' 2>/dev/null || echo '')"
  [[ -z "$desc" || "$desc" == "null" ]] && desc="$REPO documentation"
  sed -e "s/@@TITLE@@/${REPO}/g" \
      -e "s/@@DESCRIPTION@@/${desc//\//\\/}/g" \
      -e "s/@@REPO@@/${REPO}/g" \
      -e "s/@@OWNER@@/${OWNER}/g" \
      "$TEMPLATE_DIR/_config.yml.template" > "$WORKTREE/_config.yml"

  # Copy each wiki page in, injecting front matter when absent. Home → index.
  local n=0 order=1 f base title dest
  rm -f "$WORKTREE"/*.md 2>/dev/null || true
  for f in "$WIKI_SRC"/*.md; do
    [[ -e "$f" ]] || continue
    base="$(basename "$f" .md)"; title="$(_title_of "$f")"
    if [[ "$base" == "Home" ]]; then dest="$WORKTREE/index.md"; order=1; else dest="$WORKTREE/$base.md"; order=$((order+1)); fi
    if head -1 "$f" | grep -q '^---$'; then
      cp "$f" "$dest"                         # already has front matter
    else
      { printf -- '---\ntitle: %s\nnav_order: %d\n' "$title" "$order"
        if [[ "$base" == "Home" ]]; then printf 'permalink: /\n'; fi
        printf -- '---\n\n'; cat "$f"; } > "$dest"
    fi
    n=$((n+1))
  done
  note "built $n pages into $WORKTREE (theme: just-the-docs, shared template)"
}

cmd_publish() {
  _resolve_repo
  [[ -d "$WORKTREE" ]] || die "no gh-pages worktree — run: zdots-pages init && zdots-pages build"
  _guard_outward
  git -C "$WORKTREE" add -A
  if git -C "$WORKTREE" diff --cached --quiet; then note "no changes to publish"; return 0; fi
  git -C "$WORKTREE" commit -q -m "docs(pages): publish site via zdots-pages"
  if [[ "$DO_PUSH" -eq 1 ]]; then
    git -C "$WORKTREE" push -u origin gh-pages
    note "pushed gh-pages → https://$OWNER.github.io/$REPO  (enable Pages: Settings → Pages → branch gh-pages)"
  else
    note "committed locally on gh-pages. Re-run with --push to publish (outward action)."
  fi
}

cmd_wiki() {
  _resolve_repo
  [[ -d "$WIKI_SRC" ]] || die "no docs/wiki/ in $REPO_ROOT"
  _guard_outward
  local wdir; wdir="$(mktemp -d)"
  if ! git clone -q "https://github.com/$OWNER/$REPO.wiki.git" "$wdir" 2>/dev/null; then
    rm -rf "$wdir"
    die "wiki not initialized — GitHub creates the .wiki.git repo only after the
  first page is saved in the web UI (no API exists for this). One-time step:
    open https://github.com/$OWNER/$REPO/wiki  → 'Create the first page' → Save.
  Then re-run: zdots-pages wiki --push"
  fi
  cp "$WIKI_SRC"/*.md "$wdir"/
  git -C "$wdir" add -A
  if git -C "$wdir" diff --cached --quiet; then note "wiki already up to date"; rm -rf "$wdir"; return 0; fi
  git -C "$wdir" commit -q -m "docs(wiki): sync from docs/wiki via zdots-pages"
  if [[ "$DO_PUSH" -eq 1 ]]; then
    git -C "$wdir" push -q origin HEAD
    note "synced docs/wiki → $OWNER/$REPO wiki"
  else
    note "staged wiki sync in $wdir (not pushed). Re-run with --push to publish."
  fi
  rm -rf "$wdir"
}

case "$CMD" in
  status)  cmd_status ;;
  init)    cmd_init ;;
  build)   cmd_build ;;
  publish) cmd_publish ;;
  wiki)    cmd_wiki ;;
  *)       die "unknown command: $CMD (try --help)" ;;
esac
