#!/usr/bin/env bash
# ---
# id: zdots-archeologist-run
# title: "Zdots Domain Archeology Runner"
# purpose: Runs archeologist and diagrammer, outputting to a structured vault.
# rationale: Standardizes analysis artifacts for easy context-engine ingestion.
# ---
# Usage: bin/zdots-archeologist-run <git_url> <ModelName>

set -eo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: zdots-archeologist-run <git_url> <ModelName>"
  exit 1
fi

GIT_URL="$1"
MODEL="$2"
TIMESTAMP=$(date +"%Y-%m-%d-%H%M")

# Parse URL: git@github.com:org/repo.git or https://github.com/org/repo
SOURCE=$(echo "$GIT_URL" | sed -E 's|.*(github\.com|gitlab\.com)[:/](.*)(\.git)?|\1/\2|' | sed 's|:|/|')
TARGET_DIR="${ZDOTS_MY_ROOT:-$HOME/my}/analysis/$SOURCE/$TIMESTAMP"

mkdir -p "$TARGET_DIR"

echo "==> Mining $MODEL from $SOURCE into $TARGET_DIR..."

# Run the miners
bin/zdots-archeologist "$MODEL" > "$TARGET_DIR/${MODEL}.json"
bin/zdots-archeologist-diagram "$TARGET_DIR/${MODEL}.json" > "$TARGET_DIR/${MODEL}.mmd"

# Create a summary MD for ingestion
cat <<EOF > "$TARGET_DIR/${MODEL}_report.md"
# Analysis: $MODEL
- **Timestamp**: $TIMESTAMP
- **Source**: $SOURCE

## Mermaid Diagram
\`\`\`mermaid
$(cat "$TARGET_DIR/${MODEL}.mmd")
\`\`\`

## Schema
\`\`\`json
$(cat "$TARGET_DIR/${MODEL}.json")
\`\`\`
EOF

echo "==> Archeology complete. Artifacts in $TARGET_DIR/"
echo "    Ingest with: zdots-ctx ingest $TARGET_DIR/"
