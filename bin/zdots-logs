#!/usr/bin/env bash
# bin/zdots-logs — Centralized log operations for all zdots-managed services.
#
# Every log source registered in svc-registry.bash is available by its service
# name. Use "all" (or no service argument) to operate across all sources.
#
# Commands:
#   list   [--json]              Table of all log sources: path, size, status
#   check  [--json]              Size health check; warns ≥100M, fails ≥500M
#   tail   [<svc>] [-n N]       Follow logs (default: all, -n 50)
#   show   [<svc>] [-n N]       Last N lines, no follow (default: all, -n 100)
#   head   [<svc>] [-n N]       First N lines (default: all, -n 50)
#   grep   <pattern> [<svc>]    Search across log files
#
# Service names match zsvc identifiers: llama embed otel o2 colima nginx
#   postgres redis worker — or any registered alias.
# Use "all" or omit the service to target every registered log source.
#
# Options:
#   -n, --lines N    Number of lines (default varies by command)
#   --json           Machine-readable output (list, check commands)
#   -h, --help       Show this help
#
# Examples:
#   zdots-logs list
#   zdots-logs check
#   zdots-logs check --json
#   zdots-logs tail
#   zdots-logs tail llama -n 200
#   zdots-logs show otel -n 30
#   zdots-logs head worker
#   zdots-logs grep ERROR
#   zdots-logs grep "connection refused" postgres

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

# shellcheck source=lib/svc-registry.bash
source "$ZDOTDIR/lib/svc-registry.bash"

# ── Helpers ───────────────────────────────────────────────────────────────────
_die()  { printf 'zdots-logs: %s\n' "$*" >&2; exit 1; }
_info() { printf '==> %s\n' "$*" >&2; }

_fmt_bytes() {
  local b="${1:-0}"
  if   (( b >= 1073741824 )); then printf '%dG' $(( b / 1073741824 ))
  elif (( b >= 1048576 ));    then printf '%dM' $(( b / 1048576 ))
  elif (( b >= 1024 ));       then printf '%dK' $(( b / 1024 ))
  else                             printf '%dB' "$b"
  fi
}

_file_size() {
  local f="$1"
  [[ -f "$f" ]] || { printf -- '-'; return; }
  local b
  b=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || printf 0)
  _fmt_bytes "$b"
}

_file_bytes() {
  local f="$1"
  [[ -f "$f" ]] || { printf 0; return; }
  stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || printf 0
}

_file_mtime() {
  local f="$1"
  [[ -f "$f" ]] || { printf -- '-'; return; }
  stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$f" 2>/dev/null \
    || stat -c '%y' "$f" 2>/dev/null | cut -c1-16 \
    || printf '?'
}

_json_str() { printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g'; }

# ── Log source collection ─────────────────────────────────────────────────────
declare -a LOG_NAMES=()
declare -a LOG_PATHS=()
declare -a ALL_SVCS=()
mapfile -t ALL_SVCS < <(zdots_svc_managed)

_collect_all() {
  local svc log
  for svc in "${ALL_SVCS[@]}"; do
    log="${ZDOTS_SVC_LOG[$svc]:-}"
    [[ -n "$log" ]] || continue
    LOG_NAMES+=("${ZDOTS_SVC_DISPLAY[$svc]:-$svc}")
    LOG_PATHS+=("$log")
  done
  (( ${#LOG_PATHS[@]} )) || _die "no log sources registered"
}

_collect_one() {
  local svc display log
  svc="$(zdots_svc_resolve "$1" 2>/dev/null)" || _die "unknown service: $1"
  display="${ZDOTS_SVC_DISPLAY[$svc]:-$svc}"
  log="${ZDOTS_SVC_LOG[$svc]:-}"
  [[ -n "$log" ]] || _die "${display} has no registered log path"
  LOG_NAMES=("$display")
  LOG_PATHS=("$log")
}

_collect() {
  local target="${1:-all}"
  if [[ "$target" == "all" ]]; then
    _collect_all
  else
    _collect_one "$target"
  fi
}

# ── Size check helpers ────────────────────────────────────────────────────────
# Thresholds in bytes
readonly _WARN_BYTES=$(( 100 * 1024 * 1024 ))   # 100 MiB
readonly _CRIT_BYTES=$(( 500 * 1024 * 1024 ))   # 500 MiB

_size_status() {
  local sz="$1"
  if   (( sz >= _CRIT_BYTES )); then printf 'crit'
  elif (( sz >= _WARN_BYTES )); then printf 'warn'
  else                               printf 'ok'
  fi
}

# Estimate growth rate using file birth time (macOS APFS) or mtime fallback.
# Outputs: age_days bytes_per_day proj_30d proj_90d
_growth_estimate() {
  local f="$1" sz="$2"
  local now; now=$(date +%s)
  local btime age_days=0 rate=0 proj_30=0 proj_90=0

  # macOS birth time (stat -f%B); falls back to 0 on Linux/non-APFS
  btime=$(stat -f%B "$f" 2>/dev/null || printf 0)
  if (( btime > 0 && now > btime )); then
    age_days=$(( (now - btime) / 86400 ))
    (( age_days < 1 )) && age_days=1
    rate=$(( sz / age_days ))
    proj_30=$(( sz + rate * 30 ))
    proj_90=$(( sz + rate * 90 ))
  fi
  printf '%s %s %s %s' "$age_days" "$rate" "$proj_30" "$proj_90"
}

# ── Commands ──────────────────────────────────────────────────────────────────
cmd_list() {
  local json=false
  [[ "${1:-}" == "--json" ]] && { json=true; shift; }

  _collect_all

  if $json; then
    local i first=true
    printf '{"sources":['
    for i in "${!LOG_PATHS[@]}"; do
      $first || printf ','
      first=false
      local p="${LOG_PATHS[$i]}" n="${LOG_NAMES[$i]}"
      local exists=false sz=0 mtime="-" status="missing"
      [[ -f "$p" ]] && exists=true
      if [[ -f "$p" ]]; then
        sz=$(_file_bytes "$p")
        mtime=$(stat -f '%Sm' -t '%Y-%m-%dT%H:%M:%S' "$p" 2>/dev/null \
                  || stat -c '%y' "$p" 2>/dev/null | cut -c1-19 | tr ' ' T \
                  || printf '?')
        status=$(_size_status "$sz")
      fi
      printf '{"name":"%s","path":"%s","exists":%s,"bytes":%s,"modified":"%s","status":"%s"}' \
        "$(_json_str "$n")" "$(_json_str "$p")" "$exists" "$sz" "$mtime" "$status"
    done
    printf ']}\n'
    return
  fi

  printf '%-16s  %-8s  %-6s  %-16s  %s\n' NAME SIZE STATUS MODIFIED PATH
  printf '%s\n' "$(printf '%0.s-' {1..90})"
  local i
  for i in "${!LOG_PATHS[@]}"; do
    local p="${LOG_PATHS[$i]}" n="${LOG_NAMES[$i]}"
    local sz_h status exists_mark=""
    [[ -f "$p" ]] || { exists_mark=" [missing]"; sz_h="-"; status="-"; }
    if [[ -f "$p" ]]; then
      sz_h=$(_file_size "$p")
      status=$(_size_status "$(_file_bytes "$p")")
    fi
    printf '%-16s  %-8s  %-6s  %-16s  %s%s\n' \
      "$n" "$sz_h" "$status" "$(_file_mtime "$p")" "$p" "$exists_mark"
  done
}

cmd_check() {
  local json=false
  [[ "${1:-}" == "--json" ]] && { json=true; shift; }

  _collect_all

  local -i any_warn=0 any_crit=0
  local i

  if $json; then
    local first=true
    printf '{"warn_threshold_bytes":%s,"crit_threshold_bytes":%s,"files":[' \
      "$_WARN_BYTES" "$_CRIT_BYTES"
  else
    printf 'Log size check  (warn ≥%s, crit ≥%s)\n' \
      "$(_fmt_bytes "$_WARN_BYTES")" "$(_fmt_bytes "$_CRIT_BYTES")"
  fi

  for i in "${!LOG_PATHS[@]}"; do
    local p="${LOG_PATHS[$i]}" n="${LOG_NAMES[$i]}"
    local sz age_days rate proj_30 proj_90 status

    if [[ ! -f "$p" ]]; then
      if $json; then
        $first || printf ','
        first=false
        printf '{"name":"%s","path":"%s","exists":false,"status":"missing"}' \
          "$(_json_str "$n")" "$(_json_str "$p")"
      else
        printf '  %-16s  -         missing\n' "$n"
      fi
      continue
    fi

    sz=$(_file_bytes "$p")
    status=$(_size_status "$sz")
    read -r age_days rate proj_30 proj_90 <<< "$(_growth_estimate "$p" "$sz")"

    [[ "$status" == "warn" ]] && any_warn=1
    [[ "$status" == "crit" ]] && any_crit=1

    if $json; then
      $first || printf ','
      first=false
      printf '{"name":"%s","path":"%s","exists":true,"bytes":%s,"age_days":%s,"bytes_per_day":%s,"projected_30d":%s,"projected_90d":%s,"status":"%s"}' \
        "$(_json_str "$n")" "$(_json_str "$p")" \
        "$sz" "$age_days" "$rate" "$proj_30" "$proj_90" "$status"
    else
      local label=""
      [[ "$status" == "crit" ]] && label="  *** CRITICAL — at risk"
      [[ "$status" == "warn" ]] && label="  ** WARNING — at risk"
      printf '  %-16s  %-8s  %s%s\n' "$n" "$(_fmt_bytes "$sz")" "$status" "$label"
      if (( rate > 0 )); then
        printf '  %-16s  growth ~%s/day  →  30d: %s  90d: %s  (est.)\n' \
          "" "$(_fmt_bytes "$rate")" "$(_fmt_bytes "$proj_30")" "$(_fmt_bytes "$proj_90")"
      fi
    fi
  done

  if $json; then
    printf '],"any_warn":%s,"any_crit":%s}\n' \
      "$( [[ $any_warn -eq 1 ]] && printf true || printf false )" \
      "$( [[ $any_crit -eq 1 ]] && printf true || printf false )"
  else
    printf '\n'
    if   (( any_crit )); then printf '[FAIL] one or more log files exceed %s — rotation needed\n' "$(_fmt_bytes "$_CRIT_BYTES")"
    elif (( any_warn )); then printf '[warn] one or more log files exceed %s — monitor closely\n' "$(_fmt_bytes "$_WARN_BYTES")"
    else                       printf '[ok]   all log files within size thresholds\n'
    fi
  fi

  # Exit 1 on CRITICAL so zdots-doctor and zdots-heal can detect it
  [[ $any_crit -eq 0 ]]
}

cmd_tail() {
  local target="all" lines=50
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--lines) lines="${2:?--lines requires N}"; shift ;;
      --lines=*)  lines="${1#*=}" ;;
      *)          target="$1" ;;
    esac
    shift
  done

  _collect "$target"
  local -a existing=()
  local p
  for p in "${LOG_PATHS[@]}"; do
    mkdir -p "$(dirname "$p")" 2>/dev/null || true
    existing+=("$p")
  done

  (( ${#existing[@]} )) || _die "no log files found"
  if [[ "${#existing[@]}" -eq 1 ]]; then
    _info "tailing ${existing[0]} — Ctrl+C to stop"
  else
    _info "tailing ${#existing[@]} log sources — Ctrl+C to stop"
  fi
  trap 'exit 0' INT TERM
  tail -n "$lines" -F "${existing[@]}"
}

cmd_show() {
  local target="all" lines=100
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--lines) lines="${2:?--lines requires N}"; shift ;;
      --lines=*)  lines="${1#*=}" ;;
      *)          target="$1" ;;
    esac
    shift
  done

  _collect "$target"
  local p
  for p in "${LOG_PATHS[@]}"; do
    if [[ -f "$p" ]]; then
      printf '\n==> %s <==\n' "$p"
      tail -n "$lines" "$p"
    else
      printf '\n==> %s [not found] <==\n' "$p" >&2
    fi
  done
}

cmd_head() {
  local target="all" lines=50
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--lines) lines="${2:?--lines requires N}"; shift ;;
      --lines=*)  lines="${1#*=}" ;;
      *)          target="$1" ;;
    esac
    shift
  done

  _collect "$target"
  local p
  for p in "${LOG_PATHS[@]}"; do
    if [[ -f "$p" ]]; then
      printf '\n==> %s <==\n' "$p"
      head -n "$lines" "$p"
    else
      printf '\n==> %s [not found] <==\n' "$p" >&2
    fi
  done
}

cmd_grep() {
  [[ $# -ge 1 ]] || _die "grep requires a pattern"
  local pattern="$1"; shift
  local target="all"
  [[ $# -gt 0 ]] && { target="$1"; shift; }

  _collect "$target"
  local -a existing=()
  local p
  for p in "${LOG_PATHS[@]}"; do
    [[ -f "$p" ]] && existing+=("$p")
  done

  (( ${#existing[@]} )) || _die "no log files exist to search"
  grep -i --color=auto -H "$pattern" "${existing[@]}" || true
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
CMD="${1:-}"
[[ -n "$CMD" ]] || { sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }
shift

case "$CMD" in
  list)              cmd_list  "$@" ;;
  check)             cmd_check "$@" ;;
  tail)              cmd_tail  "$@" ;;
  show)              cmd_show  "$@" ;;
  head)              cmd_head  "$@" ;;
  grep)              cmd_grep  "$@" ;;
  -h|--help|help)    sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *)                 _die "unknown command: $CMD  (try --help)" ;;
esac
