#!/usr/bin/env bash
# bin/pi-ctx-hydrate — PHI-safe context hydration for Pi sessions.
#
# Fetches methodology context and caps output at 60 lines (~900 tokens) so
# there is still room for Pi's reasoning and file reads within the 32k window.
# Use before a focused zpi session to prime the model with relevant patterns.
#
# Usage:
#   pi-ctx-hydrate [TAG]
#
# Options:
#   --help, -h   Show this help

set -euo pipefail
ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

TAG=""

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: pi-ctx-hydrate [TAG]

Fetch methodology context for Pi sessions. Strips diagnostic noise and
caps output at 60 lines (~900 tokens).

Examples:
  pi-ctx-hydrate              # all available context
  pi-ctx-hydrate phi          # phi-safety methodologies
  pi-ctx-hydrate testing      # TDD / testing patterns
  pi-ctx-hydrate shell        # zsh / shell patterns
EOF
    exit 0
    ;;
  -*) printf 'pi-ctx-hydrate: unknown option: %s\n' "$1" >&2; exit 2 ;;
  *)  TAG="${1:-}" ;;
esac

# PHI scrub the tag if one was supplied
if [[ -n "$TAG" ]]; then
  source "${ZDOTDIR}/lib/phi_scrubber.bash"
  if phi_should_suppress "$TAG"; then
    printf 'pi-ctx-hydrate: tag matches a suppress pattern — refusing\n' >&2
    exit 1
  fi
  TAG=$(printf '%s' "$TAG" | phi_scrub) || {
    printf 'pi-ctx-hydrate: PHI scrubber unavailable — aborting\n' >&2
    exit 1
  }
fi

# Strip zdots-brain diagnostics, drop blank lines at top, cap at ~900 tokens.
"${ZDOTDIR}/bin/zdots-ctx" hydrate ${TAG:+"$TAG"} 2>/dev/null \
  | grep -v '^zdots-brain:' \
  | sed '/./,$!d' \
  | head -60
