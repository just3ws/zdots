#!/usr/bin/env bash
# bin/gemstash-ctl — manage the gemstash caching proxy + private gem server.
#
# gemstash is a pull-through cache for rubygems.org (fast repeat installs, and
# resilience when rubygems.org is down) plus a private gem host. Metadata lives
# in the dedicated 'gemstash' Postgres database on the zdots postgres@18 server
# (peer/trust as the OS user — no password, no secret in the plist); cached
# .gem files live on disk under ~/.gemstash. Analytics: `pgcli gemstash` or
# DuckDB's postgres scanner over that DB — no lock contention with the daemon.
#
# GRAMMAR (consistent with zdots-statusd-ctl / otel-collector / llama-ctl):
#   init / install / start / stop / restart / status / health / logs
# Plus one internal verb used only by launchd:
#   run   Set up env, then exec gemstash in the foreground (Puma). gemstash
#         2.8.2 no longer daemonizes, so launchd (KeepAlive) supervises it
#         directly. Not meant to be run by hand.
#
# The service binds loopback only (127.0.0.1:9292); nginx terminates TLS for
# https://gemstash.localhost (Z-205 cutover, etc/nginx/servers/gemstash.conf).
# Bundler's mirror stays on the raw loopback URL — Ruby's OpenSSL cannot see
# the mkcert CA. No secrets in the plist: Postgres auth is peer/trust as the
# OS user over the local socket.

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
LOG_FILE="$STATE/gemstash.log"
PLIST_LABEL="com.zdots.gemstash"
PLIST_FILE="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
BASE_PATH="$HOME/.gemstash"
CONFIG_FILE="$BASE_PATH/config.yml"
PORT=9292

# shellcheck disable=SC2034 # consumed by sourced lifecycle helpers
SVC_NAME="gemstash"
# shellcheck source=lib/svc-launchd.bash
source "${ZDOTDIR}/lib/svc-launchd.bash"
# shellcheck source=lib/svc-process.bash
source "${ZDOTDIR}/lib/svc-process.bash"

_die()  { printf 'gemstash-ctl: error: %s\n' "$*" >&2; exit 1; }
_info() { printf 'gemstash-ctl: %s\n' "$*" >&2; }

usage() {
  cat <<EOF
Usage: gemstash-ctl <command> [--json]

Service Lifecycle:
  init      Generate ${CONFIG_FILE} (Postgres backend, loopback bind)
  install   Register the macOS launchd service (KeepAlive, RunAtLoad)
  start     Load and start the service
  stop      Unload and stop the service
  restart   stop then start
  status    Show service state and process info
  health    Exit 0 if the service answers on 127.0.0.1:${PORT}, else exit 1
  logs      Tail the service log
  run       launchd entry point — set up env, exec gemstash (foreground)
            (internal; do not run by hand)

Options:
  --json      Output status/health as JSON (valid for status, health)
  -h, --help  Show this help

Caching gem proxy on 127.0.0.1:${PORT}, backed by the 'gemstash' Postgres DB.
Manage it via \`zsvc <verb> gemstash\`; this script is the authoritative ctl.
EOF
}

# init — write the machine-local gemstash config. base_path must be absolute
# (gemstash does not expand ~), but we derive it from \$HOME so the generator
# stays portable across machines.
cmd_init() {
  mkdir -p "$BASE_PATH"
  cat > "$CONFIG_FILE" <<EOF
---
# Generated by gemstash-ctl. Metadata in the dedicated 'gemstash' Postgres DB
# (peer/trust as the OS user); cached .gem files on disk under base_path.
:db_adapter: postgres
:db_url: postgres:///gemstash
:base_path: "${BASE_PATH}"
:bind: tcp://127.0.0.1:${PORT}
:rubygems_url: https://rubygems.org
# Single-process Puma (no cluster/fork): gemstash's own default is 1, but
# Puma treats any workers > 0 as clustered and forks a worker via
# Process.fork. On macOS that fork crashes instantly against the ObjC
# runtime's fork-safety check (NSCharacterSet init race), which the master
# then retries in a tight loop — observed filling gemstash.log at ~1GB/2min
# (Z-296). workers: 0 runs Puma::Single in-process: no fork, no crash, and
# it matches the design intent below (one coherent in-memory cache).
:puma_workers: 0
# In-memory index/dependency cache. Default max_size is 500 entries. Bumped 4x
# for a higher hit rate (fewer upstream fetches), but kept modest on purpose:
# this box also runs llama.cpp, a Colima VM, Postgres, context-engine, and O2,
# and cached /info blobs can be tens of KB — so not thousands of entries.
# Single Puma process → one coherent in-memory cache (Redis would add
# coupling for no gain here: the TTL makes cross-restart persistence moot).
:cache_max_size: 2000
# Cache TTL (seconds). Default 1800 (30 min). Extended to 2h: fewer upstream
# index re-checks for a personal cache. Downside is bounded — only newly
# PUBLISHED gem versions lag by up to the TTL; cached .gem files are immutable.
# Push higher (e.g. 28800 = a workday) if you rarely need same-day releases.
:cache_expiration: 7200
EOF
  _info "wrote $CONFIG_FILE"
}

# run — launchd entry point. gemstash runs Puma in the foreground (2.8.2 dropped
# daemonization), so launchd supervises the process directly. PATH is captured
# into the plist at install time; mise resolves the Ruby that owns the gem.
cmd_run() {
  cd "$ZDOTDIR" || _die "cannot cd to $ZDOTDIR"
  [[ -f "$CONFIG_FILE" ]] || _die "config missing: $CONFIG_FILE (run: gemstash-ctl init)"
  if command -v mise >/dev/null 2>&1; then
    exec mise exec -- gemstash start --config-file "$CONFIG_FILE"
  fi
  exec gemstash start --config-file "$CONFIG_FILE"
}

cmd_install() {
  [[ "$OS" == "darwin" ]] || _die "launchd service is macOS-only (nothing to install on $OS)"
  command -v gemstash >/dev/null 2>&1 || _die "gemstash not on PATH (gem install gemstash)"
  [[ -f "$CONFIG_FILE" ]] || cmd_init
  mkdir -p "$STATE"
  ZDOTS_SVC_ENV_KEYS="HOME PATH ZDOTDIR" \
    zdots_svc_launchd_register \
      "$PLIST_LABEL" "$PLIST_FILE" "$ZDOTDIR/bin/gemstash-ctl" "$LOG_FILE" "run"
}

cmd_start() {
  [[ "$OS" == "darwin" ]] || _die "macOS-only"
  if [[ ! -f "$PLIST_FILE" ]]; then
    _info "plist missing — running install first"
    cmd_install
  fi
  zdots_svc_launchd_start "$PLIST_LABEL" "$PLIST_FILE"
}

cmd_stop() {
  [[ "$OS" == "darwin" ]] || _die "macOS-only"
  zdots_svc_launchd_stop "$PLIST_LABEL"
}

cmd_status() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local state running pid
  state=$(zdots_svc_launchd_status "$PLIST_LABEL")
  running=$(echo "$state" | awk '{print $1}')
  pid=$(echo "$state" | awk '{print $2}')

  zdots_svc_print_status "$json" "$running" "$pid" "http://127.0.0.1:${PORT}" "$LOG_FILE" \
    "launchd=$([[ -f "$PLIST_FILE" ]] && echo true || echo false)"
}

cmd_health() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local healthy=false
  curl -sf --max-time 3 "http://127.0.0.1:${PORT}/" >/dev/null 2>&1 && healthy=true

  zdots_svc_print_health "$json" "$healthy" "http://127.0.0.1:${PORT}"
}

cmd_logs() {
  zdots_svc_logs "$LOG_FILE"
}

case "${1:-}" in
  init)      cmd_init ;;
  install)   cmd_install ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   zdots_svc_restart cmd_stop cmd_start ;;
  status)    shift; cmd_status "$@" ;;
  health)    shift; cmd_health "$@" ;;
  logs)      cmd_logs ;;
  run)       cmd_run ;;
  -h|--help) usage; exit 0 ;;
  "")        usage >&2; exit 1 ;;
  *)         printf 'gemstash-ctl: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
