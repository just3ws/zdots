#!/usr/bin/env bash
# bin/log-rotate — Safely rotate launchd service logs with compression.
#
# Rotates a service's log file by compressing the current content and
# truncating the active log. Safe for services with open file descriptors:
# truncates in-place so the service continues writing without restart.
#
# Usage: log-rotate <service-name> [--dry-run] [--help]
#        log-rotate --install-agent [--dry-run]
#   service-name     Name of the launchd service (e.g., otel-collector, llama-server)
#   --install-agent  Render and install com.zdots.log-rotate LaunchAgent for current $HOME
#   --dry-run        Show what would happen without rotating or installing
#   --help           Show this help
#
# Exit: 0 on success, 1 on error or dry-run preview.

set -uo pipefail
trap '' PIPE

# Get service name from first arg
SERVICE=""
DRY_RUN=0
INSTALL_AGENT=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --install-agent) INSTALL_AGENT=1 ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \?//'; exit 0 ;;
    -*) printf 'log-rotate: unknown option: %s\n' "$1" >&2; exit 1 ;;
    *) SERVICE="$1" ;;
  esac
  shift
done

if [[ $INSTALL_AGENT -eq 1 ]]; then
  _script_root="$(cd "$(dirname "$0")/.." && pwd)"
  _zdotdir="${ZDOTDIR:-$HOME/.config/zsh}"
  _state="${XDG_STATE_HOME:-$HOME/.local/state}"
  _tmpl="${_zdotdir}/etc/launchd/com.zdots.log-rotate.plist"
  [[ -r "$_tmpl" ]] || _tmpl="${_script_root}/etc/launchd/com.zdots.log-rotate.plist"
  _dest="$HOME/Library/LaunchAgents/com.zdots.log-rotate.plist"
  if [[ ! -r "$_tmpl" ]]; then
    printf 'log-rotate: template not found: %s\n' "$_tmpl" >&2
    exit 1
  fi
  _rendered="$(sed \
    -e "s|__HOME__|${HOME}|g" \
    -e "s|__ZDOTDIR__|${_zdotdir}|g" \
    -e "s|__XDG_STATE_HOME__|${_state}|g" \
    "$_tmpl")"
  if [[ $DRY_RUN -eq 1 ]]; then
    printf '%s\n' "$_rendered"
    exit 0
  fi
  mkdir -p "$(dirname "$_dest")" "${_state}/zsh"
  printf '%s\n' "$_rendered" > "$_dest"
  if command -v plutil >/dev/null 2>&1; then
    plutil -lint "$_dest" >/dev/null || { printf 'log-rotate: invalid rendered plist: %s\n' "$_dest" >&2; exit 1; }
  fi
  if command -v launchctl >/dev/null 2>&1; then
    launchctl bootout "gui/$(id -u)/com.zdots.log-rotate" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$_dest" 2>/dev/null || launchctl load -w "$_dest" 2>/dev/null || true
  fi
  printf 'log-rotate: installed LaunchAgent -> %s\n' "$_dest"
  exit 0
fi

if [[ -z "$SERVICE" ]]; then
  printf 'log-rotate: service name required\n' >&2
  sed -n '2,16p' "$0" | sed 's/^# \?//' >&2
  exit 1
fi

# Find the service plist or direct log path
LOG_PATH=""
PLIST=""
if [[ -f "$SERVICE" ]]; then
  LOG_PATH="$SERVICE"
else
  for p in \
    "$HOME/Library/LaunchAgents/com.zdots.${SERVICE}.plist" \
    "$HOME/Library/LaunchAgents/com.my.${SERVICE}.plist" \
    "$HOME/Library/LaunchAgents/com.just3ws.${SERVICE}.plist" \
    "$HOME/Library/LaunchAgents/${SERVICE}.plist"; do
    if [[ -f "$p" ]]; then
      PLIST="$p"
      break
    fi
  done
  if [[ -z "$PLIST" ]]; then
    printf 'log-rotate: plist not found: %s\n' "$HOME/Library/LaunchAgents/com.zdots.${SERVICE}.plist" >&2
    exit 1
  fi

  # Extract log path from plist
  LOG_PATH=$(defaults read "$PLIST" StandardErrorPath 2>/dev/null || true)
  if [[ -z "$LOG_PATH" ]]; then
    # Try StandardOutPath if StandardErrorPath not found
    LOG_PATH=$(defaults read "$PLIST" StandardOutPath 2>/dev/null || true)
  fi
fi

if [[ -z "$LOG_PATH" ]]; then
  printf 'log-rotate: could not find log path in %s\n' "$PLIST" >&2
  exit 1
fi

if [[ ! -f "$LOG_PATH" ]]; then
  printf 'log-rotate: log file does not exist: %s\n' "$LOG_PATH" >&2
  exit 1
fi

# Get current stats
LOG_SIZE=$(stat -f%z "$LOG_PATH" 2>/dev/null || echo 0)
LOG_SIZE_MB=$((LOG_SIZE / 1024 / 1024))

printf 'log-rotate: %s\n' "$SERVICE"
printf '  log:  %s\n' "$LOG_PATH"
printf '  size: %d MB\n' "$LOG_SIZE_MB"

# Check if service is running
_pid=""
if [[ -n "$PLIST" ]]; then
  _label=$(defaults read "$PLIST" Label 2>/dev/null || echo "com.zdots.${SERVICE}")
  _pid=$(launchctl list "$_label" 2>/dev/null \
          | awk -F'[ =;]+' '/"PID"/{print $2}')
fi
if [[ -z "$_pid" ]]; then
  if [[ -n "$PLIST" ]]; then
    printf '  status: NOT RUNNING (warning: service may have failed)\n' >&2
  fi
else
  printf '  status: running (PID %s)\n' "$_pid"
fi

if [[ $DRY_RUN -eq 1 ]]; then
  printf '\nDry run: would create archive and truncate log\n'
  exit 1
fi

# Rotate: compress current log, truncate active log
TS=$(date +%Y%m%d-%H%M%S)
ARCHIVE="${LOG_PATH}.${TS}.gz"

printf '\nRotating...\n'
gzip -c "$LOG_PATH" > "$ARCHIVE" || {
  printf 'log-rotate: gzip failed\n' >&2
  exit 1
}
printf '  archived: %s\n' "$ARCHIVE"

# Truncate in-place (safe for open FDs)
true > "$LOG_PATH" || {
  printf 'log-rotate: truncate failed\n' >&2
  exit 1
}
printf '  truncated: %s\n' "$LOG_PATH"

# Prune historical rotations (>30 days) for this specific log to prevent unbounded accumulation
local_dir="$(dirname "$LOG_PATH")"
base_name="$(basename "$LOG_PATH")"
find "$local_dir" -maxdepth 1 -name "${base_name}.*.gz" -mtime +30 -delete 2>/dev/null || true

# Show result
ARCHIVE_SIZE=$(stat -f%z "$ARCHIVE" 2>/dev/null || echo 0)
ARCHIVE_SIZE_MB=$((ARCHIVE_SIZE / 1024 / 1024))
printf '\nResult:\n'
printf '  %d MB → %d MB (gzip compression)\n' "$LOG_SIZE_MB" "$ARCHIVE_SIZE_MB"
printf '  active log ready for new writes\n'

exit 0
