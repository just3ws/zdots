#!/usr/bin/env python3
import argparse
import os
import sys
import mlx_lm

# Directory to store MLX models
MLX_MODELS_DIR = os.path.expanduser("~/.local/share/mlx/models")

def prepare_model(hf_repo, model_name):
    """
    Ensures an MLX-ready model exists in MLX_MODELS_DIR.
    For now, this utility focuses on conversion from HF format to MLX.
    """
    if not os.path.exists(MLX_MODELS_DIR):
        os.makedirs(MLX_MODELS_DIR)
        
    output_path = os.path.join(MLX_MODELS_DIR, model_name)
    
    print(f"Preparing MLX model: {model_name} from {hf_repo}...")
    
    # mlx_lm.convert handles the conversion from HuggingFace to MLX native
    # Direct function call as identified by signature
    try:
        mlx_lm.convert(
            hf_path=hf_repo,
            mlx_path=output_path,
            quantize=True  # Default to 4-bit quantization for performance
        )
        print(f"Model successfully prepared at: {output_path}")
    except Exception as e:
        print(f"Error preparing model: {e}")
        sys.exit(1)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Prepare MLX model from HuggingFace.")
    parser.add_argument("--repo", required=True, help="HuggingFace repo ID")
    parser.add_argument("--name", required=True, help="Local name for model")
    
    args = parser.parse_args()
    prepare_model(args.repo, args.name)
