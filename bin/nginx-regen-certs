#!/usr/bin/env bash
# bin/nginx-regen-certs — regenerate the local mkcert TLS cert to cover every
# nginx-served hostname, then validate and graceful-reload nginx, safely.
#
# "Safely" means:
#   - backs up the current cert + key (timestamped) before touching them
#   - regenerates with the UNION of (existing cert SANs) ∪ (hostnames nginx
#     serves, parsed from nginx-ctl) ∪ zdots.local ∪ loopback — so a name that
#     already worked is never silently dropped
#   - validates the nginx config and only reloads if it is valid
#   - restores the previous cert if regeneration or validation fails
#
# mkcert must have its local CA trusted once (`mkcert -install`); this only mints
# a fresh leaf cert. The validate/reload steps call sudo and will prompt.
#
# Usage: nginx-regen-certs [--dry-run]

set -uo pipefail

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
BREW="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
CONF_DIR="$BREW/etc/nginx"
CERT_DIR="$CONF_DIR/certs"
CERT="$CERT_DIR/zdots-local.pem"
KEY="$CERT_DIR/zdots-local-key.pem"
DRY_RUN=false

_die()  { printf 'nginx-regen-certs: error: %s\n' "$*" >&2; exit 1; }
_info() { printf 'nginx-regen-certs: %s\n' "$*" >&2; }
_ok()   { printf 'nginx-regen-certs: [ok] %s\n' "$*" >&2; }

# Deploy the tracked nginx configs (ssl_params.conf + servers/*.conf) over the
# copies nginx actually loads. bin/bootstrap installs them once and never
# updates, so edits to the tracked vhosts (e.g. a new server_name) otherwise
# never reach nginx. Overwrites only tracked-managed files; deployed-only vhosts
# (e.g. emrbear.conf) are left untouched.
sync_configs() {
  local src dst rel n=0
  mkdir -p "$CONF_DIR/servers"
  for src in "$ZDOTDIR/etc/nginx/ssl_params.conf" "$ZDOTDIR"/etc/nginx/servers/*.conf; do
    [[ -f "$src" ]] || continue
    case "$src" in
      */servers/*) rel="servers/${src##*/}" ;;
      *)           rel="${src##*/}" ;;
    esac
    dst="$CONF_DIR/$rel"
    diff -q "$src" "$dst" >/dev/null 2>&1 && continue
    if $DRY_RUN; then
      _info "would sync: $rel"
    else
      cp "$src" "$dst" || _die "failed to deploy $rel"
      _info "synced: $rel"
    fi
    n=$((n + 1))
  done
  if [[ $n -eq 0 ]]; then
    _info "nginx configs already in sync"
  else
    local verb=synced; $DRY_RUN && verb="would sync"
    _ok "$verb $n config(s); deployed-only vhosts preserved"
  fi
}

usage() {
  cat <<EOF
Usage: nginx-regen-certs [--dry-run]

Deploy the tracked nginx vhosts to the dir nginx loads, regenerate the local
mkcert TLS cert so it covers every hostname nginx serves (plus zdots.local),
then validate and graceful-reload nginx. Backs up the old cert and restores it
if anything fails; deployed-only vhosts are preserved.

Options:
  --dry-run   Show the resolved SAN set and planned actions; change nothing
  -h, --help  Show this help

Prereqs: mkcert installed with its CA trusted (\`mkcert -install\` once).
validate/reload prompt for sudo.
EOF
}

case "${1:-}" in
  --dry-run) DRY_RUN=true ;;
  -h|--help) usage; exit 0 ;;
  "")        ;;
  *)         _die "unknown option: $1 (see --help)" ;;
esac

command -v mkcert >/dev/null 2>&1 || _die "mkcert not installed (brew install mkcert)"
[[ -f "$CERT" ]] || _die "current cert not found: $CERT"

# Build the SAN union. Start from the existing cert so no trusted name is lost.
names=()
declare -A seen=()
_add() {
  local n
  for n in "$@"; do
    n="${n// /}"
    [[ -n "$n" && -z "${seen[$n]:-}" ]] && { seen[$n]=1; names+=("$n"); }
  done
}

while IFS= read -r n; do _add "$n"; done < <(
  openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null \
    | grep -oE '(DNS|IP Address):[^,]+' | sed -E 's/^(DNS|IP Address)://'
)
while IFS= read -r n; do _add "$n"; done < <(
  grep -oE 'HOSTS=\([^)]*\)' "$ZDOTDIR/bin/nginx-ctl" 2>/dev/null | tr ' ()' '\n' | grep -E '\.local$'
)
_add zdots.local localhost 127.0.0.1

[[ ${#names[@]} -gt 0 ]] || _die "no hostnames resolved for the cert"

_info "cert:        $CERT"
_info "SANs (${#names[@]}): ${names[*]}"

sync_configs

if $DRY_RUN; then
  _ok "dry run — nothing changed"
  exit 0
fi

ts="$(date +%Y%m%d-%H%M%S)"
if ! cp "$CERT" "$CERT.bak-$ts" || ! cp "$KEY" "$KEY.bak-$ts"; then
  _die "backup failed"
fi
_ok "backed up cert + key to *.bak-$ts"

_restore() { cp "$CERT.bak-$ts" "$CERT" && cp "$KEY.bak-$ts" "$KEY" && _info "restored previous cert"; }

if ! mkcert -cert-file "$CERT" -key-file "$KEY" "${names[@]}"; then
  _restore
  _die "mkcert failed — previous cert restored"
fi
_ok "cert regenerated (${#names[@]} SANs)"

if ! "$ZDOTDIR/bin/nginx-ctl" validate; then
  _restore
  _die "nginx config invalid — reverted cert, did NOT reload"
fi

"$ZDOTDIR/bin/nginx-ctl" reload || _die "reload failed (config was valid; new cert kept)"

code="$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' https://zdots.local/healthz 2>/dev/null || true)"
if [[ "$code" == "200" ]]; then
  _ok "https://zdots.local/healthz → 200"
else
  _info "reloaded; https://zdots.local/healthz → ${code:-no-response} (start it with: zsvc start status)"
fi
_ok "done"
