#!/usr/bin/env ruby
# bin/ctx-mcp — MCP server for the PostgreSQL Intelligence Suite (zdots-ctx).
#
# Exposes live context (methodologies, lessons, residue) to AI agents.
# Allows AIs to both query existing knowledge and capture new insights.
#
# Transport: stdio (JSON-RPC 2.0)
# Register in ~/.claude.json → mcpServers:
#   "ctx": {"type":"stdio","command":"${ZDOTDIR}/bin/ctx-mcp"}

require "json"
require "open3"

ZDOTDIR = ENV.fetch("ZDOTDIR", File.expand_path("~/.config/zsh"))
BIN = File.join(ZDOTDIR, "bin")
CTX_BIN = File.join(BIN, "zdots-ctx")

$stdout.sync = true
$stderr.sync = true

require_relative "../lib/zdots"
require_relative "../lib/zdots/manifest"

# ... (id/method/params logic remains same)

# ---------------------------------------------------------------------------
# Tool registry (Dynamic from Manifest)
# ---------------------------------------------------------------------------
TOOLS = Zdots::Manifest.mcp_tools.map do |t|
  {
    name: t[:name],
    description: t[:description],
    inputSchema: {
      type: "object",
      properties: (t[:params] || {}).each_with_object({}) { |(k, v), h| h[k] = { type: v == "json" ? "string" : v } },
      required: (t[:params] || {}).keys
    }
  }
end.freeze

# ---------------------------------------------------------------------------
# Implementations
# ---------------------------------------------------------------------------
def run_ctx(*args)
  # We source env.sh first to ensure DATABASE_URL and ZDOTS_MY_ROOT are set,
  # which is the only reason a shell is involved at all.
  #
  # Arguments are passed as positional parameters ("$@") rather than
  # interpolated into the command string. Nothing derived from tool input is
  # ever parsed by bash as source. The previous version escaped by hand with
  # gsub("'", "'\\''"), but \' in a gsub *string* replacement is the post-match
  # backreference, not a literal — so every apostrophe closed the quoted string
  # and content after it was executed. See Z-297/Z-309.
  env_sh = File.join(ZDOTDIR, "env.sh")
  script = %(source "#{env_sh}" && exec "#{CTX_BIN}" "$@")
  stdout, stderr, status = Open3.capture3("bash", "-c", script, "ctx-mcp", *args.map(&:to_s))
  { stdout: stdout, stderr: stderr, exit_code: status.exitstatus }
end

def tool_ctx_status(_args)
  res = run_ctx("status", "--json")
  res[:exit_code] == 0 ? res[:stdout] : "Error checking status: #{res[:stderr]}"
end

def tool_ctx_query(args)
  term = args["term"]
  cmd_args = args["semantic"] ? ["query", "--semantic", term] : ["query", term]
  res = run_ctx(*cmd_args)
  res[:exit_code] == 0 ? res[:stdout] : "Error querying '#{term}': #{res[:stderr]}"
end

def tool_ctx_hydrate(args)
  tag = args["tag"] || ""
  res = run_ctx("hydrate", tag, "--json")
  res[:exit_code] == 0 ? res[:stdout] : "Error hydrating: #{res[:stderr]}"
end

def tool_ctx_add_methodology(args)
  slug = args["slug"]
  title = args["title"]
  content = args["content"]
  tags = args.fetch("tags", [])
  
  res = run_ctx("add-methodology", slug, title, content, *tags)
  res[:exit_code] == 0 ? "✅ Methodology '#{slug}' saved." : "❌ Error: #{res[:stderr]}"
end

def tool_ctx_add_lesson(args)
  content = args["content"]
  context = args.fetch("context", "")
  tags = args.fetch("tags", [])
  
  res = run_ctx("add-lesson", content, context, *tags)
  res[:exit_code] == 0 ? "✅ Lesson saved." : "❌ Error: #{res[:stderr]}"
end

def tool_ctx_capture(_args)
  res = run_ctx("capture", "--json")
  res[:exit_code] == 0 ? res[:stdout] : "Error capturing residue: #{res[:stderr]}\nNote: This tool requires a valid ZDOTS_SESSION_ID."
end

def tool_ctx_semantic_search(args)
  term = args["term"]
  res = run_ctx("query", "--semantic", term)
  res[:exit_code] == 0 ? res[:stdout] : "Error in semantic search for '#{term}': #{res[:stderr]}"
end

def tool_ctx_enqueue(args)
  type = args["type"]
  payload_json = args["payload"]
  priority = args.fetch("priority", 10)

  run_args = ["enqueue"]
  run_args << "--force" if args["force"]
  run_args += [type, payload_json, priority.to_s]

  res = run_ctx(*run_args)
  res[:exit_code] == 0 ? "✅ #{res[:stdout]}" : "❌ Error: #{res[:stderr]}"
end

def tool_ctx_jobs(_args)
  res = run_ctx("jobs", "--json")
  res[:exit_code] == 0 ? res[:stdout] : "Error fetching jobs: #{res[:stderr]}"
end

def tool_ctx_living_docs(_args)
  res = run_ctx("living-docs")
  res[:exit_code] == 0 ? "✅ Living Docs sync triggered." : "❌ Error: #{res[:stderr]}"
end

# Z-247 event stream — read the JSONL directly (a file, not a zdots-ctx verb).
def tool_ctx_pipeline_events(_args)
  path = ENV["ZDOTS_PIPELINE_EVENTS_FILE"] ||
         File.join(ENV.fetch("XDG_STATE_HOME", File.expand_path("~/.local/state")),
                   "zdots", "pipeline-events.jsonl")
  return "No pipeline events yet (#{path} absent)." unless File.exist?(path)

  events = File.readlines(path).filter_map { |l| JSON.parse(l) rescue nil }
  summary = events.group_by { |e| e["job_type"] }.transform_values do |es|
    {
      started: es.count { |e| e["event"] == "started" },
      succeeded: es.count { |e| e["event"] == "succeeded" },
      failed: es.count { |e| e["event"] == "failed" },
      error_classes: es.filter_map { |e| e["error_class"] }.uniq
    }
  end
  JSON.pretty_generate({ summary: summary, recent: events.last(20) })
end

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
SUPPORTED_PROTOCOL_VERSIONS = ["2024-11-05", "2026-07-28"].freeze

def respond(id, result)
  $stdout.puts JSON.generate({ jsonrpc: "2.0", id: id, result: result.merge(resultType: "complete") })
end

def error_response(id, code, message)
  $stdout.puts JSON.generate({
    jsonrpc: "2.0", id: id,
    error: { code: code, message: message }
  })
end

def call_tool(name, args)
  case name
  when "ctx_status"          then tool_ctx_status(args)
  when "ctx_query"           then tool_ctx_query(args)
  when "ctx_hydrate"         then tool_ctx_hydrate(args)
  when "ctx_add_methodology" then tool_ctx_add_methodology(args)
  when "ctx_add_lesson"      then tool_ctx_add_lesson(args)
  when "ctx_capture"         then tool_ctx_capture(args)
  when "ctx_semantic_search" then tool_ctx_semantic_search(args)
  when "ctx_enqueue"         then tool_ctx_enqueue(args)
  when "ctx_jobs"            then tool_ctx_jobs(args)
  when "ctx_pipeline_events" then tool_ctx_pipeline_events(args)
  when "living_docs"         then tool_ctx_living_docs(args)
  else raise "Unknown tool: #{name}"
  end
end

$stdin.each_line do |line|
  line = line.strip
  next if line.empty?
  begin
    msg = JSON.parse(line)
  rescue JSON::ParserError
    error_response(nil, -32700, "Parse error")
    next
  end

  id = msg["id"]
  method = msg["method"]
  params = msg["params"] || {}

  case method
  when "initialize"
    respond(id, {
      protocolVersion: "2024-11-05",
      capabilities: { tools: {} },
      serverInfo: { name: "ctx-mcp", version: "1.0.0" }
    })
  when "server/discover"
    respond(id, {
      protocolVersions: SUPPORTED_PROTOCOL_VERSIONS,
      capabilities: { tools: {} },
      serverInfo: { name: "ctx-mcp", version: "1.0.0" }
    })
  when "tools/list"
    respond(id, { tools: TOOLS.sort_by { |t| t[:name] }, ttlMs: 300_000, cacheScope: "private" })
  when "tools/call"
    begin
      result_text = call_tool(params["name"], params.fetch("arguments", {}))
      respond(id, { content: [{ type: "text", text: result_text }] })
    rescue => e
      respond(id, { content: [{ type: "text", text: "Error: #{e.message}" }], isError: true })
    end
  when "ping" then respond(id, {})
  else respond(id, {}) if id
  end
end
