#!/usr/bin/env bash
# bin/otel-collector — Manage the bare-metal OpenTelemetry Collector.
#
# RATIONALE:
# To maintain high shell performance, we use a local bare-metal collector
# on the host. It receives OTLP spans from the shell and apps, buffers them,
# and forwards them to the heavier LGTM stack running in Colima.
#
# GRAMMAR:
# Service lifecycle verbs are consistent with llama-ctl and local-ci:
#   install / start / stop / restart / status / health / logs / validate

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

VERSION="0.148.0"
DISTRO="otelcol-contrib"
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)
[ "$ARCH" = "x86_64" ] && ARCH="amd64"
[ "$ARCH" = "aarch64" ] && ARCH="arm64"

INSTALL_DIR="${HOME}/.local/bin"
BINARY="${INSTALL_DIR}/${DISTRO}"
CONFIG_FILE="${ZDOTDIR:-$(pwd)}/etc/otel-collector.yaml"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/otel-collector.log"
PLIST_LABEL="com.zdots.otel-collector"
PLIST_FILE="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
OTLP_ENDPOINT="http://127.0.0.1:4318"

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

_die()  { printf 'otel-collector: error: %s\n' "$*" >&2; exit 1; }
_info() { printf 'otel-collector: %s\n' "$*" >&2; }

usage() {
  cat <<EOF
Usage: otel-collector <command> [--json]

Service Lifecycle:
  install   Download binary and register macOS launchd service
  start     Load and start the launchd service
  stop      Unload and stop the service
  restart   stop then start (picks up config changes)
  status    Show service state and process info
  health    Exit 0 if collector endpoint is reachable, exit 1 otherwise
  logs      Tail the collector log
  validate  Validate etc/otel-collector.yaml

Options:
  --json      Output status/health as JSON (valid for status, health)
  -h, --help  Show this help

Environment:
  ZDOTDIR  Repository root (config file: \$ZDOTDIR/etc/otel-collector.yaml)
EOF
}

# ---------------------------------------------------------------------------
# Subcommand implementations
# ---------------------------------------------------------------------------

cmd_install() {
  _info "installing v${VERSION} for ${OS}/${ARCH}..."
  mkdir -p "$INSTALL_DIR"

  local url tmp_dir
  url="https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${VERSION}/${DISTRO}_${VERSION}_${OS}_${ARCH}.tar.gz"
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "$tmp_dir"' EXIT

  if curl -L "$url" -o "${tmp_dir}/otel.tar.gz"; then
    tar -xzf "${tmp_dir}/otel.tar.gz" -C "$tmp_dir"
    mv "${tmp_dir}/${DISTRO}" "$BINARY"
    chmod +x "$BINARY"
    _info "installed binary to $BINARY"
  else
    _die "failed to download binary from $url"
  fi

  if [ "$OS" = "darwin" ]; then
    _info "registering macOS launchd service..."
    mkdir -p "$(dirname "$PLIST_FILE")"
    mkdir -p "$(dirname "$LOG_FILE")"
    cat > "$PLIST_FILE" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BINARY}</string>
        <string>--config</string>
        <string>${CONFIG_FILE}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>${LOG_FILE}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>${HOME}</string>
    </dict>
</dict>
</plist>
PLIST
    _info "service registered at $PLIST_FILE"
    _info "run 'otel-collector start' to enable"
  fi
}

cmd_start() {
  [ -x "$BINARY" ] || _die "binary not found. Run 'otel-collector install' first."
  if [ "$OS" = "darwin" ]; then
    if launchctl print "gui/$(id -u)/${PLIST_LABEL}" >/dev/null 2>&1; then
      _info "${PLIST_LABEL} is already running"
      return 0
    fi
    _info "starting ${PLIST_LABEL}..."
    launchctl bootstrap "gui/$(id -u)" "$PLIST_FILE"
  else
    mkdir -p "$(dirname "$LOG_FILE")"
    nohup "$BINARY" --config "$CONFIG_FILE" >> "$LOG_FILE" 2>&1 &
    printf '%s\n' "$!" > "${XDG_STATE_HOME:-$HOME/.local/state}/zsh/otel-collector.pid"
  fi
}

cmd_stop() {
  _info "stopping ${PLIST_LABEL}..."
  if [ "$OS" = "darwin" ]; then
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
  else
    local pid_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/otel-collector.pid"
    if [ -f "$pid_file" ]; then
      kill "$(cat "$pid_file")" 2>/dev/null || true
      rm -f "$pid_file"
    fi
  fi
}

cmd_status() {
  local json=false
  [ "${1:-}" = "--json" ] && json=true

  local running=false pid=""
  if [ "$OS" = "darwin" ]; then
    if launchctl list "$PLIST_LABEL" >/dev/null 2>&1; then
      pid=$(launchctl list "$PLIST_LABEL" 2>/dev/null \
        | grep '"PID"' | awk '{print $3}' | tr -d ';' || true)
      [ -n "$pid" ] && running=true
    fi
  else
    local pid_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/otel-collector.pid"
    if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
      pid=$(cat "$pid_file")
      running=true
    fi
  fi

  if $json; then
    printf '{"running":%s,"pid":%s,"otlp_endpoint":"%s","log_file":"%s"}\n' \
      "$running" "${pid:-null}" "$OTLP_ENDPOINT" "$LOG_FILE"
    return
  fi

  if $running; then
    printf 'otel-collector: running (PID: %s)\n' "${pid:-unknown}"
  else
    printf 'otel-collector: not running\n'
  fi
  printf 'otel-collector: endpoint  %s\n' "$OTLP_ENDPOINT"
  printf 'otel-collector: log       %s\n' "$LOG_FILE"
}

cmd_health() {
  local json=false
  [ "${1:-}" = "--json" ] && json=true

  if curl -sf -m 3 "${OTLP_ENDPOINT}/v1/traces" \
       -H "Content-Type: application/json" \
       -d '{"resourceSpans":[]}' >/dev/null 2>&1; then
    $json && printf '{"healthy":true,"endpoint":"%s"}\n' "$OTLP_ENDPOINT"
    return 0
  else
    $json && printf '{"healthy":false,"endpoint":"%s"}\n' "$OTLP_ENDPOINT"
    return 1
  fi
}

cmd_logs() {
  trap 'exit 0' INT TERM
  tail -f "$LOG_FILE"
}

cmd_validate() {
  [ -x "$BINARY" ] || _die "binary not found. Run 'otel-collector install' first."
  _info "validating $CONFIG_FILE..."
  "$BINARY" validate --config "$CONFIG_FILE"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  install)   cmd_install ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; cmd_start ;;
  status)    shift; cmd_status "${@}" ;;
  health)    shift; cmd_health "${@}" ;;
  logs)      cmd_logs ;;
  validate)  cmd_validate ;;
  -h|--help) usage; exit 0 ;;
  "")        usage >&2; exit 1 ;;
  *)         printf 'otel-collector: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
