#!/usr/bin/env sh
# bin/otel-collector — Manage the bare-metal OpenTelemetry Collector.
#
# RATIONALE:
# To maintain high shell performance, we use a local bare-metal collector 
# on the host. It receives OTLP spans from the shell and apps, buffers them, 
# and forwards them to the heavier LGTM stack running in Colima.
#
# PURPOSE:
# 1. Automate installation of the official otelcol-contrib binary.
# 2. Manage the lifecycle (start/stop/status) of the host collector.
# 3. Link host telemetry to the Colima observability hub.

set -eu

VERSION="0.148.0"
DISTRO="otelcol-contrib"
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)
[ "$ARCH" = "x86_64" ] && ARCH="amd64"
[ "$ARCH" = "aarch64" ] && ARCH="arm64"

INSTALL_DIR="${HOME}/.local/bin"
BINARY="${INSTALL_DIR}/${DISTRO}"
CONFIG_FILE="${ZDOTDIR:-$(pwd)}/etc/otel-collector.yaml"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/otel-collector.log"
PID_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/otel-collector.pid"
PLIST_LABEL="com.zdots.otel-collector"
PLIST_FILE="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"

usage() {
  cat <<EOF
Usage: otel-collector <command>

Commands:
  install - Download binary and register macOS service
  start   - Start the service via launchctl
  stop    - Stop the service via launchctl
  restart - Restart the service (reload config)
  status  - Check service status via launchctl
  validate - Validate the collector configuration
  logs    - Tail the collector logs
EOF
}

validate_otel() {
  if [ ! -x "$BINARY" ]; then
    echo "otel-collector: error: binary not found. Run 'otel-collector install' first." >&2
    exit 1
  fi
  echo "otel-collector: validating config $CONFIG_FILE..."
  "$BINARY" validate --config "$CONFIG_FILE"
}

install_otel() {
  echo "otel-collector: installing version v${VERSION} for ${OS}/${ARCH}..."
  mkdir -p "$INSTALL_DIR"
  
  URL="https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${VERSION}/${DISTRO}_${VERSION}_${OS}_${ARCH}.tar.gz"
  TMP_DIR=$(mktemp -d)
  
  if curl -L "$URL" -o "${TMP_DIR}/otel.tar.gz"; then
    tar -xzf "${TMP_DIR}/otel.tar.gz" -C "$TMP_DIR"
    mv "${TMP_DIR}/${DISTRO}" "$BINARY"
    chmod +x "$BINARY"
    echo "otel-collector: installed binary to $BINARY"
  else
    echo "otel-collector: error: failed to download binary from $URL" >&2
    exit 1
  fi
  rm -rf "$TMP_DIR"

  # Register service if on macOS
  if [ "$OS" = "darwin" ]; then
    echo "otel-collector: registering macOS service..."
    mkdir -p "$(dirname "$PLIST_FILE")"
    cat > "$PLIST_FILE" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BINARY}</string>
        <string>--config</string>
        <string>${CONFIG_FILE}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOG_FILE}</string>
    <key>StandardErrorPath</key>
    <string>${LOG_FILE}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>${HOME}</string>
    </dict>
</dict>
</plist>
EOF
    echo "otel-collector: service registered at $PLIST_FILE"
    echo "otel-collector: to enable, run 'otel-collector start'"
  fi
}

start_otel() {
  if [ ! -x "$BINARY" ]; then
    echo "otel-collector: error: binary not found. Run 'otel-collector install' first." >&2
    exit 1
  fi

  if [ "$OS" = "darwin" ]; then
    echo "otel-collector: starting service ${PLIST_LABEL}..."
    launchctl load -w "$PLIST_FILE"
  else
    # Fallback for non-macOS (legacy behavior)
    echo "otel-collector: starting manually (PID file fallback)..."
    mkdir -p "$(dirname "$LOG_FILE")"
    nohup "$BINARY" --config "$CONFIG_FILE" > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  fi
}

stop_otel() {
  if [ "$OS" = "darwin" ]; then
    echo "otel-collector: stopping service ${PLIST_LABEL}..."
    launchctl unload -w "$PLIST_FILE" 2>/dev/null || true
  else
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      kill "$PID" 2>/dev/null || true
      rm -f "$PID_FILE"
    fi
  fi
}

status_otel() {
  if [ "$OS" = "darwin" ]; then
    if launchctl list "$PLIST_LABEL" >/dev/null 2>&1; then
      PID=$(launchctl list "$PLIST_LABEL" | grep -i '"PID"' | awk '{print $3}' | tr -d ';')
      echo "otel-collector: running via launchd (PID: ${PID:-unknown})"
      return 0
    else
      echo "otel-collector: not running (launchd)."
      return 1
    fi
  else
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "otel-collector: running (PID: $(cat "$PID_FILE"))"
      return 0
    fi
    echo "otel-collector: not running."
    return 1
  fi
}

case "${1:-}" in
  install) install_otel ;;
  start)   start_otel ;;
  stop)    stop_otel ;;
  restart) stop_otel; start_otel ;;
  status)  status_otel ;;
  validate) validate_otel ;;
  logs)    tail -f "$LOG_FILE" ;;
  *)       usage; exit 1 ;;
esac
