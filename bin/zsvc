#!/usr/bin/env bash
# bin/zsvc — Zdots service control ("brew services" for zdots)
#
# Provides a single interface to start, stop, restart, tail logs, and
# diagnose every service managed by zdots. Delegates to the authoritative
# ctl script for each service; adds no logic of its own.
#
# Services:  llama  embed  otel  colima  nginx  postgres  redis
# Commands:  list  start  stop  restart  status  health  logs  diag  validate

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
BIN="$ZDOTDIR/bin"
_LAUNCHD_UID="$(id -u)"

# Single source of truth for the service catalog + health/state probes.
# shellcheck source=lib/svc-registry.bash
source "$ZDOTDIR/lib/svc-registry.bash"

# ---------------------------------------------------------------------------
# Service registry
# Sets SVC_* vars for the given service alias.
# ---------------------------------------------------------------------------
# Populate the SVC_* variables for a service alias from the shared registry
# (lib/svc-registry.bash). Uses accessor functions to avoid direct array access.
# SVC_CTL resolves a repo bin/ script to its full path; an external command
# (e.g. colima) or no ctl is left as-is.
_svc_meta() {
  SVC_NAME="$(zdots_svc_resolve "$1")" || {
    printf 'zsvc: unknown service: %s\n' "$1" >&2
    printf 'zsvc: known services: %s\n' "$(zdots_svc_managed | paste -sd, - | sed 's/,/, /g')" >&2
    exit 1
  }
  SVC_DISPLAY="$(zdots_svc_display "$SVC_NAME")"
  SVC_LABEL="$(zdots_svc_label "$SVC_NAME")"
  SVC_LOG="$(zdots_svc_log "$SVC_NAME")"
  SVC_ENDPOINT="$(zdots_svc_endpoint "$SVC_NAME")"
  SVC_TYPE="$(zdots_svc_type "$SVC_NAME")"
  local ctl; ctl="$(zdots_svc_ctl "$SVC_NAME")"
  if [[ -n "$ctl" && -f "$BIN/$ctl" ]]; then SVC_CTL="$BIN/$ctl"; else SVC_CTL="$ctl"; fi
  SVC_INSTALL="$(zdots_svc_install "$SVC_NAME")"
  SVC_START="$(zdots_svc_start "$SVC_NAME")"
  SVC_STOP="$(zdots_svc_stop "$SVC_NAME")"
  SVC_RESTART="$(zdots_svc_restart "$SVC_NAME")"
  SVC_STATUS="$(zdots_svc_status "$SVC_NAME")"
  SVC_HEALTH="$(zdots_svc_status "$SVC_NAME")"  # Note: HEALTH uses status ctl command, not a separate probe
  SVC_LOGS="$(zdots_svc_logs "$SVC_NAME")"
  SVC_VALIDATE="$(zdots_svc_validate "$SVC_NAME")"
}

mapfile -t ALL_SVCS < <(zdots_svc_managed)
LOCAL_URLS=(
  "llama.local|https://llama.local/health"
  "embed.local|https://embed.local/health"
  "o2.local|https://o2.local/healthz"
  "my.local|http://my.local/"
  "dev.my.local|http://dev.my.local/"
)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Color helpers
_CLR_OK='\033[0;32m'
_CLR_WARN='\033[0;33m'
_CLR_ERR='\033[0;31m'
_CLR_INFO='\033[0;36m'
_CLR_RST='\033[0m'

_ok()   { printf "zsvc: ${_CLR_OK}✅ [ok]${_CLR_RST}  %s\n" "$*" >&2; }
_warn() { printf "zsvc: ${_CLR_WARN}⚠️  [!!]${_CLR_RST}  %s\n" "$*" >&2; }
_info() { printf "zsvc: ${_CLR_INFO}ℹ️  %s${_CLR_RST}\n"       "$*" >&2; }
_die()  { printf "zsvc: ${_CLR_ERR}❌ [err]${_CLR_RST} %s\n" "$*" >&2; exit 1; }
_sep()  { printf "\n${_CLR_INFO}--- %s ---${_CLR_RST}\n" "$*"; }

_json_escape() {
  sed 's/\\/\\\\/g; s/"/\\"/g' <<<"$1"
}

# State probing (launchd user-domain, nginx system-domain, colima) lives once
# in lib/svc-registry.bash → zdots_svc_state. zsvc reads it through that seam.

# Plain user-domain Homebrew LaunchAgents (postgres, redis): managed directly via
# launchctl — never `brew services`. No bespoke ctl script.
_plist_path()   { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$SVC_LABEL"; }
_plist_target() { printf 'gui/%s/%s' "$_LAUNCHD_UID" "$SVC_LABEL"; }

# Light, dependency-free liveness probe per service. Echoes a one-line verdict.
_plist_health() {
  case "$SVC_NAME" in
    postgres)
      if command -v pg_isready >/dev/null 2>&1 && pg_isready -q 2>/dev/null; then
        _ok "accepting connections (pg_isready)"
      else _warn "not accepting connections"; fi ;;
    redis)
      if [[ "$(redis-cli ping 2>/dev/null)" == "PONG" ]]; then
        _ok "PONG"
      else _warn "no PONG"; fi ;;
  esac
}

_svc_state_pid() { zdots_svc_state "$SVC_NAME"; }

# Health verdict for the current service: "ok\t<detail>" or "fail\t<detail>".
# The probe itself lives once in the registry (zdots_svc_healthy); only the
# human-facing detail label is chosen here.
_svc_health_text() {
  local detail
  case "$SVC_NAME" in
    llama|embed) detail='/health' ;;
    otel)        detail='OTLP receiver' ;;
    colima)      detail='colima status' ;;
    nginx)       detail='localhost:80' ;;
    postgres)    detail='pg_isready' ;;
    redis)       detail='PONG' ;;
    worker)      detail='process alive' ;;
    *)           detail='' ;;
  esac
  if zdots_svc_healthy "$SVC_NAME"; then
    printf 'ok\t%s' "$detail"
  else
    printf 'fail\t%s' "$detail"
  fi
}

_local_url_health() {
  local item name url code failed=0
  printf '%-16s  %-6s  %-5s  %s\n' LOCAL_URL STATUS CODE URL
  printf '%-16s  %-6s  %-5s  %s\n' '---------' '------' '----' '---'
  for item in "${LOCAL_URLS[@]}"; do
    name="${item%%|*}"
    url="${item#*|}"
    code=$(curl -sk --max-time 2 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null) || true
    code="${code:-000}"
    case "$code" in
      000|5*) failed=1; printf '%-16s  %-6s  %-5s  %s\n' "$name" fail "$code" "$url" ;;
      *)      printf '%-16s  %-6s  %-5s  %s\n' "$name" ok   "$code" "$url" ;;
    esac
  done
  return "$failed"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_list() {
  printf '%-16s  %-18s  %-8s  %s\n' SERVICE STATE PID ENDPOINT
  printf '%-16s  %-18s  %-8s  %s\n' '-------' '-----' '---' '--------'
  local svc state_pid state pid
  for svc in "${ALL_SVCS[@]}"; do
    _svc_meta "$svc"
    state_pid=$(zdots_svc_state "$SVC_NAME")
    state="${state_pid%%$'\t'*}"
    pid="${state_pid##*$'\t'}"
    printf '%-16s  %-18s  %-8s  %s\n' "$SVC_DISPLAY" "$state" "$pid" "${SVC_ENDPOINT:--}"
  done
}

cmd_health_all() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local svc state_pid state health detail failed=0
  local service_json="" url_json="" first=true item name url code status

  if $json; then
    for svc in "${ALL_SVCS[@]}"; do
      _svc_meta "$svc"
      state_pid=$(_svc_state_pid)
      state="${state_pid%%$'\t'*}"
      health="$(_svc_health_text)"
      detail="${health##*$'\t'}"
      health="${health%%$'\t'*}"
      [[ "$health" == ok ]] || failed=1
      $first || service_json+=","
      first=false
      service_json+=$(printf '{"name":"%s","display":"%s","state":"%s","health":"%s","detail":"%s","endpoint":"%s","log":"%s"}' \
        "$(_json_escape "$SVC_NAME")" "$(_json_escape "$SVC_DISPLAY")" "$(_json_escape "$state")" \
        "$(_json_escape "$health")" "$(_json_escape "$detail")" "$(_json_escape "${SVC_ENDPOINT:-}")" "$(_json_escape "${SVC_LOG:-}")")
    done

    first=true
    for item in "${LOCAL_URLS[@]}"; do
      name="${item%%|*}"
      url="${item#*|}"
      code=$(curl -sk --max-time 2 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null) || true
      code="${code:-000}"
      case "$code" in
        000|5*) status=fail; failed=1 ;;
        *)      status=ok ;;
      esac
      $first || url_json+=","
      first=false
      url_json+=$(printf '{"name":"%s","url":"%s","status":"%s","code":"%s"}' \
        "$(_json_escape "$name")" "$(_json_escape "$url")" "$(_json_escape "$status")" "$(_json_escape "$code")")
    done

    printf '{"healthy":%s,"services":[%s],"local_urls":[%s]}\n' \
      "$([[ "$failed" == 0 ]] && printf true || printf false)" "$service_json" "$url_json"
    return "$failed"
  fi

  printf '%-16s  %-18s  %-6s  %s\n' SERVICE STATE HEALTH DETAIL
  printf '%-16s  %-18s  %-6s  %s\n' '-------' '-----' '------' '------'
  for svc in "${ALL_SVCS[@]}"; do
    _svc_meta "$svc"
    state_pid=$(_svc_state_pid)
    state="${state_pid%%$'\t'*}"
    health="$(_svc_health_text)"
    detail="${health##*$'\t'}"
    health="${health%%$'\t'*}"
    [[ "$health" == ok ]] || failed=1
    printf '%-16s  %-18s  %-6s  %s\n' "$SVC_DISPLAY" "$state" "$health" "$detail"
  done

  printf '\n'
  _local_url_health || failed=1
  return "$failed"
}

cmd_start() {
  _svc_meta "$1"
  if [[ "$SVC_TYPE" == "plist" ]]; then
    local plist; plist=$(_plist_path)
    [[ -f "$plist" ]] || _die "${SVC_DISPLAY}: LaunchAgent plist missing: $plist"
    if launchctl print "$(_plist_target)" >/dev/null 2>&1; then
      _ok "${SVC_DISPLAY} already running"; return
    fi
    _info "starting ${SVC_DISPLAY} (launchctl bootstrap)..."
    launchctl bootstrap "gui/${_LAUNCHD_UID}" "$plist" && _ok "started"
    return
  fi
  # If the launchd plist is missing, run install first so the service is
  # registered before we try to start it. Handles the case where update-local
  # failed mid-phase and left a service un-installed.
  if [[ "$SVC_TYPE" == "launchd" && -n "$SVC_INSTALL" ]]; then
    local plist="$HOME/Library/LaunchAgents/${SVC_LABEL}.plist"
    if [[ ! -f "$plist" ]]; then
      _warn "${SVC_DISPLAY} plist missing — running install first"
      "$SVC_CTL" "$SVC_INSTALL"
      return
    fi
  fi
  _info "starting ${SVC_DISPLAY}..."
  "$SVC_CTL" "$SVC_START"
}

cmd_stop() {
  _svc_meta "$1"
  if [[ "$SVC_TYPE" == "plist" ]]; then
    _info "stopping ${SVC_DISPLAY} (launchctl bootout)..."
    launchctl bootout "$(_plist_target)" 2>/dev/null && _ok "stopped" \
      || _warn "${SVC_DISPLAY} was not running"
    return
  fi
  _info "stopping ${SVC_DISPLAY}..."
  "$SVC_CTL" "$SVC_STOP"
}

cmd_restart() {
  _svc_meta "$1"
  if [[ "$SVC_TYPE" == "plist" ]]; then
    _info "restarting ${SVC_DISPLAY} (launchctl kickstart -k)..."
    launchctl kickstart -k "$(_plist_target)" && _ok "restarted"
    return
  fi
  if [[ -n "$SVC_RESTART" ]]; then
    _info "restarting ${SVC_DISPLAY}..."
    "$SVC_CTL" "$SVC_RESTART"
  else
    _info "restarting ${SVC_DISPLAY} (stop + start)..."
    "$SVC_CTL" "$SVC_STOP" || true
    sleep 2
    "$SVC_CTL" "$SVC_START"
  fi
}

cmd_status() {
  local svc="$1"; shift
  _svc_meta "$svc"
  if [[ "$SVC_TYPE" == "plist" ]]; then
    local sp; sp=$(zdots_svc_state "$SVC_NAME")
    local st="${sp%%$'\t'*}" pid="${sp##*$'\t'}"
    if [[ "$st" == "running" ]]; then _ok "${SVC_DISPLAY} ${st} (pid ${pid}, ${SVC_ENDPOINT})"
    else _warn "${SVC_DISPLAY} ${st}"; fi
    _plist_health
    return
  fi
  "$SVC_CTL" "$SVC_STATUS" "$@"
}

cmd_logs_all() {
  local lines=50 paths_only=0 follow=1 json=false arg
  while [[ $# -gt 0 ]]; do
    arg="$1"; shift
    case "$arg" in
      --paths) paths_only=1 ;;
      --json) json=true; paths_only=1 ;;
      --no-follow) follow=0 ;;
      -n|--lines)
        [[ $# -gt 0 ]] || _die "--lines requires a number"
        lines="$1"; shift ;;
      --lines=*) lines="${arg#*=}" ;;
      *) _die "unknown logs all option: $arg" ;;
    esac
  done

  local -a files
  local svc sources_json="" first=true
  files=()
  for svc in "${ALL_SVCS[@]}"; do
    _svc_meta "$svc"
    [[ -n "$SVC_LOG" ]] || continue
    if $json; then
      $first || sources_json+=","
      first=false
      sources_json+=$(printf '{"name":"%s","display":"%s","path":"%s","exists":%s}' \
        "$(_json_escape "$SVC_NAME")" "$(_json_escape "$SVC_DISPLAY")" "$(_json_escape "$SVC_LOG")" \
        "$([[ -f "$SVC_LOG" ]] && printf true || printf false)")
    elif [[ "$paths_only" == "1" ]]; then
      printf '%-16s %s\n' "$SVC_DISPLAY" "$SVC_LOG"
    else
      mkdir -p "$(dirname "$SVC_LOG")" 2>/dev/null || true
      files+=("$SVC_LOG")
    fi
  done
  if $json; then
    printf '{"sources":[%s],"tail_command":"zsvc logs all"}\n' "$sources_json"
    return 0
  fi
  [[ "$paths_only" == "1" ]] && return 0
  (( ${#files[@]} )) || _die "no log sources registered"

  trap 'exit 0' INT TERM
  if [[ "$follow" == "1" ]]; then
    _info "tailing all registered logs — Ctrl+C to stop"
    tail -n "$lines" -F "${files[@]}"
  else
    tail -n "$lines" "${files[@]}"
  fi
}

cmd_logs() {
  local svc="$1"; shift || true
  if [[ "$svc" == "all" || "$svc" == "--all" ]]; then
    cmd_logs_all "$@"
    return
  fi

  _svc_meta "$svc"
  if [[ -n "$SVC_LOGS" ]]; then
    "$SVC_CTL" "$SVC_LOGS"
  elif [[ -n "$SVC_LOG" ]]; then
    trap 'exit 0' INT TERM
    mkdir -p "$(dirname "$SVC_LOG")"
    _info "tailing ${SVC_LOG} — Ctrl+C to stop"
    tail -f "$SVC_LOG"
  else
    _die "${SVC_DISPLAY} has no log source"
  fi
}

cmd_health() {
  local json=false
  if [[ "${1:-}" == "--json" ]]; then
    json=true
    shift
  fi
  if [[ $# -eq 0 || "${1:-}" == "all" || "${1:-}" == "--all" ]]; then
    if $json; then cmd_health_all --json; else cmd_health_all; fi
    return
  fi
  _svc_meta "$1"
  local health detail state_pid state
  health="$(_svc_health_text)"
  detail="${health##*$'\t'}"
  health="${health%%$'\t'*}"
  if $json; then
    state_pid=$(_svc_state_pid)
    state="${state_pid%%$'\t'*}"
    printf '{"name":"%s","display":"%s","state":"%s","health":"%s","detail":"%s","endpoint":"%s","log":"%s"}\n' \
      "$(_json_escape "$SVC_NAME")" "$(_json_escape "$SVC_DISPLAY")" "$(_json_escape "$state")" \
      "$(_json_escape "$health")" "$(_json_escape "$detail")" "$(_json_escape "${SVC_ENDPOINT:-}")" "$(_json_escape "${SVC_LOG:-}")"
  else
  printf '%-16s  %-6s  %s\n' "$SVC_DISPLAY" "$health" "$detail"
  fi
  [[ "$health" == ok ]]
}

cmd_diag() {
  _svc_meta "$1"
  printf '\n==> zsvc diag: %s\n' "$SVC_DISPLAY"

  _sep "status"
  if [[ "$SVC_TYPE" == "plist" ]]; then
    cmd_status "$1" 2>&1 || true
  else
    "$SVC_CTL" "$SVC_STATUS" 2>&1 || true
    if [[ -n "$SVC_HEALTH" ]]; then
      _sep "health"
      "$SVC_CTL" "$SVC_HEALTH" 2>&1 || true
    fi
  fi

  if [[ -n "$SVC_VALIDATE" ]]; then
    _sep "validate"
    "$SVC_CTL" "$SVC_VALIDATE" 2>&1 || true
  fi

  if [[ "$SVC_TYPE" == "launchd" || "$SVC_TYPE" == "plist" ]]; then
    _sep "launchd state"
    launchctl print "gui/${_LAUNCHD_UID}/${SVC_LABEL}" 2>/dev/null || printf '(not registered)\n'
  elif [[ "$SVC_TYPE" == "nginx" ]]; then
    _sep "launchd state (system domain)"
    launchctl print "system/${SVC_LABEL}" 2>/dev/null || printf '(not registered)\n'
  fi

  if [[ -n "$SVC_LOG" ]]; then
    _sep "last 50 log lines — ${SVC_LOG}"
    if [[ -f "$SVC_LOG" ]]; then
      tail -50 "$SVC_LOG"
    else
      printf '(log not found — service may not have started yet)\n'
    fi
  fi

  _sep "suggested commands"
  printf '  zsvc logs %s\n'    "$SVC_NAME"
  printf '  zsvc restart %s\n' "$SVC_NAME"
  [[ -n "$SVC_VALIDATE" ]] && printf '  zsvc validate %s\n' "$SVC_NAME"
  printf '  log show --style compact --last 5m --predicate '\''eventMessage CONTAINS "%s"'\''\n' "$SVC_LABEL"
}

cmd_validate() {
  _svc_meta "$1"
  if [[ -n "$SVC_VALIDATE" ]]; then
    "$SVC_CTL" "$SVC_VALIDATE"
  else
    _warn "${SVC_DISPLAY} has no validate command"
    exit 1
  fi
}

cmd_reload() {
  _svc_meta "$1"
  # Graceful, zero-downtime reload where the service supports it (nginx).
  # Everything else has no native reload — point at restart instead.
  if [[ "$SVC_TYPE" == "nginx" && -n "$SVC_CTL" ]]; then
    "$SVC_CTL" reload
  else
    _warn "${SVC_DISPLAY} has no graceful reload — use: zsvc restart ${SVC_NAME}"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: zsvc <command> [service] [options]

Unified service control for zdots-managed services.

COMMANDS
  list                  Table of all services: state, pid, endpoint
  start   <service>     Start a service
  stop    <service>     Stop a service
  restart <service>     Restart a service (stop + start if no native restart)
  reload  <service>     Graceful zero-downtime reload (nginx)
  status  <service>     Full status from the service's ctl script
  health  [--json] [service|all] Probe service liveness and local URLs
  logs    <service>     Tail the service log (Ctrl+C to stop)
  logs    all [--paths|--json] [options] Tail all registered service logs
  diag    <service>     Status + health + launchd state + last 50 log lines
  validate <service>    Validate service config (llama, otel)

SERVICES
  llama     llama-server   — AI inference        port 11500  [aliases: ai, server]
  embed     llama-embed    — Embedding server    port 11501  [aliases: llama-embed]
  otel      otel-collector — Telemetry           port 4318   [aliases: telemetry]
  colima    Colima VM      — Docker runtime                  [aliases: vm, docker]
  nginx     nginx          — TLS reverse proxy   80/443      [aliases: web, proxy]
  postgres  postgresql@18  — `my` database       port 5432   [aliases: pg, db]
  redis     redis          — analytics cache     port 6379   [aliases: cache, kv]
  worker    zdots-worker   — async job queue drain            [aliases: jobs]

NOTE
  nginx is a root (system-domain) LaunchDaemon and uses sudo via nginx-ctl.
  postgres/redis are user LaunchAgents managed directly via launchctl.
  zsvc verifies registration and component health. For branch readiness, run:
    zdots-ctl status && bats tests/platform_e2e.bats

EXAMPLES
  zsvc list
  zsvc start llama
  zsvc restart otel
  zsvc logs embed
  zsvc logs all --paths
  zsvc logs all -n 100
  zsvc health
  zsvc status postgres
  zsvc reload nginx          # graceful config reload (after editing servers/*.conf)
  zsvc diag llama
  zsvc status llama --json

NOTES
  zsvc controls individual services. For the full platform stack use zdots-ctl:
    zdots-ctl up      start everything in dependency order
    zdots-ctl down    stop everything
    zdots-ctl check   deep health diagnostic
  Lifecycle diagrams: docs/platform-service-plane.md
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

[[ $# -ge 1 ]] || { usage >&2; exit 1; }

case "$1" in
  list)     cmd_list ;;
  start)    [[ $# -ge 2 ]] || { usage >&2; exit 1; }; cmd_start "$2" ;;
  stop)     [[ $# -ge 2 ]] || { usage >&2; exit 1; }; cmd_stop "$2" ;;
  restart)  [[ $# -ge 2 ]] || { usage >&2; exit 1; }; cmd_restart "$2" ;;
  reload)   [[ $# -ge 2 ]] || { usage >&2; exit 1; }; cmd_reload "$2" ;;
  status)   [[ $# -ge 2 ]] || { usage >&2; exit 1; }; shift; cmd_status "$@" ;;
  health)   shift; cmd_health "$@" ;;
  logs)     [[ $# -ge 2 ]] || { usage >&2; exit 1; }; shift; cmd_logs "$@" ;;
  diag)     [[ $# -ge 2 ]] || { usage >&2; exit 1; }; cmd_diag "$2" ;;
  validate) [[ $# -ge 2 ]] || { usage >&2; exit 1; }; cmd_validate "$2" ;;
  -h|--help) usage ;;
  *) printf 'zsvc: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
