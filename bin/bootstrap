#!/usr/bin/env sh
# ---
# id: bootstrap
# title: "Zdots Bootstrap"
# purpose: Single-command system recreation on a new machine.
# rationale: Idempotent setup for XDG dirs, shell symlinks, git config, Homebrew packages, AI stack, and ruby_llm gem.
# ---
# bin/bootstrap — First-time setup. Run via: make bootstrap

set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "${1:-}" in
  -h|--help)
    cat <<EOF
Usage: bootstrap

First-time zdots setup for a new machine.

Phases include Homebrew bundle selection, XDG directories, companion repos,
shell links, local AI launchd setup, OTel collector setup, nginx/mkcert,
Ruby gems, database initialization, Pi config, and gh extensions.

Logs:
  \${XDG_STATE_HOME:-~/.local/state}/zsh/bootstrap-*.log
  \${XDG_STATE_HOME:-~/.local/state}/zsh/bootstrap-*.summary.md
  Override directory with ZDOTS_LOG_DIR.

Diagnostics:
  zdots-log-analyze bootstrap
  zdots-log-analyze bootstrap --ai
EOF
    exit 0
    ;;
  "")
    ;;
  *)
    printf 'bootstrap: unknown option: %s\n' "$1" >&2
    printf 'Run: bootstrap --help\n' >&2
    exit 2
    ;;
esac

_BOOTSTRAP_STARTED_AT="$(date '+%Y-%m-%dT%H:%M:%S%z')"
_BOOTSTRAP_RUN_ID="$(date '+%Y%m%dT%H%M%S')-$$"
_BOOTSTRAP_LOG_DIR="${ZDOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zsh}"
mkdir -p "$_BOOTSTRAP_LOG_DIR"
BOOTSTRAP_LOG="${ZDOTS_BOOTSTRAP_LOG:-$_BOOTSTRAP_LOG_DIR/bootstrap-${_BOOTSTRAP_RUN_ID}.log}"
BOOTSTRAP_SUMMARY="${BOOTSTRAP_LOG%.log}.summary.md"
BOOTSTRAP_LATEST="$_BOOTSTRAP_LOG_DIR/bootstrap-latest.log"
if command -v ln >/dev/null 2>&1; then
  ln -sf "$BOOTSTRAP_LOG" "$BOOTSTRAP_LATEST" 2>/dev/null || true
fi
if [ "${ZDOTS_TRANSCRIPT_TEE:-1}" = "1" ] && command -v tee >/dev/null 2>&1 && command -v mkfifo >/dev/null 2>&1; then
  _BOOTSTRAP_FIFO="${BOOTSTRAP_LOG}.fifo"
  rm -f "$_BOOTSTRAP_FIFO"
  mkfifo "$_BOOTSTRAP_FIFO"
  tee -a "$BOOTSTRAP_LOG" < "$_BOOTSTRAP_FIFO" &
  exec > "$_BOOTSTRAP_FIFO" 2>&1
  rm -f "$_BOOTSTRAP_FIFO"
else
  exec >> "$BOOTSTRAP_LOG" 2>&1
fi

_bootstrap_phase_index=0
_bootstrap_phase_total=16
_bootstrap_current_phase="preflight"

_bootstrap_log() {
  printf '%s bootstrap: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"
}

_bootstrap_summary() {
  printf '%s\n' "$*" >> "$BOOTSTRAP_SUMMARY"
}

_bootstrap_phase() {
  _bootstrap_phase_index=$((_bootstrap_phase_index + 1))
  _bootstrap_current_phase="$1"
  printf '\n==> bootstrap phase %02d/%02d: %s\n' "$_bootstrap_phase_index" "$_bootstrap_phase_total" "$_bootstrap_current_phase"
  _bootstrap_summary "- phase ${_bootstrap_phase_index}/${_bootstrap_phase_total}: ${_bootstrap_current_phase}"
}

_bootstrap_finish() {
  _status=$?
  if [ "$_status" -eq 0 ]; then
    _bootstrap_log "complete status=0 log=$BOOTSTRAP_LOG summary=$BOOTSTRAP_SUMMARY"
    _bootstrap_summary "- result: complete"
  else
    _bootstrap_log "failed status=$_status phase=$_bootstrap_current_phase log=$BOOTSTRAP_LOG summary=$BOOTSTRAP_SUMMARY"
    _bootstrap_summary "- result: failed status=${_status} phase=${_bootstrap_current_phase}"
  fi
  exit "$_status"
}
trap _bootstrap_finish EXIT

{
  printf '# zdots bootstrap run\n'
  printf -- '- started: %s\n' "$_BOOTSTRAP_STARTED_AT"
  printf -- '- repo: %s\n' "$REPO_ROOT"
  printf -- '- log: %s\n' "$BOOTSTRAP_LOG"
  printf -- '- latest: %s\n' "$BOOTSTRAP_LATEST"
  printf -- '- context: %s\n' "${ZDOTS_CONTEXT:-home}"
} > "$BOOTSTRAP_SUMMARY"
_bootstrap_log "run_id=$_BOOTSTRAP_RUN_ID repo=$REPO_ROOT log=$BOOTSTRAP_LOG summary=$BOOTSTRAP_SUMMARY"

if [ -f "$REPO_ROOT/.zdots.local" ]; then
  . "$REPO_ROOT/.zdots.local"
fi
if [ "${ZDOTS_CONTEXT:-home}" = "work" ] && [ -f "$REPO_ROOT/.zdots.work" ]; then
  . "$REPO_ROOT/.zdots.work"
fi

case "${ZDOTS_CONTEXT:-home}" in
  home) BREWFILE="$REPO_ROOT/Brewfile.home" ;;
  work) BREWFILE="$REPO_ROOT/Brewfile.work" ;;
  *)
    echo "bootstrap: ERROR: unknown ZDOTS_CONTEXT=${ZDOTS_CONTEXT}; expected home or work" >&2
    exit 1
    ;;
esac

_bootstrap_phase "preflight: Xcode tools, Homebrew availability, selected Brewfile"

# 0. Xcode Command Line Tools
# Required for git, compilers, and Homebrew itself. If you ran `git clone` to
# get here, CLT is likely installed already — this handles the edge case where
# it isn't (fresh out-of-box Mac, System Integrity Protection reset, etc.).
if ! xcode-select -p >/dev/null 2>&1; then
  echo "bootstrap: Xcode Command Line Tools not found — starting installation."
  echo "           A dialog will appear: click Install and wait for it to finish."
  echo "           Then re-run: $0"
  xcode-select --install 2>/dev/null || true
  exit 1
fi

# 1. Homebrew
# Three states handled in sequence:
#   a) Installed + in PATH → nothing to do
#   b) Installed at known prefix but PATH not yet updated → activate shellenv
#   c) Not installed → download + install, then activate
#
# The shellenv eval makes brew (and everything it installs) available for the
# rest of this script without requiring a new shell. On Apple Silicon the
# prefix is /opt/homebrew; on Intel it's /usr/local.
_brew_activate() {
  if   [ -x "/opt/homebrew/bin/brew" ]; then eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x "/usr/local/bin/brew"    ]; then eval "$(/usr/local/bin/brew shellenv)"
  fi
}

if ! command -v brew >/dev/null 2>&1; then _brew_activate; fi

if ! command -v brew >/dev/null 2>&1; then
  echo "bootstrap: Homebrew not found — installing..."
  echo "           You may be prompted for your password."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  _brew_activate
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "bootstrap: ERROR: Homebrew unavailable after install attempt." >&2
  echo "           Open a new Terminal window and re-run: $0" >&2
  exit 1
fi
echo "bootstrap: $(brew --version | head -1)"

if [ ! -f "$BREWFILE" ]; then
  echo "bootstrap: Brewfile not found at $BREWFILE" >&2
  exit 1
fi
echo "bootstrap: selected Brewfile: $BREWFILE"

_bootstrap_phase "filesystem: XDG directories and secure local state"

# 2. XDG Infrastructure & Security
# Create core XDG structure
echo "bootstrap: initializing XDG infrastructure..."
mkdir -p "$HOME/.config" "$HOME/.cache" "$HOME/.local/state" "$HOME/.local/share"
# Ensure secure permissions (700)
chmod 700 "$HOME/.config" "$HOME/.cache" "$HOME/.local/state" "$HOME/.local/share"

# Create application-specific subdirectories (Prevents home-directory pollution)
mkdir -p \
  "$HOME/.config/git" \
  "$HOME/.config/aws" \
  "$HOME/.config/npm" \
  "$HOME/.config/bundle" \
  "$HOME/.config/python" \
  "$HOME/.local/state/zsh" \
  "$HOME/.local/state/less" \
  "$HOME/.local/state/node" \
  "$HOME/.local/state/psql" \
  "$HOME/.local/share/zsh" \
  "$HOME/.local/share/go" \
  "$HOME/.local/share/gem" \
  "$HOME/.local/share/python" \
  "$HOME/.local/share/pnpm" \
  "$HOME/.local/share/cargo" \
  "$HOME/.local/share/rustup" \
  "$HOME/.local/share/gnupg"

# Initialize required files (ignore is always safe to touch; config comes from gdots below)
touch "$HOME/.config/git/ignore"

_bootstrap_phase "companion repos: adots and vdots"

# 2b. Companion repos — adots (home dotfiles) and vdots (neovim)
#
# adots: bare git repo at ~/.homegit, work-tree at ~.
# Tracks root dotfiles (.bashrc, .tmux.conf, etc.) and ~/.config/* entries.
# On a clean restore, git-restore pulls them back without a separate clone.
#
# WARNING: the git restore step below overwrites files in $HOME. On a
# corporate machine, IT-managed files (.gitconfig, .bashrc, etc.) will be
# replaced. Back them up before this runs if your employer manages those files.
echo "bootstrap: setting up adots home-dotfiles repo (~/.homegit)..."
if [ ! -d "$HOME/.homegit" ]; then
  git clone --bare https://github.com/just3ws/adots.git "$HOME/.homegit" \
    && echo "bootstrap: adots cloned." \
    || echo "bootstrap: WARNING: adots clone failed — run: git clone --bare https://github.com/just3ws/adots.git ~/.homegit"
fi
if [ -d "$HOME/.homegit" ]; then
  GIT_DIR="$HOME/.homegit" GIT_WORK_TREE="$HOME" git restore --source=HEAD -- . 2>/dev/null \
    && echo "bootstrap: adots files restored." \
    || echo "bootstrap: WARNING: adots restore failed — run: GIT_DIR=~/.homegit GIT_WORK_TREE=~ git restore --source=HEAD -- ."
fi

# vdots: neovim config at ~/.config/nvim.
echo "bootstrap: setting up vdots neovim config (~/.config/nvim)..."
if [ ! -d "$HOME/.config/nvim" ]; then
  git clone https://github.com/just3ws/vdots.git "$HOME/.config/nvim" \
    && echo "bootstrap: vdots cloned." \
    || echo "bootstrap: WARNING: vdots clone failed — run: git clone https://github.com/just3ws/vdots.git ~/.config/nvim"
else
  echo "bootstrap: vdots already present ($HOME/.config/nvim)"
fi

_bootstrap_phase "shell entry points: zsh/bash links and startup warnings"

# 3. Shell Entry Points (Symlinks)
echo "bootstrap: linking shell entry points..."
if [ ! -e "$HOME/.zshenv" ]; then ln -s "$REPO_ROOT/.zshenv" "$HOME/.zshenv"; fi
if [ ! -e "$HOME/.bashrc" ]; then ln -s "$REPO_ROOT/bashrc" "$HOME/.bashrc"; fi
if [ ! -e "$HOME/.bash_profile" ]; then ln -s "$REPO_ROOT/bash_profile" "$HOME/.bash_profile"; fi

# Warn about zsh config files in $HOME that load before ZDOTDIR.
# Tools like nvm, conda, and Homebrew installers commonly append to ~/.zshrc
# or ~/.zprofile, silently shadowing zdots config.
for _f in .zshrc .zprofile .zlogin .zlogout; do
  if [ -f "$HOME/$_f" ]; then
    echo "bootstrap: WARNING: $HOME/$_f exists and will be loaded by zsh before ZDOTDIR."
    echo "           Migrate its contents to \$ZDOTDIR/conf.d/ or env.sh, then delete it."
    echo "           Run 'make check' to surface this as a blocking error after migration."
  fi
done
unset _f

_bootstrap_phase "git: local include files and hooks path"

# 4. Git Integration
echo "bootstrap: configuring git..."
if [ ! -e "$HOME/.gitconfig" ]; then
  cat > "$HOME/.gitconfig" <<'EOF'
[include]
  path = ~/.config/git/config
EOF
elif ! grep -Fq '.config/git/config' "$HOME/.gitconfig"; then
  {
    echo ""
    echo "[include]"
    echo "  path = ~/.config/git/config"
  } >> "$HOME/.gitconfig"
fi

# ~/.config/git/config is tracked in adots — restored by the git restore step above.
# Ensure the directory exists in case adots restore hasn't run yet.
mkdir -p "$HOME/.config/git"
touch "$HOME/.config/git/config" "$HOME/.config/git/ignore"

if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$REPO_ROOT" config --local core.hooksPath .githooks
fi

_bootstrap_phase "toolchain: Homebrew bundle"

# 5. Toolchain — Homebrew packages
echo "bootstrap: installing Homebrew packages (this may take a while)..."
brew bundle --file "$BREWFILE"

_bootstrap_phase "runtime: mise trust and Ruby install"

# 5b. Runtime versions — mise installs Ruby from mise.toml
#
# SEQUENCING: brew bundle installs mise the tool, but mise does not
# automatically install language runtimes. We must run `mise install`
# explicitly here, before step 7 (bundle install) and step 9 (DB init).
#
# On Apple Silicon, Ruby is compiled from source with jemalloc and the
# Homebrew openssl@3 — expect 5–10 minutes on first run.
_mise_bin="$(command -v mise 2>/dev/null || true)"
if [ -z "$_mise_bin" ]; then
  # Homebrew may not have updated PATH in this shell session yet
  _mise_bin="/opt/homebrew/bin/mise"
fi

if [ -x "$_mise_bin" ]; then
  # Trust the repo's mise.toml so mise installs without an interactive prompt
  "$_mise_bin" trust "$REPO_ROOT/mise.toml" 2>/dev/null || true

  # Apple Silicon: compile Ruby with jemalloc allocator and the correct
  # openssl@3 prefix. Both are installed by the selected Brewfile; this wires them in.
  _brew_prefix="$(brew --prefix 2>/dev/null || printf '/opt/homebrew')"
  _ruby_opts="--with-openssl-dir=${_brew_prefix}/opt/openssl@3"
  if [ "$(uname -m)" = "arm64" ] && [ -d "${_brew_prefix}/opt/jemalloc" ]; then
    _ruby_opts="${_ruby_opts} --with-jemalloc"
    echo "bootstrap: Apple Silicon + jemalloc detected — enabling jemalloc for Ruby"
  fi

  echo "bootstrap: installing Ruby $(cat "$REPO_ROOT/etc/ruby-version") via mise..."
  echo "bootstrap: (first run compiles from source — allow 5–10 minutes)"
  RUBY_CONFIGURE_OPTS="$_ruby_opts" \
    "$_mise_bin" install --cd "$REPO_ROOT" \
    || echo "bootstrap: WARNING: mise install failed — run: RUBY_CONFIGURE_OPTS=\"$_ruby_opts\" mise install"
  unset _brew_prefix _ruby_opts
else
  echo "bootstrap: mise not found after brew bundle — skipping Ruby install."
  echo "           mise should have been installed above. Try restarting your shell"
  echo "           or run: brew install mise && mise install"
fi
unset _mise_bin

_bootstrap_phase "ai boundary: local model policy and endpoint probe"

# 6. AI Stack Setup — LOCAL MODELS ONLY
#
# SECURITY BOUNDARY: This machine runs local AI exclusively until you
# complete security setup and explicitly enable cloud access.
#
#   ZDOTS_AI_MODE=local  (enforced in .zdots.env — override in .zdots.local only)
#
# What "local" means:
#   - ai-query, zaider (Aider), and zdots-ctx all use ZDOTS_AI_ENDPOINT
#   - ZDOTS_AI_ENDPOINT defaults to http://127.0.0.1:11500 (this machine)
#   - To use a more powerful machine on your LAN, set in .zdots.local:
#       ZDOTS_AI_ENDPOINT=http://powerstation.local:11500
#   - No OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY are set
#   - Cloud API keys go in .zdots.secrets ONLY — never in this repo
#
# Local AI stack: llama.cpp (inference) + zdots-ctx (knowledge base)
#   ai-query "analyze this"          — one-shot inference
#   zaider                           — Aider wired to local model
#   zdots-ctx query <term>           — search local knowledge base
#   zdots-ctx hydrate [tag]          — context for AI tasks
#   zdots-brain                      — background job worker
echo ""
_AI_ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"
echo "================================================================"
echo "  AI SECURITY BOUNDARY: LOCAL MODELS ONLY"
echo "  ZDOTS_AI_MODE=${ZDOTS_AI_MODE:-local} (no cloud API keys configured)"
echo "  Endpoint: ${_AI_ENDPOINT}"
echo "  To use a remote LAN machine, set ZDOTS_AI_ENDPOINT in .zdots.local"
echo "  To enable cloud AI: add keys to .zdots.secrets + set ZDOTS_AI_MODE=cloud"
echo "================================================================"
echo ""

# PHI-safe operating mode banner — fires when ZDOTS_CONTEXT=work.
if [ "${ZDOTS_CONTEXT:-home}" = "work" ]; then
  echo "================================================================"
  echo "  PHI-SAFE OPERATING MODE ACTIVE (ZDOTS_CONTEXT=work)"
  echo "  capture          : ${ZDOTS_CAPTURE_ENABLED:-0} (0=off, required before capture)"
  echo "  history-redact   : ${ZDOTS_HISTORY_REDACT:-1} (1=on)"
  echo "  ai-mode          : ${ZDOTS_AI_MODE:-local} (local=safe, no cloud egress)"
  echo "  db-encryption    : $([ -n "${ZDOTS_DB_ENCRYPTION_KEY:-}" ] && echo 'key present' || echo 'KEY NOT SET — required for capture')"
  echo ""
  echo "  Verify posture:  zdots-ctl check"
  echo "  Full policy:     backlog/docs/doc-002 - PHI-Safety-Policy.md"
  echo "================================================================"
  echo ""

  # Warn (not error) if ZDOTS_DB_ENCRYPTION_KEY is unset on a work machine.
  if [ -z "${ZDOTS_DB_ENCRYPTION_KEY:-}" ]; then
    echo "bootstrap: WARNING: ZDOTS_CONTEXT=work but ZDOTS_DB_ENCRYPTION_KEY is not set."
    echo "bootstrap:   Generate: openssl rand -hex 32"
    echo "bootstrap:   Store:    zdots-keychain add ZDOTS_DB_ENCRYPTION_KEY <value>"
    echo "bootstrap:   Then add to .zdots.secrets via the Keychain pattern."
    echo "bootstrap:   Capture (zdots-ctx capture) will refuse to run until this is set."
    echo ""
  fi
fi

# Probe endpoint reachability. On an unknown network (corporate proxy, air-gap),
# the local server may not be accessible yet. Set ZDOTS_AI_MODE=none for the
# session so all AI tools exit cleanly rather than hang or error opaquely.
if [ "${ZDOTS_AI_MODE:-local}" != "cloud" ] && [ "${ZDOTS_AI_MODE:-local}" != "none" ]; then
  if ! curl -sf -m 2 --connect-timeout 2 "${_AI_ENDPOINT}/health" >/dev/null 2>&1; then
    echo "bootstrap: WARNING: AI endpoint unreachable at ${_AI_ENDPOINT}"
    echo "bootstrap: Setting ZDOTS_AI_MODE=none for this session."
    echo "bootstrap: AI tools will exit cleanly until the endpoint is available."
    echo "bootstrap: To persist: add ZDOTS_AI_MODE=none to .zdots.local until resolved."
    export ZDOTS_AI_MODE=none
  fi
fi

_bootstrap_phase "llama: chat model launchd registration and model hydration"

if command -v llama-server >/dev/null 2>&1; then
  if command -v llama-ctl >/dev/null 2>&1; then
    echo "bootstrap: registering llama.cpp launchd service..."
    llama-ctl install || echo "bootstrap: warning: llama-ctl install failed (non-blocking)"
    echo "bootstrap: downloading AI model (profile: ${ZDOTS_AI_PROFILE:-standard}, ~4.7 GB)..."
    llama-ctl model-download || echo "bootstrap: warning: model download failed — run 'llama-ctl model-download' manually"
    echo "bootstrap: re-registering plist with model path..."
    llama-ctl install || true
  fi
else
  echo "bootstrap: llama-server not found — skipping AI setup."
  echo "           Run: llama-ctl install && llama-ctl model-download && llama-ctl install"
fi

_bootstrap_phase "embedding: Nomic server setup"

# 6b. Embedding server — Nomic embed-v2 MoE (port 11501)
# Must be a separate process from the chat server: --embeddings + --spec-draft-model
# causes a llama.cpp crash loop. 0.5 GB model, runs alongside the 5 GB chat model.
if command -v llama-server >/dev/null 2>&1 && command -v llama-ctl >/dev/null 2>&1; then
  echo "bootstrap: downloading Nomic embed model (profile: embed, ~0.5 GB)..."
  ZDOTS_AI_PROFILE=embed llama-ctl model-download \
    || echo "bootstrap: warning: embed model download failed — run: ZDOTS_AI_PROFILE=embed llama-ctl model-download"
  echo "bootstrap: registering embedding server launchd service..."
  llama-ctl install-embed \
    || echo "bootstrap: warning: llama-ctl install-embed failed — run manually after model download"
else
  echo "bootstrap: llama-server not found — skipping embed server setup."
fi

_bootstrap_phase "observability: OpenTelemetry collector"

# 6b2. OTel Collector — binary not in Homebrew; managed by bin/otel-collector
# Installs ~/.local/bin/otelcol-contrib and registers the launchd plist.
echo "bootstrap: installing OpenTelemetry Collector..."
if command -v otel-collector >/dev/null 2>&1; then
  otel-collector install \
    && echo "bootstrap: otelcol-contrib installed." \
    || echo "bootstrap: WARNING: otel-collector install failed — run: otel-collector install"
else
  echo "bootstrap: otel-collector script not found — skipping (run after zdots is on PATH)."
fi

_bootstrap_phase "local proxy: mkcert, nginx, and hosts guidance"

# 6c. Local TLS: mkcert CA + service certs
# mkcert creates a locally-trusted CA and issues certs for *.local hostnames.
# nginx uses these certs for https://llama.local, https://embed.local, etc.
_NGINX_PREFIX="$(brew --prefix)/etc/nginx"
if command -v mkcert >/dev/null 2>&1; then
  echo "bootstrap: installing local CA via mkcert (macOS will prompt for your password)..."
  mkcert -install 2>&1 \
    || echo "bootstrap: WARNING: mkcert -install failed — run 'mkcert -install' manually."
  _CERT_PEM="$_NGINX_PREFIX/certs/zdots-local.pem"
  if [ ! -f "$_CERT_PEM" ]; then
    echo "bootstrap: generating TLS certs for local service hostnames..."
    mkdir -p "$_NGINX_PREFIX/certs"
    mkcert \
      -cert-file "$_NGINX_PREFIX/certs/zdots-local.pem" \
      -key-file  "$_NGINX_PREFIX/certs/zdots-local-key.pem" \
      llama.local embed.local grafana.local my.local dev.my.local localhost 127.0.0.1 \
      || echo "bootstrap: WARNING: cert generation failed — run mkcert manually."
  else
    echo "bootstrap: TLS certs already present ($_CERT_PEM)"
  fi
else
  echo "bootstrap: mkcert not found — skipping TLS cert setup."
    echo "           mkcert should have been installed via the selected Brewfile above."
  echo "           Run: brew install mkcert && mkcert -install"
fi

# 6d. nginx: local reverse proxy on port 80/443
# Fixes the default Homebrew nginx (listens on 8080, conflicts with llama-server)
# and installs zdots service configs.
if command -v nginx >/dev/null 2>&1; then
  _NGINX_CONF="$_NGINX_PREFIX/nginx.conf"
  # Fix default server port: 8080 (Homebrew default) conflicts with llama-server.
  if grep -qE 'listen[[:space:]]+8080[^0-9]' "$_NGINX_CONF" 2>/dev/null; then
    echo "bootstrap: fixing nginx default server port 8080 → 80..."
    sed -i.bak 's/listen       8080;/listen       80 default_server;/' "$_NGINX_CONF"
  fi
  # Install zdots nginx configs (ssl_params.conf and servers/zdots.conf).
  _REPO_NGINX="$REPO_ROOT/etc/nginx"
  if [ -f "$_REPO_NGINX/ssl_params.conf" ]; then
    cp "$_REPO_NGINX/ssl_params.conf" "$_NGINX_PREFIX/ssl_params.conf"
    echo "bootstrap: installed nginx ssl_params.conf"
  fi
  if [ ! -f "$_NGINX_PREFIX/servers/zdots.conf" ] && [ -f "$_REPO_NGINX/servers/zdots.conf" ]; then
    cp "$_REPO_NGINX/servers/zdots.conf" "$_NGINX_PREFIX/servers/zdots.conf"
    echo "bootstrap: installed nginx servers/zdots.conf"
  fi
  # Validate config before attempting start.
  if nginx -t 2>/dev/null; then
    echo "bootstrap: nginx config valid."
    echo "bootstrap: MANUAL STEP REQUIRED: start nginx on port 80."
    echo "           Run: sudo launchctl load /Library/LaunchDaemons/homebrew.mxcl.nginx.plist"
    echo "           NOTE: use 'sudo launchctl kickstart -k system/homebrew.mxcl.nginx' for restarts."
    echo "           Do NOT use 'sudo brew services restart nginx' — it takes root ownership of"
    echo "           Homebrew paths and breaks subsequent 'brew link' and 'brew install' operations."
  else
    echo "bootstrap: WARNING: nginx config validation failed — run: nginx -t"
  fi
  unset _NGINX_CONF _REPO_NGINX
else
  echo "bootstrap: nginx not found — skipping local proxy setup."
  echo "           Run: brew install nginx && sudo brew services start nginx"
fi
unset _NGINX_PREFIX

# 6e. /etc/hosts — local service hostnames
# nginx routes requests by Host header; /etc/hosts maps hostnames to 127.0.0.1.
# These entries require sudo — bootstrap prints the commands.
_NEEDED_HOSTS="llama.local embed.local grafana.local"
_MISSING_HOSTS=""
for _HOST in $_NEEDED_HOSTS; do
  grep -qF "$_HOST" /etc/hosts 2>/dev/null || _MISSING_HOSTS="$_MISSING_HOSTS $_HOST"
done
if [ -n "$_MISSING_HOSTS" ]; then
  echo ""
  echo "bootstrap: MANUAL STEP REQUIRED: /etc/hosts entries missing for:$_MISSING_HOSTS"
  echo "           Run the following (one-time, requires sudo):"
  for _HOST in $_MISSING_HOSTS; do
    echo "             sudo sh -c 'echo \"127.0.0.1 ${_HOST}\" >> /etc/hosts'"
  done
  echo ""
fi
unset _NEEDED_HOSTS _MISSING_HOSTS _HOST

_bootstrap_phase "ruby: gems and pg native extension wiring"

# 7. Ruby gems — AI pipeline, PHI scrubber, DB bridge
#
# Uses the mise-managed Ruby pinned in etc/ruby-version — never the system Ruby
# or any project-activated version. postgresql@18 is keg-only so pg_config is
# not in PATH; we pass it explicitly so the pg native gem compiles cleanly.
_ruby_ver="$(cat "$REPO_ROOT/etc/ruby-version")"
_mise_bundle="$HOME/.local/share/mise/installs/ruby/${_ruby_ver}/bin/bundle"

if [ -x "$_mise_bundle" ]; then
  echo "bootstrap: installing Ruby gems (Ruby ${_ruby_ver})..."
  _brew_prefix="$(brew --prefix 2>/dev/null || printf '/opt/homebrew')"
  _pg_config="${_brew_prefix}/opt/postgresql@18/bin/pg_config"

  BUNDLE_GEMFILE="$REPO_ROOT/Gemfile" \
  BUNDLE_BUILD__PG="${_pg_config:+--with-pg-config=${_pg_config}}" \
    "$_mise_bundle" install \
    || echo "bootstrap: WARNING: bundle install failed — run: zdots-ruby -S bundle install"

  unset _brew_prefix _pg_config
else
  echo "bootstrap: Ruby ${_ruby_ver} not installed via mise — skipping gem install."
  echo "           Run: mise install && zdots-ruby -S bundle install"
fi
unset _ruby_ver _mise_bundle

_bootstrap_phase "local identity and database initialization"

# 8. Machine-local identity file
if [ ! -f "$REPO_ROOT/.zdots.local" ]; then
  echo "bootstrap: creating .zdots.local from template..."
  cp "$REPO_ROOT/.zdots.local.example" "$REPO_ROOT/.zdots.local"
  echo "bootstrap: IMPORTANT: edit .zdots.local and set ZDOTS_CONTEXT (home|work) and any overrides."
fi

# 9. Intelligence suite database
# Requires PostgreSQL running. Uses ZDOTS_MIGRATION_URL (peer auth as OS superuser by default).
if command -v psql >/dev/null 2>&1; then
  echo "bootstrap: initializing intelligence suite database..."
  if "$REPO_ROOT/bin/zdots-ctx" init-db; then
    echo "bootstrap: database ready."
  else
    echo "bootstrap: warning: database setup failed — run 'zdots-ctx init-db' after PostgreSQL is running."
  fi
else
  echo "bootstrap: psql not found — skipping database setup."
  echo "           Install PostgreSQL then run: zdots-ctx init-db"
fi

_bootstrap_phase "pi: self-hosted coding agent configuration"

# 10. Pi coding agent configuration
# Creates or reconciles ~/.pi/agent/settings.json and models.json.
# These wire Pi to the local llamacpp endpoint and disable cloud providers.
_PI_AGENT_DIR="$HOME/.pi/agent"
_pi_bin="$(command -v pi 2>/dev/null || true)"
[ -z "$_pi_bin" ] && _pi_bin="$(ls "$HOME"/.local/share/mise/installs/node/*/bin/pi 2>/dev/null | sort -V | tail -1 || true)"
if [ -n "$_pi_bin" ]; then
  echo "bootstrap: configuring Pi coding agent..."
  mkdir -p "$_PI_AGENT_DIR"
  if [ ! -f "$_PI_AGENT_DIR/settings.json" ]; then
    cat > "$_PI_AGENT_DIR/settings.json" <<'PISETTINGS'
{
  "defaultModel": "local",
  "defaultProvider": "llamacpp",
  "defaultThinkingLevel": "off"
}
PISETTINGS
    echo "bootstrap: created ~/.pi/agent/settings.json (llamacpp default)"
  fi
  _AI_BASE="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}/v1"
  if [ ! -f "$_PI_AGENT_DIR/models.json" ] || ! grep -Fq "\"baseUrl\": \"${_AI_BASE}\"" "$_PI_AGENT_DIR/models.json"; then
    if [ -f "$_PI_AGENT_DIR/models.json" ]; then
      cp "$_PI_AGENT_DIR/models.json" "$_PI_AGENT_DIR/models.json.bak"
      echo "bootstrap: backed up stale ~/.pi/agent/models.json"
    fi
    cat > "$_PI_AGENT_DIR/models.json" <<PIMODELS
{
  "providers": {
    "llamacpp": {
      "api": "openai-completions",
      "apiKey": "local",
      "baseUrl": "${_AI_BASE}",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "supportsUsageInStreaming": false,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "local",
          "name": "Qwen3-8B (llama.cpp)",
          "contextWindow": 32768,
          "maxTokens": 2048,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
PIMODELS
    echo "bootstrap: wrote ~/.pi/agent/models.json (endpoint: ${_AI_BASE})"
  fi
fi
unset _pi_bin _PI_AGENT_DIR _AI_BASE

_bootstrap_phase "github: gh extensions"

# 11. gh extensions
if command -v gh >/dev/null 2>&1; then
  echo "bootstrap: installing gh extensions..."
  gh extension install dlvhdr/gh-dash 2>/dev/null \
    && echo "bootstrap: gh-dash installed." \
    || echo "bootstrap: gh-dash already installed or failed — run: gh extension install dlvhdr/gh-dash"
else
  echo "bootstrap: gh not found — skipping extension install."
fi

echo "bootstrap: complete. Restart your shell or run 'exec zsh'."
