#!/usr/bin/env zsh

set -euo pipefail

REPO_ROOT="${0:A:h:h}"

if [[ ! -f "$REPO_ROOT/Brewfile" ]]; then
  echo "bootstrap: Brewfile not found at $REPO_ROOT/Brewfile" >&2
  exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "bootstrap: Homebrew is required." >&2
  echo "Install with:" >&2
  echo "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"" >&2
  exit 1
fi

mkdir -p \
  "$HOME/.config" \
  "$HOME/.config/git" \
  "$HOME/.cache" \
  "$HOME/.local/state" \
  "$HOME/.local/share"

touch "$HOME/.config/git/config" "$HOME/.config/git/ignore"

if [[ ! -e "$HOME/.gitconfig" ]]; then
  cat > "$HOME/.gitconfig" <<'EOF'
[include]
  path = ~/.config/git/config
EOF
  echo "bootstrap: created $HOME/.gitconfig include -> ~/.config/git/config"
elif ! grep -Fq '.config/git/config' "$HOME/.gitconfig"; then
  {
    echo
    echo "[include]"
    echo "  path = ~/.config/git/config"
  } >> "$HOME/.gitconfig"
  echo "bootstrap: appended include for ~/.config/git/config to $HOME/.gitconfig"
fi

brew bundle --file "$REPO_ROOT/Brewfile"

if [[ ! -e "$HOME/.zshenv" ]]; then
  ln -s "$REPO_ROOT/.zshenv" "$HOME/.zshenv"
  echo "bootstrap: linked $HOME/.zshenv -> $REPO_ROOT/.zshenv"
fi

if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  current_hooks_path="$(git -C "$REPO_ROOT" config --local --get core.hooksPath || true)"
  if [[ "$current_hooks_path" != ".githooks" ]]; then
    git -C "$REPO_ROOT" config --local core.hooksPath .githooks
    echo "bootstrap: configured git core.hooksPath -> .githooks"
  fi
fi

echo "bootstrap: complete"
exec "$SHELL"
