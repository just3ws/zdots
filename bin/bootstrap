#!/usr/bin/env sh
# ---
# id: bootstrap
# title: "Zdots Bootstrap"
# purpose: Single-command system recreation on a new machine.
# rationale: Idempotent setup for XDG dirs, shell symlinks, git config, Homebrew packages, AI stack, and ruby_llm gem.
# ---
# bin/bootstrap — First-time setup. Run via: make bootstrap

set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# 1. Prerequisites
if [ ! -f "$REPO_ROOT/Brewfile" ]; then
  echo "bootstrap: Brewfile not found at $REPO_ROOT/Brewfile" >&2
  exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "bootstrap: Homebrew is required." >&2
  echo "Install with:" >&2
  echo "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"" >&2
  exit 1
fi

# 2. XDG Infrastructure & Security
# Create core XDG structure
echo "bootstrap: initializing XDG infrastructure..."
mkdir -p "$HOME/.config" "$HOME/.cache" "$HOME/.local/state" "$HOME/.local/share"
# Ensure secure permissions (700)
chmod 700 "$HOME/.config" "$HOME/.cache" "$HOME/.local/state" "$HOME/.local/share"

# Create application-specific subdirectories (Prevents home-directory pollution)
mkdir -p \
  "$HOME/.config/git" \
  "$HOME/.config/aws" \
  "$HOME/.config/npm" \
  "$HOME/.config/bundle" \
  "$HOME/.config/python" \
  "$HOME/.local/state/zsh" \
  "$HOME/.local/state/less" \
  "$HOME/.local/state/node" \
  "$HOME/.local/state/psql" \
  "$HOME/.local/share/zsh" \
  "$HOME/.local/share/go" \
  "$HOME/.local/share/gem" \
  "$HOME/.local/share/python" \
  "$HOME/.local/share/pnpm" \
  "$HOME/.local/share/cargo" \
  "$HOME/.local/share/rustup" \
  "$HOME/.local/share/gnupg"

# Initialize required files
touch "$HOME/.config/git/config" "$HOME/.config/git/ignore"

# 3. Shell Entry Points (Symlinks)
echo "bootstrap: linking shell entry points..."
if [ ! -e "$HOME/.zshenv" ]; then ln -s "$REPO_ROOT/.zshenv" "$HOME/.zshenv"; fi
if [ ! -e "$HOME/.bashrc" ]; then ln -s "$REPO_ROOT/bashrc" "$HOME/.bashrc"; fi
if [ ! -e "$HOME/.bash_profile" ]; then ln -s "$REPO_ROOT/bash_profile" "$HOME/.bash_profile"; fi

# Warn about zsh config files in $HOME that load before ZDOTDIR.
# Tools like nvm, conda, and Homebrew installers commonly append to ~/.zshrc
# or ~/.zprofile, silently shadowing zdots config.
for _f in .zshrc .zprofile .zlogin .zlogout; do
  if [ -f "$HOME/$_f" ]; then
    echo "bootstrap: WARNING: $HOME/$_f exists and will be loaded by zsh before ZDOTDIR."
    echo "           Migrate its contents to \$ZDOTDIR/conf.d/ or env.sh, then delete it."
    echo "           Run 'make check' to surface this as a blocking error after migration."
  fi
done
unset _f

# 4. Git Integration
echo "bootstrap: configuring git..."
if [ ! -e "$HOME/.gitconfig" ]; then
  cat > "$HOME/.gitconfig" <<'EOF'
[include]
  path = ~/.config/git/config
EOF
elif ! grep -Fq '.config/git/config' "$HOME/.gitconfig"; then
  {
    echo ""
    echo "[include]"
    echo "  path = ~/.config/git/config"
  } >> "$HOME/.gitconfig"
fi

if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$REPO_ROOT" config --local core.hooksPath .githooks
fi

# 5. Toolchain
echo "bootstrap: installing brew dependencies (this may take a while)..."
brew bundle --file "$REPO_ROOT/Brewfile"

# 6. AI Stack Setup
# Install launchd service + download active profile GGUF.
# llama.cpp is installed via brew bundle above; this registers the plist and fetches the model.
if command -v llama-server >/dev/null 2>&1; then
  if command -v llama-ctl >/dev/null 2>&1; then
    echo "bootstrap: registering llama.cpp launchd service..."
    llama-ctl install || echo "bootstrap: warning: llama-ctl install failed (non-blocking)"
    echo "bootstrap: downloading AI model (profile: ${ZDOTS_AI_PROFILE:-standard}, ~4.7 GB)..."
    llama-ctl model-download || echo "bootstrap: warning: model download failed — run 'llama-ctl model-download' manually"
    echo "bootstrap: re-registering plist with model path..."
    llama-ctl install || true
  fi
else
  echo "bootstrap: llama-server not found — skipping AI setup."
  echo "           Run: llama-ctl install && llama-ctl model-download && llama-ctl install"
fi

# 7. Ruby ecosystem for AI and Platform control plane
if command -v bundle >/dev/null 2>&1 || [ -x "$HOME/.local/share/mise/shims/bundle" ]; then
  _bundle_bin="bundle"
  if ! command -v bundle >/dev/null 2>&1; then _bundle_bin="$HOME/.local/share/mise/shims/bundle"; fi
  echo "bootstrap: installing ruby dependencies via bundler..."
  "$_bundle_bin" install || echo "bootstrap: warning: bundle install failed — run 'bundle install' after mise activates ruby"
else
  echo "bootstrap: bundler not found — skipping bundle install."
fi

# 8. Machine-local identity file
if [ ! -f "$REPO_ROOT/.zdots.local" ]; then
  echo "bootstrap: creating .zdots.local from template..."
  cp "$REPO_ROOT/.zdots.local.example" "$REPO_ROOT/.zdots.local"
  echo "bootstrap: IMPORTANT: edit .zdots.local and set ZDOTS_CONTEXT (home|work) and any overrides."
fi

# 9. Intelligence suite database
# Requires PostgreSQL running. Uses ZDOTS_MIGRATION_URL (peer auth as OS superuser by default).
if command -v psql >/dev/null 2>&1; then
  echo "bootstrap: initializing intelligence suite database..."
  if "$REPO_ROOT/bin/zdots-ctx" init-db; then
    echo "bootstrap: database ready."
  else
    echo "bootstrap: warning: database setup failed — run 'zdots-ctx init-db' after PostgreSQL is running."
  fi
else
  echo "bootstrap: psql not found — skipping database setup."
  echo "           Install PostgreSQL then run: zdots-ctx init-db"
fi

echo "bootstrap: complete. Restart your shell or run 'exec zsh'."
