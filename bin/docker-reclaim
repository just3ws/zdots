#!/usr/bin/env bash
# bin/docker-reclaim — Reclaim disk space from Docker and Colima.
#
# WHY fstrim:
# docker system prune frees blocks INSIDE the Colima VM disk image. Without
# fstrim, the qemu/vz disk image on the macOS host does NOT shrink — the freed
# blocks are just marked available but still occupy host filesystem space.
# fstrim signals the VM to discard those freed blocks, returning them to macOS.
#
# SAFETY:
# Default: dry run. Pass -f to execute. No data loss without the flag.

set -euo pipefail

# SIGPIPE: write failures from broken pipes exit cleanly.
trap '' PIPE

# Colima uses a profile-specific socket, not /var/run/docker.sock.
# Set DOCKER_HOST if not already set and Colima socket is present.
if [[ -z "${DOCKER_HOST:-}" ]]; then
  if [[ -S "${HOME}/.colima/default/docker.sock" ]]; then
    export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"
  elif [[ -S "${HOME}/.colima/docker.sock" ]]; then
    export DOCKER_HOST="unix://${HOME}/.colima/docker.sock"
  fi
fi

usage() {
  cat <<EOF
Usage: docker-reclaim [-f]

  (no flag)   Dry run — show what would be reclaimed (safe)
  -f          Execute — DESTRUCTIVE: prunes containers, images, volumes,
              build cache, then runs fstrim inside the Colima VM.
              Without fstrim, freed VM space does not return to the macOS host.

  -h, --help  Show this help
EOF
}

FORCE=false
case "${1:-}" in
  -f)         FORCE=true ;;
  -h|--help)  usage; exit 0 ;;
  "")         : ;;
  *)          printf 'docker-reclaim: unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac

if [[ "$FORCE" != "true" ]]; then
  printf 'docker-reclaim: dry run — pass -f to execute.\n\n'
  printf 'Current Docker usage:\n'
  docker system df 2>/dev/null || printf '  (docker not reachable)\n'
  printf '\nColima status:\n'
  colima status 2>/dev/null | grep -E 'runtime|disk|cpu|memory' || printf '  (colima not running)\n'
  printf '\nTo reclaim, run:\n'
  printf '  docker-reclaim -f\n'
  exit 0
fi

printf 'docker-reclaim: reclaiming Docker resources...\n' >&2

# 1. Prune containers, networks, dangling images
docker system prune -f

# 2. Prune build cache (often the largest consumer — 7GB+ common)
docker builder prune -af

# 3. Prune all unused images (not just dangling)
docker image prune -af

# 4. Prune unused volumes (data volumes — confirm first if unsure)
docker volume prune -f

printf '\ndocker-reclaim: Docker-level reclaim complete. Current usage:\n' >&2
docker system df

# 5. Colima pruning + TRIM
# colima prune removes unused instances/snapshots.
# fstrim tells the VM to discard freed blocks, which shrinks the
# qcow2/vz disk image on the macOS host filesystem.
if command -v colima >/dev/null 2>&1; then
  printf '\ndocker-reclaim: pruning Colima...\n' >&2
  yes | colima prune 2>/dev/null || true

  printf 'docker-reclaim: running fstrim inside Colima VM...\n' >&2
  printf '  (releases freed blocks from VM disk image back to macOS host)\n' >&2
  colima ssh -- sudo fstrim -av 2>/dev/null || \
    printf '  fstrim failed or not supported — disk image may not shrink on host\n' >&2
fi

printf '\ndocker-reclaim: done.\n' >&2
