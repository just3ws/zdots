#!/usr/bin/env bash
# bin/pi-ctx-query — PHI-safe knowledge-base query for Pi sessions.
#
# Scrubs the query term through phi_scrubber before it reaches zdots-ctx,
# strips zdots-brain diagnostic noise, and caps output at 40 lines (~600 tokens)
# to leave room for Pi's reasoning and file context.
#
# Usage:
#   pi-ctx-query <term> [--semantic]
#
# Options:
#   --semantic   Semantic (vector) search instead of text search
#   --help, -h   Show this help

set -euo pipefail
ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

SEMANTIC=""
TERM=""

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      cat <<'EOF'
Usage: pi-ctx-query <term> [--semantic]

PHI-safe knowledge-base search for Pi sessions. Scrubs the query term,
strips diagnostic noise, and caps output at 40 lines (~600 tokens).

Options:
  --semantic   Vector search (finds related concepts, not just keywords)
  --help, -h   Show this help

Examples:
  pi-ctx-query "phi scrubber"
  pi-ctx-query "database migration" --semantic
EOF
      exit 0
      ;;
    --semantic) SEMANTIC="--semantic" ;;
    -*) printf 'pi-ctx-query: unknown option: %s\n' "$arg" >&2; exit 2 ;;
    *)  TERM="$arg" ;;
  esac
done

if [[ -z "$TERM" ]]; then
  printf 'pi-ctx-query: search term required\n' >&2
  printf 'Usage: pi-ctx-query <term> [--semantic]\n' >&2
  exit 2
fi

# PHI scrub the query term — fail hard if scrubber unavailable or input suppress-flagged
source "${ZDOTDIR}/lib/phi_scrubber.bash"
if phi_should_suppress "$TERM"; then
  printf 'pi-ctx-query: query term matches a suppress pattern — refusing\n' >&2
  exit 1
fi
clean_term=$(printf '%s' "$TERM" | phi_scrub) || {
  printf 'pi-ctx-query: PHI scrubber unavailable — aborting\n' >&2
  exit 1
}

# Strip zdots-brain diagnostics (stderr) and cap stdout to ~600 tokens.
# Emit a clear "no results" line instead of silent empty output.
# shellcheck disable=SC2086
result=$(
  "${ZDOTDIR}/bin/zdots-ctx" query "$clean_term" $SEMANTIC 2>/dev/null \
  | grep -v '^zdots-brain:' \
  | grep -v '^$' \
  | head -40 \
  || true
)

if [[ -z "$result" ]]; then
  printf 'no results for: %s\n' "$clean_term"
  exit 0
fi

printf '%s\n' "$result"
