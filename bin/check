#!/usr/bin/env zsh

set -euo pipefail

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"
SKIP_EXTERNAL="${ZDOTS_CHECK_SKIP_EXTERNAL:-0}"

zsh -n .zshenv .zprofile .zshrc .aliasrc .fzf.zsh conf.d/*.zsh functions/enabled/* bin/*

errfile="$(mktemp)"
zsh -i -c 'exit' >/dev/null 2>"$errfile"
ret=$?
if [[ $ret -ne 0 ]]; then
  echo "DEBUG: ret is $ret, type is ${(t)ret}" >&2
  echo "check: zsh -i -c exit failed with exit code $ret" >&2
  [[ -s "$errfile" ]] && cat "$errfile" >&2
  rm -f "$errfile"
  exit 1
fi
if [[ -s "$errfile" ]]; then
  echo "check: zsh -i -c exit emitted stderr:" >&2
  cat "$errfile" >&2
  rm -f "$errfile"
  exit 1
fi
rm -f "$errfile"

errfile="$(mktemp)"
zsh -l -i -c 'exit' >/dev/null 2>"$errfile"
ret=$?
if [[ $ret -ne 0 ]]; then
  echo "DEBUG: ret-l is $ret, type is ${(t)ret}" >&2
  echo "check: zsh -l -i -c exit failed with exit code $ret" >&2
  [[ -s "$errfile" ]] && cat "$errfile" >&2
  rm -f "$errfile"
  exit 1
fi
if [[ -s "$errfile" ]]; then
  echo "check: zsh -l -i -c exit emitted stderr:" >&2
  cat "$errfile" >&2
  rm -f "$errfile"
  exit 1
fi
rm -f "$errfile"

assert_history_mode() {
  local mode="$1"
  local share_flag="$2"
  local flags

  flags="$(ZDOTS_SHARE_HISTORY="$share_flag" zsh -i -c '
    [[ -o share_history ]] && echo "share:on" || echo "share:off"
    [[ -o inc_append_history_time ]] && echo "inc_append_history_time:on" || echo "inc_append_history_time:off"
  ')"

  if [[ "$share_flag" == "1" ]]; then
    if ! grep -qx 'share:on' <<<"$flags"; then
      echo "check: expected share_history in ${mode} mode" >&2
      exit 1
    fi
    if grep -qx 'inc_append_history_time:on' <<<"$flags"; then
      echo "check: inc_append_history_time must be disabled in ${mode} mode" >&2
      exit 1
    fi
  else
    if grep -qx 'share:on' <<<"$flags"; then
      echo "check: share_history should be disabled in ${mode} mode" >&2
      exit 1
    fi
    if ! grep -qx 'inc_append_history_time:on' <<<"$flags"; then
      echo "check: expected inc_append_history_time in ${mode} mode" >&2
      exit 1
    fi
  fi
}

assert_history_mode "default" 0
assert_history_mode "shared" 1

assert_ctrl_r_policy() {
  local mode="$1"
  shift
  local -a shell_args=("$@")
  local fallback_bindings
  local fzf_bindings

  fallback_bindings="$(ZDOTS_CHECK_SKIP_FZF=1 zsh "${shell_args[@]}" -c '
    bindkey "^R"
    bindkey -M emacs "^R"
    bindkey -M viins "^R"
  ')"
  if [[ "$(grep -c 'history-incremental-search-backward' <<<"$fallback_bindings")" -ne 3 ]]; then
    echo "check: expected ^R fallback bindings in ${mode} mode" >&2
    echo "$fallback_bindings" >&2
    exit 1
  fi

  fzf_bindings="$(zsh "${shell_args[@]}" -c '
    zle -N fzf-history-widget self-insert
    source "$ZDOTDIR/conf.d/70-integrations.zsh"
    echo "R: $(bindkey "^R")"
    echo "R-emacs: $(bindkey -M emacs "^R")"
    echo "R-viins: $(bindkey -M viins "^R")"
    echo "XR: $(bindkey "^X^R")"
  ')"
  if [[ "$(grep -c 'fzf-history-widget' <<<"$fzf_bindings")" -lt 3 ]]; then
    echo "check: expected ^R fzf bindings in ${mode} mode" >&2
    echo "$fzf_bindings" >&2
    exit 1
  fi
  if ! grep -q 'fzf-history-widget-accept' <<<"$fzf_bindings"; then
    echo "check: expected ^X^R fzf binding in ${mode} mode" >&2
    echo "$fzf_bindings" >&2
    exit 1
  fi
}

assert_ctrl_r_policy "interactive" -i
assert_ctrl_r_policy "login+interactive" -l -i

assert_fzf_tab_policy() {
  local mode="$1"
  shift
  local -a shell_args=("$@")
  local widgets_out
  local tab_binding

  widgets_out="$(zsh "${shell_args[@]}" -c '
    zle -l
  ')"

  if ! grep -q 'fzf-tab-complete' <<<"$widgets_out"; then
    echo "check: expected fzf-tab-complete widget in ${mode} mode" >&2
    exit 1
  fi

  tab_binding="$(zsh "${shell_args[@]}" -c '
    bindkey "^I"
  ')"
  if ! grep -q 'expand-or-complete' <<<"$tab_binding"; then
    echo "check: expected ^I to be bound to expand-or-complete in ${mode} mode" >&2
    echo "$tab_binding" >&2
    exit 1
  fi
}

if [[ "$SKIP_EXTERNAL" != "1" ]]; then
  assert_fzf_tab_policy "interactive" -i
  assert_fzf_tab_policy "login+interactive" -l -i
fi

assert_pnpm_path() {
  local mode="$1"
  shift
  local -a shell_args=("$@")
  local pnpm_count

  pnpm_count="$(zsh "${shell_args[@]}" -c '
    typeset -i count=0
    for entry in ${(s/:/)PATH}; do
      [[ "$entry" == "$PNPM_HOME" ]] && (( count++ ))
    done
    echo "$count"
  ')"

  if [[ "$pnpm_count" -ne 1 ]]; then
    echo "check: expected exactly one PNPM_HOME PATH entry in ${mode} mode, got ${pnpm_count}" >&2
    exit 1
  fi
}

assert_pnpm_path "interactive" -i
assert_pnpm_path "login+interactive" -l -i

assert_login_shell_node_path() {
  local actual_node
  local expected_node

  expected_node="$(zsh -l -c 'command -v mise >/dev/null 2>&1 && mise which node' 2>/dev/null || true)"
  if [[ -z "$expected_node" ]]; then
    return 0
  fi

  actual_node="$(zsh -l -c 'command -v node' 2>/dev/null || true)"
  if [[ -z "$actual_node" ]]; then
    echo "check: node missing in login shell while mise provides one" >&2
    echo "check: mise node=$expected_node" >&2
    exit 1
  fi

  if [[ "$actual_node" != "$expected_node" ]]; then
    echo "check: expected login shell node to match mise node" >&2
    echo "check: node=$actual_node" >&2
    echo "check: mise node=$expected_node" >&2
    exit 1
  fi
}

assert_login_shell_node_path

report_startup_timing() {
  local -i runs="${ZDOTS_STARTUP_BENCH_RUNS:-5}"
  local threshold="${ZDOTS_STARTUP_WARN_THRESHOLD_SEC:-0.08}"
  local timings_file
  local median
  local real
  local -i i

  if (( runs < 1 )); then
    echo "check: startup timing skipped (runs < 1)"
    return 0
  fi

  timings_file="$(mktemp)"
  for (( i = 1; i <= runs; i++ )); do
    real="$({ /usr/bin/time -p env ZDOTDIR="$REPO_ROOT" HOME="$HOME" zsh -i -c exit >/dev/null; } 2>&1 | awk '$1=="real"{print $2}')"
    if [[ -z "$real" ]]; then
      echo "check: warning: startup timing run ${i} did not produce a real value" >&2
      rm -f "$timings_file"
      return 0
    fi
    print -r -- "$real" >>"$timings_file"
  done

  median="$(sort -n "$timings_file" | awk '
    { values[NR] = $1 }
    END {
      if (NR == 0) exit 1
      if (NR % 2 == 1) {
        print values[(NR + 1) / 2]
      } else {
        print (values[NR / 2] + values[(NR / 2) + 1]) / 2
      }
    }
  ')"
  rm -f "$timings_file"

  if [[ -z "$median" ]]; then
    echo "check: warning: startup timing median unavailable" >&2
    return 0
  fi

  echo "check: startup median real=${median}s over ${runs} runs (warn>${threshold}s)"
  if awk -v median="$median" -v threshold="$threshold" 'BEGIN { exit (median > threshold) ? 0 : 1 }'; then
    echo "check: warning: startup median exceeds budget threshold (non-blocking)" >&2
  fi
}

if ! zsh -i -c 'command -v mise >/dev/null 2>&1 && mise --version >/dev/null 2>&1'; then
  if [[ "$SKIP_EXTERNAL" == "1" ]]; then
    echo "check: skipping mise dependency check (ZDOTS_CHECK_SKIP_EXTERNAL=1)"
  else
    echo "check: mise failed to initialize in interactive shell" >&2
    exit 1
  fi
fi

compaudit_out="$(zsh -i -c 'autoload -Uz compaudit; compaudit 2>/dev/null' || true)"
if [[ -n "$compaudit_out" ]]; then
  echo "check: insecure completion paths detected by compaudit:" >&2
  print -r -- "$compaudit_out" >&2
  # In CI environments, compaudit often fails due to system-level directory permissions (e.g. /usr/local/share).
  # We make it non-blocking in CI by default unless overridden.
  _zdots_strict_comp="${ZDOTS_CHECK_STRICT_COMPAUDIT:-}"
  if [[ -z "$_zdots_strict_comp" && "$CI" == "true" ]]; then
    _zdots_strict_comp=0
  fi
  if [[ "${_zdots_strict_comp:-1}" == "1" ]]; then
    exit 1
  fi
  unset _zdots_strict_comp
fi

if [[ "$SKIP_EXTERNAL" != "1" ]]; then
  if ! zsh -i -c 'candidates=("$HOMEBREW_PREFIX/opt/powerlevel10k/powerlevel10k.zsh-theme" "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme" "$HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme"); for c in $candidates; do [[ -r "$c" ]] && exit 0; done; exit 1'; then
    echo "check: no Powerlevel10k theme candidate found" >&2
    exit 1
  fi

  if command -v brew >/dev/null 2>&1 && [[ -f "$REPO_ROOT/Brewfile" ]]; then
    HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file "$REPO_ROOT/Brewfile"
  fi
else
  echo "check: skipping external dependency checks (ZDOTS_CHECK_SKIP_EXTERNAL=1)"
fi

if command -v shellcheck >/dev/null 2>&1; then
  shfiles=()
  while IFS= read -r shfile; do
    shfiles+=("$shfile")
  done < <(rg -l '^#![[:space:]]*/usr/bin/env[[:space:]]+(bash|sh)$' -- bin functions/enabled conf.d 2>/dev/null || true)

  if (( ${#shfiles[@]} > 0 )); then
    shellcheck -x "${shfiles[@]}"
  else
    echo "check: shellcheck available, no bash/sh scripts detected; skipping shellcheck pass"
  fi
fi

if [[ -f "$HOME/.zshenv" && "${ZDOTS_CHECK_VERIFY_BOOTSTRAP:-1}" == "1" ]]; then
  if ! grep -Eq '(^|[[:space:]])ZDOTDIR=.*\.config/zsh|Bootstrap Zdots' "$HOME/.zshenv"; then
    echo "check: warning: ~/.zshenv may not be using zdots bootstrap/source-of-truth" >&2
  fi
fi

if [[ "${ZDOTS_CHECK_REPORT_STARTUP:-0}" == "1" ]]; then
  report_startup_timing
fi

echo "check: OK"
