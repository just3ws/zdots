#!/usr/bin/env zsh
# ---
# id: check
# title: "Zdots Shell Integrity Check"
# purpose: Validate shell syntax, loading behavior, keybindings, safe mode, and run the bats test suite.
# rationale: CI-safe health gate for the zsh config layer; complements zdots-ctl check (platform services).
# ---
# bin/check — Shell integrity validator. Run via: make check / make check-fast

set -eu
setopt pipefail
setopt nonomatch

# Strip ANSI/OSC escape sequences from captured shell output.
# iTerm2 shell integration injects OSC 1337 sequences that pollute
# output captured via `zsh -i -c '...'`.
_strip_escapes() {
  sed $'s/\x1b\][^\x07]*\x07//g; s/\x1b\\[[0-9;]*[a-zA-Z]//g'
}

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"
# In some CI environments, ZDOTDIR might already be set or workspace might be nested.
# If current directory already ends with .config/zsh, use it directly.
if [[ "$PWD" == */.config/zsh ]]; then
  export ZDOTDIR="$PWD"
else
  export ZDOTDIR="${ZDOTDIR:-$REPO_ROOT}"
fi
SKIP_EXTERNAL="${ZDOTS_CHECK_SKIP_EXTERNAL:-0}"

for f in .zshenv .zprofile .zshrc .aliasrc .fzf.zsh conf.d/*.zsh functions/enabled/*; do
  if [[ -f "$f" ]]; then
    if ! zsh -n "$f" 2>/dev/null; then
      echo "check: syntax error in $f" >&2
      zsh -n "$f"
      exit 1
    fi
  fi
done

# bin/*: dispatch by shebang rather than assuming zsh for everything.
for f in bin/*; do
  [[ -f "$f" ]] || continue
  shebang="$(head -1 "$f" 2>/dev/null)"
  case "$shebang" in
    '#!/usr/bin/env zsh'|'#!/bin/zsh')
      if ! zsh -n "$f" 2>/dev/null; then
        echo "check: syntax error in $f" >&2
        zsh -n "$f"
        exit 1
      fi ;;
    '#!/usr/bin/env bash'|'#!/bin/bash'|'#!/usr/bin/env sh'|'#!/bin/sh')
      # shellcheck handles these below; skip zsh -n
      : ;;
    '#!/usr/bin/env ruby'|'#!/usr/bin/ruby')
      if command -v ruby >/dev/null 2>&1; then
        if ! ruby -c "$f" >/dev/null 2>&1; then
          echo "check: syntax error in $f" >&2
          ruby -c "$f"
          exit 1
        fi
      fi ;;
  esac
done

errfile="$(mktemp)"
set +e
zsh -i -c 'exit' >/dev/null 2>"$errfile"
ret=$?
set -e
if [[ $ret -ne 0 ]]; then
  echo "check: zsh -i -c exit failed with exit code $ret" >&2
  cat "$errfile" >&2
  rm -f "$errfile"
  exit 1
fi
if [[ -s "$errfile" ]]; then
  # Filter out known non-critical errors
  if grep -vE "can't change option: zle" "$errfile" | grep -q .; then
    echo "check: zsh -i -c exit emitted stderr:" >&2
    cat "$errfile" >&2
    rm -f "$errfile"
    exit 1
  fi
fi
rm -f "$errfile"

errfile="$(mktemp)"
set +e
zsh -l -i -c 'exit' >/dev/null 2>"$errfile"
ret=$?
set -e
if [[ $ret -ne 0 ]]; then
  echo "check: zsh -l -i -c exit failed with exit code $ret" >&2
  [[ -s "$errfile" ]] && cat "$errfile" >&2
  rm -f "$errfile"
  exit 1
fi
if [[ -s "$errfile" ]]; then
  # Filter out known non-critical errors
  if grep -vE "can't change option: zle" "$errfile" | grep -q .; then
    echo "check: zsh -l -i -c exit emitted stderr:" >&2
    cat "$errfile" >&2
    rm -f "$errfile"
    exit 1
  fi
fi
rm -f "$errfile"

assert_history_mode() {
  local mode="$1"
  local share_flag="$2"
  local flags

  flags="$(ZDOTS_CHECK_ZLE=1 ZDOTS_SHARE_HISTORY="$share_flag" zsh -i -c '
    [[ -o share_history ]] && echo "share:on" || echo "share:off"
    [[ -o inc_append_history_time ]] && echo "inc_append_history_time:on" || echo "inc_append_history_time:off"
  ' | _strip_escapes)"

  if [[ "$share_flag" == "1" ]]; then
    if ! grep -qx 'share:on' <<<"$flags"; then
      echo "check: expected share_history in ${mode} mode" >&2
      exit 1
    fi
    if grep -qx 'inc_append_history_time:on' <<<"$flags"; then
      echo "check: inc_append_history_time must be disabled in ${mode} mode" >&2
      exit 1
    fi
  else
    if grep -qx 'share:on' <<<"$flags"; then
      echo "check: share_history should be disabled in ${mode} mode" >&2
      exit 1
    fi
    if ! grep -qx 'inc_append_history_time:on' <<<"$flags"; then
      echo "check: expected inc_append_history_time in ${mode} mode" >&2
      exit 1
    fi
  fi
}

assert_history_mode "default" 0
assert_history_mode "shared" 1

assert_ctrl_r_policy() {
  local mode="$1"
  shift
  local -a shell_args=("$@")
  local fallback_bindings
  local fzf_bindings

  fallback_bindings="$(ZDOTS_CHECK_SKIP_FZF=1 zsh "${shell_args[@]}" -c '
    bindkey "^R"
    bindkey -M emacs "^R"
    bindkey -M viins "^R"
  ' | _strip_escapes)"
  if [[ "$(grep -c 'history-incremental-search-backward' <<<"$fallback_bindings")" -ne 3 ]]; then
    echo "check: expected ^R fallback bindings in ${mode} mode" >&2
    echo "$fallback_bindings" >&2
    exit 1
  fi

  fzf_bindings="$(ZDOTS_CHECK_ZLE=1 zsh "${shell_args[@]}" -c '
    zle -N fzf-history-widget self-insert
    source "$ZDOTDIR/conf.d/70-integrations.zsh"
    echo "R: $(bindkey "^R")"
    echo "R-emacs: $(bindkey -M emacs "^R")"
    echo "R-viins: $(bindkey -M viins "^R")"
    echo "XR: $(bindkey "^X^R")"
  ' | _strip_escapes)"
  if [[ "$(grep -c 'fzf-history-widget' <<<"$fzf_bindings")" -lt 3 ]]; then
    echo "check: expected ^R fzf bindings in ${mode} mode" >&2
    echo "$fzf_bindings" >&2
    if [[ "$CI" == "true" ]]; then
      echo "check: warning: ZLE widgets may not initialize in CI subshells (non-blocking)" >&2
      return 0
    fi
    exit 1
  fi
  if ! grep -q 'fzf-history-widget-accept' <<<"$fzf_bindings"; then
    echo "check: expected ^X^R fzf binding in ${mode} mode" >&2
    echo "$fzf_bindings" >&2
    if [[ "$CI" == "true" ]]; then
      echo "check: warning: ZLE widgets may not initialize in CI subshells (non-blocking)" >&2
      return 0
    fi
    exit 1
  fi
}

assert_ctrl_r_policy "interactive" -i
assert_ctrl_r_policy "login+interactive" -l -i

assert_fzf_tab_policy() {
  local mode="$1"
  shift
  local -a shell_args=("$@")
  local widgets_out
  local tab_binding

  widgets_out="$(ZDOTS_CHECK_ZLE=1 zsh "${shell_args[@]}" -c '
    zle -l
  ' | _strip_escapes)"

  if ! grep -q 'fzf-tab-complete' <<<"$widgets_out"; then
    echo "check: expected fzf-tab-complete widget in ${mode} mode" >&2
    if [[ "$CI" == "true" ]]; then
      echo "check: warning: ZLE widgets may not initialize in CI subshells (non-blocking)" >&2
      return 0
    fi
    exit 1
  fi

  tab_binding="$(zsh "${shell_args[@]}" -c '
    bindkey "^I"
  ' | _strip_escapes)"
  if ! grep -q 'expand-or-complete' <<<"$tab_binding"; then
    echo "check: expected ^I to be bound to expand-or-complete in ${mode} mode" >&2
    echo "$tab_binding" >&2
    exit 1
  fi
}

if [[ "$SKIP_EXTERNAL" != "1" ]]; then
  assert_fzf_tab_policy "interactive" -i
  assert_fzf_tab_policy "login+interactive" -l -i
fi

assert_pnpm_path() {
  local mode="$1"
  shift
  local -a shell_args=("$@")
  local pnpm_count

  pnpm_count="$(zsh "${shell_args[@]}" -c '
    typeset -i count=0
    for entry in ${(s/:/)PATH}; do
      [[ "$entry" == "$PNPM_HOME" ]] && (( count++ ))
    done
    echo "$count"
  ' | _strip_escapes)"

  if [[ "$pnpm_count" -gt 1 ]]; then
    echo "check: expected at most one PNPM_HOME PATH entry in ${mode} mode, got ${pnpm_count}" >&2
    exit 1
  fi
}

if [[ "$SKIP_EXTERNAL" != "1" ]]; then
  assert_pnpm_path "interactive" -i
  assert_pnpm_path "login+interactive" -l -i
fi

assert_safe_mode() {
  local errfile
  errfile="$(mktemp)"
  set +e
  ZDOTS_SAFE_MODE=1 zsh -i -c 'exit' >/dev/null 2>"$errfile"
  local ret=$?
  set -e
  if [[ $ret -ne 0 ]]; then
    echo "check: safe mode shell failed with exit code $ret" >&2
    cat "$errfile" >&2
    rm -f "$errfile"
    exit 1
  fi
  # Filter known non-critical output and verify diagnostic message appeared
  if [[ -s "$errfile" ]]; then
    local stripped_stderr
    stripped_stderr="$(_strip_escapes <"$errfile")"
    if grep -vE "can't change option: zle|zdots: SAFE MODE" <<<"$stripped_stderr" | grep -q .; then
      echo "check: safe mode shell emitted unexpected stderr:" >&2
      cat "$errfile" >&2
      rm -f "$errfile"
      exit 1
    fi
    if ! grep -q 'SAFE MODE' <<<"$stripped_stderr"; then
      echo "check: safe mode did not emit diagnostic message" >&2
      rm -f "$errfile"
      exit 1
    fi
  else
    echo "check: safe mode did not emit diagnostic message (empty stderr)" >&2
    rm -f "$errfile"
    exit 1
  fi
  rm -f "$errfile"

  # Verify essential modules loaded (check for observability trace ID)
  local trace_check
  trace_check="$(ZDOTS_SAFE_MODE=1 zsh -i -c 'echo "TRACE:${ZDOTS_TRACE_ID:-missing}"' 2>/dev/null | _strip_escapes)"
  if ! grep -q 'TRACE:' <<<"$trace_check" || grep -q 'TRACE:missing' <<<"$trace_check"; then
    echo "check: safe mode shell missing trace ID (essential modules not loaded)" >&2
    exit 1
  fi
}

assert_safe_mode

assert_zle_guard() {
  local errfile
  errfile="$(mktemp)"
  set +e
  zsh -c 'source "$ZDOTDIR/.zshrc"' >/dev/null 2>"$errfile"
  local ret=$?
  set -e
  # Non-interactive sourcing may fail (expected) — we care about ZLE errors specifically.
  # NOTE: This catches explicit ZLE option/builtin errors but not bindkey calls,
  # which silently succeed in non-ZLE contexts. Bindkey guards are enforced by convention.
  local stripped
  stripped="$(_strip_escapes <"$errfile")"
  if grep -qi "can't change option: zle\|zle: not available" <<<"$stripped"; then
    echo "check: ZLE widget errors in non-ZLE context (guards insufficient):" >&2
    cat "$errfile" >&2
    rm -f "$errfile"
    exit 1
  fi
  rm -f "$errfile"
}

assert_zle_guard

assert_provider_timeout() {
  # Skip if no timeout command available (test would be meaningless)
  if ! command -v timeout >/dev/null 2>&1 && ! command -v gtimeout >/dev/null 2>&1; then
    echo "check: skipping provider timeout test (no timeout command available)"
    return 0
  fi

  # Create a temporary provider that sleeps for 10 seconds
  local tmp_provider
  tmp_provider="$(mktemp)"
  cat > "$tmp_provider" <<'PROVIDER'
#!/bin/sh
sleep 10
echo "should_not_reach"
PROVIDER
  chmod +x "$tmp_provider"

  # Source env.sh to get zdots_cmd_timeout, then test it
  local output
  set +e
  output="$(ZDOTS_PROVIDER_TIMEOUT=1 zsh -c '
    source "'"$ZDOTDIR"'/env.sh"
    zdots_cmd_timeout "'"$tmp_provider"'"
    echo "exit:$?"
  ' 2>/dev/null)"
  local ret=$?
  set -e
  rm -f "$tmp_provider"

  # The timeout should have fired (exit code 124 from timeout command)
  if grep -q 'should_not_reach' <<<"$output"; then
    echo "check: provider timeout did not fire — slow command ran to completion" >&2
    exit 1
  fi
  if ! grep -q 'exit:124' <<<"$output"; then
    echo "check: provider timeout exit code unexpected (expected 124):" >&2
    echo "$output" >&2
    # Non-blocking: timeout behavior varies by implementation
    echo "check: warning: timeout exit code mismatch (non-blocking)" >&2
  fi
}

assert_provider_timeout

assert_otel_collector() {
  if [[ "$SKIP_EXTERNAL" == "1" ]]; then
    return 0
  fi

  if ! "$ZDOTDIR/bin/otel-collector" status >/dev/null 2>&1; then
    echo "check: OTel collector is not running" >&2
    exit 1
  fi
}

assert_otel_collector

assert_login_shell_node_path() {
  local actual_node
  local expected_node

  # Only check node if mise is actually available and provides a node version
  expected_node="$(zsh -l -c 'command -v mise >/dev/null 2>&1 && mise which node' 2>/dev/null || true)"
  if [[ -z "$expected_node" ]]; then
    # mise not available or doesn't provide node; skip this check
    return 0
  fi

  actual_node="$(zsh -l -c 'command -v node' 2>/dev/null || true)"
  if [[ -z "$actual_node" ]]; then
    echo "check: node missing in login shell while mise provides one" >&2
    echo "check: mise node=$expected_node" >&2
    exit 1
  fi

  if [[ "$actual_node" != "$expected_node" ]]; then
    # If it's a mise shim, it's also acceptable
    if [[ "$actual_node" == *"/.local/share/mise/shims/node" ]]; then
      return 0
    fi
    echo "check: expected login shell node to match mise node" >&2
    echo "check: node=$actual_node" >&2
    echo "check: mise node=$expected_node" >&2
    exit 1
  fi
}

# Only check node path in local development environments
# Skip in CI/minimal environments without mise or when SKIP_EXTERNAL is set
if [[ "$SKIP_EXTERNAL" != "1" && -x "$(command -v mise 2>/dev/null || true)" ]]; then
  assert_login_shell_node_path
fi

report_startup_timing() {
  local -i runs="${ZDOTS_STARTUP_BENCH_RUNS:-5}"
  local threshold="${ZDOTS_STARTUP_WARN_THRESHOLD_SEC:-0.08}"
  local timings_file
  local median
  local real
  local -i i

  if (( runs < 1 )); then
    echo "check: startup timing skipped (runs < 1)"
    return 0
  fi
  if ! command -v /usr/bin/time >/dev/null 2>&1; then
    echo "check: startup timing skipped (/usr/bin/time not found)" >&2
    return 0
  fi

  timings_file="$(mktemp)"
  for (( i = 1; i <= runs; i++ )); do
    real="$({ /usr/bin/time -p env ZDOTDIR="$REPO_ROOT" HOME="$HOME" zsh -i -c exit >/dev/null; } 2>&1 | awk '$1=="real"{print $2}')"
    if [[ -z "$real" ]]; then
      echo "check: warning: startup timing run ${i} did not produce a real value" >&2
      rm -f "$timings_file"
      return 0
    fi
    print -r -- "$real" >>"$timings_file"
  done

  median="$(sort -n "$timings_file" | awk '
    { values[NR] = $1 }
    END {
      if (NR == 0) exit 1
      if (NR % 2 == 1) {
        print values[(NR + 1) / 2]
      } else {
        print (values[NR / 2] + values[(NR / 2) + 1]) / 2
      }
    }
  ')"
  rm -f "$timings_file"

  if [[ -z "$median" ]]; then
    echo "check: warning: startup timing median unavailable" >&2
    return 0
  fi

  echo "check: startup median real=${median}s over ${runs} runs (warn>${threshold}s)"
  if awk -v median="$median" -v threshold="$threshold" 'BEGIN { exit (median > threshold) ? 0 : 1 }'; then
    echo "check: warning: startup median exceeds budget threshold (non-blocking)" >&2
  fi
}

if ! zsh -i -c 'command -v mise >/dev/null 2>&1 && mise --version >/dev/null 2>&1'; then
  if [[ "$SKIP_EXTERNAL" == "1" ]]; then
    echo "check: skipping mise dependency check (ZDOTS_CHECK_SKIP_EXTERNAL=1)"
  else
    echo "check: mise failed to initialize in interactive shell" >&2
    exit 1
  fi
fi

compaudit_out="$(zsh -i -c 'autoload -Uz compaudit; compaudit 2>/dev/null' | _strip_escapes || true)"
if [[ -n "$compaudit_out" ]]; then
  echo "check: insecure completion paths detected by compaudit:" >&2
  print -r -- "$compaudit_out" >&2
  # In CI environments, compaudit often fails due to system-level directory permissions (e.g. /usr/local/share).
  # We make it non-blocking in CI by default unless overridden.
  _zdots_strict_comp="${ZDOTS_CHECK_STRICT_COMPAUDIT:-}"
  if [[ -z "$_zdots_strict_comp" && "$CI" == "true" ]]; then
    _zdots_strict_comp=0
  fi
  if [[ "${_zdots_strict_comp:-1}" == "1" ]]; then
    exit 1
  fi
  unset _zdots_strict_comp
fi

if [[ "$SKIP_EXTERNAL" != "1" ]]; then
  if ! zsh -i -c 'candidates=("$HOMEBREW_PREFIX/opt/powerlevel10k/powerlevel10k.zsh-theme" "$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme" "$HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme"); for c in $candidates; do [[ -r "$c" ]] && exit 0; done; exit 1'; then
    echo "check: no Powerlevel10k theme candidate found" >&2
    exit 1
  fi

  case "${ZDOTS_CONTEXT:-home}" in
    work) _zdots_brewfile="$REPO_ROOT/Brewfile.work" ;;
    *)    _zdots_brewfile="$REPO_ROOT/Brewfile.home" ;;
  esac
  if command -v brew >/dev/null 2>&1 && [[ -f "$_zdots_brewfile" ]]; then
    if ! HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file "$_zdots_brewfile"; then
      echo "check: warning: brew bundle check failed (non-blocking)" >&2
      if [[ "${ZDOTS_CHECK_STRICT_BREW:-0}" == "1" ]]; then
        exit 1
      fi
    fi
  fi
  unset _zdots_brewfile
  
  if command -v bats >/dev/null 2>&1; then
    echo "check: running Bats tests..."
    bats tests/
  else
    echo "check: warning: bats not found — skipping Bats tests (install via: brew install bats-core)" >&2
  fi
else
  echo "check: skipping external dependency checks (ZDOTS_CHECK_SKIP_EXTERNAL=1)"
fi

if command -v shellcheck >/dev/null 2>&1; then
  shfiles=()
  while IFS= read -r shfile; do
    shfiles+=("$shfile")
  done < <(rg -l '^#![[:space:]]*/usr/bin/env[[:space:]]+(bash|sh)$' -- bin functions/enabled conf.d 2>/dev/null || true)

  if (( ${#shfiles[@]} > 0 )); then
    shellcheck -x --severity=warning "${shfiles[@]}"
  else
    echo "check: shellcheck available, no bash/sh scripts detected; skipping shellcheck pass"
  fi
fi

if [[ -f "$HOME/.zshenv" && "${ZDOTS_CHECK_VERIFY_BOOTSTRAP:-1}" == "1" ]]; then
  if ! grep -Eq '(^|[[:space:]])ZDOTDIR=.*\.config/zsh|Bootstrap Zdots' "$HOME/.zshenv"; then
    echo "check: warning: ~/.zshenv may not be using zdots bootstrap/source-of-truth" >&2
  fi
fi

assert_no_home_zsh_configs() {
  local -a errant=()
  for f in .zshrc .zprofile .zlogin .zlogout; do
    [[ -f "$HOME/$f" ]] && errant+=("$HOME/$f")
  done
  if (( ${#errant[@]} > 0 )); then
    echo "check: errant zsh config files in \$HOME (loaded by zsh before ZDOTDIR):" >&2
    printf '  %s\n' "${errant[@]}" >&2
    echo "  These shadow zdots config. Migrate contents to \$ZDOTDIR/conf.d/ or env.sh, then delete." >&2
    if [[ "${ZDOTS_CHECK_STRICT_HOME:-0}" == "1" ]]; then
      exit 1
    fi
  fi
}
assert_no_home_zsh_configs

if [[ "${ZDOTS_CHECK_REPORT_STARTUP:-0}" == "1" ]]; then
  report_startup_timing
fi

echo "check: OK"
