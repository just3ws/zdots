#!/usr/bin/env bash
# ---
# id: commit-msg
# title: "AI Commit Message Generator"
# purpose: Generate a conventional commit message from staged changes.
# rationale: Pipes git diff --staged through RTK compression then ai-query;
#            produces a ready-to-use commit message without opening an editor.
# ---
# bin/commit-msg — Draft a conventional commit message from the staged diff.
#
# Usage:
#   commit-msg            # print message to stdout
#   commit-msg --copy     # also copy to clipboard (pbcopy)
#   commit-msg --commit   # run git commit -m "<message>" immediately
#   commit-msg --help

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
AI_QUERY="${ZDOTDIR}/bin/ai-query"

usage() {
  cat <<EOF
Usage: commit-msg [--copy] [--commit] [--help]

Drafts a conventional commit message from the current staged diff.

Options:
  --copy    Copy the generated message to the clipboard (pbcopy)
  --commit  Run: git commit -m "<generated message>"
  --help    Show this message

The diff is compressed with rtk before inference if rtk is available.
EOF
}

OPT_COPY=false
OPT_COMMIT=false

for arg in "$@"; do
  case "$arg" in
    --copy)   OPT_COPY=true ;;
    --commit) OPT_COMMIT=true ;;
    --help)   usage; exit 0 ;;
    *) printf 'commit-msg: unknown option: %s\n' "$arg" >&2; usage >&2; exit 1 ;;
  esac
done

# Require ai-query
if [[ ! -x "$AI_QUERY" ]]; then
  printf 'commit-msg: ai-query not found at %s\n' "$AI_QUERY" >&2
  exit 1
fi

# Pre-flight: llama.cpp health
if ! curl -sf -m 2 "${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:8080}/health" >/dev/null 2>&1; then
  printf 'commit-msg: llama.cpp is not running. Start with: llama-ctl start\n' >&2
  exit 1
fi

# Capture staged diff
DIFF=$(git diff --staged 2>/dev/null)

if [[ -z "$DIFF" ]]; then
  printf 'commit-msg: nothing staged. Use git add first.\n' >&2
  exit 1
fi

PROMPT="Write a conventional commit message for this diff.
Rules:
- Format: type(scope): short description  (≤72 chars, lowercase)
- Types: feat / fix / docs / refactor / test / chore / perf / style
- Scope: the main file, module, or component changed (omit if unclear)
- Body: 1-3 bullet lines starting with - if the change needs explanation, otherwise omit
- No backticks, no markdown headers, no trailing period on subject line
- Output ONLY the commit message, nothing else"

# Compress diff with rtk if available, then infer
if command -v rtk >/dev/null 2>&1; then
  MSG=$(printf '%s' "$DIFF" | rtk | "$AI_QUERY" --mode safe-extract "$PROMPT")
else
  MSG=$(printf '%s' "$DIFF" | "$AI_QUERY" --mode safe-extract "$PROMPT")
fi

# Trim leading/trailing whitespace
MSG=$(printf '%s' "$MSG" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

printf '%s\n' "$MSG"

if $OPT_COPY; then
  printf '%s' "$MSG" | pbcopy
  printf '\n(copied to clipboard)\n' >&2
fi

if $OPT_COMMIT; then
  git commit -m "$MSG"
fi
