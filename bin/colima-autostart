#!/usr/bin/env bash
# bin/colima-autostart — Start Colima and dependent services at login.
# Managed by launchd: com.zdots.colima-autostart

set -eu

# Ensure Homebrew and common paths are available (for launchd)
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/colima-autostart.log"
mkdir -p "$(dirname "$LOG")"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >> "$LOG"; }

log "colima-autostart: begin"

# 1. Start Colima if not already running
if colima status >/dev/null 2>&1; then
  log "Colima already running"
else
  log "Starting Colima..."
  # Kubernetes-by-default for local diagnostics work (Colima bundles k3s, a real
  # CNCF-conformant distro → prod-parity + kubectl idioms). Toggle off with
  # ZDOTS_COLIMA_KUBERNETES=0 in .zdots.local. IMPORTANT: --kubernetes runs k3s
  # ALONGSIDE the docker runtime — the Docker socket stays available, so the
  # compose / work-* workflow and the OTel observability harness are NOT stranded.
  # Resource defaults are k8s-tuned (tenant app + MariaDB/Mongo/memcached + k3s); tune
  # in .zdots.local to host capacity. Decoupled from ZDOTS_CI_* (CI has its own).
  _k8s_args=()
  [ "${ZDOTS_COLIMA_KUBERNETES:-1}" = "1" ] && _k8s_args+=(--kubernetes)
  colima start \
    --cpu "${ZDOTS_COLIMA_CPU:-4}" \
    --memory "${ZDOTS_COLIMA_MEMORY:-8}" \
    --disk "${ZDOTS_COLIMA_DISK:-60}" \
    "${_k8s_args[@]}" 2>>"$LOG" || {
    log "ERROR: colima start failed (exit $?)"
    exit 1
  }
  unset _k8s_args
  log "Colima started (kubernetes=${ZDOTS_COLIMA_KUBERNETES:-1}, cpu=${ZDOTS_COLIMA_CPU:-4}, mem=${ZDOTS_COLIMA_MEMORY:-8})"
fi

# 2. Wait for Docker socket to be ready (up to 30s).
# ~/.colima is canonical — colima ignores XDG_CONFIG_HOME whenever it exists
# (decided 2026-07-04, see Z-195/Z-181; not worth fighting upstream).
_sock="${HOME}/.colima/default/docker.sock"
socket=""
i=0
while [ "$i" -lt 30 ]; do
  if [ -S "$_sock" ]; then
    socket="$_sock"
    break
  fi
  sleep 1
  i=$((i + 1))
done
unset _sock
if [ -z "$socket" ]; then
  log "ERROR: Docker socket not available after 30s at ${HOME}/.colima/default/docker.sock"
  exit 1
fi
log "Docker socket ready: ${socket}"

# Observability is no longer a container workload — OpenObserve runs as a native
# launchd service (com.zdots.openobserve). Colima is started here only for other
# container workloads (e.g. the Rails app on a work box). See docs/openobserve.md.

log "colima-autostart: done"
