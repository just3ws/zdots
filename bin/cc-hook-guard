#!/usr/bin/env bash
# bin/cc-hook-guard — Claude Code PreToolUse guard for Bash commands.
#
# Backstop for the things the shell's own guards can't catch when Claude
# Code runs commands directly (it bypasses shell functions like safe-rm):
#   1. `brew services ... nginx` — takes root ownership of Homebrew files and
#      poisons the install. nginx must be driven via launchctl. (Known footgun.)
#   2. Catastrophic `rm -rf` against a home/root target.
#   3. `git push` on a WORK machine — work CC fixes forward (commits allowed),
#      but the principal alone pushes to the zdots repo. Commit is NOT blocked.
#
# Contract: reads the PreToolUse hook JSON on stdin. Exit 2 blocks the tool
# call and feeds stderr back to Claude as the reason. Exit 0 allows it. Any
# other failure mode is treated as "allow" (fail-open) so a broken guard never
# wedges the session — the deny-list in .claude/settings.json is the belt to
# this hook's suspenders.
#
# See ROUTER.md / CLAUDE.md for the broader AI boundary model.

set -u

# Read the command out of the hook payload. jq is in both Brewfiles; if it is
# somehow absent, fail open rather than block every command.
if ! command -v jq >/dev/null 2>&1; then
  exit 0
fi

cmd="$(jq -r '.tool_input.command // ""' 2>/dev/null)" || exit 0
[[ -z "$cmd" ]] && exit 0

_block() {
  printf 'cc-hook-guard: BLOCKED — %s\n' "$1" >&2
  exit 2
}

# Command-position anchor: start of string, or right after a shell separator
# (; | & newline) or a command-substitution opener, optionally followed by
# `sudo`. Anchoring here avoids false positives when the same words appear
# inside a quoted string, a commit message, or an `echo` argument.
_boundary='(^|[;&|`(]|&&|\|\|)[[:space:]]*(sudo[[:space:]]+)?'

# 0. WORK MACHINE: no pushes. Work CC may commit (fix-forward, focused changes),
#    but the principal is solely responsible for pushing to the zdots repo.
_ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
[[ -r "${_ZDOTDIR}/lib/cc-context.bash" ]] && source "${_ZDOTDIR}/lib/cc-context.bash"
if typeset -f cc_is_work >/dev/null 2>&1 && cc_is_work; then
  if printf '%s' "$cmd" | grep -Eq "${_boundary}git\b[^|;&]*[[:space:]]push\b"; then
    _block "work machine: git push disabled — Claude Code fixes forward here (commit is fine); the principal pushes to the zdots repo from a normal terminal"
  fi
fi

# 1. nginx via brew services — never (only as an actual invocation).
if printf '%s' "$cmd" | grep -Eq "${_boundary}brew[[:space:]]+services\b" \
   && printf '%s' "$cmd" | grep -Eq '\bnginx\b'; then
  _block "use launchctl for nginx, not 'brew services' (it root-owns Homebrew files)"
fi

# 2. Catastrophic recursive force-remove against a home/root target.
if printf '%s' "$cmd" | grep -Eq "${_boundary}rm\b" \
   && printf '%s' "$cmd" | grep -Eq -e '-[A-Za-z]*r[A-Za-z]*f' -e '-[A-Za-z]*f[A-Za-z]*r' \
   && printf '%s' "$cmd" | grep -Eq 'rm[^|;&]*[[:space:]](/|~|\$HOME|/\*|/Users/[^/ ]+)([[:space:]]|$|/\*)'; then
  _block "refusing 'rm -rf' against a home/root target — remove specific paths instead"
fi

exit 0
