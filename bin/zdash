#!/usr/bin/env zsh
# bin/zdash — Interactive workflow launcher.
#
# fzf-powered task picker wired to the full Pi↔Aider↔ztask cycle.
# One command to orient, select, and launch.
#
# Keybindings:
#   enter      ztask start — activate task environment
#   ctrl-p     zpi   — explore/plan with Pi (read-only)
#   ctrl-a     zaider — implement with Aider (write/commit)
#   ctrl-s     zdots-status — full platform health TUI
#   ctrl-d     ztask done — complete the active task
#   ctrl-r     refresh task list
#   ?          toggle preview pane
#   esc / q    quit
#
# Internal subcommands (called by fzf, not for direct use):
#   zdash --list           print task list for fzf input
#   zdash --preview ID     print formatted task file for fzf preview

setopt NO_UNSET

export ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
export TASKS_DIR="${ZDOTDIR}/backlog/tasks"
ACTIVE_TASK_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/active_task"

# ── Color helpers ─────────────────────────────────────────────────────────────
_c()  { printf '\033[%sm' "$1"; }
RST=$(_c 0); BOLD=$(_c 1); DIM=$(_c 2)
RED=$(_c '0;31'); YEL=$(_c '0;33'); GRN=$(_c '0;32'); CYN=$(_c '0;36')

# ── Task list (also: zdash --list) ───────────────────────────────────────────
# Tab-separated: ICON  ID  PRIORITY  TITLE
# Reads task frontmatter directly — stable contract vs. backlog CLI text output.
_cmd_list() {
  local active_id=""
  if [[ -f "$ACTIVE_TASK_FILE" ]]; then
    local _at; _at=$(< "$ACTIVE_TASK_FILE")
    active_id="${_at:l}"
  fi

  local -a _task_files
  _task_files=( "${TASKS_DIR}"/z-*.md(N) )
  [[ ${#_task_files[@]} -eq 0 ]] && return

  local id title status priority pri_col pri_abbr icon icol
  while IFS=$'\t' read -r id title status priority; do
    [[ -z "$id" ]] && continue
    [[ "${status:l}" == "done" ]] && continue

    case "${(U)priority}" in
      HIGH)   pri_col="$RED"; pri_abbr="HIGH" ;;
      MEDIUM) pri_col="$YEL"; pri_abbr="MED " ;;
      LOW)    pri_col="$DIM"; pri_abbr="LOW " ;;
      *)      pri_col="$RST"; pri_abbr="    " ;;
    esac

    if   [[ "${id:l}" == "$active_id" ]];          then icon="★"; icol="$GRN"
    elif [[ "${status:l}" == "in progress" ]];      then icon="◒"; icol="$CYN"
    else                                                 icon="○"; icol="$DIM"
    fi

    printf '%s%s%s\t%s\t%s%s%s\t%s\n' \
      "$icol" "$icon" "$RST" \
      "$id" \
      "$pri_col" "$pri_abbr" "$RST" \
      "$title"
  done < <(
    awk '
      FNR==1 { in_front=0; id=""; title=""; status=""; priority="" }
      /^---/ {
        if (in_front == 0) { in_front = 1; next }
        print id "\t" title "\t" status "\t" priority
        nextfile
      }
      in_front != 1 { next }
      /^id:/       { sub(/^id:[[:space:]]*/, "");       id = $0 }
      /^title:/    { sub(/^title:[[:space:]]*/, "");    title = $0 }
      /^status:/   { sub(/^status:[[:space:]]*/, "");   status = $0 }
      /^priority:/ { sub(/^priority:[[:space:]]*/, ""); priority = $0 }
    ' "${_task_files[@]}" 2>/dev/null
  )
}

# ── Preview renderer (also: zdash --preview ID) ───────────────────────────────
_cmd_preview() {
  local id="${1:l}" file in_front=1 ln
  file=$(ls "${TASKS_DIR}/${id}"*.md 2>/dev/null | head -1)

  if [[ -z "$file" || ! -f "$file" ]]; then
    printf '\033[2mno task file: %s\033[0m\n' "$1"
    return
  fi

  while IFS= read -r ln; do
    if [[ $in_front -eq 1 && "$ln" == "---" ]]; then
      printf '%s%s%s\n' "$DIM" "$ln" "$RST"; continue
    fi
    if [[ $in_front -eq 1 && "$ln" =~ ^[a-z_]+: ]]; then
      printf '%s%s%s\n' "$DIM" "$ln" "$RST"; continue
    fi
    in_front=0
    if [[ "$ln" =~ ^#+ ]]; then
      printf '%s%s%s\n' "$BOLD$CYN" "$ln" "$RST"
    else
      printf '%s\n' "$ln"
    fi
  done < "$file"
}

# ── Subcommand dispatch (called by fzf) ───────────────────────────────────────
case "${1:-}" in
  --list)    _cmd_list;           exit 0 ;;
  --preview) _cmd_preview "${2:-}"; exit 0 ;;
esac

# ── Header ────────────────────────────────────────────────────────────────────
_build_header() {
  local ai_dot ai_txt
  if curl -sf -m 1 "${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}/health" >/dev/null 2>&1; then
    ai_dot="${GRN}●${RST}"; ai_txt="llama.cpp"
  else
    ai_dot="${RED}●${RST}"; ai_txt="DOWN"
  fi

  local active_task="none"
  [[ -f "$ACTIVE_TASK_FILE" ]] && active_task=$(cat "$ACTIVE_TASK_FILE")

  printf '  %s %s  mode=%s  active=%s\n' \
    "$ai_dot" "$ai_txt" "${ZDOTS_AI_MODE:-local}" "$active_task"
  printf '  %senter=start  ^p=Pi  ^a=Aider  ^s=status  ^d=done  ?=preview  ^r=reload  q=quit%s\n' \
    "$DIM" "$RST"
}

# ── Source AI providers ───────────────────────────────────────────────────────
[[ -r "${ZDOTDIR}/providers/tools/pi.zsh" ]]    && source "${ZDOTDIR}/providers/tools/pi.zsh"
[[ -r "${ZDOTDIR}/providers/tools/aider.zsh" ]] && source "${ZDOTDIR}/providers/tools/aider.zsh"

# ── Main loop ─────────────────────────────────────────────────────────────────
_self="${0:A}"   # absolute path to this script — safe for fzf subcommands

while true; do
  if [[ -z "$(_cmd_list)" ]]; then
    printf '%sno open tasks — all done!%s\n' "$GRN" "$RST"
    exit 0
  fi

  result=$(
    "${_self}" --list | fzf \
      --ansi \
      --height=100% \
      --layout=reverse \
      --border=rounded \
      --prompt="  zdash › " \
      --header="$(_build_header)" \
      --delimiter=$'\t' \
      --with-nth=1,2,3,4 \
      --preview="${_self} --preview {2}" \
      --preview-window=right:55%:wrap:hidden \
      --bind='?:toggle-preview' \
      --bind="ctrl-r:reload(${_self} --list)" \
      --expect='enter,ctrl-p,ctrl-a,ctrl-s,ctrl-d' \
      --no-multi \
      2>/dev/null
  ) || true

  [[ -z "$result" ]] && break

  key=$(printf '%s' "$result" | head -1)
  sel=$(printf '%s' "$result" | tail -1)
  id=$(printf '%s' "$sel" | cut -f2)
  title=$(printf '%s' "$sel" | cut -f4)

  [[ -z "$id" ]] && break

  case "$key" in
    ""|enter)
      printf '%s[zdash]%s starting %s%s%s: %s\n' "$CYN" "$RST" "$BOLD" "$id" "$RST" "$title"
      "${ZDOTDIR}/bin/ztask" start "$id"
      break
      ;;
    ctrl-p)
      printf '%s[zdash]%s zpi — exploring %s\n' "$CYN" "$RST" "$id"
      local task_file
      task_file=$(ls "${TASKS_DIR}/${id:l}"*.md 2>/dev/null | head -1)
      if [[ -n "$task_file" ]]; then
        zpi "Working on task ${id}. Spec:

$(cat "$task_file")

Surface the key decision points and any gaps in the spec."
      else
        zpi
      fi
      break
      ;;
    ctrl-a)
      printf '%s[zdash]%s zaider — implementing %s\n' "$CYN" "$RST" "$id"
      zaider
      break
      ;;
    ctrl-s)
      "${ZDOTDIR}/bin/zdots-status"
      continue   # loop back to picker after status exits
      ;;
    ctrl-d)
      printf '%s[zdash]%s ztask done\n' "$CYN" "$RST"
      "${ZDOTDIR}/bin/ztask" done
      break
      ;;
    *)
      break
      ;;
  esac
done
