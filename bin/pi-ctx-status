#!/usr/bin/env bash
# bin/pi-ctx-status — Compact KB and AI stack status for Pi sessions.
#
# Emits ~15 lines (~200 tokens) — safe to paste into any Pi session as
# orientation without meaningfully denting the context budget.
#
# Usage:
#   pi-ctx-status [--help]

set -euo pipefail
ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: pi-ctx-status

Compact knowledge-base and AI stack status (~15 lines, ~200 tokens).
EOF
    exit 0
    ;;
  "") ;;
  *) printf 'pi-ctx-status: unknown option: %s\n' "$1" >&2; exit 2 ;;
esac

# KB counts — strip prefix noise, keep the numbers
kb=$(
  "${ZDOTDIR}/bin/zdots-ctx" status 2>/dev/null \
  | grep -E 'methodologies|lessons|pending|dead' \
  | sed 's/^[[:space:]]*//'
)

# AI stack — one-line summary
model=$(llama-ctl status 2>/dev/null | grep 'active_model' | awk '{print $2}' || true)
healthy=$(llama-ctl status 2>/dev/null | grep '^healthy' | awk '{print $2}' || true)

printf 'kb: %s\n' "${kb//$'\n'/ | }"
printf 'ai: mode=%s endpoint=%s\n' "${ZDOTS_AI_MODE:-local}" "${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"
[[ -n "$model" ]] && printf 'model: %s healthy=%s\n' "$model" "${healthy:-unknown}"
