#!/usr/bin/env bash
# bin/zdots-hygiene — Unified system storage hygiene & eviction routine
#
# Usage:
#   zdots-hygiene          # Dry run — preview safe evictions and space to recover
#   zdots-hygiene -f       # Execute non-destructive cleanup actions
#   zdots-hygiene --apply  # Same as -f
#   zdots-hygiene --help   # Show help

set -euo pipefail

_ZDOTS_LIB_DIR="${ZDOTDIR:-$HOME/.config/zsh}/lib"
if [[ -f "$_ZDOTS_LIB_DIR/cli-help.bash" ]]; then
  source "$_ZDOTS_LIB_DIR/cli-help.bash"
  zdots_cli_wants_help "$@" && {
    cat << 'EOF'
zdots-hygiene — Unified system storage hygiene & eviction routine

Usage:
  zdots-hygiene [options]

Options:
  (no flag)     Dry run mode — preview reclaimable space and actions
  -f, --apply   Execute non-destructive cleanup sweeps
  -h, --help    Show this help message

Actions Executed on --apply:
  1. Docker/Colima VM: Prune unused images/volumes & run fstrim inside Colima
  2. Python uv Cache: Clear package/build caches (uv cache clean)
  3. Homebrew: Remove old formula bottles & clear brew download cache
  4. Ingestion Buffer: Evict staged media/docs in ingest-sources > 7 days old
  5. Diagnostic Logs: Remove stale trace dumps (collector-diag-*.jsonl) > 14 days old
  6. Agent Runtimes: Purge obsolete codex-runtimes cache
  7. Package Caches: Prune unreferenced pnpm packages, stale npx (>30d), and unused mise versions
EOF
    exit 0
  }
fi

apply=false
for arg in "$@"; do
  case "$arg" in
    -f|--apply) apply=true ;;
    -h|--help) exit 0 ;;
    *) printf 'zdots-hygiene: unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

_fmt_bytes() {
  local bytes="${1:-0}"
  if (( bytes >= 1073741824 )); then
    awk -v b="$bytes" 'BEGIN { printf "%.1fGB", b/1073741824 }'
  elif (( bytes >= 1048576 )); then
    awk -v b="$bytes" 'BEGIN { printf "%.1fMB", b/1048576 }'
  elif (( bytes >= 1024 )); then
    awk -v b="$bytes" 'BEGIN { printf "%.1fKB", b/1024 }'
  else
    printf '%dB' "$bytes"
  fi
}

_file_bytes() {
  local file="$1"
  if [[ -f "$file" ]]; then
    wc -c < "$file" 2>/dev/null | tr -d ' ' || echo "0"
  else
    echo "0"
  fi
}

_dir_bytes() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    du -sk "$dir" 2>/dev/null | awk '{print $1 * 1024}' || echo "0"
  else
    echo "0"
  fi
}

# Validates whether a candidate directory matches the expected ephemeral npx cache layout
_is_valid_npx_signature() {
  local dir="$1"
  local base
  base="$(basename "$dir")"
  # npx stores one-off packages in 16-hex hash directories
  if [[ ! "$base" =~ ^[0-9a-f]{16}$ ]]; then
    return 1
  fi
  # Must contain package.json or node_modules
  if [[ ! -f "$dir/package.json" && ! -d "$dir/node_modules" ]]; then
    return 1
  fi
  return 0
}

# Measure candidate evictions
ingest_dir="$HOME/.local/state/zdots/ingest-sources"
stale_ingest_bytes=0
stale_ingest_count=0
if [[ -d "$ingest_dir" ]]; then
  while IFS= read -r -d '' f; do
    sz=$(_file_bytes "$f")
    stale_ingest_bytes=$(( stale_ingest_bytes + sz ))
    stale_ingest_count=$(( stale_ingest_count + 1 ))
  done < <(find "$ingest_dir" -type f -mtime +7 -print0 2>/dev/null)
fi

log_state_dir="$HOME/.local/state/zsh"
stale_diag_bytes=0
stale_diag_count=0
if [[ -d "$log_state_dir" ]]; then
  while IFS= read -r -d '' f; do
    sz=$(_file_bytes "$f")
    stale_diag_bytes=$(( stale_diag_bytes + sz ))
    stale_diag_count=$(( stale_diag_count + 1 ))
  done < <(find "$log_state_dir" -maxdepth 1 \( -name "collector-diag-*.jsonl" -mtime +14 -o -name "*.log.*.gz" -mtime +30 \) -print0 2>/dev/null)
fi

uv_cache_bytes=$(_dir_bytes "$HOME/.cache/uv")
codex_cache_bytes=$(_dir_bytes "$HOME/.cache/codex-runtimes")

npx_dir="$HOME/.npm/_npx"
stale_npx_bytes=0
stale_npx_count=0
if [[ -d "$npx_dir" ]]; then
  while IFS= read -r -d '' d; do
    if _is_valid_npx_signature "$d"; then
      sz=$(_dir_bytes "$d")
      stale_npx_bytes=$(( stale_npx_bytes + sz ))
      stale_npx_count=$(( stale_npx_count + 1 ))
    else
      printf 'zdots-hygiene: [warn] skipping anomalous npx path (signature mismatch): %s\n' "$d" >&2
    fi
  done < <(find "$npx_dir" -mindepth 1 -maxdepth 1 -type d -mtime +30 -print0 2>/dev/null)
fi

media_scratch_dir="$HOME/.local/state/just3ws/scratch"
stale_scratch_bytes=0
stale_scratch_count=0
if [[ -d "$media_scratch_dir" ]]; then
  while IFS= read -r -d '' f; do
    sz=$(_file_bytes "$f")
    stale_scratch_bytes=$(( stale_scratch_bytes + sz ))
    stale_scratch_count=$(( stale_scratch_count + 1 ))
  done < <(find "$media_scratch_dir" -type f \( -name "*.wav" -o -name "*.mp3" -o -name "*.flac" \) -mtime +2 -print0 2>/dev/null)
fi

brew_cache_bytes=0
if command -v brew >/dev/null 2>&1; then
  bcache=$(brew --cache 2>/dev/null || echo "")
  [[ -n "$bcache" ]] && brew_cache_bytes=$(_dir_bytes "$bcache")
fi

total_reclaimable=$(( stale_ingest_bytes + stale_diag_bytes + uv_cache_bytes + codex_cache_bytes + stale_npx_bytes + stale_scratch_bytes + brew_cache_bytes ))

if ! $apply; then
  printf 'zdots-hygiene: dry run -- pass -f or --apply to execute sweeps.\n\n'
  printf 'Candidate Evictions:\n'
  printf '  1. Stale Ingestion Buffers (>7d): %-8s  (%d files in %s)\n' \
    "$(_fmt_bytes "$stale_ingest_bytes")" "$stale_ingest_count" "$ingest_dir"
  printf '  2. Stale Logs & Rotations (>30d): %-8s  (%d files in %s)\n' \
    "$(_fmt_bytes "$stale_diag_bytes")" "$stale_diag_count" "$log_state_dir"
  printf '  3. Python uv Cache:              %-8s\n' "$(_fmt_bytes "$uv_cache_bytes")"
  printf '  4. Codex Runtimes Cache:          %-8s\n' "$(_fmt_bytes "$codex_cache_bytes")"
  printf '  5. Stale npx Runtimes (>30d):     %-8s  (%d dirs in %s)\n' \
    "$(_fmt_bytes "$stale_npx_bytes")" "$stale_npx_count" "$npx_dir"
  printf '  6. Stale Audio Scratch (>2d):     %-8s  (%d files in %s)\n' \
    "$(_fmt_bytes "$stale_scratch_bytes")" "$stale_scratch_count" "$media_scratch_dir"
  printf '  7. Homebrew Download Cache:       %-8s\n' "$(_fmt_bytes "$brew_cache_bytes")"
  printf '  ─────────────────────────────────────────────────────────────\n'
  printf '  Total Estimated Reclaimable:      %-8s  (+ Docker/Colima VM fstrim, pnpm store)\n\n' "$(_fmt_bytes "$total_reclaimable")"
  printf 'To execute, run:\n  zdots-hygiene -f\n'
  exit 0
fi

printf 'zdots-hygiene: executing storage hygiene sweeps...\n'

# 1. Stale Ingestion Buffers (>7d)
if (( stale_ingest_count > 0 )); then
  printf '  [hygiene] purging %d stale ingestion files (>7d)...\n' "$stale_ingest_count"
  find "$ingest_dir" -type f -mtime +7 -delete 2>/dev/null || true
  printf '  [hygiene] freed %s from ingestion buffer\n' "$(_fmt_bytes "$stale_ingest_bytes")"
else
  printf '  [hygiene] ingestion buffer clean (no files >7d)\n'
fi

# 2. Stale Diagnostic Logs (>14d) & Rotated Service Logs (>30d)
if (( stale_diag_count > 0 )); then
  printf '  [hygiene] purging %d stale diagnostic dumps and rotated log archives (>30d)...\n' "$stale_diag_count"
  find "$log_state_dir" -maxdepth 1 \( -name "collector-diag-*.jsonl" -mtime +14 -o -name "*.log.*.gz" -mtime +30 \) -delete 2>/dev/null || true
  printf '  [hygiene] freed %s from stale logs\n' "$(_fmt_bytes "$stale_diag_bytes")"
else
  printf '  [hygiene] diagnostic dumps & log archives clean\n'
fi

# 3. Docker / Colima VM
if command -v docker-reclaim >/dev/null 2>&1; then
  printf '  [hygiene] running docker-reclaim -f...\n'
  docker-reclaim -f >/dev/null 2>&1 || true
fi

# 4. Python uv Cache
if command -v uv >/dev/null 2>&1; then
  printf '  [hygiene] cleaning uv cache...\n'
  uv cache clean >/dev/null 2>&1 || true
fi

# 5. Codex Runtimes
if [[ -d "$HOME/.cache/codex-runtimes" ]]; then
  printf '  [hygiene] removing codex-runtimes cache...\n'
  rm -rf "$HOME/.cache/codex-runtimes"
fi

# 6. Homebrew
if command -v brew >/dev/null 2>&1; then
  printf '  [hygiene] running brew cleanup...\n'
  brew cleanup --prune=all >/dev/null 2>&1 || true
  rm -rf "$(brew --cache 2>/dev/null)" 2>/dev/null || true
fi

# 7. Stale Audio Scratch Buffers (>2d)
if (( stale_scratch_count > 0 )); then
  printf '  [hygiene] purging %d stale audio scratch files (>2d)...\n' "$stale_scratch_count"
  find "$media_scratch_dir" -type f \( -name "*.wav" -o -name "*.mp3" -o -name "*.flac" \) -mtime +2 -delete 2>/dev/null || true
  printf '  [hygiene] freed %s from audio scratch buffer\n' "$(_fmt_bytes "$stale_scratch_bytes")"
else
  printf '  [hygiene] media audio scratch buffer clean (no files >2d)\n'
fi

# 8. Package Managers & Tool Caches (pnpm, npm, mise)
if command -v pnpm >/dev/null 2>&1; then
  pstore="$(pnpm store path 2>/dev/null || echo "")"
  if [[ -n "$pstore" && -d "$pstore" ]]; then
    printf '  [hygiene] pruning unreferenced packages from pnpm store (%s)...\n' "$pstore"
    pnpm store prune >/dev/null 2>&1 || true
  else
    printf '  [hygiene:warn] pnpm installed but store path unreachable; skipping store prune\n' >&2
  fi
fi

if [[ -d "$npx_dir" ]] && (( stale_npx_count > 0 )); then
  printf '  [hygiene] purging %d verified stale npx runtimes (>30d)...\n' "$stale_npx_count"
  freed_npx=0
  while IFS= read -r -d '' d; do
    if _is_valid_npx_signature "$d"; then
      sz=$(_dir_bytes "$d")
      rm -rf "$d" 2>/dev/null || true
      freed_npx=$(( freed_npx + sz ))
    fi
  done < <(find "$npx_dir" -mindepth 1 -maxdepth 1 -type d -mtime +30 -print0 2>/dev/null)
  printf '  [hygiene] freed %s from verified npx cache\n' "$(_fmt_bytes "$freed_npx")"
fi

if command -v npm >/dev/null 2>&1; then
  npm cache clean --force >/dev/null 2>&1 || true
fi

if command -v mise >/dev/null 2>&1; then
  if mise prune --help >/dev/null 2>&1; then
    printf '  [hygiene] pruning unused mise tool versions...\n'
    mise prune -y >/dev/null 2>&1 || true
  else
    printf '  [hygiene:warn] mise installed but prune command unsupported; skipping mise prune\n' >&2
  fi
fi

printf '\nzdots-hygiene: sweep complete. Current status:\n'
zdots-storage
