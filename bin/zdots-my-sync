#!/usr/bin/env bash
# ---
# id: zdots-my-sync
# title: "Zdots 'my' Directory Sync"
# purpose: Initialize or update the ~/my directory structure for knowledge ingestion.
# rationale: Keeps the local knowledge vault structure in alignment across machines.
# ---
# bin/zdots-my-sync — Ensures required ~/my structure exists.

set -eo pipefail

usage() {
  cat <<EOF
Usage: zdots-my-sync [OPTIONS]

Initializes or updates the ~/my directory structure for knowledge ingestion.

Options:
  -h, --help    Show this help

EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    *) printf 'zdots-my-sync: unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

MY_ROOT="${ZDOTS_MY_ROOT:-$HOME/my}"
DIRS=(
  "backlog"
  "lessons"
  "methodologies"
  "standards"
  "transcripts"
  "adrs"
)

echo "==> Syncing ~/my structure in $MY_ROOT..."

for dir in "${DIRS[@]}"; do
  target="$MY_ROOT/$dir"
  if [ ! -d "$target" ]; then
    echo "  [+] Creating $target"
    mkdir -p "$target"
  fi
done

echo "==> ~/my sync complete."
echo "    Next steps:"
echo "    1. Populate $MY_ROOT/standards with platform docs."
echo "    2. Run 'zdots-ctx ingest $MY_ROOT/standards/' to index documentation."
echo "    3. Drop new transcripts in $MY_ROOT/transcripts/ and run ingest."
