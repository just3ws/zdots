#!/usr/bin/env bash
# bin/zdots-platform — one command for the four-repo platform.
#
# The platform is zdots (kernel) + adots (home-dir config, BARE repo) +
# my (private, nested in adots' work-tree) + vdots (nvim). Every cross-repo
# task needs the right git invocation per repo — adots especially (GIT_DIR
# ~/.homegit, work-tree $HOME) — and this command bakes them in.
#
# The work→upstream loop: local commits on `work`, upstream main merges INTO
# work (see /platform-integrate), the operator pushes.

set -euo pipefail

usage() {
  cat <<EOF
Usage: zdots-platform <verb> [args]

Verbs:
  status          branch · ahead/behind origin/main · dirty count, per repo
  fetch           git fetch origin on all four repos
  verify          compare local work tip vs remote origin/work, per repo
  push            print the push commands for repos with unpushed work
  push --run      execute the pushes (refused inside Claude Code — the
                  principal pushes; cc-hook-guard is the enforced boundary)
  exec <git args> run a git command across all four repos (e.g. exec log -1)
  -h, --help      this help

Repos: zdots(~/.config/zsh)  my(~/my)  vdots(~/.config/nvim)  adots(bare ~/.homegit)
EOF
}

# name|worktree-ish git runner. adots must never be checked like a normal repo.
_repos=(zdots my vdots adots)
_git() { # _git <repo> <git args...>
  local repo="$1"; shift
  case "$repo" in
    zdots) git -C "$HOME/.config/zsh" "$@" ;;
    my)    git -C "$HOME/my" "$@" ;;
    vdots) git -C "$HOME/.config/nvim" "$@" ;;
    adots) env GIT_DIR="$HOME/.homegit" GIT_WORK_TREE="$HOME" git "$@" ;;
  esac
}

cmd_status() {
  printf '%-6s %-8s %6s %6s %6s\n' REPO BRANCH AHEAD BEHIND DIRTY
  for r in "${_repos[@]}"; do
    local branch ahead behind dirty
    branch=$(_git "$r" branch --show-current 2>/dev/null || echo '?')
    ahead=$(_git "$r" rev-list --count origin/main..HEAD 2>/dev/null || echo '?')
    behind=$(_git "$r" rev-list --count HEAD..origin/main 2>/dev/null || echo '?')
    if [[ "$r" == adots ]]; then
      dirty=$(_git "$r" status --short --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')
    else
      dirty=$(_git "$r" status --short 2>/dev/null | wc -l | tr -d ' ')
    fi
    printf '%-6s %-8s %6s %6s %6s\n' "$r" "$branch" "$ahead" "$behind" "$dirty"
  done
}

cmd_fetch() {
  for r in "${_repos[@]}"; do
    printf '%s: ' "$r"
    _git "$r" fetch origin 2>&1 | grep -vE 'untracked cache' | tail -1 || true
    printf 'fetched\n'
  done
}

cmd_verify() {
  local ok=0
  for r in "${_repos[@]}"; do
    local remote local_tip
    remote=$(_git "$r" ls-remote --heads origin work 2>/dev/null | cut -c1-12)
    local_tip=$(_git "$r" rev-parse --short=12 work 2>/dev/null || echo '-')
    if [[ -n "$remote" && "$remote" == "$local_tip" ]]; then
      printf '%s: MATCH %s\n' "$r" "$local_tip"
    elif [[ -z "$remote" ]]; then
      printf '%s: origin/work ABSENT (local %s)\n' "$r" "$local_tip"; ok=1
    else
      printf '%s: MISMATCH remote=%s local=%s\n' "$r" "$remote" "$local_tip"; ok=1
    fi
  done
  return $ok
}

cmd_push() {
  local run=false
  [[ "${1:-}" == "--run" ]] && run=true
  if $run && [[ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}" ]]; then
    echo "zdots-platform: push --run refused under Claude Code — the principal pushes (cc-hook-guard boundary)." >&2
    exit 2
  fi
  for r in "${_repos[@]}"; do
    local ahead pushed
    ahead=$(_git "$r" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
    pushed=$(_git "$r" ls-remote --heads origin work 2>/dev/null | cut -c1-12)
    local_tip=$(_git "$r" rev-parse --short=12 work 2>/dev/null || echo '-')
    [[ "$ahead" == 0 || "$pushed" == "$local_tip" ]] && continue
    if $run; then
      printf '==> %s\n' "$r"
      _git "$r" push -u origin work
    else
      case "$r" in
        adots) echo "env GIT_DIR=\$HOME/.homegit GIT_WORK_TREE=\$HOME git push -u origin work" ;;
        zdots) echo "git -C ~/.config/zsh push -u origin work" ;;
        my)    echo "git -C ~/my push -u origin work" ;;
        vdots) echo "git -C ~/.config/nvim push -u origin work" ;;
      esac
    fi
  done
}

cmd_exec() {
  [[ $# -ge 1 ]] || { echo "zdots-platform: exec needs git arguments" >&2; exit 1; }
  for r in "${_repos[@]}"; do
    printf '==> %s\n' "$r"
    _git "$r" "$@" || true
  done
}

case "${1:-}" in
  status)  cmd_status ;;
  fetch)   cmd_fetch ;;
  verify)  shift; cmd_verify "$@" ;;
  push)    shift; cmd_push "$@" ;;
  exec)    shift; cmd_exec "$@" ;;
  -h|--help|"") usage; [[ "${1:-}" ]] || exit 1; exit 0 ;;
  *) printf 'zdots-platform: unknown verb: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
