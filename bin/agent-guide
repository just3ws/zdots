#!/usr/bin/env bash
# bin/agent-guide — Live service status and usage guidance for AI agents.
#
# Run this command first. It checks what is actually running right now and
# tells you exactly how to use every service on this machine. No assumptions.
#
# Safe to call from any bash context — no interactive zsh required.

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

usage() {
  cat <<EOF
Usage: agent-guide [--json]

Options:
  --json      Emit a JSON object with service status and connection info
  -h, --help  Show this help

With no options: human-readable guide with live service status.
With --json: machine-readable JSON suitable for jq filtering.
EOF
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
JSON=false
for arg in "$@"; do
  case "$arg" in
    --json)     JSON=true ;;
    -h|--help)  usage; exit 0 ;;
    *)          printf 'agent-guide: unknown option: %s\n' "$arg" >&2; usage >&2; exit 1 ;;
  esac
done

# ---------------------------------------------------------------------------
# Live status probes (all silent — results stored in variables)
# ---------------------------------------------------------------------------
AI_ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"
OTEL_ENDPOINT="http://127.0.0.1:4318"
O2_URL="http://127.0.0.1:5080"
LOG_DIR="${ZDOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zsh}"
AGENT_ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
LOG_ANALYZER="${AGENT_ZDOTDIR}/bin/zdots-log-analyze"

AI_UP=false
AI_MODEL_ID="unknown"
OTEL_UP=false
O2_UP=false
COLIMA_UP=false

CONTROL_STATUS_JSON=""
if [ -x "${AGENT_ZDOTDIR}/bin/zdots-ctl" ]; then
  CONTROL_STATUS_JSON="$("${AGENT_ZDOTDIR}/bin/zdots-ctl" status --json 2>/dev/null || true)"
fi

if [ -n "$CONTROL_STATUS_JSON" ] && printf '%s\n' "$CONTROL_STATUS_JSON" | jq -e . >/dev/null 2>&1; then
  AI_UP=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '(.ai_server // false) or (.ai_socket_listening // false)')
  AI_MODEL_ID=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.ai_model // empty')
  if [ -z "$AI_MODEL_ID" ] || [ "$AI_MODEL_ID" = "unknown" ]; then
    AI_MODEL_ID="${ZDOTS_AI_MODEL:-local}"
  fi
  AI_ENDPOINT=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.ai_endpoint // "'"$AI_ENDPOINT"'"')
  OTEL_UP=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.otel_collector // false')
  OTEL_ENDPOINT=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.otlp_endpoint // "'"$OTEL_ENDPOINT"'"')
  O2_UP=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.openobserve // false')
  O2_URL=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.o2_url // "'"$O2_URL"'"')
  COLIMA_UP=$(printf '%s\n' "$CONTROL_STATUS_JSON" | jq -r '.colima // false')
else
  if curl -sf -m 2 "${AI_ENDPOINT}/health" >/dev/null 2>&1; then
    AI_UP=true
    AI_MODEL_ID=$(curl -sf -m 2 "${AI_ENDPOINT}/v1/models" 2>/dev/null \
      | jq -r '.data[0].id // "local"' 2>/dev/null || printf 'local')
  fi

  if launchctl list com.zdots.otel-collector 2>/dev/null | grep -q '"PID"'; then
    OTEL_UP=true
  fi

  if curl -sf -m 2 "${O2_URL}/healthz" >/dev/null 2>&1; then
    O2_UP=true
  fi

  # Colima is optional now (container workloads only, not observability).
  if colima status 2>&1 | grep -q "is running"; then
    COLIMA_UP=true
  fi
fi

WHISPER_UP=false
if command -v whisper-cpp >/dev/null 2>&1; then
  WHISPER_UP=true
fi

FABRIC_UP=false
if command -v fabric-ai >/dev/null 2>&1; then
  FABRIC_UP=true
fi

CURRENT_USER="$(id -un 2>/dev/null || printf 'unknown')"
AI_MODE="${ZDOTS_AI_MODE:-local}"

CLOUD_KEYS_SET=false
if [ -n "${OPENAI_API_KEY:-}" ] || [ -n "${ANTHROPIC_API_KEY:-}" ] || [ -n "${GEMINI_API_KEY:-}" ]; then
  CLOUD_KEYS_SET=true
fi

# ---------------------------------------------------------------------------
# JSON output mode
# ---------------------------------------------------------------------------
if $JSON; then
  jq -n \
    --argjson ai_up        "$AI_UP" \
    --arg     ai_ep        "$AI_ENDPOINT" \
    --arg     ai_model     "$AI_MODEL_ID" \
    --argjson otel_up      "$OTEL_UP" \
    --arg     otel_ep      "$OTEL_ENDPOINT" \
    --argjson colima_up    "$COLIMA_UP" \
    --argjson o2_up        "$O2_UP" \
    --arg     o2_url       "$O2_URL" \
    --argjson whisper_up   "$WHISPER_UP" \
    --argjson fabric_up    "$FABRIC_UP" \
    --arg     current_user "$CURRENT_USER" \
    --arg     ai_mode        "$AI_MODE" \
    --argjson cloud_keys_set "$CLOUD_KEYS_SET" \
    '{
      services: {
        llama_cpp:   { up: $ai_up,      endpoint: $ai_ep,     model: $ai_model, start: "llama-ctl start" },
        whisper_cpp: { up: $whisper_up,                                          start: "whisper-ctl install" },
        fabric_ai:   { up: $fabric_up,                                           start: "brew install fabric-ai" },
        otelcol:     { up: $otel_up,    endpoint: $otel_ep,                      start: "otel-collector start" },
        colima:      { up: $colima_up,                                            start: "colima start" },
        openobserve: { up: $o2_up,      url: $o2_url,                            start: "zsvc start o2" }
      },
      ai: {
        mode:              $ai_mode,
        inference_command: "ai-query",
        endpoint:          $ai_ep,
        model:             $ai_model,
        subprocess_safe:   true,
        interactive_only:  ["ai"],
        aider_command:     "zaider",
        knowledge_base:    "zdots-ctx query / zdots-ctx hydrate",
        deploy_logs:       "zdots-log-analyze update|bootstrap|upgrade [--ai]",
        expert_patterns:   "zdots-ask --pattern <name> / zdots-pattern",
        cloud_keys_set:    $cloud_keys_set
      },
      otel: {
        otlp_http_endpoint:  $otel_ep,
        otlp_grpc_endpoint:  "grpc://127.0.0.1:4317",
        protocol:            "http/protobuf",
        backend:             "openobserve",
        ui_url:              $o2_url
      },
      env: {
        ZDOTS_DATABASE_URL:            "postgresql://zdots_rw@/my",
        ZDOTS_AI_ENDPOINT:             $ai_ep,
        ZDOTS_AI_MODEL:                "local",
        OTEL_EXPORTER_OTLP_ENDPOINT:   $otel_ep,
        OTEL_EXPORTER_OTLP_PROTOCOL:   "http/protobuf"
      },
      ai_caps: {
        text:     "llama-caps",
        json:     "llama-caps --json",
        markdown: "llama-caps --md",
        note:     "Full capability + integration guide for the local llama.cpp server"
      },
      mcp: {
        servers: [
          {
            name:  "llama-mcp",
            tools: ["llama_capabilities","llama_health","llama_config","llama_run_test","llama_integration_snippet"],
            note:  "Inference control plane"
          },
          {
            name:  "ctx-mcp",
            tools: ["ctx_status","ctx_query","ctx_hydrate","ctx_add_methodology","ctx_add_lesson","ctx_capture","ctx_enqueue","ctx_jobs"],
            note:  "Knowledge Layer — second brain (lessons, methodologies, session residue)"
          }
        ],
        note: "Registered in ~/.claude.json; available natively in Claude Code sessions"
      },
      database: {
        name:           "my",
        app_user:       "zdots_rw",
        app_url:        "postgresql://zdots_rw@/my",
        readonly_user:  "zdots_ro",
        readonly_url:   "postgresql://zdots_ro@/my",
        migration_user: ($current_user + " (OS superuser via ZDOTS_MIGRATION_URL)"),
        note:           "All writes go through zdots-ctx or context-engine only. Use zdots_ro for safe psql exploration.",
        explore:        "psql -U zdots_ro my"
      },
      docs: {
        platform_control: "zdots-ctl check / up / down / reset / status",
        service_control:  "zsvc list / health --json / logs all --json / diag <service>",
        lifecycle:        "docs/lifecycle.md",
        ai:               "docs/llama-cpp.md",
        deploy_logs:      "docs/deploy-log-analysis.md",
        otel:             "docs/otel-collector-guide.md",
        agents:           "AGENTS.md"
      },
      diagnostics: {
        log_dir:       "'"$LOG_DIR"'",
        log_analyzer:  "'"$LOG_ANALYZER"'",
        service_health_json: "zsvc health --json",
        service_logs_json:   "zsvc logs all --json",
        service_logs_tail:   "zsvc logs all",
        local_urls_health:   "zsvc health --json | jq .local_urls",
        update:        "zdots-log-analyze update",
        bootstrap:     "zdots-log-analyze bootstrap",
        upgrade:       "zdots-log-analyze upgrade",
        ai:            "zdots-log-analyze update --ai"
      }
    }'
  exit 0
fi

# ---------------------------------------------------------------------------
# Human-readable output helpers
# ---------------------------------------------------------------------------
_bold() { printf '\033[1m%s\033[0m' "$*"; }
_ok()   { printf '\033[0;32m[UP]  \033[0m %s' "$*"; }
_down() { printf '\033[0;31m[DOWN]\033[0m %s' "$*"; }
_head() { printf '\n'; _bold "$*"; printf '\n'; printf '%*s\n' "${#*}" '' | tr ' ' '-'; }

# ---------------------------------------------------------------------------
# Human-readable output
# ---------------------------------------------------------------------------
_bold "=== Zdots Agent Guide ==="
printf '\nThis machine is the central hub for AI inference and OTel observability.\n'
printf 'For machine-readable output: agent-guide --json\n'

_head "Platform Control — zdots-ctl"

cat <<'EOF'
zdots-ctl is the single command to manage the full Zdots platform.

  zdots-ctl check        deep diagnostic: tools, configs, health, OTel, disk
  zdots-ctl status       live aggregate status of all services
  zdots-ctl up           start all services in dependency order (idempotent)
  zdots-ctl down         stop all services cleanly
  zdots-ctl reset        full platform restart (down + up)
  zdots-ctl install      first-time setup on a new workstation
  zdots-ctl status --json  machine-readable JSON
EOF

_head "Core Guides"

cat <<'EOF'
Refer to these for architectural and workflow standards:

  docs/lifecycle.md         Project lifecycle, setup, and tutorial (NEW)
  AGENTS.md                 Agent mandates, RTK optimization, PHI rules
  CONTEXT.md                Domain language and active project state
  docs/tooling.md           Full CLI reference table
EOF

_head "Service Control — zsvc"

cat <<'EOF'
Use zsvc for per-service diagnostics and consolidated logs.

  zsvc list                 service registry with state, pid, endpoint
  zsvc health               service liveness + nginx-fronted .local URLs
  zsvc health --json        machine-readable health for AI tools
  zsvc logs all --paths     print every registered log source
  zsvc logs all --json      machine-readable log source inventory
  zsvc logs all             tail all registered logs from one terminal
  zsvc diag <service>       status + health + launchd state + recent logs

Registered services: llama, embed, otel, colima, nginx, postgres, redis.
EOF

_head "Deploy Logs — Non-OTel Diagnostics"

cat <<EOF
Phase-marked transcripts:
  ${LOG_DIR}/bootstrap-*.log
  ${LOG_DIR}/zdots-update-local-*.log
  ${LOG_DIR}/upgrade-homebrew-*.log

AI/HI handoff:
  zdots-log-analyze update
  zdots-log-analyze bootstrap --tail 400
  zdots-log-analyze upgrade --ai
  zdots-ctx diagnose-log update --tail 160

These packs include a non-OTel system snapshot, so diagnostics still work when
the collector or OpenObserve are down.
EOF

_head "Live Service Status"

if $AI_UP; then
  printf '%s  model=%s  endpoint=%s\n' "$(_ok "llama.cpp (AI inference)")" "$AI_MODEL_ID" "$AI_ENDPOINT"
else
  printf '%s  endpoint=%s\n' "$(_down "llama.cpp (AI inference)")" "$AI_ENDPOINT"
fi

if $OTEL_UP; then
  printf '%s  http=%s  grpc=grpc://127.0.0.1:4317\n' "$(_ok "otelcol-contrib (OTel collector)")" "$OTEL_ENDPOINT"
else
  printf '%s\n' "$(_down "otelcol-contrib (OTel collector)")"
fi

if $COLIMA_UP; then
  printf '%s\n' "$(_ok "Colima (container runtime)")"
else
  printf '%s\n' "$(_down "Colima (container runtime)")"
fi

if $O2_UP; then
  printf '%s  %s\n' "$(_ok "OpenObserve (logs/metrics/traces)")" "$O2_URL"
else
  printf '%s\n' "$(_down "OpenObserve (logs/metrics/traces)")"
fi

if ! $AI_UP || ! $OTEL_UP || ! $O2_UP; then
  printf '\n  To bring everything up: zdots-ctl up\n'
fi

_head "AI Inference — llama.cpp"

cat <<EOF
Endpoint:  ${AI_ENDPOINT}
Model ID:  ${AI_MODEL_ID}  (always use "local" as the model name in API calls)

CAPABILITY DISCOVERY — start here when integrating or debugging:
  llama-caps              full capability report (terminal)
  llama-caps --json       machine-readable capability + integration doc
  llama-caps --md         markdown — copy/paste to any AI (Gemini, ChatGPT, etc.)
  llama-caps --md | pbcopy

  MCP tools (Claude Code only — already registered in ~/.claude.json):
    llama_capabilities    complete capability + integration guide
    llama_health          live health check
    llama_config          resolved server config with capacity limits
    llama_run_test        run integration test suite (quick or full)
    llama_integration_snippet  working code for ruby_llm / python / node / curl

  Knowledge Layer MCP tools (ctx-mcp):
    ctx_status            check intelligence suite connectivity
    ctx_query             search methodologies and lessons
    ctx_hydrate           get context for AI tasks
    ctx_add_methodology   record a new preferred methodology
    ctx_add_lesson        record a new lesson learnt
    ctx_capture           distill session residue
    ctx_enqueue           enqueue a background side-effect job
    ctx_jobs              list pending and running jobs

  llama-ctl config --json includes _discovery block with all bootstrap pointers

SUBPROCESS / AGENT USE — preferred method:
  ai-query "What does SIGPIPE mean?"
  git diff | ai-query "Write a commit message"
  cat error.log | ai-query "Find the root cause"
  ai-query --system "You are a JSON formatter" "pretty print this" < data.json

  Options: -s/--system TEXT   override system prompt
           -m/--model  NAME   override model name  (default: local)
           -e/--endpoint URL  override server URL

DIRECT HTTP — works from any context, no tooling required:
  curl -sf -m 2 ${AI_ENDPOINT}/health
  curl -s ${AI_ENDPOINT}/v1/chat/completions \
    -H "Content-Type: application/json" \
    -d '{"model":"local","messages":[{"role":"user","content":"Hello"}],"stream":false}'
  curl -s ${AI_ENDPOINT}/v1/embeddings \
    -H "Content-Type: application/json" \
    -d '{"model":"local","input":"text to embed"}'
  curl -s ${AI_ENDPOINT}/metrics

DO NOT USE from scripts/agents — interactive zsh only:
  ai "prompt"          # requires interactive zsh session

SERVICE MANAGEMENT:
  llama-ctl status          check launchd state + health + active model
  llama-ctl status --json   same, as JSON
  llama-ctl start           start server
  llama-ctl stop            stop server
  llama-ctl restart         restart server
  llama-ctl health          exits 0=up, 1=down
  llama-ctl health --json   same, as JSON
  llama-ctl logs            tail server log
  llama-ctl install         install + register launchd plist (first-time setup)
  llama-ctl model-download  download active profile GGUF from HuggingFace
  llama-ctl validate        validate etc/ai-models.yaml

HARDWARE LIMITS (M4 MBA, 16GB RAM, 256GB disk):
  One active GGUF at a time. If OOM, switch to constrained profile:
    ZDOTS_AI_PROFILE=constrained llama-ctl install
  Full config: etc/ai-models.yaml
  Full guide:  docs/llama-cpp.md
EOF

