#!/usr/bin/env bash
# bin/agent-guide — Live service status and usage guidance for AI agents.
#
# Run this command first. It checks what is actually running right now and
# tells you exactly how to use every service on this machine. No assumptions.
#
# Usage:
#   agent-guide           Human-readable output
#   agent-guide --plain   Strip ANSI codes (pipe-friendly, agent-safe)
#
# Safe to call from any bash context — no interactive zsh required.

set -euo pipefail

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
PLAIN=false
[[ "${1:-}" == "--plain" ]] && PLAIN=true

_bold() { $PLAIN && printf '%s' "$*" || printf '\033[1m%s\033[0m' "$*"; }
_ok()   { $PLAIN && printf '[UP]   %s' "$*" || printf '\033[0;32m[UP]  \033[0m %s' "$*"; }
_down() { $PLAIN && printf '[DOWN] %s' "$*" || printf '\033[0;31m[DOWN]\033[0m %s' "$*"; }
_warn() { $PLAIN && printf '[WARN] %s' "$*" || printf '\033[0;33m[WARN]\033[0m %s' "$*"; }
_head() { printf '\n'; _bold "$*"; printf '\n'; printf '%*s\n' "${#*}" '' | tr ' ' '-'; }

# ---------------------------------------------------------------------------
# Live status probes
# ---------------------------------------------------------------------------
AI_ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:8080}"
AI_MODEL="${ZDOTS_AI_MODEL:-local}"
OTEL_ENDPOINT="http://127.0.0.1:4318"
GRAFANA_URL="http://127.0.0.1:3000"

# llama.cpp
AI_UP=false
AI_MODEL_ID="unknown"
if curl -sf -m 2 "${AI_ENDPOINT}/health" >/dev/null 2>&1; then
  AI_UP=true
  AI_MODEL_ID=$(curl -sf -m 2 "${AI_ENDPOINT}/v1/models" 2>/dev/null \
    | jq -r '.data[0].id // "local"' 2>/dev/null || echo "local")
fi

# otelcol — "PID" key only present when process is actively running
OTEL_UP=false
if launchctl list com.zdots.otel-collector 2>/dev/null | grep -q '"PID"'; then
  OTEL_UP=true
fi

# Colima (LGTM stack host)
COLIMA_UP=false
if colima status 2>&1 | grep -q "is running"; then
  COLIMA_UP=true
fi

# Grafana (LGTM stack)
GRAFANA_UP=false
if curl -sf -m 2 "${GRAFANA_URL}/api/health" >/dev/null 2>&1; then
  GRAFANA_UP=true
fi

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
_bold "=== Zdots Agent Guide ==="
printf '\nThis machine is the central hub for AI inference and OTel observability.\n'
printf 'Run this command any time to get current status and usage instructions.\n'

# --- Status Summary --------------------------------------------------------
_head "Live Service Status"

if $AI_UP; then
  printf '%s  model=%s  endpoint=%s\n' "$(_ok "llama.cpp (AI inference)")" "$AI_MODEL_ID" "$AI_ENDPOINT"
else
  printf '%s  endpoint=%s\n' "$(_down "llama.cpp (AI inference)")" "$AI_ENDPOINT"
  printf '         Start with: llama-ctl start\n'
fi

if $OTEL_UP; then
  printf '%s  http=%s  grpc=%s\n' "$(_ok "otelcol-contrib (OTel collector)")" "http://127.0.0.1:4318" "grpc://127.0.0.1:4317"
else
  printf '%s\n' "$(_down "otelcol-contrib (OTel collector)")"
  printf '         Start with: otel-collector start\n'
fi

if $COLIMA_UP; then
  printf '%s\n' "$(_ok "Colima (container runtime)")"
else
  printf '%s\n' "$(_down "Colima (container runtime)")"
  printf '         Start with: local-ci up\n'
fi

if $GRAFANA_UP; then
  printf '%s  %s  (admin/admin)\n' "$(_ok "LGTM stack (Grafana/Loki/Tempo/Mimir)")" "$GRAFANA_URL"
else
  printf '%s\n' "$(_down "LGTM stack (Grafana/Loki/Tempo/Mimir)")"
  printf '         Start with: local-ci up\n'
fi

# --- AI Inference ----------------------------------------------------------
_head "AI Inference — llama.cpp"

cat <<EOF
Endpoint:  ${AI_ENDPOINT}
Model ID:  ${AI_MODEL_ID}  (always use "local" as the model name in API calls)

SUBPROCESS / AGENT USE — preferred method:
  ai-query "What does SIGPIPE mean?"
  git diff | ai-query "Write a commit message"
  cat error.log | ai-query "Find the root cause"
  ai-query --system "You are a JSON formatter" "pretty print this" < data.json

  Options: -s/--system TEXT   override system prompt
           -m/--model  NAME   override model name  (default: local)
           -e/--endpoint URL  override server URL

DIRECT HTTP — works from any context, no tooling required:
  # Health check
  curl -sf -m 2 ${AI_ENDPOINT}/health

  # Chat completion
  curl -s ${AI_ENDPOINT}/v1/chat/completions \\
    -H "Content-Type: application/json" \\
    -d '{"model":"local","messages":[{"role":"user","content":"Hello"}],"stream":false}'

  # Text embeddings
  curl -s ${AI_ENDPOINT}/v1/embeddings \\
    -H "Content-Type: application/json" \\
    -d '{"model":"local","input":"text to embed"}'

  # Prometheus metrics
  curl -s ${AI_ENDPOINT}/metrics

DO NOT USE from scripts/agents — interactive zsh only:
  ai "prompt"          # requires interactive zsh session
  ai-start / ai-stop   # requires interactive zsh session

SERVICE MANAGEMENT:
  llama-ctl status          check launchd state + health + active model
  llama-ctl start           start server
  llama-ctl stop            stop server
  llama-ctl restart         restart server
  llama-ctl logs            tail server log
  llama-ctl health          exits 0=up, 1=down
  llama-ctl install         install + register launchd plist (first-time setup)
  llama-ctl model-download  download active profile GGUF from HuggingFace

HARDWARE LIMITS (M4 MBA, 16GB RAM, 256GB disk):
  One active GGUF at a time. If OOM, switch to constrained profile:
    ZDOTS_AI_PROFILE=constrained llama-ctl install
  Full config: etc/ai-models.yaml
  Full guide:  docs/llama-cpp.md
EOF

# --- OTel / LGTM -----------------------------------------------------------
_head "Observability — OTel + LGTM Stack"

cat <<EOF
Architecture:
  Your app → OTLP (http/protobuf :4318 or gRPC :4317)
           → otelcol-contrib (host)
           → LGTM stack in Colima
           → Grafana :3000 / Loki / Tempo / Mimir

CONNECT YOUR APP — set these env vars:
  export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_ENDPOINT}"
  export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"

GRAFANA:  ${GRAFANA_URL}  (login: admin / admin)
  - Traces → Tempo
  - Logs   → Loki
  - Metrics → Mimir (includes RED metrics auto-derived from traces)

VERIFY CONNECTIVITY:
  # Send a test trace
  curl -sf ${OTEL_ENDPOINT}/v1/traces \\
    -H "Content-Type: application/json" \\
    -d '{"resourceSpans":[]}'

COLLECTOR MANAGEMENT:
  otel-collector status     check if collector is running
  otel-collector start      start host collector
  otel-collector stop       stop host collector
  otel-collector restart    restart (picks up config changes)
  otel-collector validate   validate etc/otel-collector.yaml
  otel-collector logs       tail collector log
  otel-collector install    first-time: install otelcol-contrib binary

LGTM STACK MANAGEMENT:
  local-ci up               start Colima + LGTM stack
  local-ci down             stop LGTM stack
  local-ci status           check stack status
  local-ci logs             tail LGTM logs
  local-ci restart          down then up

Full guide: docs/otel-collector-guide.md
EOF

# --- Destructive Commands --------------------------------------------------
_head "Destructive Commands — Confirm Before Running"

cat <<EOF
These commands permanently destroy data. Never run the destructive forms
without first reviewing a dry run or getting explicit user confirmation.

  docker-reclaim            DRY RUN — shows what would be freed (safe)
  docker-reclaim -f         DESTRUCTIVE: prunes all containers, images,
                            volumes, build cache, then runs fstrim in Colima VM.
                            Freed host disk space is not returned without fstrim,
                            but this flag deletes data permanently.

  llama-ctl model-prune     DESTRUCTIVE: permanently deletes all GGUFs except
                            the currently active profile's model file.
                            Downloads are ~4.7GB and take time to restore.

  llama-ctl df              safe: shows model directory disk usage (read-only)
  docker-df                 safe: shows Docker disk usage (read-only)
EOF

# --- Quick Reference -------------------------------------------------------
_head "Quick Reference"

cat <<EOF
Environment variables (set by providers/ai/llama-cpp.zsh in interactive zsh):
  ZDOTS_AI_ENDPOINT   AI server base URL   (default: ${AI_ENDPOINT})
  ZDOTS_AI_MODEL      Model alias          (default: local)
  ZDOTS_AI_PROFILE    Active model profile (default: standard)

Override at call time:
  ZDOTS_AI_ENDPOINT=http://other:8080 ai-query "prompt"

Detailed documentation:
  docs/llama-cpp.md              Complete llama-ctl + API reference
  docs/otel-collector-guide.md   OTel setup, SDK examples, pipeline details
  AGENTS.md                      Full agent standards and workflow
EOF

printf '\n'
