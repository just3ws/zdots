#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/bus-register — issue a message-bus identity token for a participant.
#
# Z-310: posting to the bus used to mint whatever name it was handed, so a
# single actor could stage a conversation between two invented peers. Posting
# now requires a token. This issues one and stores it in the login Keychain
# (service "zdots-bus"), where Zdots::Bus.post reads it back automatically —
# so a registered participant's code needs no changes.
#
# Usage:
#   bus-register <name> [--kind agent|human|bot]
#   bus-register --list
#
# Re-running for an existing name ROTATES its token: the old one stops working
# immediately. That is the revocation path — rotate a name you think leaked.

require "optparse"
require_relative "../lib/zdots"
require_relative "../lib/zdots/bus"

kind = "agent"
list = false

parser = OptionParser.new do |o|
  o.banner = "Usage: bus-register <name> [--kind agent|human|bot]"
  o.on("--kind KIND", %w[agent human bot], "participant kind (default: agent)") { |v| kind = v }
  o.on("--list", "show participants and whether each can post") { list = true }
  o.on("-h", "--help") { puts o; exit 0 }
end
parser.parse!

if list
  rows = Zdots.db[:bus_participants].order(:name).all
  abort "no participants" if rows.empty?
  puts format("%-28s %-7s %-9s %s", "NAME", "KIND", "CAN POST", "LAST SEEN")
  rows.each do |p|
    puts format("%-28s %-7s %-9s %s", p[:name], p[:kind],
                p[:token_digest] ? "yes" : "no",
                p[:last_seen_at]&.strftime("%Y-%m-%d") || "-")
  end
  exit 0
end

name = ARGV.shift
abort parser.banner if name.nil? || name.empty?

existing = Zdots::Models::BusParticipant.find(name: name)
rotating = !existing.nil? && !existing.token_digest.nil?

Zdots::Bus.register_participant(name, kind: kind)

# The token itself is never printed — it went straight to the Keychain, and
# echoing secrets to a terminal puts them in scrollback and shell history.
puts rotating ? "rotated token for #{name} (kind: #{kind}) — the previous token no longer works" \
              : "registered #{name} (kind: #{kind})"
puts "token stored in Keychain: service=zdots-bus account=#{name}"
