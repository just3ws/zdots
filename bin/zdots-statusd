#!/usr/bin/env ruby
# frozen_string_literal: true

# zdots-statusd — the Observable Control Plane's status console, served at
# zdots.localhost (separate from my.localhost so it survives context-engine/Postgres
# being down). nginx exposes only its sanitized map routes on the trusted LAN.
# A thin viewer over zdots' health tools — the intelligence lives in zsvc and
# zdots-ctl, not here. The server itself remains loopback-only.
#
# ponytail: stdlib TCPServer, single-thread serial accept loop — one operator,
# add threading if it ever matters. No web framework, no deps.

require "socket"
require "json"
require "yaml"
require "erb"
require "shellwords"
require "time"
require "net/http"
require "uri"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

if ARGV.first =~ /\A(-h|--help)\z/
  puts <<~USAGE
    Usage: zdots-statusd            # serve the control-plane console (foreground)

    The zdots.localhost status console — a no-dep loopback HTTP server rendering live
    platform health (zdots-ctl status, zsvc, service logs). Binds
    127.0.0.1:${ZDOTS_STATUS_PORT:-11600}. Routes: GET / (console), GET /map
    (interactive topology with hostname families, nginx path-to-upstream routes,
    ports, and system connections), GET /map.json (sanitized live snapshot), GET /healthz,
    GET /man, GET /docs, GET /help, GET /backlog (read-only Backlog.md board), GET /theme.
    The lan.just3ws.com vhost exposes only /map and /map.json.

    Don't run this by hand for normal use — manage it as a Platform Service:
      zsvc start|stop|restart|status|logs status

    Env:
      ZDOTS_STATUS_PORT   listen port (default 11600)
      ZDOTDIR             zdots root (for shelling out to zdots-ctl / zsvc)
  USAGE
  exit 0
end

PORT   = (ENV["ZDOTS_STATUS_PORT"] || "11600").to_i
ZDOTS  = ENV["ZDOTDIR"] || File.expand_path("#{__dir__}/..")
BIN    = File.join(ZDOTS, "bin")
STATE  = ENV["XDG_STATE_HOME"] ? File.join(ENV["XDG_STATE_HOME"], "zsh") :
         File.expand_path("~/.local/state/zsh")
# Hokusai's Great Wave, served faint behind /theme. Read once (110KB); nil if absent.
WAVE_IMG = begin
  File.binread(File.join(ZDOTS, "assets", "kanagawa-wave", "great-wave.jpg"))
rescue StandardError
  nil
end

# --- data sources -----------------------------------------------------------

# Structured platform health (the one tool that emits real JSON).
def ctl_status
  out = `#{BIN}/zdots-ctl status --json 2>/dev/null`
  JSON.parse(out)
rescue StandardError
  {}
end

# Per-service launchd detail (state/pid/endpoint), parsed from the zsvc table.
def services
  rows = []
  `#{BIN}/zsvc list 2>/dev/null`.each_line do |ln|
    next if ln =~ /\A(SERVICE|-+|\s*\z)/
    cols = ln.split(/\s{2,}/).map(&:strip).reject(&:empty?)
    next if cols.size < 2

    rows << { name: cols[0], state: cols[1], pid: cols[2], endpoint: cols[3] }
  end
  rows
end

# Stable topology is data, while health is sampled from the existing service
# controls. Keep the LAN map's response deliberately smaller than the private
# localhost console: it must not expose logs, PIDs, backlog, docs, or disk paths.
def topology
  JSON.parse(File.read(File.join(ZDOTS, "etc", "system-topology.json")))
rescue StandardError
  { "nodes" => [], "links" => [] }
end

def platform_versions
  config_home = ENV.fetch("XDG_CONFIG_HOME", File.join(Dir.home, ".config"))
  paths = {
    "zdots" => File.join(ZDOTS, "VERSION"),
    "adots" => File.join(Dir.home, "VERSION"),
    "my" => File.join(Dir.home, "my", "VERSION"),
    "vdots" => File.join(config_home, "nvim", "VERSION"),
    "media-pipeline" => File.join(ENV.fetch("MEDIA_PIPELINE_ROOT", File.join(Dir.home, "github.com", "just3ws", "media-pipeline")), "VERSION"),
    "just3ws.github.io" => File.join(ENV.fetch("JUST3WS_SITE_ROOT", File.join(Dir.home, "github.com", "just3ws", "just3ws.github.io")), "VERSION")
  }
  paths.to_h do |name, path|
    version = File.read(path).strip
    [name, version]
  rescue StandardError
    [name, nil]
  end
end

def topology_with_versions
  atlas = topology
  versions = platform_versions
  atlas["platform_versions"] = versions
  atlas.fetch("nodes", []).each do |node|
    key = node["version_key"]
    node["version"] = versions[key] if key
  end
  atlas
end

def topology_snapshot
  atlas = topology_with_versions
  rows = services
  state_by_key = rows.to_h do |row|
    [row[:name].to_s.downcase.gsub(/[^a-z0-9]+/, "-"), row[:state]]
  end
  platform = ctl_status
  nodes = atlas.fetch("nodes", []).map do |node|
    key = node["service_key"]
    state = key && state_by_key[key]
    health = node.key?("health_key") ? platform[node["health_key"]] : nil
    health = http_healthy?(node["health_url"]) if node["health_url"]
    { id: node["id"], state: state || (key ? "unobserved" : "catalogued"), health: health, version: node["version"] }
  end
  running = nodes.count { |node| node[:state] == "running" }
  checked = nodes.count { |node| !node[:health].nil? }
  unhealthy = nodes.count { |node| node[:health] == false }
  { checked_at: Time.now.utc.iso8601, platform_versions: atlas["platform_versions"], summary: { running: running, checked: checked, unhealthy: unhealthy }, nodes: nodes }
end

def http_healthy?(url)
  uri = URI(url)
  http = Net::HTTP.new(uri.host, uri.port, nil)
  http.open_timeout = 0.6
  http.read_timeout = 0.6
  http.start { |connection| connection.get(uri.request_uri).code.to_i.between?(200, 299) }
rescue StandardError
  false
end

def topology_json
  JSON.generate(topology_snapshot)
end

def topology_page
  atlas = topology_with_versions
  versions = atlas.fetch("platform_versions", {})
  beacon = versions["zdots"]
  version_cards = [
    ["zdots", "zdots"], ["adots", "adots"], ["my", "my"], ["vdots", "vdots"],
    ["media-pipeline", "media-pipeline"], ["just3ws.github.io", "just3ws site"]
  ].map do |key, label|
    version = versions[key]
    state = version.nil? ? "missing" : version == beacon ? "aligned" : "drift"
    %(<div class="version-card #{state}"><b>#{h(label)}</b><span>#{h(version || "no VERSION")}</span></div>)
  end.join

  graph_nodes = atlas.fetch("nodes", []).map do |node|
    monitored = node["service_key"] || node["health_key"] || node["health_url"]
    status = if monitored
               %(<span class="state" data-node-state="#{h(node['id'])}">checking</span>)
             else
               ""
             end
    version = node["version"] ? %(<small class="node-version">#{h(node["version"])}</small>) : ""
    <<~NODE.strip
      <button class="node #{h(node['kind'])}" data-node="#{h(node['id'])}"
        style="--x:#{node['x']};--y:#{node['y']}" type="button">
        <b>#{h(node['label'])}</b><small>#{h(node['port'])}</small>#{version}#{status}
      </button>
    NODE
  end.join

  graph_links = atlas.fetch("links", []).map do |link|
    from = atlas["nodes"].find { |node| node["id"] == link["from"] }
    to = atlas["nodes"].find { |node| node["id"] == link["to"] }
    next unless from && to

    <<~EDGE.strip
      <line x1="#{from['x']}%" y1="#{from['y']}%" x2="#{to['x']}%" y2="#{to['y']}%"
        data-link-from="#{h(link['from'])}" data-link-to="#{h(link['to'])}" />
    EDGE
  end.compact.join

  family_cards = atlas.fetch("hostname_families", []).map do |family|
    <<~FAMILY.strip
      <div class="domain-family"><b>#{h(family['owner'])} · #{h(family['status'])}</b>
        <small>Local: #{h(family['local_pattern'])}<br>LAN: #{h(family['lan_pattern'])}<br>#{h(family['notes'])}</small></div>
    FAMILY
  end.join

  catalog = JSON.generate(atlas).gsub("</", "<\\/")
  <<~HTML
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <title>LAN System Map</title>
      <style>
        #{CSS}
        body { min-height: 100vh; }
        .map-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
        .map-head h1 { font-size: 1.6rem; }
        .map-head p { max-width: 48rem; }
        .version-ribbon { display: flex; flex-direction: column; gap: .5rem; margin: 0 0 1rem; }
        .version-ribbon h2 { margin: 0; border: 0; padding: 0; color: var(--text); font-size: .78rem; }
        .version-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .5rem; }
        .version-card { display: flex; flex-direction: column; gap: .2rem; min-width: 0; padding: .5rem .65rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); }
        .version-card b { font-size: .7rem; color: var(--text-dim); }
        .version-card span { font: .73rem var(--mono); overflow-wrap: anywhere; }
        .version-card.aligned { border-color: rgba(5,150,105,.35); }
        .version-card.drift, .version-card.missing { border-color: rgba(180,83,9,.55); }
        .map-shell { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem); gap: 1rem; align-items: start; }
        .map-canvas { position: relative; height: calc(100vh - 17rem); min-height: 40rem; max-height: 70rem; overflow: auto; background: radial-gradient(ellipse at center, rgba(15,118,110,.07), transparent 70%), var(--bg); border: 1px solid var(--border); border-radius: 16px; padding: 1rem; }
        .map-stage { position: relative; min-width: 1000px; height: 100%; min-height: 38rem; }
