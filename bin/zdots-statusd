#!/usr/bin/env ruby
# frozen_string_literal: true

# zdots-statusd — the Observable Control Plane's own status console, served at
# zdots.localhost (separate from my.localhost so it survives context-engine/Postgres
# being down). A thin viewer over zdots' health tools — the intelligence lives
# in zsvc / zdots-ctl / the logs, not here. Loopback-only; nginx terminates TLS.
#
# ponytail: stdlib TCPServer, single-thread serial accept loop — one operator,
# add threading if it ever matters. No web framework, no deps.

require "socket"
require "json"
require "erb"
require "shellwords"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

if ARGV.first =~ /\A(-h|--help)\z/
  puts <<~USAGE
    Usage: zdots-statusd            # serve the control-plane console (foreground)

    The zdots.localhost status console — a no-dep loopback HTTP server rendering live
    platform health (zdots-ctl status, zsvc, service logs). Binds
    127.0.0.1:${ZDOTS_STATUS_PORT:-11600}. Routes: GET / (console), GET /healthz.

    Don't run this by hand for normal use — manage it as a Platform Service:
      zsvc start|stop|restart|status|logs status

    Env:
      ZDOTS_STATUS_PORT   listen port (default 11600)
      ZDOTDIR             zdots root (for shelling out to zdots-ctl / zsvc)
  USAGE
  exit 0
end

PORT   = (ENV["ZDOTS_STATUS_PORT"] || "11600").to_i
ZDOTS  = ENV["ZDOTDIR"] || File.expand_path("#{__dir__}/..")
BIN    = File.join(ZDOTS, "bin")
STATE  = ENV["XDG_STATE_HOME"] ? File.join(ENV["XDG_STATE_HOME"], "zsh") :
         File.expand_path("~/.local/state/zsh")

# --- data sources -----------------------------------------------------------

# Structured platform health (the one tool that emits real JSON).
def ctl_status
  out = `#{BIN}/zdots-ctl status --json 2>/dev/null`
  JSON.parse(out)
rescue StandardError
  {}
end

# Per-service launchd detail (state/pid/endpoint), parsed from the zsvc table.
def services
  rows = []
  `#{BIN}/zsvc list 2>/dev/null`.each_line do |ln|
    next if ln =~ /\A(SERVICE|-+|\s*\z)/
    cols = ln.split(/\s{2,}/).map(&:strip).reject(&:empty?)
    next if cols.size < 2

    rows << { name: cols[0], state: cols[1], pid: cols[2], endpoint: cols[3] }
  end
  rows
end

# Recent error counts for the *service* logs — "how are the logs doing" at a
# glance. Filtered to logs that match a known service so the periodic
# upgrade/update logs in the state dir don't drown out the signal.
def log_health(svc_names)
  keys = svc_names.map { |n| n.sub(/@.*\z/, "") } + %w[zdots-worker]
  Dir["#{STATE}/*.log"].sort.filter_map do |path|
    name = File.basename(path, ".log")
    next unless keys.uniq.any? { |k| name.include?(k) }

    tail = begin
      File.readlines(path).last(400)
    rescue StandardError
      []
    end
    next if tail.empty?

    errs = tail.count { |l| l =~ /\b(ERROR|FAILED|FATAL)\b/i }
    { name: name, errors: errs }
  end
end

# Claude Code token burn — read the cache cc-burn-watch writes (never run
# ccusage here; the console must stay fast). nil when the watcher is off/stale.
def token_burn
  path = "#{STATE}/cc-burn.json"
  return nil unless File.exist?(path) && (Time.now - File.mtime(path)) < 1800

  data = JSON.parse(File.read(path))
  return nil if data.nil?
  data
rescue StandardError
  nil
end

# --- presentation -----------------------------------------------------------

SERVICE_LABELS = {
  "colima" => "Colima (Docker VM)", "openobserve" => "OpenObserve",
  "otel_collector" => "OTel Collector", "ai_server" => "Inference (llama.cpp)",
  "embed_server" => "Embed server", "intelligence_suite" => "Knowledge Layer",
  "cache" => "Redis", "worker" => "zdots-worker"
}.freeze

def health_cards(status)
  SERVICE_LABELS.filter_map do |key, label|
    next unless status.key?(key)

    { label: label, up: status[key] == true }
  end
end

def pill(up)
  cls = up ? "ok" : "down"
  "<span class=\"pill #{cls}\">#{up ? 'up' : 'down'}</span>"
end

def h(str) = ERB::Util.html_escape(str.to_s)

def fmt_n(n)
  n = n.to_f
  return format("%.1fM", n / 1e6) if n >= 1e6
  return format("%.0fk", n / 1e3) if n >= 1e3
  format("%d", n)
end

# Claude Code token-burn panel. Empty string when no fresh data (watcher off) so
# the section simply doesn't render.
def burn_section(b)
  return "" unless b

  warn_pct  = (ENV["ZDOTS_CC_WARN_PCT"]  || "70").to_i
  alert_pct = (ENV["ZDOTS_CC_ALERT_PCT"] || "90").to_i
  pct = b["pct"]
  sev = "ok"
  if pct
    sev = "warn"  if pct >= warn_pct
    sev = "alert" if pct >= alert_pct
  end
  pillcls = { "ok" => "ok", "warn" => "warn", "alert" => "down" }[sev]
  pctcell = pct ? %(<span class="pill #{pillcls}">#{pct}% of ceiling</span>) : %(<span class="pill warn">calibrating</span>)
  rmin = b["remaining_min"].to_i
  reset = format("%dh %02dm", rmin / 60, rmin % 60)
  proj = b["proj_pct"] ? "#{b['proj_pct']}%" : "?"

  <<~SEC
    <section aria-labelledby="cc-h">
      <h2 id="cc-h">Claude Code — 5h token window <span class="dim">(self-calibrating · <a href="/man/cc-burn">cc-burn</a>)</span></h2>
      <div class="grid">
        <div class="card"><div class="lbl">window used</div>#{pctcell}</div>
        <div class="card"><div class="lbl">resets in</div><span class="mono">#{reset}</span></div>
        <div class="card"><div class="lbl">burn rate</div><span class="mono">#{fmt_n(b['rate_tpm'])}/min</span></div>
        <div class="card"><div class="lbl">used / ceiling</div><span class="mono">#{fmt_n(b['used'])} / #{fmt_n(b['limit'])}</span></div>
        <div class="card"><div class="lbl">projected</div><span class="mono">#{proj} by reset</span></div>
        <div class="card"><div class="lbl">cache reuse</div><span class="mono">#{b['cache_pct']}%</span></div>
      </div>
    </section>
  SEC
end

ROOT_NAV = %(<a href="/">← console</a> · <a href="/man">man index</a>).freeze

# Shared page chrome so /man pages match the console (cross-linked back).
def wrap(title, inner)
  <<~HTML
    <!doctype html>
    <html lang="en"><head><meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>#{h(title)} — zdots.localhost</title><style>#{CSS}</style></head>
    <body><header><h1><span class="mark">zdots</span>.localhost</h1>
    <p class="sub">#{ROOT_NAV}</p></header><main>#{inner}</main></body></html>
  HTML
end

# /man — index of every tracked manual page, grouped, cross-linked.
def man_index
  items = Dir["#{ZDOTS}/man/man*/*"].sort.map do |p|
    sect = File.basename(File.dirname(p)).sub("man", "")
    name = File.basename(p).sub(/\.\d+\z/, "")
    %(<li><a href="/man/#{h(name)}">#{h(name)}</a> <span class="mono">(#{sect})</span></li>)
  end.join
  wrap("man pages", %(<section aria-labelledby="m-h"><h2 id="m-h">Manual pages</h2><ul class="eps cols">#{items}</ul></section>))
end

# /man/<cmd> — render a manual page to HTML via mandoc, wrapped in console chrome.
def render_man(cmd)
  return nil unless cmd =~ /\A[a-z0-9][a-z0-9-]*\z/
  path = Dir["#{ZDOTS}/man/man*/#{cmd}.*"].first
  return nil unless path

  html = `mandoc -Thtml -O fragment #{path.shellescape} 2>/dev/null`
  return nil if html.strip.empty?

  # Interlink: turn mandoc's .Xr cross-references (rendered as <a class="Xr">,
  # no href) into clickable links to the referenced man page when we have it.
  html = html.gsub(%r{<a class="Xr">([a-z0-9][a-z0-9._-]*)\((\d+)\)</a>}) do
    name, sect = Regexp.last_match(1), Regexp.last_match(2)
    have = !Dir["#{ZDOTS}/man/man*/#{name}.*"].empty?
    have ? %(<a class="Xr" href="/man/#{name}">#{name}(#{sect})</a>) : "#{name}(#{sect})"
  end
  wrap("#{cmd} (man)", %(<section class="man"><p class="dim"><a href="/man">↩ all man pages</a></p>#{html}</section>))
end

# --- docs (markdown) --------------------------------------------------------

def doc_files
  top = %w[README.md AGENTS.md CLAUDE.md SETUP.md GEMINI.md].map { |f| "#{ZDOTS}/#{f}" }
  (top + Dir["#{ZDOTS}/docs/**/*.md"]).select { |p| File.file?(p) }.uniq
end

def doc_key(path) = path.sub("#{ZDOTS}/", "").sub(/\.md\z/, "").gsub("/", ":")

def docs_index
  items = doc_files.sort_by { |p| doc_key(p) }.map { |p| %(<li><a href="/docs/#{h(doc_key(p))}">#{h(doc_key(p))}</a></li>) }.join
  wrap("docs", %(<section aria-labelledby="d-h"><h2 id="d-h">Documentation</h2><ul class="eps cols">#{items}</ul></section>))
end

def render_doc(key)
  return nil unless key =~ /\A[A-Za-z0-9:._-]+\z/
  path = doc_files.find { |p| doc_key(p) == key }
  return nil unless path

  md = File.read(path)
  # Render via pandoc (reliable here; the kramdown gem mis-loads strscan on this
  # Ruby). Fall back to escaped <pre> if pandoc is absent.
  body =
    if system("command -v pandoc >/dev/null 2>&1")
      out = IO.popen(["pandoc", "-f", "gfm", "-t", "html"], "r+") do |io|
        io.write(md); io.close_write; io.read
      end
      # Interlink: relative *.md links → /docs/<key>.
      out.to_s.gsub(/href="([^":]+?)\.md(#[^"]*)?"/) do
        tgt, frag = Regexp.last_match(1), Regexp.last_match(2)
        %(href="/docs/#{tgt.sub(%r{\A\./}, '').gsub('/', ':')}#{frag}")
      end
    else
      "<pre>#{h(md)}</pre>"
    end
  wrap("#{key} (doc)", %(<section class="doc"><p class="dim"><a href="/docs">↩ all docs</a></p>#{body}</section>))
end

# --- live --help ------------------------------------------------------------

def help_index
  cmds = Dir["#{BIN}/*"].select { |p| File.file?(p) && File.executable?(p) }.map { |p| File.basename(p) }.sort
  items = cmds.map { |c| %(<li><a href="/help/#{h(c)}">#{h(c)}</a></li>) }.join
  wrap("help", %(<section aria-labelledby="hp-h"><h2 id="hp-h">Command <code>--help</code></h2><ul class="eps cols">#{items}</ul></section>))
end

def render_help(cmd)
  return nil unless cmd =~ /\A[a-z0-9][a-z0-9._-]*\z/
  bin = "#{BIN}/#{cmd}"
  return nil unless File.file?(bin) && File.executable?(bin)

  # Safety: only invoke --help on scripts that actually handle it, else the
  # command could execute real behaviour. Pre-check the source for a handler.
  handles = File.read(bin).match?(/--help|-h\)|"help"|\bhelp\)/) rescue false
  man = Dir["#{ZDOTS}/man/man*/#{cmd}.*"].empty? ? "" : %( · <a href="/man/#{cmd}">man page</a>)
  out = "(no --help handler detected — see the man page or the source)"
  if handles
    out = `timeout 5 #{bin.shellescape} --help 2>&1`
    out = `timeout 5 #{bin.shellescape} -h 2>&1` if out.strip.empty?
  end
  wrap("#{cmd} --help", %(<section><h2>#{h(cmd)} <span class="dim">--help#{man}</span></h2><pre class="man">#{h(out)}</pre></section>))
end

# Service-name → ctl man page, for linking the launchd table to its docs.
SVC_MAN = {
  "llama-server" => "llama-ctl", "llama-embed" => "llama-ctl",
  "otel-collector" => "otel-collector", "openobserve" => "openobserve-ctl",
  "whisper" => "whisper-ctl"
}.freeze

def svc_link(name)
  base = name.sub(/@.*\z/, "")
  man = SVC_MAN[base] || base
  Dir["#{ZDOTS}/man/man*/#{man}.*"].empty? ? h(name) : %(<a href="/man/#{man}">#{h(name)}</a>)
end

def render_page(live:)
  status = ctl_status
  cards  = health_cards(status)
  up     = cards.count { |c| c[:up] }
  svcs   = services
  logs   = log_health(svcs.map { |s| s[:name] })
  burn   = token_burn
  refresh = live ? %(<meta http-equiv="refresh" content="10">) : ""
  now = Time.now.strftime("%Y-%m-%d %H:%M:%S")
  toggle = live ? %(<a href="/?live=0">⏸ pause</a>) : %(<a href="/">▶ resume live</a>)

  <<~HTML
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <title>zdots.localhost — Control Plane</title>
      <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
      #{refresh}
      <style>#{CSS}</style>
    </head>
    <body>
      <header>
        <h1><span class="mark">zdots</span>.localhost</h1>
        <p class="sub">Observable Control Plane · #{up}/#{cards.size} services up · #{now}
          · <a href="/man">man</a> · <a href="/docs">docs</a> · <a href="/help">help</a> · <span class="live">#{toggle}</span></p>
      </header>
      <main>
        <section aria-labelledby="svc-h">
          <h2 id="svc-h">Platform Services</h2>
          <div class="grid">
            #{cards.map { |c| %(<div class="card"><div class="lbl">#{h(c[:label])}</div>#{pill(c[:up])}</div>) }.join}
          </div>
        </section>

        #{burn_section(burn)}

        <section aria-labelledby="ld-h">
          <h2 id="ld-h">launchd / processes</h2>
          <table>
            <thead><tr><th>Service</th><th>State</th><th>PID</th><th>Endpoint</th></tr></thead>
            <tbody>
              #{svcs.map { |s| %(<tr><td>#{svc_link(s[:name])}</td><td>#{pill(s[:state] == 'running')}</td><td class="mono">#{h(s[:pid])}</td><td class="mono">#{h(s[:endpoint])}</td></tr>) }.join}
            </tbody>
          </table>
        </section>

        <section aria-labelledby="log-h">
          <h2 id="log-h">Log health <span class="dim">(errors in last 400 lines)</span></h2>
          <table>
            <thead><tr><th>Log</th><th>Errors</th></tr></thead>
            <tbody>
              #{logs.map { |l| %(<tr><td class="mono">#{h(l[:name])}</td><td>#{l[:errors].zero? ? '<span class="pill ok">clean</span>' : %(<span class="pill warn">#{l[:errors]}</span>)}</td></tr>) }.join}
            </tbody>
          </table>
        </section>

        <section aria-labelledby="ep-h">
          <h2 id="ep-h">Endpoints</h2>
          <ul class="eps">
            #{%w[o2_url ai_endpoint embed_endpoint otlp_endpoint].filter_map { |k| status[k] && %(<li class="mono">#{h(k)}: #{h(status[k])}</li>) }.join}
          </ul>
        </section>
      </main>
    </body>
    </html>
  HTML
end

