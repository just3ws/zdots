        </section>

        <p class="map-foot">
          #{atlas.fetch('nodes', []).size} nodes · #{atlas.fetch('links', []).size} connections ·
          #{atlas.fetch('nodes', []).count { |node| node['service_key'] }} service-registry entries.
          Topology is static configuration; status is a live read-only sample from launchd-backed
          service state and application health URLs. “Unobserved” means this status source does
          not own that service. No logs, process IDs, disk paths, or controls are exposed on this
          LAN view. Source: etc/system-topology.json; refreshes every 30 seconds.
        </p>
        <script type="application/json" id="topology-catalog">#{catalog}</script>
        <script>
          (() => {
            const catalog = JSON.parse(document.getElementById("topology-catalog").textContent);
            const detail = document.getElementById("node-detail");
            const lanView = location.hostname === "lan.just3ws.com";
            let snapshot = { nodes: [] };

            if (lanView) {
              document.querySelectorAll("[data-local-only]").forEach((element) => {
                element.hidden = true;
              });
            }

            function stateFor(node) {
              if (node.health === true) return "healthy";
              if (node.health === false) return "unhealthy";
              return node.state || "catalogued";
            }

            function select(id) {
              const node = catalog.nodes.find((item) => item.id === id);
              if (!node) return;

              document.querySelectorAll(".node").forEach((button) => {
                button.classList.toggle("selected", button.dataset.node === id);
              });
              document.querySelectorAll("svg line").forEach((line) => {
                line.classList.toggle("active", line.dataset.linkFrom === id || line.dataset.linkTo === id);
              });

              const connected = catalog.links.filter((link) => link.from === id || link.to === id);
              const linkMarkup = connected.map((link) => {
                const otherId = link.from === id ? link.to : link.from;
                const other = catalog.nodes.find((item) => item.id === otherId);
                if (!other) return "";
                return `<span><button type="button" data-select="${other.id}">${other.label}</button><small>${link.label}</small></span>`;
              }).join("");
              const observed = snapshot.nodes.find((item) => item.id === id) || {};
              const versionDetail = node.version ? `<dt>Platform version</dt><dd>${node.version}</dd>` : "";
              const versionNote = node.version_note ? `<p class="sub">${node.version_note}</p>` : "";
              const contractDetail = node.version_key === "my" ? `<dt>Structure contract</dt><dd>my.structure.v1</dd>` : "";
              const route = lanView ? node.lan_href : node.href;
              const open = route
                ? `<a href="${route}" rel="noreferrer">${route}</a>`
                : node.href ? `${node.href} · available on this Mac only` : "No web route";
              const signal = node.health_key
                ? `zdots-ctl status: ${node.health_key}`
                : node.health_url ? `HTTP GET ${node.health_url}`
                  : node.signal || "Process state only; no application health probe";
              const hosts = (node.hosts || []).join(", ") || "—";
              const lanHosts = (node.lan_hosts || []).map((item) => `${item.host} (${item.status})`).join("; ") || "No active LAN hostname";
              const lanCandidates = (node.lan_alias_candidates || []).join(", ") || "—";
              const routes = (node.routes || []).map((item) => `<span>${item.host || "all hosts"} ${item.path} → ${item.target}<small>${item.note || ""}</small></span>`).join("") || "—";
              const health = observed.health === true ? "healthy"
                : observed.health === false ? "unhealthy" : "not checked";

              detail.innerHTML = `
                <h2>${node.label}</h2><p class="sub">${node.description}</p>${versionNote}
                <dl>
                  ${versionDetail}${contractDetail}
                  <dt>Area</dt><dd>${node.area}</dd>
                  <dt>Owner</dt><dd>${node.owner}</dd>
                  <dt>Process / port</dt><dd>${node.process || "—"} · ${node.port || "—"}</dd>
                  <dt>Hostnames</dt><dd>${hosts}</dd>
                  <dt>LAN hostnames</dt><dd>${lanHosts}<small>Candidate shared aliases: ${lanCandidates}</small></dd>
                  <dt>Request routes</dt><dd>${routes}</dd>
                  <dt>Manager</dt><dd>${node.manager || "—"}</dd>
                  <dt>Process state</dt><dd>${observed.state || "checking"}</dd>
                  <dt>Health</dt><dd><span class="state" data-state="${stateFor(observed)}">${health}</span><small>${signal}</small></dd>
                  <dt>Open</dt><dd>${open}</dd>
                  <dt>Connected to</dt><dd>${linkMarkup || "—"}</dd>
                </dl>`;
              detail.querySelectorAll("[data-select]").forEach((button) => {
                button.addEventListener("click", () => select(button.dataset.select));
              });
            }

            async function refresh() {
              try {
                const response = await fetch("/map.json", { cache: "no-store" });
                if (!response.ok) throw new Error("status unavailable");
                snapshot = await response.json();
                document.getElementById("checked-at").textContent = new Date(snapshot.checked_at).toLocaleString();
                document.getElementById("map-summary").textContent =
                  `${snapshot.summary.checked} health checks · ${snapshot.summary.unhealthy} need attention · ${snapshot.summary.running} processes running`;
                snapshot.nodes.forEach((node) => {
                  const status = document.querySelector(`[data-node-state="${node.id}"]`);
                  if (status) {
                    status.textContent = stateFor(node);
                    status.dataset.state = stateFor(node);
                  }
                });
                const selected = document.querySelector(".node.selected");
                if (selected) select(selected.dataset.node);
              } catch (_error) {
                document.getElementById("map-summary").textContent = "Live status unavailable";
              }
            }

            document.querySelectorAll(".node").forEach((button) => {
              button.addEventListener("click", () => select(button.dataset.node));
            });
            select(catalog.nodes[0]?.id);
            refresh();
            setInterval(refresh, 30000);
          })();
        </script>
      </main>
    </body>
    </html>
  HTML
end

# Recent error counts for the *service* logs — "how are the logs doing" at a
# glance. Filtered to logs that match a known service so the periodic
# upgrade/update logs in the state dir don't drown out the signal.
def log_health(svc_names)
  keys = svc_names.map { |n| n.sub(/@.*\z/, "") } + %w[zdots-worker]
  Dir["#{STATE}/*.log"].sort.filter_map do |path|
    name = File.basename(path, ".log")
    next unless keys.uniq.any? { |k| name.include?(k) }

    tail = begin
      File.readlines(path).last(400)
    rescue StandardError
      []
    end
    next if tail.empty?

    errs = tail.count { |l| l =~ /\b(ERROR|FAILED|FATAL)\b/i }
    { name: name, errors: errs }
  end
end

# --- presentation -----------------------------------------------------------

SERVICE_LABELS = {
  "colima" => "Colima (Docker VM)", "openobserve" => "OpenObserve",
  "otel_collector" => "OTel Collector", "ai_server" => "Inference (llama.cpp)",
  "embed_server" => "Embed server", "intelligence_suite" => "Knowledge Layer",
  "cache" => "Redis", "worker" => "zdots-worker"
}.freeze

def health_cards(status)
  SERVICE_LABELS.filter_map do |key, label|
    next unless status.key?(key)

    { label: label, up: status[key] == true }
  end
end

def pill(up)
  cls = up ? "ok" : "down"
  "<span class=\"pill #{cls}\">#{up ? 'up' : 'down'}</span>"
end

def h(str) = ERB::Util.html_escape(str.to_s)

ROOT_NAV = [
  %(<a href="/">← console</a>), %(<a href="/map">system map</a>),
  %(<a href="https://lan.just3ws.com">LAN Atlas ↗</a>), %(<a href="/man">man index</a>),
  %(<a href="/backlog">backlog</a>), %(<a href="/theme">theme</a>)
].join(" · ").freeze

# Shared page chrome so /man pages match the console (cross-linked back).
def wrap(title, inner)
  <<~HTML
    <!doctype html>
    <html lang="en"><head><meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>#{h(title)} — zdots.localhost</title><style>#{CSS}</style></head>
    <body><header><h1><span class="mark">zdots</span>.localhost</h1>
    <p class="sub">#{ROOT_NAV}</p></header><main>#{inner}</main></body></html>
  HTML
end

# /man — index of every tracked manual page, grouped, cross-linked.
def man_index
  items = Dir["#{ZDOTS}/man/man*/*"].sort.map do |p|
    sect = File.basename(File.dirname(p)).sub("man", "")
    name = File.basename(p).sub(/\.\d+\z/, "")
    %(<li><a href="/man/#{h(name)}">#{h(name)}</a> <span class="mono">(#{sect})</span></li>)
  end.join
  wrap("man pages", %(<section aria-labelledby="m-h"><h2 id="m-h">Manual pages</h2><ul class="eps cols">#{items}</ul></section>))
end

# /man/<cmd> — render a manual page to HTML via mandoc, wrapped in console chrome.
def render_man(cmd)
  return nil unless cmd =~ /\A[a-z0-9][a-z0-9-]*\z/
  path = Dir["#{ZDOTS}/man/man*/#{cmd}.*"].first
  return nil unless path

  html = `mandoc -Thtml -O fragment #{path.shellescape} 2>/dev/null`
  return nil if html.strip.empty?

  # Interlink: turn mandoc's .Xr cross-references (rendered as <a class="Xr">,
  # no href) into clickable links to the referenced man page when we have it.
  html = html.gsub(%r{<a class="Xr">([a-z0-9][a-z0-9._-]*)\((\d+)\)</a>}) do
    name, sect = Regexp.last_match(1), Regexp.last_match(2)
    have = !Dir["#{ZDOTS}/man/man*/#{name}.*"].empty?
    have ? %(<a class="Xr" href="/man/#{name}">#{name}(#{sect})</a>) : "#{name}(#{sect})"
  end
  wrap("#{cmd} (man)", %(<section class="man"><p class="dim"><a href="/man">↩ all man pages</a></p>#{html}</section>))
end

# --- docs (markdown) --------------------------------------------------------

def doc_files
  # All root-level docs (AGENTS, CONTEXT, PI, AIDER, README, …) plus the
  # docs/ tree. Root glob keeps every top-level doc browsable and cross-linkable.
  (Dir["#{ZDOTS}/*.md"] + Dir["#{ZDOTS}/docs/**/*.md"]).select { |p| File.file?(p) }.uniq
end

def doc_key(path) = path.sub("#{ZDOTS}/", "").sub(/\.md\z/, "").gsub("/", ":")

def docs_index
  items = doc_files.sort_by { |p| doc_key(p) }.map { |p| %(<li><a href="/docs/#{h(doc_key(p))}">#{h(doc_key(p))}</a></li>) }.join
  wrap("docs", %(<section aria-labelledby="d-h"><h2 id="d-h">Documentation</h2><ul class="eps cols">#{items}</ul></section>))
end

def render_doc(key)
  return nil unless key =~ /\A[A-Za-z0-9:._-]+\z/
  path = doc_files.find { |p| doc_key(p) == key }
  return nil unless path

  md = File.read(path)
  # Render via pandoc (reliable here; the kramdown gem mis-loads strscan on this
  # Ruby). Fall back to escaped <pre> if pandoc is absent.
  body =
    if system("command -v pandoc >/dev/null 2>&1")
      out = IO.popen(["pandoc", "-f", "gfm", "-t", "html"], "r+") do |io|
        io.write(md); io.close_write; io.read
      end
      # Interlink: rewrite relative *.md links to /docs/<key>, resolved against
      # THIS doc's directory (so docs/wiki/Foo.md's `Bar.md` → docs:wiki:Bar, and
      # `../tooling.md` → docs:tooling). Links that don't resolve to a doc under
      # ZDOTS (external URLs, off-tree paths like backlog/docs/…) are left as-is.
      base = File.dirname(path)
      servable = doc_files
      out.to_s.gsub(/href="([^"]+?)\.md(#[^"]*)?"/) do
        whole, tgt, frag = Regexp.last_match(0), Regexp.last_match(1), Regexp.last_match(2)
        next whole if tgt.include?("://")

        abs = File.expand_path("#{tgt}.md", base)
        servable.include?(abs) ? %(href="/docs/#{doc_key(abs)}#{frag}") : whole
      end
    else
      "<pre>#{h(md)}</pre>"
    end
  wrap("#{key} (doc)", %(<section class="doc"><p class="dim"><a href="/docs">↩ all docs</a></p>#{body}</section>))
end

# /backlog — read-only board over backlog/ (Backlog.md's plan of record).
# Parses task frontmatter directly, same approach as a tenant-app dashboard
# BacklogBoard: never writes; task edits go through the backlog CLI/MCP only.
BACKLOG_DIRS  = { "active" => "tasks", "completed" => "completed", "draft" => "drafts" }.freeze
PRIORITY_RANK = { "high" => 0, "medium" => 1, "low" => 2 }.freeze
STATUS_RANK   = ["In Progress", "To Do", "Draft", "Done"].freeze

def backlog_task(path, bucket)
  raw = File.read(path)
  return nil unless raw.start_with?("---")

  fm = YAML.safe_load(raw.split("---", 3)[1], permitted_classes: [Date, Time]) || {}
  { id: fm["id"], title: fm["title"].to_s.strip, status: fm["status"] || bucket,
    priority: fm["priority"], type: fm["type"], labels: Array(fm["labels"]),
    created: fm["created_date"].to_s[0, 10], path: path }
rescue StandardError
  nil
end

# /backlog/<id> — one task's full content (frontmatter summary + rendered body).
def find_backlog_task(id)
  BACKLOG_DIRS.each_value do |dir|
    Dir["#{ZDOTS}/backlog/#{dir}/*.md"].each do |p|
      raw = File.read(p)
      next unless raw.start_with?("---")

      fm = YAML.safe_load(raw.split("---", 3)[1], permitted_classes: [Date, Time]) || {}
      return [fm, raw.split("---", 3)[2].to_s, p] if fm["id"].to_s.casecmp(id) == 0
    end
  end
  nil
rescue StandardError
  nil
end

def render_backlog_task(id)
  return nil unless id =~ /\A[A-Za-z][A-Za-z0-9._-]*\z/

  fm, body, path = find_backlog_task(id)
  return nil unless fm

  meta = %w[status priority type].filter_map { |k| fm[k] ? %(<span class="lb">#{h(k)}: #{h(fm[k])}</span>) : nil }.join
  labels = Array(fm["labels"]).map { |l| %(<span class="lb">#{h(l)}</span>) }.join
  rendered =
    if system("command -v pandoc >/dev/null 2>&1")
      IO.popen(["pandoc", "-f", "gfm", "-t", "html"], "r+") { |io| io.write(body); io.close_write; io.read }
    else
      "<pre>#{h(body)}</pre>"
    end
  wrap("#{fm['id']} (task)", <<~HTML)
    <section class="doc">
      <p class="dim"><a href="/backlog">↩ backlog</a> · #{h(File.basename(path.to_s))}</p>
      <h2>#{h(fm["id"])} — #{h(fm["title"].to_s.strip)}</h2>
      <p>#{meta}#{labels}</p>
      #{rendered}
    </section>
  HTML
end

def backlog_board
  tasks = BACKLOG_DIRS.flat_map do |bucket, dir|
    Dir["#{ZDOTS}/backlog/#{dir}/*.md"].map { |p| backlog_task(p, bucket) }.compact
  end
  docs = Dir["#{ZDOTS}/backlog/docs/*.md"].map { |p| File.basename(p, ".md") }.sort
  by_status = tasks.group_by { |t| t[:status] }
  { by_status: by_status, docs: docs, counts: by_status.transform_values(&:size).merge("total" => tasks.size) }
end

def backlog_index
  b = backlog_board
  statuses = b[:by_status].keys.sort_by { |s| STATUS_RANK.index(s) || 9 }
  kpis = statuses.map { |s| %(<div class="kpi"><b>#{b[:counts][s]}</b> #{h(s)}</div>) }.join
  sections = statuses.map do |status|
    rows = b[:by_status][status]
             .sort_by { |t| [PRIORITY_RANK.fetch(t[:priority].to_s, 3), t[:id].to_s] }
             .map do |t|
               pr = t[:priority] ? %(<span class="pr #{h(t[:priority])}">#{h(t[:priority])}</span>) : ""
               labels = t[:labels].first(4).map { |l| %(<span class="lb">#{h(l)}</span>) }.join
               id_cell = t[:id] ? %(<a href="/backlog/#{h(t[:id])}">#{h(t[:id])}</a>) : ""
               %(<tr><td class="mono">#{id_cell}</td><td>#{pr}</td><td>#{h(t[:type])}</td>
                 <td>#{h(t[:title])}</td><td>#{labels}</td><td class="mono">#{h(t[:created])}</td></tr>)
             end.join
    %(<h2>#{h(status)} (#{b[:by_status][status].size})</h2>
      <table><thead><tr><th>ID</th><th>Pri</th><th>Type</th><th>Title</th><th>Labels</th><th>Created</th></tr></thead>
      <tbody>#{rows}</tbody></table>)
  end.join
  docs = b[:docs].map { |d| h(d) }.join(" · ")
  wrap("backlog", <<~HTML)
    <section aria-labelledby="bl-h">
      <h2 id="bl-h">Backlog — the plan of record</h2>
      <p class="dim">Read-only over backlog/ (Backlog.md). Edits go through the backlog CLI/MCP, never by hand.
      Docs: #{docs}.</p>
      <div class="kpis">#{kpis}</div>
      #{sections}
    </section>
  HTML
end

# --- live --help ------------------------------------------------------------

def help_index
  cmds = Dir["#{BIN}/*"].select { |p| File.file?(p) && File.executable?(p) }.map { |p| File.basename(p) }.sort
  items = cmds.map { |c| %(<li><a href="/help/#{h(c)}">#{h(c)}</a></li>) }.join
  wrap("help", %(<section aria-labelledby="hp-h"><h2 id="hp-h">Command <code>--help</code></h2><ul class="eps cols">#{items}</ul></section>))
end

def render_help(cmd)
  return nil unless cmd =~ /\A[a-z0-9][a-z0-9._-]*\z/
  bin = "#{BIN}/#{cmd}"
  return nil unless File.file?(bin) && File.executable?(bin)

  # Safety: only invoke --help on scripts that actually handle it, else the
  # command could execute real behaviour. Pre-check the source for a handler.
  handles = File.read(bin).match?(/--help|-h\)|"help"|\bhelp\)/) rescue false
  man = Dir["#{ZDOTS}/man/man*/#{cmd}.*"].empty? ? "" : %( · <a href="/man/#{cmd}">man page</a>)
  out = "(no --help handler detected — see the man page or the source)"
  if handles
    out = `timeout 5 #{bin.shellescape} --help 2>&1`
    out = `timeout 5 #{bin.shellescape} -h 2>&1` if out.strip.empty?
  end
  wrap("#{cmd} --help", %(<section><h2>#{h(cmd)} <span class="dim">--help#{man}</span></h2><pre class="man">#{h(out)}</pre></section>))
end

# Service-name → ctl man page, for linking the launchd table to its docs.
SVC_MAN = {
  "llama-server" => "llama-ctl", "llama-embed" => "llama-ctl",
  "otel-collector" => "otel-collector", "openobserve" => "openobserve-ctl",
  "whisper" => "whisper-ctl"
}.freeze

def svc_link(name)
  base = name.sub(/@.*\z/, "")
  man = SVC_MAN[base] || base
  Dir["#{ZDOTS}/man/man*/#{man}.*"].empty? ? h(name) : %(<a href="/man/#{man}">#{h(name)}</a>)
end

def render_page(live:)
  status = ctl_status
  cards  = health_cards(status)
  up     = cards.count { |c| c[:up] }
  svcs   = services
  logs   = log_health(svcs.map { |s| s[:name] })
  refresh = live ? %(<meta http-equiv="refresh" content="10">) : ""
  now = Time.now.strftime("%Y-%m-%d %H:%M:%S")
  toggle = live ? %(<a href="/?live=0">⏸ pause</a>) : %(<a href="/">▶ resume live</a>)

  <<~HTML
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <title>zdots.localhost — Control Plane</title>
      <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
      #{refresh}
      <style>#{CSS}</style>
    </head>
    <body>
      <header>
        <h1><span class="mark">zdots</span>.localhost</h1>
        <p class="sub">Observable Control Plane · #{up}/#{cards.size} services up · #{now}
          · <a href="/map">system map</a> · <a href="https://lan.just3ws.com">LAN Atlas ↗</a> · <a href="/man">man</a> · <a href="/docs">docs</a> · <a href="/help">help</a> · <a href="/backlog">backlog</a> · <span class="live">#{toggle}</span></p>
      </header>
      <main>
        <section aria-labelledby="svc-h">
          <h2 id="svc-h">Platform Services</h2>
          <div class="grid">
            #{cards.map { |c| %(<div class="card"><div class="lbl">#{h(c[:label])}</div>#{pill(c[:up])}</div>) }.join}
          </div>
        </section>


        <section aria-labelledby="ld-h">
          <h2 id="ld-h">launchd / processes</h2>
          <table>
            <thead><tr><th>Service</th><th>State</th><th>PID</th><th>Endpoint</th></tr></thead>
            <tbody>
              #{svcs.map { |s| %(<tr><td>#{svc_link(s[:name])}</td><td>#{pill(s[:state] == 'running')}</td><td class="mono">#{h(s[:pid])}</td><td class="mono">#{h(s[:endpoint])}</td></tr>) }.join}
            </tbody>
          </table>
        </section>

        <section aria-labelledby="log-h">
          <h2 id="log-h">Log health <span class="dim">(errors in last 400 lines)</span></h2>
          <table>
            <thead><tr><th>Log</th><th>Errors</th></tr></thead>
            <tbody>
              #{logs.map { |l| %(<tr><td class="mono">#{h(l[:name])}</td><td>#{l[:errors].zero? ? '<span class="pill ok">clean</span>' : %(<span class="pill warn">#{l[:errors]}</span>)}</td></tr>) }.join}
            </tbody>
          </table>
        </section>

        <section aria-labelledby="ep-h">
          <h2 id="ep-h">Endpoints</h2>
          <ul class="eps">
            #{%w[o2_url ai_endpoint embed_endpoint otlp_endpoint].filter_map { |k| status[k] && %(<li class="mono">#{h(k)}: #{h(status[k])}</li>) }.join}
          </ul>
        </section>
      </main>
    </body>
    </html>
  HTML
end

