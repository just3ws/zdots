#!/usr/bin/env zsh
# ---
# id: bench
# title: "Zdots Startup Benchmark"
# purpose: Measure shell startup latency across cold and warm runs.
# rationale: Guards against conf.d module bloat by surfacing regressions against the 80ms performance budget.
# ---
# bin/bench — Shell startup performance benchmarking suite.

# Use scoped options
setopt localoptions errexit pipefail

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

# Detect tool for high-precision timing
USE_HYPERFINE=0
if command -v hyperfine >/dev/null 2>&1; then
  USE_HYPERFINE=1
fi

message () {
  echo "==> $1"
}

# 1. Total Startup Bench (Interactive Shell)
bench_startup() {
  message "Benchmarking total shell startup (interactive)..."
  if [[ "$USE_HYPERFINE" == "1" ]]; then
    hyperfine --warmup 3 --runs 10 \
      "ZDOTDIR=$REPO_ROOT zsh -i -c exit"
  else
    # Fallback to /usr/bin/time for basic median
    for i in {1..5}; do
      /usr/bin/time -p env ZDOTDIR="$REPO_ROOT" zsh -i -c exit 2>&1 | awk '$1=="real"{print $2}'
    done | sort -n | awk '{a[NR]=$1} END {print "Median: " a[int(NR/2)+1] "s"}'
  fi
}

# 2. Module Breakdown (conf.d profiling)
bench_breakdown() {
  message "Profiling individual modules in conf.d..."
  for f in "$REPO_ROOT/conf.d/"*.zsh(N); do
    name=$(basename "$f")
    # Time sourcing the file in a fresh zsh instance
    t=$(ZDOTDIR="$REPO_ROOT" zsh -c "zmodload zsh/datetime; start=\$EPOCHREALTIME; source $f; end=\$EPOCHREALTIME; printf '%.6f' \$((end - start))")
    printf "%-25s : %s s\n" "$name" "$t"
  done | sort -k3 -n -r
}

# 3. Caching Efficiency (Cold vs Warm)
bench_caching() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
  message "Benchmarking caching efficiency (Homebrew/Mise)..."

  if [[ "$USE_HYPERFINE" == "1" ]]; then
    echo "Cold startup (no cache):"
    rm -f "$cache_dir/brew_shellenv" "$cache_dir/mise_activate"
    hyperfine --runs 5 "ZDOTDIR=$REPO_ROOT zsh -i -c exit"

    echo
    echo "Warm startup (with cache):"
    # Ensure cache is populated
    ZDOTDIR="$REPO_ROOT" zsh -i -c exit >/dev/null 2>&1
    hyperfine --runs 5 "ZDOTDIR=$REPO_ROOT zsh -i -c exit"
  else
    # Simple manual comparison if hyperfine is missing
    rm -f "$cache_dir/brew_shellenv" "$cache_dir/mise_activate"
    cold=$(/usr/bin/time -p env ZDOTDIR="$REPO_ROOT" zsh -i -c exit 2>&1 | awk '$1=="real"{print $2}')
    warm=$(/usr/bin/time -p env ZDOTDIR="$REPO_ROOT" zsh -i -c exit 2>&1 | awk '$1=="real"{print $2}')
    printf "Cold: %s s\n" "$cold"
    printf "Warm: %s s\n" "$warm"
  fi
}

# 4. Detailed zprof (If requested)
bench_zprof() {
  message "Generating detailed zprof report..."
  ZDOTDIR="$REPO_ROOT" zsh -i -c "zmodload zsh/zprof; exit; zprof" | head -n 20
}

# Argument parsing
case "${1:-all}" in
  startup)
    bench_startup
    ;;
  breakdown)
    bench_breakdown
    ;;
  cache)
    bench_caching
    ;;
  zprof)
    bench_zprof
    ;;
  all)
    bench_startup
    echo
    bench_breakdown
    echo
    bench_caching
    ;;
  *)
    echo "Usage: $0 [startup|breakdown|cache|zprof|all]"
    exit 1
    ;;
esac
