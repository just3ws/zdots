#!/usr/bin/env zsh
# bin/local-ci — Manage Colima & local GitHub Actions (act)

set -eu
setopt pipefail

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

# Configuration
CPU=${ZDOTS_CI_CPU:-2}
MEMORY=${ZDOTS_CI_MEMORY:-4}
DISK=${ZDOTS_CI_DISK:-60}
# Proxy macos-latest to an Ubuntu image for local act execution
IMAGE_MAPPING="macos-latest=catthehacker/ubuntu:act-latest"

usage() {
  cat <<EOF
Usage: local-ci <command> [args]

Commands:
  up       - Start colima and observability stack
  down     - Stop colima and observability stack
  status   - Check colima, docker, and otel status
  run      - Run act (GitHub Actions locally)
  otel     - Manage observability stack (up|down|logs)
  clean    - Remove act artifacts and prune docker images
  restart  - down then up
  rebuild  - Delete and recreate the colima instance

EOF
}

check_deps() {
  local missing=()
  for cmd in colima docker; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  # Check for compose specifically (either plugin or standalone)
  if ! docker compose version >/dev/null 2>&1 && ! command -v docker-compose >/dev/null 2>&1; then
    missing+=("docker-compose")
  fi

  if (( ${#missing[@]} > 0 )); then
    echo "Error: Missing dependencies: ${missing[*]}" >&2
    echo "Run 'brew bundle' to install them." >&2
    exit 1
  fi
}

_compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  else
    docker-compose "$@"
  fi
}

colima_up() {
  if colima status >/dev/null 2>&1; then
    echo "Colima is already running."
  else
    echo "Starting colima (CPU: $CPU, Memory: ${MEMORY}G, Disk: ${DISK}G)..."
    colima start --cpu "$CPU" --memory "$MEMORY" --disk "$DISK" --very-verbose
  fi
  # Automatically start OTEL stack
  otel_up
}

colima_down() {
  # Stop OTEL stack first
  otel_down
  if colima status >/dev/null 2>&1; then
    echo "Stopping colima..."
    colima stop --very-verbose
  else
    echo "Colima is already stopped."
  fi
}

otel_up() {
  echo "Starting Central Observability Hub (LGTM)..."
  _compose -f "$REPO_ROOT/etc/docker-compose.lgtm.yaml" up -d
}

otel_down() {
  echo "Stopping Central Observability Hub (LGTM)..."
  _compose -f "$REPO_ROOT/etc/docker-compose.lgtm.yaml" down
}

otel_status() {
  echo "--- Observability Hub ---"
  _compose -f "$REPO_ROOT/etc/docker-compose.lgtm.yaml" ps
}

colima_status() {
  echo "--- Colima ---"
  colima status --very-verbose || echo "Colima is not running."
  echo "\n--- Docker ---"
  docker version --format 'Client: {{.Client.Version}}\nServer: {{.Server.Version}}' 2>/dev/null || echo "Docker daemon not reachable."
  echo ""
  otel_status
}

run_act() {
  echo "Running GitHub Actions locally via act..."
  # Use -P to map macos-latest to a Linux image
  # Set DOCKER_HOST for the act process to find the Colima socket
  # Use --container-daemon-socket - to disable bind mounting the socket inside containers,
  # which avoids permission/mounting issues with the Colima socket path.
  DOCKER_HOST="unix://${HOME}/.config/colima/default/docker.sock" \
  act \
    --container-architecture linux/arm64 \
    --container-daemon-socket - \
    -P "$IMAGE_MAPPING" \
    "$@"
}

case "${1:-}" in
  up)
    check_deps
    colima_up
    ;;
  down)
    colima_down
    ;;
  status)
    colima_status
    ;;
  run)
    check_deps
    shift
    run_act "$@"
    ;;
  otel)
    check_deps
    shift
    case "${1:-status}" in
      up) otel_up ;;
      down) otel_down ;;
      status) otel_status ;;
      logs) _compose -f "$REPO_ROOT/etc/docker-compose.lgtm.yaml" logs -f ;;
      *) echo "Unknown otel command: $1" ;;
    esac
    ;;
  clean)
    echo "Cleaning up..."
    docker system prune -f
    ;;
  restart)
    colima_down
    colima_up
    ;;
  rebuild)
    echo "WARNING: This will delete the current colima instance. Proceed? [y/N]"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      colima delete -f --very-verbose
      colima_up
    else
      echo "Aborted."
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac
