#!/usr/bin/env zsh
# bin/local-ci — Colima + local CI (act); DEPRECATED LGTM stack management.
#
# DEPRECATED (Z-134): Observability moved off the containerized LGTM stack to
# native OpenObserve — use `zsvc o2` / `openobserve-ctl` and see docs/openobserve.md.
# The LGTM verbs below (start/stop/status/health/logs) remain only as a rollback
# path against the archived compose file (etc/archive/docker-compose.lgtm.yaml);
# they are no longer wired into zdots-ctl or colima-autostart. The `run` (act),
# `prune`, and `rebuild` Colima utilities are unaffected.
#
# RATIONALE (historical):
# Colima provides the container runtime. The LGTM stack (Grafana, Loki, Tempo,
# Mimir) ran inside Colima via Docker Compose as the observability hub.
#
# GRAMMAR:
# Service lifecycle verbs are consistent with llama-ctl and otel-collector:
#   start / stop / restart / status / health / logs / install (n/a here)
# Additional commands unique to this service:
#   prune   — reclaim Docker space (dry-run first; -f to execute)
#   rebuild — delete and recreate the Colima VM (destructive)
#   run     — run GitHub Actions locally via act

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

CPU=${ZDOTS_CI_CPU:-2}
MEMORY=${ZDOTS_CI_MEMORY:-4}
DISK=${ZDOTS_CI_DISK:-60}
COMPOSE_FILE="$REPO_ROOT/etc/archive/docker-compose.lgtm.yaml"  # DEPRECATED (Z-134): archived
GRAFANA_URL="http://127.0.0.1:3000"
IMAGE_MAPPING="macos-latest=catthehacker/ubuntu:act-latest"

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

_die() {
  printf 'local-ci: error: %s\n' "$*" >&2
  exit 1
}

# Progress messages go to STDERR — keeps STDOUT clean for data/JSON output.
_info() { printf 'local-ci: %s\n' "$*" >&2; }

_compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    _die "docker compose not found. Run: brew bundle --file \"${HOMEBREW_BUNDLE_FILE:-$REPO_ROOT/Brewfile.home}\""
  fi
}

_check_deps() {
  local missing=()
  for cmd in colima docker; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if ! docker compose version >/dev/null 2>&1 && ! command -v docker-compose >/dev/null 2>&1; then
    missing+=("docker-compose")
  fi
  (( ${#missing[@]} == 0 )) || _die "missing dependencies: ${missing[*]}. Run: brew bundle --file \"${HOMEBREW_BUNDLE_FILE:-$REPO_ROOT/Brewfile.home}\""
}

_grafana_healthy() {
  curl -sf -m 3 "${GRAFANA_URL}/api/health" >/dev/null 2>&1
}

_colima_running() {
  colima status >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Subcommand implementations
# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
Usage: local-ci <command> [--json]

Service Lifecycle:
  start     Start Colima and the LGTM observability stack
  stop      Stop the LGTM stack and Colima
  restart   stop then start
  status    Show Colima, Docker, and LGTM stack status
  health    Exit 0 if Grafana is reachable, exit 1 otherwise
  logs      Tail LGTM stack logs (optional: service name to filter)

Maintenance:
  prune     Prune Docker containers, images, and build cache (dry run by default)
  prune -f  Execute prune — DESTRUCTIVE, permanent
  rebuild   Delete and recreate the Colima VM — DESTRUCTIVE
  reset-password Reset Grafana admin password

CI:
  run [args]  Run GitHub Actions locally via act

Options:
  --json    Output status/health as JSON (valid for status, health)
  -h, --help  Show this help

Environment:
  ZDOTS_CI_CPU     vCPUs for Colima  (default: 2)
  ZDOTS_CI_MEMORY  RAM in GB         (default: 4)
  ZDOTS_CI_DISK    Disk in GB        (default: 60)
EOF
}

cmd_start() {
  _check_deps
  if _colima_running; then
    _info "Colima already running"
  else
    _info "starting Colima (CPU: ${CPU}, Memory: ${MEMORY}G, Disk: ${DISK}G)..."
    colima start --cpu "$CPU" --memory "$MEMORY" --disk "$DISK" --very-verbose
  fi
  _warn "DEPRECATED: the LGTM stack is retired (Z-134). Observability is now native"
  _warn "OpenObserve — use: zsvc start o2. Starting LGTM from the archived compose anyway..."
  _compose -f "$COMPOSE_FILE" up -d
  _info "done (rollback mode). Grafana: ${GRAFANA_URL} (admin/admin)"
}

cmd_stop() {
  _info "stopping LGTM stack..."
  _compose -f "$COMPOSE_FILE" down 2>/dev/null || true
  if _colima_running; then
    _info "stopping Colima..."
    colima stop --very-verbose
  else
    _info "Colima already stopped"
  fi
}

cmd_status() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local colima_up=false docker_up=false grafana_up=false

  _colima_running  && colima_up=true  || true
  docker info >/dev/null 2>&1 && docker_up=true || true
  _grafana_healthy && grafana_up=true || true

  if $json; then
    # Emit structured JSON to STDOUT; suppress compose stderr noise.
    local containers
    containers=$(_compose -f "$COMPOSE_FILE" ps --format json 2>/dev/null || printf '[]')
    printf '{"colima":%s,"docker":%s,"grafana":%s,"grafana_url":"%s","lgtm_containers":%s}\n' \
      "$colima_up" "$docker_up" "$grafana_up" "$GRAFANA_URL" "$containers"
    return
  fi

  printf '--- Colima ---\n'
  colima status --very-verbose 2>/dev/null || printf 'not running\n'
  printf '\n--- Docker ---\n'
  docker version --format 'Client: {{.Client.Version}}\nServer: {{.Server.Version}}' 2>/dev/null \
    || printf 'daemon not reachable\n'
  printf '\n--- LGTM Stack ---\n'
  _compose -f "$COMPOSE_FILE" ps 2>/dev/null || printf '(stack not running)\n'
  printf '\n--- Grafana ---\n'
  if $grafana_up; then
    printf 'reachable at %s (admin/admin)\n' "$GRAFANA_URL"
  else
    printf 'not reachable (start with: local-ci start)\n'
  fi
}

cmd_health() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  if _grafana_healthy; then
    $json && printf '{"healthy":true,"grafana_url":"%s"}\n' "$GRAFANA_URL"
    return 0
  else
    $json && printf '{"healthy":false,"grafana_url":"%s"}\n' "$GRAFANA_URL"
    return 1
  fi
}

cmd_logs() {
  # Clean exit on interrupt — tail -f runs forever by design.
  trap 'exit 0' INT TERM
  _compose -f "$COMPOSE_FILE" logs -f "$@"
}

cmd_prune() {
  local force=false
  [[ "${1:-}" == "-f" ]] && force=true

  if ! $force; then
    printf 'local-ci prune: dry run — pass -f to execute.\n'
    printf '\nDocker disk usage:\n'
    docker system df 2>/dev/null || printf '  (docker not reachable)\n'
    printf '\nTo prune, run:\n'
    printf '  local-ci prune -f\n'
    return 0
  fi

  _info "pruning Docker containers, images, build cache..."
  docker system prune -f
  docker builder prune -f
  printf '\nDocker disk usage after prune:\n'
  docker system df
}

cmd_rebuild() {
  printf 'local-ci: WARNING: deletes the current Colima VM. Proceed? [y/N] ' >&2
  local response
  read -r response
  if [[ "$response" =~ ^[Yy]$ ]]; then
    colima delete -f --very-verbose
    cmd_start
  else
    _info "aborted"
  fi
}

cmd_reset_password() {
  local container="zdots-lgtm"
  local password=""

  if [[ $# -eq 2 ]]; then
    container="$1"
    password="$2"
  elif [[ $# -eq 1 ]]; then
    password="$1"
  else
    _die "usage: local-ci reset-password [container] <new-password>"
  fi

  _info "resetting Grafana admin password in container '${container}'..."
  if ! docker exec -it "$container" \
    /otel-lgtm/grafana/bin/grafana \
    cli \
    --homepath /otel-lgtm/grafana \
    --configOverrides cfg:default.paths.data=/data/grafana/data \
    admin reset-admin-password "$password"; then
    _die "failed to reset password inside container"
  fi

  _info "password reset succeeded. Restarting service..."
  docker restart "$container" >/dev/null
  _info "done. Login with username: admin"
}

cmd_run() {
  _check_deps
  _info "running GitHub Actions locally via act..."
  DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock" \
  act \
    --container-architecture linux/arm64 \
    --container-daemon-socket - \
    -P "$IMAGE_MAPPING" \
    "$@"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  start)        cmd_start ;;
  stop)         cmd_stop ;;
  restart)      cmd_stop; cmd_start ;;
  status)       shift; cmd_status "${@}" ;;
  health)       shift; cmd_health "${@}" ;;
  logs)         shift; cmd_logs "${@}" ;;
  prune)        shift; cmd_prune "${@}" ;;
  rebuild)      cmd_rebuild ;;
  reset-password) shift; cmd_reset_password "${@}" ;;
  run)          shift; cmd_run "${@}" ;;
  -h|--help)    usage; exit 0 ;;
  "")           usage >&2; exit 1 ;;
  *)            printf 'local-ci: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
