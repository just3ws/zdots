#!/usr/bin/env bash
# bin/ai-query — Local AI inference from any shell context.
#
# Unlike the `ai` zsh function (conf.d/70-integrations.zsh), this is a plain
# bash script. It works from subprocesses, agent sandboxes, CI environments,
# and anywhere that doesn't have the interactive zsh environment loaded.
#
# Usage:
#   ai-query <prompt>
#   <command> | ai-query <prompt>
#   ai-query <prompt> < file.txt
#   ai-query --system "custom system prompt" <prompt>
#
# Options:
#   -s, --system TEXT    Override system prompt
#   -m, --model  NAME    Override model name (default: local)
#   -e, --endpoint URL   Override server URL
#   -h, --help           Show this help
#
# Environment:
#   ZDOTS_AI_ENDPOINT    Server base URL (default: http://127.0.0.1:8080)
#   ZDOTS_AI_MODEL       Model name / alias (default: local)

set -euo pipefail

ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:8080}"
MODEL="${ZDOTS_AI_MODEL:-local}"
SYSTEM="You are a helpful shell assistant. Concisely parse the provided data."

usage() {
  cat <<EOF
Usage: ai-query [options] <prompt>
       <command> | ai-query [options] <prompt>

Options:
  -s, --system TEXT    Override system prompt
  -m, --model  NAME    Override model name (default: ${MODEL})
  -e, --endpoint URL   Override server URL (default: ${ENDPOINT})
  -h, --help           Show this help

Environment:
  ZDOTS_AI_ENDPOINT    Server base URL (default: http://127.0.0.1:8080)
  ZDOTS_AI_MODEL       Model alias    (default: local)

Examples:
  ai-query "What does SIGPIPE mean?"
  git diff | ai-query "Write a commit message"
  cat error.log | ai-query "Find the root cause"
  ai-query --system "You are a JSON formatter" "pretty print this" < data.json
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--system)   SYSTEM="$2";   shift 2 ;;
    -m|--model)    MODEL="$2";    shift 2 ;;
    -e|--endpoint) ENDPOINT="$2"; shift 2 ;;
    -h|--help)     usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "ai-query: unknown option: $1" >&2; usage >&2; exit 1 ;;
    *)  break ;;
  esac
done

PROMPT="${1:-}"
if [[ -z "$PROMPT" ]]; then
  echo "ai-query: error: prompt required" >&2
  usage >&2
  exit 1
fi

# Read stdin if not a terminal
INPUT=""
if [[ ! -t 0 ]]; then
  INPUT=$(cat)
fi

# Build user message
if [[ -n "$INPUT" ]]; then
  USER_MSG="Data: ${INPUT}

Task: ${PROMPT}"
else
  USER_MSG="$PROMPT"
fi

# Health check (fail fast — don't hang)
if ! curl -sf -m 2 "${ENDPOINT}/health" >/dev/null 2>&1; then
  echo "ai-query: llama.cpp server not responding at ${ENDPOINT}" >&2
  echo "ai-query: start with: llama-ctl start" >&2
  exit 1
fi

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

jq -nc \
  --arg model  "$MODEL" \
  --arg system "$SYSTEM" \
  --arg user   "$USER_MSG" \
  '{
    model: $model,
    messages: [
      {role: "system", content: $system},
      {role: "user",   content: $user}
    ],
    stream: false,
    temperature: 0.2
  }' \
  | curl -sf -X POST "${ENDPOINT}/v1/chat/completions" \
      -H "Content-Type: application/json" \
      -d @- >| "$TMP"

if [[ ! -s "$TMP" ]]; then
  echo "ai-query: empty response from server" >&2
  exit 1
fi

API_ERROR=$(jq -r '.error.message // empty' "$TMP" 2>/dev/null)
if [[ -n "$API_ERROR" ]]; then
  echo "ai-query: error: ${API_ERROR}" >&2
  exit 1
fi

jq -r '.choices[0].message.content // empty' "$TMP"
