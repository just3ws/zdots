#!/usr/bin/env bash
# bin/zsynod — the AI collaborators' forum: an append-only, hash-chained ledger
# of proposals, votes, discussion, and handoffs, with quorum-commit and a
# rotating chair. Raft's replicated log + commit-safety, without Raft's throne.
#
# The Ledger (zsynod/ledger.jsonl) is canon: ordered, attributed, append-only,
# and hash-chained so history cannot be silently rewritten (`zsynod verify`).
# zsynod/minutes.md is a generated human mirror. Charter: docs/zsynod-charter.md.
#
# Identity: write actions need a member — set ZSYNOD_MEMBER or pass --as <member>.
#
# Usage:
#   zsynod init                          seed roster + genesis (idempotent)
#   zsynod members                       list members and lanes
#   zsynod status                        round, chair, open proposals + tallies
#   zsynod chair                         show the current rotating chair
#   zsynod propose "<title>" [--body T] [--round N]
#   zsynod speak  <id> "<remark>"        contribute to discussion (every voice)
#   zsynod second <id>                   lightweight concur (logged, counts as aye)
#   zsynod vote   <id> aye|nay|abstain [--note T]
#   zsynod commit <id>                   stamp committed iff quorum of ayes
#   zsynod ratify <id>                   principal authority commit (--as mike)
#   zsynod handoff --to M --task "T" [--state T] [--ref <id>]
#   zsynod committee <id> --purpose T    form a named special committee
#   zsynod log [--round N] [--json]      show ledger entries
#   zsynod minutes                       regenerate minutes.md
#   zsynod view                          regenerate + display the minutes
#   zsynod history [Z-NNN|P#]            chronological discussion record over time
#   zsynod queue [list]                  proposed diffs in dependency + priority order
#   zsynod queue add --summary T [--ref Z-NNN] [--after Q1,Q2] [--priority P] [--patch F|-]
#   zsynod queue show|apply|reject|defer <Qid>   review / apply (git apply) / dispose
#   zsynod turn [--session ID] [--since N] [--json]  headless ledger turn report
#   zsynod tick [--topic Z-NNN] [--frontier] [--json] one deliberation turn:
#       local pi (and frontier on demand) discuss a backlog issue; remarks
#       auto-append, proposals/handoffs print as commands for you to approve
#   zsynod ask "<question>"              pose a question to the forum (no vote)
#   zsynod tail [member] [-f] [-n N]     tail a member's captured transcript
#   zsynod console [--headless]          principal cockpit (prompts or report)
#   zsynod verify                        re-walk the hash chain (integrity check)
#   zsynod convene                       open the tmux forum room (one at a time)
#   zsynod attach                        attach to the convened room
#   zsynod goto <member>                 jump to a seat's window
#   zsynod room                          list the room's windows
#   zsynod adjourn                       close the forum (transcripts kept)
#   (internal pane entrypoints: zsynod seat <id> · zsynod watch)
#
# Global: --as <member>

set -uo pipefail
trap '' PIPE

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
SESSION="${ZSYNOD_SESSION:-zsynod}"   # the tmux room name = the singleton lock
ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
DIR="${ZSYNOD_DIR:-$ZDOTDIR/zsynod}"
LEDGER="$DIR/ledger.jsonl"
MEMBERS="$DIR/members.json"
MINUTES="$DIR/minutes.md"
SESSIONS="$DIR/sessions"
CHARTER="docs/zsynod-charter.md"
LOCK="$DIR/.lock"

# Default roster (charter §3). Voting agents + the human principal.
DEFAULT_ROSTER='{
  "members":[
    {"id":"claude","tier":"frontier","voting":true,"lane":"architecture, security/PHI review, facilitation, charter stewardship"},
    {"id":"gemini","tier":"frontier","voting":true,"lane":"large-context synthesis, breadth research, red-team/dissent"},
    {"id":"codex","tier":"frontier","voting":true,"lane":"high-volume code generation, refactors, test authoring"},
    {"id":"antigravity","tier":"frontier","voting":true,"lane":"agentic multi-file execution / IDE orchestration"},
    {"id":"pi","tier":"local","voting":true,"lane":"first responder & triage; read/explain/plan"},
    {"id":"aider","tier":"local","voting":true,"lane":"file edits + git execution of ratified decisions"},
    {"id":"mike","tier":"principal","voting":false,"lane":"ratify, veto, tiebreak, ultimate arbiter"}
  ]
}'

if [[ -t 1 ]]; then
  RST=$'\e[0m'; B=$'\e[1m'; D=$'\e[2m'; GRN=$'\e[0;32m'; YEL=$'\e[0;33m'; RED=$'\e[0;31m'; CYN=$'\e[0;36m'
else RST=''; B=''; D=''; GRN=''; YEL=''; RED=''; CYN=''; fi

_die() { printf 'zsynod: %s\n' "$*" >&2; exit 1; }
_usage() { sed -n '2,40p' "$0" | sed -E 's/^# ?//'; }
command -v jq >/dev/null 2>&1 || _die "jq is required"
command -v shasum >/dev/null 2>&1 || _die "shasum is required"

MEMBER="${ZSYNOD_MEMBER:-}"

# ── hash-chained append (charter §2) ─────────────────────────────────────────
_hash() { printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1; }

_lock()   { local n=0; until mkdir "$LOCK" 2>/dev/null; do sleep 0.1; (( ++n > 50 )) && _die "ledger locked (stale $LOCK?)"; done; }
_unlock() { rmdir "$LOCK" 2>/dev/null || true; }

# _append <type> <data-json>  — chains onto the last entry, writes one line.
_append() {
  local type="$1" data="$2"
  [[ -n "$MEMBER" ]] || _die "no member identity — set ZSYNOD_MEMBER or pass --as <member>"
  _member_known "$MEMBER" || _die "unknown member: $MEMBER (see: zsynod members)"
  _lock
  local prev seq round
  if [[ -s "$LEDGER" ]]; then
    prev="$(tail -1 "$LEDGER" | jq -r '.hash')"
    seq=$(( $(tail -1 "$LEDGER" | jq -r '.seq') + 1 ))
  else prev="GENESIS"; seq=0; fi
  round="$(_cur_round)"
  local base canon h final
  base="$(jq -nc --argjson seq "$seq" --arg ts "$(date -u +%FT%TZ)" --argjson round "$round" \
    --arg actor "$MEMBER" --arg type "$type" --argjson data "$data" --arg prev "$prev" \
    '{seq:$seq,ts:$ts,round:$round,actor:$actor,type:$type,data:$data,prev:$prev}')"
  canon="$(printf '%s' "$base" | jq -Sc .)"
  h="$(_hash "${prev}${canon}")"
  final="$(printf '%s' "$base" | jq -c --arg h "$h" '. + {hash:$h}')"
  printf '%s\n' "$final" >> "$LEDGER"
  _unlock
  printf '%s' "$h"
}

# ── roster ───────────────────────────────────────────────────────────────────
_member_known() { [[ -f "$MEMBERS" ]] && jq -e --arg m "$1" '.members[]|select(.id==$m)' "$MEMBERS" >/dev/null 2>&1; }
_voting_ids()   { jq -r '.members[]|select(.voting)|.id' "$MEMBERS"; }
_quorum()       { local n; n="$(_voting_ids | wc -l | tr -d ' ')"; echo $(( n/2 + 1 )); }
_cur_round()    { [[ -s "$LEDGER" ]] && jq -rs 'map(.round)|max // 0' "$LEDGER" || echo 0; }

# ── proposal tally: latest vote per voting member wins; second == aye ─────────
# echoes: "<ayes> <nays> <abstain> <state> <title>"
_tally() {
  local pid="$1"
  jq -rs --arg p "$pid" '
    ([.[]|select(.type=="propose" and .data.id==$p)]|last) as $prop
    | if $prop==null then "NONE" else
      ([.[]|select((.type=="vote" or .type=="second") and .data.proposal==$p)]
        | group_by(.actor)
        | map((sort_by(.seq)|last) | (if .type=="second" then "aye" else .data.vote end)))
      as $v
      | ([.[]|select(.type=="commit" and .data.proposal==$p)]|length>0) as $committed
      | ( ($v|map(select(.=="aye"))|length)|tostring) + " "
        + (($v|map(select(.=="nay"))|length)|tostring) + " "
        + (($v|map(select(.=="abstain"))|length)|tostring) + " "
        + (if $committed then "committed" else "open" end) + " "
        + ($prop.data.title)
      end' "$LEDGER"
}

_proposal_ids() { jq -rs '[.[]|select(.type=="propose")|.data.id]|unique|.[]' "$LEDGER" 2>/dev/null; }
_next_pid()     { local n; n="$(jq -rs '[.[]|select(.type=="propose")]|length' "$LEDGER" 2>/dev/null || echo 0)"; echo "P$(( n + 1 ))"; }

_frontier_ids() { jq -r '.members[]|select(.tier=="frontier")|.id' "$MEMBERS"; }
_session_path() { printf '%s/%s.json' "$SESSIONS" "$1"; }
_session_turns_path() { printf '%s/%s.turns.jsonl' "$SESSIONS" "$1"; }
_session_valid() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }

_participants_csv() {
  local explicit="${1:-}" frontier="${2:-0}"
  if [[ -n "$explicit" ]]; then
    printf '%s' "$explicit"
  elif [[ "$frontier" == "1" ]]; then
    _frontier_ids | paste -sd, -
  else
    _voting_ids | paste -sd, -
  fi
}

_validate_participants() {
  local csv="${1:-}" id
  [[ -z "$csv" ]] && return 0
  IFS=',' read -r -a ids <<< "$csv"
  for id in "${ids[@]}"; do
    [[ -n "$id" ]] || _die "empty participant in --participants"
    _member_known "$id" || _die "unknown participant: $id"
  done
}

_session_resume_since() {
  local id="${1:-}" fallback="${2:-0}" f
  [[ -n "$id" ]] || { printf '%s' "$fallback"; return; }
  f="$(_session_path "$id")"
  if [[ -f "$f" ]]; then
    jq -r '.last_seq // 0' "$f"
  else
    printf '%s' "$fallback"
  fi
}

_session_resume_participants() {
  local id="${1:-}" f
  [[ -n "$id" ]] || return 0
  f="$(_session_path "$id")"
  [[ -f "$f" ]] || return 0
  jq -r '(.participants // []) | join(",")' "$f"
}

_session_resume_meeting_type() {
  local id="${1:-}" fallback="${2:-regular}" f
  [[ -n "$id" ]] || { printf '%s' "$fallback"; return; }
  f="$(_session_path "$id")"
  if [[ -f "$f" ]]; then
    jq -r --arg fallback "$fallback" '.meeting_type // $fallback' "$f"
  else
    printf '%s' "$fallback"
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_init() {
  mkdir -p "$DIR"
  [[ -f "$MEMBERS" ]] || printf '%s\n' "$DEFAULT_ROSTER" | jq . > "$MEMBERS"
  if [[ ! -s "$LEDGER" ]]; then
    MEMBER="system"
    # genesis is unsigned-actor; bypass identity check by writing directly.
    local base canon h
    base="$(jq -nc --arg ts "$(date -u +%FT%TZ)" '{seq:0,ts:$ts,round:0,actor:"system",type:"genesis",data:{charter:"'"$CHARTER"'"},prev:"GENESIS"}')"
    canon="$(printf '%s' "$base" | jq -Sc .)"; h="$(_hash "GENESIS${canon}")"
    printf '%s\n' "$(printf '%s' "$base" | jq -c --arg h "$h" '.+{hash:$h}')" > "$LEDGER"
    printf '%szsynod initialized%s — %s members, quorum %s\n' "$GRN" "$RST" "$(_voting_ids|wc -l|tr -d ' ')" "$(_quorum)"
  else
    printf 'zsynod: already initialized (%s)\n' "$LEDGER"
  fi
  cmd_minutes >/dev/null
}

cmd_members() {
  printf '%s%-12s %-10s %s%s\n' "$B" "MEMBER" "TIER" "LANE" "$RST"
  jq -r '.members[]|[.id,.tier,(if .voting then "" else "(non-voting) " end)+.lane]|@tsv' "$MEMBERS" \
    | while IFS=$'\t' read -r id tier lane; do printf '%-12s %-10s %s\n' "$id" "$tier" "$lane"; done
  printf '%squorum: %s of %s voting%s\n' "$D" "$(_quorum)" "$(_voting_ids|wc -l|tr -d ' ')" "$RST"
}

cmd_chair() {
  local round ids n idx
  round="$(_cur_round)"; mapfile -t ids < <(_voting_ids); n="${#ids[@]}"
  (( n == 0 )) && _die "no voting members"
  idx=$(( round % n ))
  printf '%sround %s · chair: %s%s%s  %s(rotates each round; facilitates, does not decide)%s\n' \
    "$B" "$round" "$CYN" "${ids[$idx]}" "$RST" "$D" "$RST"
}

cmd_propose() {
  local title="$1" body="${2:-}" round="${3:-}"
  [[ -n "$title" ]] || _die "propose needs a title"
  [[ -n "$round" ]] || round="$(( $(_cur_round) + 0 ))"
  # a proposal opens (or stays in) the current round; bump to 1 if still genesis.
  (( round == 0 )) && round=1
  local pid; pid="$(_next_pid)"
  local data; data="$(jq -nc --arg id "$pid" --arg t "$title" --arg b "$body" --argjson r "$round" \
    '{id:$id,title:$t,body:$b,round:$r}')"
  # ensure the round is recorded by writing at that round
  _ROUND_OVERRIDE="$round" _append_round propose "$data" >/dev/null
  printf '%sproposed%s %s — "%s"  (round %s)\n' "$GRN" "$RST" "$pid" "$title" "$round"
  printf '%snext: members speak, then vote — zsynod vote %s aye|nay|abstain%s\n' "$D" "$pid" "$RST"
}

# append honoring an explicit round (used by propose to open a round)
_append_round() {
  local type="$1" data="$2" r="${_ROUND_OVERRIDE:-}"
  [[ -n "$MEMBER" ]] || _die "no member identity — set ZSYNOD_MEMBER or pass --as <member>"
  _member_known "$MEMBER" || _die "unknown member: $MEMBER"
  _lock
  local prev seq
  if [[ -s "$LEDGER" ]]; then prev="$(tail -1 "$LEDGER"|jq -r .hash)"; seq=$(( $(tail -1 "$LEDGER"|jq -r .seq)+1 )); else prev="GENESIS"; seq=0; fi
  [[ -n "$r" ]] || r="$(_cur_round)"
  local base canon h
  base="$(jq -nc --argjson seq "$seq" --arg ts "$(date -u +%FT%TZ)" --argjson round "$r" \
    --arg actor "$MEMBER" --arg type "$type" --argjson data "$data" --arg prev "$prev" \
    '{seq:$seq,ts:$ts,round:$round,actor:$actor,type:$type,data:$data,prev:$prev}')"
  canon="$(printf '%s' "$base"|jq -Sc .)"; h="$(_hash "${prev}${canon}")"
  printf '%s\n' "$(printf '%s' "$base"|jq -c --arg h "$h" '.+{hash:$h}')" >> "$LEDGER"
  _unlock; printf '%s' "$h"
}

_assert_proposal() { _proposal_ids | grep -qx "$1" || _die "no such proposal: $1"; }

cmd_speak() {
  local pid="$1" remark="${2:-}"; _assert_proposal "$pid"; [[ -n "$remark" ]] || _die "speak needs a remark"
  _append speak "$(jq -nc --arg p "$pid" --arg r "$remark" '{proposal:$p,remark:$r}')" >/dev/null
  printf '%s%s spoke%s on %s\n' "$D" "$MEMBER" "$RST" "$pid"
}

cmd_second() {
  local pid="$1"; _assert_proposal "$pid"
  _append second "$(jq -nc --arg p "$pid" '{proposal:$p}')" >/dev/null
  printf '%s%s seconded%s %s (counts as aye)\n' "$GRN" "$RST" "$MEMBER" "$pid"
}

cmd_vote() {
  local pid="$1" v="${2:-}" note="${3:-}"; _assert_proposal "$pid"
  case "$v" in aye|nay|abstain) ;; *) _die "vote must be aye|nay|abstain" ;; esac
  _append vote "$(jq -nc --arg p "$pid" --arg v "$v" --arg n "$note" '{proposal:$p,vote:$v,note:$n}')" >/dev/null
  read -r ay na ab st _ < <(_tally "$pid")
  printf '%s%s voted %s%s on %s — tally: %s/%s aye (quorum %s) %s nay %s abstain [%s]\n' \
    "$B" "$MEMBER" "$v" "$RST" "$pid" "$ay" "$(_voting_ids|wc -l|tr -d ' ')" "$(_quorum)" "$na" "$ab" "$st"
}

cmd_commit() {
  local pid="$1"; _assert_proposal "$pid"
  read -r ay na ab st _ < <(_tally "$pid")
  [[ "$st" == "committed" ]] && { printf 'zsynod: %s already committed\n' "$pid"; return 0; }
  local q; q="$(_quorum)"
  (( ay >= q )) || _die "$pid lacks quorum: $ay/$q aye — not committed"
  _append commit "$(jq -nc --arg p "$pid" --argjson ay "$ay" --argjson q "$q" '{proposal:$p,ayes:$ay,quorum:$q}')" >/dev/null
  cmd_minutes >/dev/null
  printf '%scommitted%s %s (%s/%s aye)\n' "$GRN" "$RST" "$pid" "$ay" "$q"
}

cmd_ratify() {
  local pid="$1"; _assert_proposal "$pid"
  jq -e --arg m "$MEMBER" '.members[]|select(.id==$m and .tier=="principal")' "$MEMBERS" >/dev/null 2>&1 \
    || _die "ratify is principal authority (charter §5) — run with --as mike"
  read -r ay na ab st _ < <(_tally "$pid")
  [[ "$st" == "committed" ]] && { printf 'zsynod: %s already committed\n' "$pid"; return 0; }
  _append commit "$(jq -nc --arg p "$pid" --argjson ay "$ay" '{proposal:$p,by:"principal",ayes:$ay,note:"ratified by principal authority"}')" >/dev/null
  cmd_minutes >/dev/null
  printf '%sratified%s %s by principal authority (%s prior aye)\n' "$GRN" "$RST" "$pid" "$ay"
}

cmd_handoff() {
  local to="$1" task="$2" state="${3:-}" ref="${4:-}"
  [[ -n "$to" && -n "$task" ]] || _die "handoff needs --to and --task"
  _member_known "$to" || _die "unknown receiver: $to"
  _append handoff "$(jq -nc --arg to "$to" --arg t "$task" --arg s "$state" --arg r "$ref" \
    '{to:$to,task:$t,state:$s,ref:$r}')" >/dev/null
  printf '%shandoff%s %s → %s: %s\n' "$YEL" "$RST" "$MEMBER" "$to" "$task"
}

cmd_committee() {
  local id="$1" purpose="$2" participants="$3" meeting_type="${4:-committee}" ref="${5:-}" meta now last_seq data
  [[ -n "$id" ]] || _die "committee needs an id"
  [[ -n "$purpose" ]] || _die "committee needs --purpose"
  _session_valid "$id" || _die "invalid committee id: $id"
  [[ "$meeting_type" == "regular" ]] && meeting_type="committee"
  _validate_participants "$participants"
  mkdir -p "$SESSIONS"
  meta="$(_session_path "$id")"
  [[ ! -e "$meta" ]] || _die "committee/session already exists: $id"
  data="$(jq -nc \
    --arg id "$id" \
    --arg purpose "$purpose" \
    --arg participants "$participants" \
    --arg meeting_type "$meeting_type" \
    --arg ref "$ref" \
    '{
      id:$id,
      purpose:$purpose,
      participants:(if $participants == "" then [] else ($participants|split(",")) end),
      meeting_type:$meeting_type,
      ref:$ref,
      session:{id:$id, transcript:("sessions/" + $id + ".turns.jsonl")}
    }')"
  _append committee "$data" >/dev/null
  now="$(date -u +%FT%TZ)"
  last_seq="$(jq -rs 'map(.seq)|max // 0' "$LEDGER")"
  printf '%s\n' "$data" | jq \
    --arg ts "$now" \
    --argjson last_seq "$last_seq" \
    '. + {
      kind:"committee",
      created_at:$ts,
      last_turn_at:null,
      last_seq:$last_seq,
      last_since:0,
      turn_count:0,
      transcript:.session.transcript,
      resource:null
    }' > "$meta"
  printf '%scommittee%s %s — %s\n' "$GRN" "$RST" "$id" "$purpose"
  printf '%snext: zsynod turn --session %s --participants %s%s\n' "$D" "$id" "${participants:-all-voting}" "$RST"
}

cmd_committees() {
  local rows
  rows="$(jq -rs '[.[]|select(.type=="committee")|.data] | unique_by(.id) | .[] |
    [.id, (.meeting_type // "committee"), ((.participants // []) | join(",")), .purpose] | @tsv' "$LEDGER" 2>/dev/null)"
  [[ -n "$rows" ]] || { printf '%s(no committees yet — zsynod committee <id> --purpose "...")%s\n' "$D" "$RST"; return 0; }
  printf '%s%-24s %-12s %-28s %s%s\n' "$B" "COMMITTEE" "TYPE" "PARTICIPANTS" "PURPOSE" "$RST"
  while IFS=$'\t' read -r id meeting participants purpose; do
    printf '%-24s %-12s %-28s %s\n' "$id" "$meeting" "${participants:-all-voting}" "$purpose"
  done <<< "$rows"
}

cmd_status() {
  cmd_chair
  local q n; q="$(_quorum)"; n="$(_voting_ids|wc -l|tr -d ' ')"
  printf '\n%s%-5s %-9s %-7s %s%s\n' "$B" "PROP" "AYE/Q" "STATE" "TITLE" "$RST"
  local any=0
  while read -r pid; do
    [[ -z "$pid" ]] && continue; any=1
    read -r ay na ab st title < <(_tally "$pid")
    local c="$YEL"; [[ "$st" == "committed" ]] && c="$GRN"
    printf '%-5s %s%s/%s%s     %s%-9s%s %s\n' "$pid" "$B" "$ay" "$q" "$RST" "$c" "$st" "$RST" "$title"
  done < <(_proposal_ids)
  (( any == 0 )) && printf '%s(no proposals yet — zsynod propose "...")%s\n' "$D" "$RST"
  # open handoffs
  local ho; ho="$(jq -rs '[.[]|select(.type=="handoff")]|.[-5:]|.[]|"  "+.actor+" → "+.data.to+": "+.data.task' "$LEDGER" 2>/dev/null)"
  [[ -n "$ho" ]] && { printf '\n%srecent handoffs%s\n%s\n' "$B" "$RST" "$ho"; }
  local co; co="$(jq -rs '[.[]|select(.type=="committee")]|.[-5:]|.[]|"  "+.data.id+" ("+(.data.meeting_type // "committee")+"): "+.data.purpose' "$LEDGER" 2>/dev/null)"
  [[ -n "$co" ]] && { printf '\n%scommittees%s\n%s\n' "$B" "$RST" "$co"; }
}

cmd_log() {
  local round="${1:-}" json="${2:-}"
  if [[ "$json" == "json" ]]; then
    if [[ -n "$round" ]]; then jq -c --argjson r "$round" 'select(.round==$r)' "$LEDGER"; else cat "$LEDGER"; fi
    return
  fi
  jq -r --arg r "${round:-}" 'select($r=="" or (.round|tostring)==$r)
    | "[\(.seq)] r\(.round) \(.actor) \(.type) \(.data.id // .data.proposal // .data.to // "") \(.data.title // .data.remark // .data.vote // .data.task // "")"' "$LEDGER"
}

cmd_verify() {
  local prev="GENESIS" ok=1 ln n=0
  while IFS= read -r ln; do
    n=$((n+1))
    local stored canon h
    stored="$(printf '%s' "$ln" | jq -r '.hash')"
    canon="$(printf '%s' "$ln" | jq 'del(.hash)' | jq -Sc .)"
    h="$(_hash "${prev}${canon}")"
    if [[ "$h" != "$stored" ]]; then printf '%sBROKEN%s at seq %s (expected %s, got %s)\n' "$RED" "$RST" "$(printf '%s' "$ln"|jq -r .seq)" "$h" "$stored"; ok=0; fi
    prev="$stored"
  done < "$LEDGER"
  (( ok == 1 )) && printf '%schain intact%s — %s entries verified\n' "$GRN" "$RST" "$n" || { _die "ledger integrity FAILED"; }
}

_verify_json() {
  local prev="GENESIS" ok=1 ln n=0 broken_seq="" expected="" got=""
  while IFS= read -r ln; do
    n=$((n+1))
    local stored canon h
    stored="$(printf '%s' "$ln" | jq -r '.hash')"
    canon="$(printf '%s' "$ln" | jq 'del(.hash)' | jq -Sc .)"
    h="$(_hash "${prev}${canon}")"
    if [[ "$h" != "$stored" && "$ok" == "1" ]]; then
      ok=0; broken_seq="$(printf '%s' "$ln" | jq -r .seq)"; expected="$h"; got="$stored"
    fi
    prev="$stored"
  done < "$LEDGER"
  jq -nc --argjson ok "$ok" --argjson entries "$n" --arg broken_seq "$broken_seq" \
    --arg expected "$expected" --arg got "$got" \
    '{ok:($ok == 1),entries:$entries}
     + (if $ok == 1 then {} else {broken_seq:($broken_seq|tonumber),expected:$expected,got:$got} end)'
}

_turn_json() {
  local since="${1:-0}" max_tokens="${2:-}" session_id="${3:-}" meeting_type="${4:-regular}" participants="${5:-}" verify_json stdin_text=""
  [[ "$since" =~ ^[0-9]+$ ]] || _die "--since must be a non-negative integer"
  [[ -z "$max_tokens" || "$max_tokens" =~ ^[0-9]+$ ]] || _die "--max-tokens must be a non-negative integer"
  if [[ ! -t 0 ]]; then stdin_text="$(cat)"; fi
  verify_json="$(_verify_json)"
  jq -n \
    --slurpfile ledger "$LEDGER" \
    --slurpfile members "$MEMBERS" \
    --argjson since "$since" \
    --arg max_tokens "$max_tokens" \
    --arg session_id "$session_id" \
    --arg meeting_type "$meeting_type" \
    --arg participants "$participants" \
    --arg stdin "$stdin_text" \
    --argjson verify "$verify_json" '
    def voters: $members[0].members | map(select(.voting) | .id);
    def quorum: ((voters | length) / 2 | floor) + 1;
    def participant_ids: if $participants == "" then voters else ($participants | split(",")) end;
    def latest_votes($p):
      ($ledger
        | map(select((.type == "vote" or .type == "second") and .data.proposal == $p))
        | sort_by(.actor, .seq)
        | group_by(.actor)
        | map(last | if .type == "second" then "aye" else .data.vote end));
    def tally($p):
      (latest_votes($p)) as $v
      | {
          ayes: ($v | map(select(. == "aye")) | length),
          nays: ($v | map(select(. == "nay")) | length),
          abstain: ($v | map(select(. == "abstain")) | length)
        };
    def committed($p): any($ledger[]; .type == "commit" and .data.proposal == $p);
    def max_token_num: if $max_tokens == "" then null else ($max_tokens | tonumber) end;
    def entry_budget: if max_token_num == null then 1000000 else ([((max_token_num / 80) | floor), 1] | max) end;
    def proposals:
      $ledger
      | map(select(.type == "propose"))
      | unique_by(.data.id)
      | map(
          .data as $p
          | (tally($p.id)) as $t
          | (committed($p.id)) as $done
          | {
              id: $p.id,
              title: $p.title,
              round: $p.round,
              state: (if $done then "committed" else "open" end),
              ayes: $t.ayes,
              nays: $t.nays,
              abstain: $t.abstain,
              quorum: quorum,
              needed: (if $done then 0 else ([quorum - $t.ayes, 0] | max) end)
            }
        );
    ($ledger | map(.round) | max // 0) as $round
    | (voters) as $voters
    | (proposals) as $props
    | ($ledger | map(select(.seq > $since))) as $entries_since
    | ($entries_since | if length > entry_budget then .[-entry_budget:] else . end) as $emitted_entries
    | {
        kind: "zsynod_turn",
        round: $round,
        chair: $voters[$round % ($voters | length)],
        quorum: quorum,
        voting_members: ($voters | length),
        last_seq: ($ledger | map(.seq) | max // 0),
        since: $since,
        session: (
          if $session_id == "" then null
          else {
            id: $session_id,
            meeting_type: $meeting_type,
            participants: participant_ids,
            transcript: ("sessions/" + $session_id + ".turns.jsonl")
          }
          end
        ),
        resource: {
          max_tokens: max_token_num,
          entry_budget: entry_budget,
          entries_available: ($entries_since | length),
          entries_emitted: ($emitted_entries | length),
          truncated: (($entries_since | length) > ($emitted_entries | length)),
          status: (if (($entries_since | length) > ($emitted_entries | length)) then "constrained" else "ok" end)
        },
        verify: $verify,
        stdin: (if $stdin == "" then null else $stdin end),
        proposals: $props,
        entries_since: $emitted_entries,
        recent_handoffs: ($ledger | map(select(.type == "handoff")) | .[-10:]),
        suggested_actions: (
          $props
          | map(select(.state == "open"))
          | map(
              if .needed == 0 then
                {proposal:.id, action:"commit", command:("zsynod commit " + .id)}
              else
                {proposal:.id, action:"collect_votes", needed:.needed}
              end
            )
        )
      }'
}

_record_session_turn() {
  local session_id="${1:-}" report="$2" participants="$3" meeting_type="$4" meta turns now created_at turn_count kind purpose ref
  [[ -z "$session_id" ]] && return 0
  _session_valid "$session_id" || _die "invalid session id: $session_id"
  mkdir -p "$SESSIONS"
  meta="$(_session_path "$session_id")"
  turns="$(_session_turns_path "$session_id")"
  now="$(date -u +%FT%TZ)"
  created_at="$now"
  kind="session"; purpose=""; ref=""
  if [[ -f "$meta" ]]; then
    created_at="$(jq -r '.created_at // empty' "$meta")"
    kind="$(jq -r '.kind // "session"' "$meta")"
    purpose="$(jq -r '.purpose // empty' "$meta")"
    ref="$(jq -r '.ref // empty' "$meta")"
  fi
  [[ -n "$created_at" ]] || created_at="$now"
  turn_count=0
  [[ -f "$turns" ]] && turn_count="$(wc -l < "$turns" | tr -d ' ')"
  turn_count=$(( turn_count + 1 ))
  printf '%s\n' "$report" | jq -c --arg ts "$now" --argjson turn "$turn_count" \
    '. + {turn:{index:$turn, recorded_at:$ts}}' >> "$turns"
  printf '%s\n' "$report" | jq \
    --arg id "$session_id" \
    --arg kind "$kind" \
    --arg purpose "$purpose" \
    --arg ref "$ref" \
    --arg meeting_type "$meeting_type" \
    --arg participants "$participants" \
    --arg ts "$now" \
    --arg created_at "$created_at" \
    --arg transcript "$turns" \
    --argjson turn "$turn_count" \
    '{
      id:$id,
      kind:$kind,
      purpose:$purpose,
      ref:$ref,
      meeting_type:$meeting_type,
      participants: (if $participants == "" then [] else ($participants|split(",")) end),
      created_at:$created_at,
      last_turn_at:$ts,
      last_seq:.last_seq,
      last_since:.since,
      turn_count:$turn,
      transcript:$transcript,
      resource:.resource
    }
    | if .purpose == "" then del(.purpose) else . end
    | if .ref == "" then del(.ref) else . end' > "$meta"
}

cmd_turn() {
  local format="${1:-markdown}" since="${2:-0}" max_tokens="${3:-}" session_id="${4:-}" meeting_type="${5:-regular}" participants="${6:-}" report
  [[ -s "$LEDGER" ]] || _die "run 'zsynod init' first"
  cmd_minutes >/dev/null
  [[ -z "$session_id" ]] || _session_valid "$session_id" || _die "invalid session id: $session_id"
  _validate_participants "$participants"
  report="$(_turn_json "$since" "$max_tokens" "$session_id" "$meeting_type" "$participants")" || return 1
  _record_session_turn "$session_id" "$report" "$participants" "$meeting_type"
  if [[ "$format" == "json" ]]; then
    printf '%s\n' "$report"
    return
  fi
  printf '%s\n' "$report" | jq -r '
    "# zsynod turn\n\n"
    + (if .session == null then "" else "session: \(.session.id) · type: \(.session.meeting_type) · participants: \(.session.participants|join(","))\n" end)
    + "round: \(.round) · chair: \(.chair) · quorum: \(.quorum) of \(.voting_members) · last seq: \(.last_seq)\n"
    + "verify: \(if .verify.ok then "ok" else "broken" end) (\(.verify.entries) entries)\n"
    + "resource: \(.resource.status) · emitted \(.resource.entries_emitted)/\(.resource.entries_available) entries"
    + (if .resource.max_tokens == null then "" else " · max tokens \(.resource.max_tokens)" end)
    + "\n\n"
    + "## Proposals\n\n"
    + ((.proposals | map("- **\(.id)** [\(.state)] \(.title) — \(.ayes)/\(.quorum) aye, need \(.needed)") | join("\n")) // "(none)")
    + "\n\n## Since seq \(.since)\n\n"
    + (if (.entries_since|length) == 0 then "(none)" else (.entries_since | map("- [\(.seq)] \(.actor) \(.type) \(.data.id // .data.proposal // .data.to // "") \(.data.title // .data.remark // .data.vote // .data.task // "")") | join("\n")) end)
    + "\n\n## Suggested Actions\n\n"
    + ((.suggested_actions | map(if .action == "commit" then "- \(.proposal): commit ready — `\(.command)`" else "- \(.proposal): collect \(.needed) more aye(s)" end) | join("\n")) // "(none)")
  '
}

# ── tick: one deliberation turn over a backlog issue (charter §1; Kaizen) ─────
# Local pi always deliberates (free). --frontier adds codex + gemini (cloud, opt-in).
# Discussion auto-appends (type=discuss). Proposals and handoffs are GATED: printed
# as ready-to-run commands for the principal to approve — never auto-written.
# Set ZSYNOD_DISPATCH=0 to stub model calls (tests, offline).
_tick_least_discussed() {  # open backlog id with fewest discuss entries (backlog order breaks ties → rotation)
  local ids_json
  ids_json="$(backlog task list --plain 2>/dev/null | sed -nE 's/^[[:space:]]*\[[A-Za-z]+\] (Z-[0-9]+).*/\1/p' | awk '!seen[$0]++' | jq -R . | jq -sc .)"
  [[ -n "$ids_json" && "$ids_json" != "[]" ]] || { echo ""; return; }
  jq -rs --argjson ids "$ids_json" '
    ([.[]|select(.type=="discuss")|.data.topic]|group_by(.)|map({key:.[0],value:length})|from_entries) as $c
    | ($ids|map({id:.,n:($c[.]//0)})|sort_by(.n)|.[0].id) // ""' "$LEDGER" 2>/dev/null
}

_tick_history() {  # <id> -> recent prior remarks on the topic (so deliberation deepens, not repeats)
  jq -rs --arg t "$1" '[.[]|select(.type=="discuss" and .data.topic==$t)]|.[-5:]|.[]|"- "+.actor+": "+.data.remark' "$LEDGER" 2>/dev/null
}

_tick_focus() {  # <topic> -> "ID<TAB>TITLE"
  local topic="$1" line title
  if [[ -z "$topic" ]]; then
    topic="$(_tick_least_discussed)"
    [[ -n "$topic" ]] || { printf 'none\t(no open backlog issues)\n'; return; }
  fi
  # match the line whose LEADING id is the topic (a task title may name other ids)
  line="$(backlog task list --plain 2>/dev/null | grep -iE "^[[:space:]]*\[[A-Za-z]+\] ${topic}([^0-9]|$)" | head -1)"
  [[ -n "$line" ]] || { printf '%s\t(not in backlog — deliberating by id)\n' "$topic"; return; }
  title="$(printf '%s' "$line" | sed -E "s/^[[:space:]]*\[[A-Za-z]+\] ${topic} - //")"
  printf '%s\t%s\n' "$topic" "$title"
}

_tick_dispatch() {  # <member> <prompt> -> raw model output on stdout
  if [[ "${ZSYNOD_DISPATCH:-1}" != "1" ]]; then
    printf 'REMARK: [stub] %s reviewed the issue; bounded next step noted.\nASK: none\n' "$1"; return
  fi
  case "$1" in
    pi)     timeout 120 ai-query "$2" 2>/dev/null ;;
    codex)  timeout 200 codex exec "$2" 2>/dev/null ;;
    gemini) timeout 200 gemini -p "$2" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

_tick_prompt() {  # <member> <id> <title> <body> <history>
  local hist="${5:-}"
  cat <<EOF
You are '$1', a member of the zsynod (AI collaborators' forum on the zdots platform).
Deliberate on ONE issue and make a bounded, material contribution. Be concise (token economy).
Never reveal secrets or PHI. Prefer the smallest sufficient step (Kaizen).

ISSUE $2: $3
$4
$( [[ -n "$hist" ]] && printf 'Prior discussion (ADVANCE it — do NOT repeat what is already said):\n%s\n' "$hist" )
$( [[ -n "$hist" ]] && printf 'This issue already has discussion. If it is ripe, ADVANCE it to action: set ASK to a PROPOSE with a concrete execution plan. Use ASK: none ONLY if genuinely more discussion is needed first.\n' )

Output EXACTLY two lines, nothing else:
REMARK: <one-line analysis or concrete step that ADVANCES the discussion past the prior remarks>
ASK: none | PROPOSE <short title> :: <one-line execution plan> | HANDOFF <member> :: <task>
EOF
}

cmd_tick() {
  local format="${1:-markdown}" topic="${2:-}" frontier="${3:-0}"
  [[ -s "$LEDGER" ]] || _die "run 'zsynod init' first"
  local focus id title body
  focus="$(_tick_focus "$topic")"
  id="${focus%%$'\t'*}"; title="${focus#*$'\t'}"
  body=""
  if [[ "${ZSYNOD_DISPATCH:-1}" == "1" && "$id" == Z-* ]]; then
    body="$(backlog task "$id" --plain 2>/dev/null | head -30)"
  fi

  local hist; hist="$(_tick_history "$id")"

  local -a who=(pi)
  [[ "$frontier" == "1" ]] && who+=(codex gemini)
  local -a asks=() said_by=() said_remark=()
  local m out remark ask save
  for m in "${who[@]}"; do
    _member_known "$m" || continue
    out="$(_tick_dispatch "$m" "$(_tick_prompt "$m" "$id" "$title" "$body" "$hist")")"
    [[ -n "$out" ]] || continue
    remark="$(printf '%s' "$out" | sed -nE 's/^REMARK:[[:space:]]*//p' | head -1)"
    [[ -n "$remark" ]] || remark="$(printf '%s' "$out" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//' | cut -c1-240)"
    ask="$(printf '%s' "$out" | sed -nE 's/^ASK:[[:space:]]*//p' | head -1)"
    save="$MEMBER"; MEMBER="$m"
    _append discuss "$(jq -nc --arg t "$id" --arg r "$remark" '{topic:$t,remark:$r}')" >/dev/null
    MEMBER="$save"
    said_by+=("$m"); said_remark+=("$remark")
    hist="${hist:+$hist$'\n'}- $m: $remark"   # later members this tick build on earlier ones
    case "$ask" in
      PROPOSE*) local pt pb; pt="$(printf '%s' "$ask" | sed -E 's/^PROPOSE[[:space:]]*//; s/ ::.*//')"
        pb="$(printf '%s' "$ask" | sed -E 's/.* :: //')"
        asks+=("[$m] zsynod propose \"$pt\" --body \"$pb\"") ;;
      HANDOFF*) local hm ht; hm="$(printf '%s' "$ask" | sed -E 's/^HANDOFF[[:space:]]*//; s/ ::.*//')"
        ht="$(printf '%s' "$ask" | sed -E 's/.* :: //')"
        asks+=("[$m] zsynod handoff --to $hm --task \"$ht\" --ref $id") ;;
    esac
  done
  cmd_minutes >/dev/null

  if [[ "$format" == "json" ]]; then
    local disc i
    disc="$(jq -nc '[]')"
    for i in "${!said_by[@]}"; do
      disc="$(printf '%s' "$disc" | jq -c --arg a "${said_by[$i]}" --arg r "${said_remark[$i]}" '. + [{actor:$a,remark:$r}]')"
    done
    local askj='[]'
    if [[ ${#asks[@]} -gt 0 ]]; then
      askj="$(printf '%s\n' "${asks[@]}" | jq -R . | jq -sc .)"
    fi
    jq -nc --arg id "$id" --arg title "$title" --argjson disc "$disc" --argjson asks "$askj" \
      --argjson entries "$(wc -l < "$LEDGER" | tr -d ' ')" \
      '{topic:$id,title:$title,discussion:$disc,asks_awaiting_approval:$asks,entries:$entries}'
    return
  fi

  printf '%s# zsynod tick — %s %s%s\n' "$B" "$id" "$title" "$RST"
  printf '%sparticipants: %s%s\n\n' "$D" "${who[*]}" "$RST"
  printf 'discussion (appended to ledger):\n'
  local i
  if [[ ${#said_by[@]} -eq 0 ]]; then
    printf '  (no contributions this tick)\n'
  else
    for i in "${!said_by[@]}"; do printf '  %s· %s%s: %s\n' "$CYN" "${said_by[$i]}" "$RST" "${said_remark[$i]}"; done
  fi
  printf '\n%sasks awaiting your approval%s (nothing written — run a line to approve):\n' "$YEL" "$RST"
  if [[ ${#asks[@]} -eq 0 ]]; then printf '  (none)\n'; else printf '  %s\n' "${asks[@]}"; fi
  printf '\nverify: %s\n' "$(cmd_verify 2>&1 | tail -1)"
}

cmd_history() {  # chronological discussion record over time; optional filter (Z-NNN topic or P# proposal)
  local filter="${1:-}"
  [[ -s "$LEDGER" ]] || _die "run 'zsynod init' first"
  jq -rs --arg f "$filter" '
    def clip: if (.|length) > 200 then .[0:200]+"…" else . end;
    [.[]|select(.type=="speak" or .type=="discuss" or (.type=="vote" and (.data.note//"")!=""))]
    | map(select($f=="" or (.data.proposal==$f) or (.data.topic==$f)))
    | .[]
    | (.ts[0:16]) + "  " + .actor
      + (if .type=="discuss" then " ["+(.data.topic//"?")+"]" elif (.data.proposal//"")!="" then " ["+.data.proposal+"]" else "" end)
      + (if .type=="vote" then " ("+.data.vote+")" else "" end)
      + ": " + ((.data.remark // .data.note // "") | clip)
  ' "$LEDGER" 2>/dev/null
}

# ── queue: priority + dependency aware review of proposed diffs (charter §0.5) ─
# Members (esp. frontier-execution ticks) propose diffs here; the principal
# reasons over them in dependency-topo + priority order and applies the ready
# ones. Patches live in zsynod/queue/<Qid>.patch (gitignored); the ledger records
# each queued item and every status change (canon, attributed, over-time record).
QUEUE="$DIR/queue"

_q_prank()  { case "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" in HIGH) echo 0;; LOW) echo 2;; *) echo 1;; esac; }
_q_next()   { local n; n="$(jq -rs '[.[]|select(.type=="queued")|.data.id|ltrimstr("Q")|tonumber]|max // 0' "$LEDGER" 2>/dev/null)"; echo "Q$(( ${n:-0} + 1 ))"; }
_q_status() { jq -rs --arg q "$1" '[.[]|select((.type=="queued" or .type=="queue_status") and .data.id==$q)] | (last.data.status // (if length>0 then "queued" else "" end))' "$LEDGER" 2>/dev/null; }
_q_meta()   { jq -rs --arg q "$1" '[.[]|select(.type=="queued" and .data.id==$q)]|last.data // empty' "$LEDGER" 2>/dev/null; }

_q_add() {  # uses globals REF SUMMARY PRIORITY AFTER PATCHSRC; patch from --patch file or stdin
  [[ -n "$MEMBER" ]] || _die "queue add needs member identity (--as or ZSYNOD_MEMBER)"
  [[ -n "$SUMMARY" ]] || _die "queue add needs --summary"
  mkdir -p "$QUEUE"
  local qid patchfile prio afterj
  qid="$(_q_next)"; patchfile="$QUEUE/$qid.patch"
  if [[ -n "$PATCHSRC" && "$PATCHSRC" != "-" ]]; then
    [[ -f "$PATCHSRC" ]] || _die "patch file not found: $PATCHSRC"
    cp "$PATCHSRC" "$patchfile"
  else
    cat > "$patchfile"
  fi
  [[ -s "$patchfile" ]] || { rm -f "$patchfile"; _die "empty patch — nothing queued"; }
  prio="$PRIORITY"
  if [[ -z "$prio" ]]; then
    [[ "$REF" == Z-* ]] && prio="$(backlog task "$REF" --plain 2>/dev/null | sed -nE 's/.*[Pp]riority:?[[:space:]]*([A-Za-z]+).*/\1/p' | head -1)"
    prio="${prio:-MEDIUM}"
  fi
  prio="$(printf '%s' "$prio" | tr '[:lower:]' '[:upper:]')"
  afterj="$(printf '%s' "$AFTER" | tr ',' '\n' | sed '/^$/d' | jq -R . | jq -sc .)"
  _append queued "$(jq -nc --arg id "$qid" --arg ref "$REF" --arg s "$SUMMARY" --arg p "$prio" --argjson after "$afterj" --arg patch "queue/$qid.patch" \
    '{id:$id,ref:$ref,summary:$s,priority:$p,after:$after,patch:$patch,status:"queued"}')" >/dev/null
  printf 'queued %s [%s] %s%s\n' "$qid" "$prio" "$SUMMARY" "${REF:+ (ref $REF)}"
}

_q_ready() {  # <Qid> -> ready|blocked  (all 'after' deps applied?)
  local dep r="ready"
  while IFS= read -r dep; do [[ -z "$dep" ]] && continue; [[ "$(_q_status "$dep")" == "applied" ]] || r="blocked"; done < <(_q_meta "$1" | jq -r '.after[]? // empty')
  echo "$r"
}

_q_list() {
  local -a qids; mapfile -t qids < <(jq -rs '[.[]|select(.type=="queued")|.data.id]|unique|.[]' "$LEDGER" 2>/dev/null)
  if [[ ${#qids[@]} -eq 0 ]]; then printf 'queue empty — no proposed diffs.\n'; return; fi
  printf '%sproposed-diff queue%s (dependency + priority ordered)\n\n' "$B" "$RST"
  local qid meta status prio ref summary rrank rows=""
  for qid in "${qids[@]}"; do
    status="$(_q_status "$qid")"; [[ "$status" == "rejected" ]] && continue
    meta="$(_q_meta "$qid")"
    prio="$(printf '%s' "$meta" | jq -r '.priority // "MEDIUM"')"
    ref="$(printf '%s'  "$meta" | jq -r '.ref // ""')"
    summary="$(printf '%s' "$meta" | jq -r '.summary // ""')"
    case "$status" in
      applied)  rrank=3 ;;
      deferred) rrank=2 ;;
      *) [[ "$(_q_ready "$qid")" == "ready" ]] && rrank=0 || rrank=1 ;;
    esac
    rows+="$rrank	$(_q_prank "$prio")	$qid	$status	$prio	$ref	$summary"$'\n'
  done
  local rr _pr _st rf sm label; printf '%s' "$rows" | sort -t$'\t' -k1,1n -k2,2n -k3,3 | while IFS=$'\t' read -r rr _pr qid _st prio rf sm; do
    [[ -z "$qid" ]] && continue
    case "$rr" in 0) label="READY ";; 1) label="blocked";; 2) label="defer ";; 3) label="done  ";; *) label="?";; esac
    printf '  %-6s %-7s [%-6s] %s%s\n' "$qid" "$label" "$prio" "$sm" "${rf:+ (ref $rf)}"
  done
  _q_overlap_warn
}

_q_overlap_warn() {  # inferred deps: unapplied queued patches touching the same file
  local qid f pairs="" line
  while IFS= read -r qid; do
    [[ -z "$qid" ]] && continue
    local stt; stt="$(_q_status "$qid")"; [[ "$stt" == "applied" || "$stt" == "rejected" ]] && continue
    local pf="$QUEUE/$qid.patch"; [[ -f "$pf" ]] || continue
    while IFS= read -r f; do [[ -n "$f" ]] && pairs+="$f	$qid"$'\n'; done < <(sed -nE 's#^\+\+\+ b/##p' "$pf")
  done < <(jq -rs '[.[]|select(.type=="queued")|.data.id]|unique|.[]' "$LEDGER" 2>/dev/null)
  line="$(printf '%s' "$pairs" | sort | awk -F'\t' 'NF==2{c[$1]=c[$1]" "$2} END{for(k in c){n=split(c[k],a," ")-1; if(n>1) print "  ⚠ "k" touched by:"c[k]}}')"
  [[ -n "$line" ]] && { printf '\n%sinferred file overlaps%s (consider --after to order):\n%s\n' "$YEL" "$RST" "$line"; }
  return 0
}

_q_show() {
  local qid="$1"; [[ -n "$qid" ]] || _die "queue show needs a Q id"
  local meta; meta="$(_q_meta "$qid")"; [[ -n "$meta" ]] || _die "no such queued item: $qid"
  printf '%s%s%s  [%s]  status: %s  ready: %s\n' "$B" "$qid" "$RST" \
    "$(printf '%s' "$meta" | jq -r '.priority')" "$(_q_status "$qid")" "$(_q_ready "$qid")"
  printf '%s\n' "$(printf '%s' "$meta" | jq -r '"ref: "+(.ref//"-")+"   after: "+((.after//[])|join(",")|if .=="" then "-" else . end)+"\nsummary: "+.summary')"
  local pf="$QUEUE/$qid.patch"
  printf '\n%spatch%s (%s):\n' "$B" "$RST" "$pf"
  if [[ -f "$pf" ]]; then git apply --stat "$pf" 2>/dev/null || cat "$pf"; else printf '  (patch file missing)\n'; fi
}

_q_apply() {
  local qid="$1"; [[ -n "$qid" ]] || _die "queue apply needs a Q id"
  [[ -n "$MEMBER" ]] || _die "queue apply needs member identity (--as or ZSYNOD_MEMBER)"
  local meta; meta="$(_q_meta "$qid")"; [[ -n "$meta" ]] || _die "no such queued item: $qid"
  [[ "$(_q_status "$qid")" == "applied" ]] && _die "$qid already applied"
  # covenant: do not force — refuse if deps unmet or the patch will not apply cleanly
  local dep
  while IFS= read -r dep; do [[ -z "$dep" ]] && continue
    [[ "$(_q_status "$dep")" == "applied" ]] || _die "$qid blocked: dependency $dep not applied yet"
  done < <(printf '%s' "$meta" | jq -r '.after[]? // empty')
  local pf="$QUEUE/$qid.patch"; [[ -f "$pf" ]] || _die "patch file missing: $pf"
  git apply --check "$pf" 2>/dev/null || _die "$qid does not apply cleanly to the working tree — refused (covenant: do not force)"
  git apply "$pf" || _die "$qid apply failed"
  _append queue_status "$(jq -nc --arg id "$qid" --arg s applied '{id:$id,status:$s}')" >/dev/null
  printf '%sapplied %s%s to the working tree. Review and commit when ready.\n' "$GRN" "$qid" "$RST"
}

_q_set() {  # <Qid> <status> [note]
  local qid="$1" status="$2" note="${3:-}"
  [[ -n "$qid" ]] || _die "queue $status needs a Q id"
  [[ -n "$MEMBER" ]] || _die "queue $status needs member identity (--as or ZSYNOD_MEMBER)"
  [[ -n "$(_q_meta "$qid")" ]] || _die "no such queued item: $qid"
  _append queue_status "$(jq -nc --arg id "$qid" --arg s "$status" --arg n "$note" '{id:$id,status:$s,note:$n}')" >/dev/null
  printf '%s marked %s%s\n' "$qid" "$status" "${note:+ — $note}"
}

cmd_queue() {
  [[ -s "$LEDGER" ]] || _die "run 'zsynod init' first"
  local sub="${1:-list}"
  case "$sub" in
    add)     _q_add ;;
    list|"") _q_list ;;
    show)    _q_show "${2:-}" ;;
    apply)   _q_apply "${2:-}" ;;
    reject)  _q_set "${2:-}" rejected "${3:-}" ;;
    defer)   _q_set "${2:-}" deferred "${3:-}" ;;
    *) _die "queue: unknown subcommand '$sub' (add|list|show|apply|reject|defer)" ;;
  esac
}

cmd_minutes() {
  local pid ay na ab st title   # keep local: dynamic scope else clobbers callers
  { printf '# zsynod — minutes (generated from ledger.jsonl; do not edit)\n\n'
    printf '_Round %s · chair %s · quorum %s of %s · %s entries_\n\n' \
      "$(_cur_round)" "$(cmd_chair 2>/dev/null | sed -E 's/.*chair: ([^ ]*).*/\1/;s/\x1b\[[0-9;]*m//g')" \
      "$(_quorum)" "$(_voting_ids|wc -l|tr -d ' ')" "$(wc -l < "$LEDGER"|tr -d ' ')"
    printf '## Proposals\n\n'
    while read -r pid; do
      [[ -z "$pid" ]] && continue
      read -r ay na ab st title < <(_tally "$pid")
      printf -- '- **%s** [%s] %s — %s/%s aye, %s nay, %s abstain\n' "$pid" "$st" "$title" "$ay" "$(_voting_ids|wc -l|tr -d ' ')" "$na" "$ab"
      # discussion + votes-with-notes under each proposal (the missing context)
      jq -rs --arg p "$pid" '
        def clip: if (.|length) > 240 then .[0:240]+"…" else . end;
        [.[]|select((.type=="speak" or (.type=="vote" and (.data.note//"")!="")) and .data.proposal==$p)]
        | .[-8:] | .[]
        | if .type=="speak" then "    - "+.actor+": "+(.data.remark|clip)
          else "    - "+.actor+" ("+.data.vote+"): "+(.data.note|clip) end' "$LEDGER" 2>/dev/null
    done < <(_proposal_ids)
    printf '\n## Backlog deliberation (ticks)\n\n'
    jq -rs '
      def clip: if (.|length) > 240 then .[0:240]+"…" else . end;
      [.[]|select(.type=="discuss")] | group_by(.data.topic)
      | map("- **"+.[0].data.topic+"**\n"+([.[]|"    - "+.actor+": "+(.data.remark|clip)]|.[-5:]|join("\n")))
      | .[]' "$LEDGER" 2>/dev/null
    printf '\n## Open questions\n\n'
    jq -rs '[.[]|select(.type=="question")]|.[-10:]|.[]|"- ("+.actor+") "+.data.text' "$LEDGER" 2>/dev/null
    printf '\n## Committees\n\n'
    jq -rs '[.[]|select(.type=="committee")]|.[-10:]|.[]|"- **"+.data.id+"** ("+(.data.meeting_type // "committee")+") "+.data.purpose+" — "+((.data.participants // [])|join(","))' "$LEDGER" 2>/dev/null
    printf '\n## Recent handoffs\n\n'
    jq -rs '[.[]|select(.type=="handoff")]|.[-10:]|.[]|"- "+.actor+" → "+.data.to+": "+.data.task' "$LEDGER" 2>/dev/null
  } > "$MINUTES"
  printf 'zsynod: wrote %s\n' "$MINUTES"
}

cmd_view() {  # regenerate + display the minutes
  cmd_minutes >/dev/null
  if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then less -R "$MINUTES"; else cat "$MINUTES"; fi
}

cmd_ask() {  # pose a question to the forum (logged, no vote required)
  local q="$1"; [[ -n "$q" ]] || _die "ask needs a question"
  _append question "$(jq -nc --arg t "$q" '{text:$t}')" >/dev/null
  printf '%squestion logged%s by %s — answer with: zsynod speak <P#> "..." or zsynod log\n' "$CYN" "$RST" "$MEMBER"
}

cmd_tail() {  # tail a member's captured transcript (latest stamp)
  local m="$1" follow="${2:-}" n="${3:-40}" TDIR="$DIR/transcripts"
  [[ -d "$TDIR" ]] || _die "no transcripts yet — convene first"
  if [[ -z "$m" ]]; then
    printf '%stranscripts (member.stamp.log):%s\n' "$B" "$RST"; ls -1t "$TDIR" 2>/dev/null | sed 's/^/  /'; return
  fi
  local f; f="$(ls -1t "$TDIR/$m."*.log 2>/dev/null | head -1)"
  [[ -n "$f" ]] || _die "no transcript for '$m' (try: zsynod tail)"
  if [[ "$follow" == "-f" || "$follow" == "f" ]]; then tail -n "$n" -f "$f"; else tail -n "$n" "$f"; fi
}

cmd_console() {  # interactive principal cockpit — prompts for input
  if [[ "$HEADLESS" == "1" ]]; then
    cmd_turn "$FORMAT" "$SINCE" "$MAX_TOKENS" "$TURN_SESSION" "$MEETING_TYPE" "$TURN_PARTICIPANTS"
    return
  fi
  MEMBER="${MEMBER:-mike}"
  _member_known "$MEMBER" || _die "unknown member: $MEMBER"
  printf '%szsynod console%s — acting as %s. (q to exit)\n' "$B" "$RST" "$MEMBER"
  local choice open
  while :; do
    open=""
    while read -r p; do [[ -z "$p" ]] && continue; read -r _a _n _ab st _ < <(_tally "$p"); [[ "$st" == "open" ]] && open+="$p "; done < <(_proposal_ids)
    printf '\n%szsynod [round %s · open: %s]%s\n' "$D" "$(_cur_round)" "${open:-none}" "$RST"
    printf '  (s)tatus (m)inutes (t)ail (p)ropose (a)sk (r)atify (q)uit > '
    read -r choice || break
    case "$choice" in
      s) cmd_status ;;
      m) cmd_view ;;
      t) local mm; read -r -p "  member (blank=list): " mm; cmd_tail "$mm" ;;
      p) local title body; read -r -p "  proposal title: " title; [[ -z "$title" ]] && continue
         read -r -p "  body (optional): " body; cmd_propose "$title" "$body" "" ;;
      a) local q; read -r -p "  question: " q; [[ -n "$q" ]] && cmd_ask "$q" ;;
      r) local rp; read -r -p "  ratify proposal id: " rp; [[ -n "$rp" ]] && cmd_ratify "$rp" ;;
      q|"") break ;;
      *) printf '  ? — pick s/m/t/p/a/r/q\n' ;;
    esac
  done
  printf 'console closed.\n'
}

# ── convene: one tmux room at a time (charter §4 single-instance) ────────────
# The tmux session name IS the singleton lock — only one "zsynod" forum can be
# convened. Every seat starts in $ZDOTDIR (where the ledger lives) with its
# member identity preset and a primer; the launch command for known agents is
# pre-typed (not run) so the human reviews and presses Enter.
_launch_cmd() {  # member id → its agent command (members.json override wins)
  local m="$1" c
  c="$(jq -r --arg m "$m" '.members[]|select(.id==$m)|.command // ""' "$MEMBERS" 2>/dev/null)"
  [[ -n "$c" ]] && { printf '%s' "$c"; return; }
  case "$m" in claude) printf 'cl' ;; pi) printf 'zpi' ;; aider) printf 'zaider' ;; *) printf '' ;; esac
}

# ── pane entrypoints (run AS a pane's command — no send-keys) ────────────────
cmd_seat() {  # banner for a member's seat, then drop into an interactive shell
  local id="${1:-${ZSYNOD_MEMBER:-}}"; [[ -n "$id" ]] || _die "seat needs a member id"
  local lane cmd
  lane="$(jq -r --arg m "$id" '.members[]|select(.id==$m)|.lane' "$MEMBERS" 2>/dev/null)"
  cmd="$(_launch_cmd "$id")"
  clear 2>/dev/null || true
  printf '%s┌─ zsynod · seat: %s ─┐%s\n' "$B" "$id" "$RST"
  printf 'you are %s%s%s — %s\n' "$B" "$id" "$RST" "${lane:-member}"
  printf 'charter: %s · catch up: zsynod status · minutes: zsynod view\n' "$CHARTER"
  printf 'act: zsynod speak|second|vote <P#> · handoff: zsynod handoff --to <m> --task "..."\n'
  printf '%s§6 shared:%s PHI · append-only ledger · complete handoffs · scope · right-size · token economy (be brief; the strongest most of all)\n' "$D" "$RST"
  [[ -n "$cmd" ]] && printf '%s▶ launch:%s %s\n' "$GRN" "$RST" "$cmd"
  printf '\n'
  exec "${SHELL:-/bin/zsh}" -i
}

cmd_watch() {  # live status loop for the floor window
  local secs="${ZSYNOD_WATCH_SECS:-5}"
  while :; do
    clear 2>/dev/null || true
    cmd_status
    printf '\n%s(refreshing every %ss · Ctrl-b o → chair seat · Ctrl-b <n> → a seat)%s\n' "$D" "$secs" "$RST"
    sleep "$secs"
  done
}

# ── tmux interface suite (the api; never type raw tmux) ───────────────────────
_has_room() { tmux has-session -t "$SESSION" 2>/dev/null; }
cmd_attach() {
  _has_room || _die "no forum convened — run: zsynod convene"
  if [[ -n "${TMUX:-}" ]]; then tmux switch-client -t "$SESSION"; else exec tmux attach -t "$SESSION"; fi
}
cmd_adjourn() {
  _has_room || { printf 'zsynod: no forum convened\n'; return 0; }
  tmux kill-session -t "$SESSION"
  printf '%sadjourned%s — transcripts kept in %s/transcripts/\n' "$YEL" "$RST" "$DIR"
}
cmd_goto() {
  local m="${1:-}"; [[ -n "$m" ]] || _die "goto needs a member"
  _has_room || _die "no forum convened"
  tmux select-window -t "$SESSION:$m" 2>/dev/null || _die "no seat: $m (try: zsynod room)"
  [[ -z "${TMUX:-}" ]] && exec tmux attach -t "$SESSION"
}
cmd_room() {
  _has_room || { printf 'zsynod: no forum convened\n'; return 0; }
  printf '%sroom %s:%s\n' "$B" "$SESSION" "$RST"
  tmux list-windows -t "$SESSION" -F '  #{window_index}: #{window_name}#{?window_active, (active),}'
}

cmd_convene() {
  command -v tmux >/dev/null 2>&1 || _die "tmux is required to convene"
  [[ -s "$LEDGER" ]] || _die "run 'zsynod init' first"
  local S="$SESSION"
  if tmux has-session -t "$S" 2>/dev/null; then
    printf '%szsynod already convened%s (single-instance) — attaching.\n' "$YEL" "$RST" >&2
    exec tmux attach -t "$S"
  fi

  # transcripts: capture each seat's raw session output for the principal to
  # review/document as the conversation progresses. LOCAL ONLY and gitignored —
  # raw agent I/O may contain sensitive content; never commit or send to a cloud.
  local TDIR="$DIR/transcripts" stamp; stamp="$(date +%Y%m%d-%H%M)"
  mkdir -p "$TDIR"
  _capture() { tmux pipe-pane -o -t "$1" "cat >> '$TDIR/$2.$stamp.log'"; }

  # Every pane runs a zsynod entrypoint AS ITS COMMAND — no send-keys, no
  # prompt-race, no quoting: `zsynod watch` (live status) and `zsynod seat <id>`
  # (banner → interactive shell). Identity is passed via tmux env (-e).
  tmux new-session -d -s "$S" -n floor -c "$ZDOTDIR" "'$SELF' watch"
  tmux split-window -h -t "$S:floor" -c "$ZDOTDIR" -e "ZSYNOD_MEMBER=mike" "'$SELF' seat mike"
  _capture "$S:floor.1" "floor"

  local id
  while read -r id; do
    [[ -z "$id" ]] && continue
    tmux new-window -t "$S" -n "$id" -c "$ZDOTDIR" -e "ZSYNOD_MEMBER=$id" "'$SELF' seat $id"
    _capture "$S:$id" "$id"
  done < <(_voting_ids)

  tmux select-window -t "$S:floor"
  printf '%sconvened%s — %s seats + floor · transcripts → %s/*.%s.log (local, gitignored)\n' \
    "$GRN" "$RST" "$(_voting_ids|wc -l|tr -d ' ')" "$TDIR" "$stamp"
  printf '%sin-room: Ctrl-b <n> a seat · detach Ctrl-b d · zsynod goto <m> · zsynod adjourn%s\n' "$D" "$RST"
  exec tmux attach -t "$S"
}

# ── arg parse (flags anywhere; first non-flag is the subcommand) ─────────────
POS=(); BODY=""; ROUND=""; NOTE=""; TO=""; TASK=""; STATE=""; REF=""; PURPOSE=""; FOLLOW=""; LINES=""; SINCE="0"; SINCE_SET="0"; MAX_TOKENS=""; FORMAT="markdown"; HEADLESS="0"; TURN_SESSION=""; FRONTIER="0"; PARTICIPANTS=""; PARTICIPANTS_SET="0"; MEETING_TYPE="regular"; MEETING_SET="0"; TOPIC=""; AFTER=""; PRIORITY=""; SUMMARY=""; PATCHSRC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --as) MEMBER="$2"; shift 2 ;;
    --body) BODY="$2"; shift 2 ;;
    --round) ROUND="$2"; shift 2 ;;
    --note) NOTE="$2"; shift 2 ;;
    --to) TO="$2"; shift 2 ;;
    --task) TASK="$2"; shift 2 ;;
    --state) STATE="$2"; shift 2 ;;
    --ref) REF="$2"; shift 2 ;;
    --purpose) PURPOSE="$2"; shift 2 ;;
    --since) SINCE="$2"; SINCE_SET="1"; shift 2 ;;
    --max-tokens) MAX_TOKENS="$2"; shift 2 ;;
    --session) TURN_SESSION="$2"; shift 2 ;;
    --topic) TOPIC="$2"; shift 2 ;;
    --after) AFTER="$2"; shift 2 ;;
    --priority) PRIORITY="$2"; shift 2 ;;
    --summary) SUMMARY="$2"; shift 2 ;;
    --patch) PATCHSRC="$2"; shift 2 ;;
    --frontier) FRONTIER="1"; PARTICIPANTS_SET="1"; MEETING_TYPE="${MEETING_TYPE:-frontier}"; [[ "$MEETING_TYPE" == "regular" ]] && MEETING_TYPE="frontier"; shift ;;
    --participants) PARTICIPANTS="$2"; PARTICIPANTS_SET="1"; shift 2 ;;
    --meeting) MEETING_TYPE="$2"; MEETING_SET="1"; shift 2 ;;
    --headless) HEADLESS="1"; shift ;;
    --markdown) FORMAT="markdown"; shift ;;
    -f|--follow) FOLLOW="f"; shift ;;
    -n|--lines) LINES="$2"; shift 2 ;;
    --json) FORMAT="json"; POS+=("__json__"); shift ;;
    -h|--help|help) _usage; exit 0 ;;
    -*) _die "unknown flag: $1" ;;
    *) POS+=("$1"); shift ;;
  esac
done

TURN_PARTICIPANTS="$(_participants_csv "$PARTICIPANTS" "$FRONTIER")"
if [[ -n "$TURN_SESSION" && "$PARTICIPANTS_SET" == "0" ]]; then
  TURN_PARTICIPANTS="$(_session_resume_participants "$TURN_SESSION")"
fi
if [[ -n "$TURN_SESSION" && "$MEETING_SET" == "0" ]]; then
  MEETING_TYPE="$(_session_resume_meeting_type "$TURN_SESSION" "$MEETING_TYPE")"
fi
if [[ -n "$TURN_SESSION" && "$SINCE_SET" == "0" ]]; then
  SINCE="$(_session_resume_since "$TURN_SESSION" "$SINCE")"
fi

SUB="${POS[0]:-}"
case "$SUB" in
  init)     cmd_init ;;
  members)  cmd_members ;;
  status)   cmd_status ;;
  chair)    cmd_chair ;;
  propose)  cmd_propose "${POS[1]:-}" "$BODY" "$ROUND" ;;
  speak)    cmd_speak "${POS[1]:-}" "${POS[2]:-}" ;;
  second)   cmd_second "${POS[1]:-}" ;;
  vote)     cmd_vote "${POS[1]:-}" "${POS[2]:-}" "$NOTE" ;;
  commit)   cmd_commit "${POS[1]:-}" ;;
  ratify)   cmd_ratify "${POS[1]:-}" ;;
  handoff)  cmd_handoff "$TO" "$TASK" "$STATE" "$REF" ;;
  committee) cmd_committee "${POS[1]:-}" "$PURPOSE" "$TURN_PARTICIPANTS" "$MEETING_TYPE" "$REF" ;;
  committees) cmd_committees ;;
  log)      cmd_log "$ROUND" "$([[ " ${POS[*]} " == *" __json__ "* ]] && echo json)" ;;
  minutes)  cmd_minutes ;;
  view)     cmd_view ;;
  history)  cmd_history "${POS[1]:-}" ;;
  queue)    cmd_queue "${POS[1]:-}" "${POS[2]:-}" "${POS[3]:-}" ;;
  turn)     cmd_turn "$FORMAT" "$SINCE" "$MAX_TOKENS" "$TURN_SESSION" "$MEETING_TYPE" "$TURN_PARTICIPANTS" ;;
  tick)     cmd_tick "$FORMAT" "$TOPIC" "$FRONTIER" ;;
  tail)     cmd_tail "${POS[1]:-}" "$FOLLOW" "${LINES:-40}" ;;
  ask)      cmd_ask "${POS[1]:-}" ;;
  console)  cmd_console ;;
  verify)   cmd_verify ;;
  convene)  cmd_convene ;;
  attach)   cmd_attach ;;
  adjourn)  cmd_adjourn ;;
  goto)     cmd_goto "${POS[1]:-}" ;;
  room)     cmd_room ;;
  seat)     cmd_seat "${POS[1]:-}" ;;
  watch)    cmd_watch ;;
  ""|-h|--help) _usage ;;
  *) _die "unknown subcommand: $SUB (try -h)" ;;
esac
