#!/usr/bin/env python3
"""
bin/zdots-pulse - A high-signal, one-line-per-system status overview.
Designed for quick discovery and orientation in a complex environment.
"""

import argparse
import sys
from pathlib import Path

# Colors for TTY
def color(text, code):
    if sys.stdout.isatty():
        return f"\033[{code}m{text}\033[0m"
    return text

def get_status():
    zdotdir = Path.home() / ".config" / "zsh"
    
    print(color("--- Zdots Platform Pulse ---", "1;36"))
    
    # 1. Service Pulse
    import subprocess
    try:
        # Check llama-ctl health (silent)
        res = subprocess.run([str(zdotdir / "bin" / "llama-ctl"), "health"], capture_output=True)
        status = color("UP", "32") if res.returncode == 0 else color("DOWN", "31")
        print(f"{color('AI (Local):', '1')} {status}")
    except:
        print(f"{color('AI (Local):', '1')} {color('Unknown', '33')}")

    # 2. Optional attached vault context notes
    import os
    vault_root = os.environ.get("ZDOTS_VAULT_ROOT") or os.environ.get("ZDOTS_MY_ROOT") or ""
    if vault_root:
        ctx_path = Path(vault_root) / "context"
        if ctx_path.exists():
            notes = list(ctx_path.glob("*.md"))
            print(f"{color('Knowledge:', '1')} {len(notes)} context notes in {ctx_path}")

    # 3. Next Step Guidance
    print(f"\n{color('Discovery:', '1')} Run {color('agent-guide', '33')} for full connection details and man pages.")

if __name__ == "__main__":
    # Parse args (and answer -h/--help) BEFORE any probe runs (Z-249).
    parser = argparse.ArgumentParser(
        prog="zdots-pulse",
        description="High-signal, one-line-per-system zdots status overview.",
    )
    parser.parse_args()
    get_status()
