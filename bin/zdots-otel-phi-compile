#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/zdots-otel-phi-compile — compile the OTel collector's PHI scrub layer from
# the single pattern registry (etc/phi-patterns.yaml).
#
# This is the "scrub at the edge" cornerstone: rather than re-scrubbing telemetry
# every time a session reads it back, the collector masks/drops sensitive values
# on the way INTO OpenObserve, so the intelligence layer reads already-clean data.
# Per AGENTS.md §10 the collector must never hand-author patterns — it is a
# compiled consumer of the registry, exactly like phi_scrubber.bash/.rb.
#
# Reads:  etc/otel-collector.yaml      (base pipeline config — source of truth)
#         etc/phi-patterns.yaml        (the only place patterns are defined)
# Writes: etc/otel-collector.generated.yaml  (gitignored; what `serve` runs)
#
# It injects these processors, sourced entirely from the registry:
#   redaction/phi        — masks any ATTRIBUTE value matching a pattern (all signals)
#   transform/phi        — redacts log BODIES via OTTL replace_pattern (logs only)
#   transform/phi/traces — redacts span + spanevent attribute VALUES (traces).
#                          Emitted only for patterns carrying `trace_targets:`
#                          plus any `structural:` URL-path rules. RE2 (Go) regex,
#                          passed VERBATIM (RE2 supports POSIX classes natively —
#                          no translation; same escaped regex as the log path).
#                          Replacement capture refs are DOUBLE-$ ($$1 / $${1}):
#                          a bare ${1} HARD-ERRORS at collector config load
#                          ("environment variable \"1\" has invalid name"), and the
#                          Go scrubber doubles $ too (registry.go:94). The log path
#                          keeps its existing single-$ string ($1 renders correctly).
#   filter/phi           — DROPS logs/spans whose body matches a suppress pattern
# and prepends them (scrub-first) into each pipeline's processor chain.
#
# A live golden PHI-probe (--probe) boots the just-compiled config, pushes one
# synthetic span/spanevent per `probe:` entry through the trace scrub, and asserts
# each probe value is GONE and the marker present. `_compile_phi` runs it on every
# start/restart/validate — a pattern that PARSES but SCRUBS NOTHING fails closed.
#
# Usage: zdots-otel-phi-compile [--check] [-o OUT]
#   --check   compile to a temp file and validate it parses; don't overwrite OUT
#   -o OUT    output path (default etc/otel-collector.generated.yaml)
# Exit non-zero on any error so `serve` can fail closed (no unscrubbed flow).

require "yaml"

zdotdir = ENV.fetch("ZDOTDIR") { File.expand_path("..", __dir__) }
base_path     = File.join(zdotdir, "etc", "otel-collector.yaml")
patterns_path = File.join(zdotdir, "etc", "phi-patterns.yaml")
out_path      = File.join(zdotdir, "etc", "otel-collector.generated.yaml")
check_only    = false
probe_only = false
skip_probe = (ENV["ZDOTS_PHI_SKIP_PROBE"] == "1")

args = ARGV.dup
until args.empty?
  case (a = args.shift)
  when "--check" then check_only = true
  when "--probe"    then probe_only = true
  when "--no-probe" then skip_probe = true   # escape hatch for the install path
  when "-o"      then out_path = args.shift or abort("zdots-otel-phi-compile: -o needs a path")
  when "-h", "--help"
    puts File.read(__FILE__).lines[2..32].join.gsub(/^# ?/, "")
    exit 0
  else abort("zdots-otel-phi-compile: unknown arg: #{a}")
  end
end

[base_path, patterns_path].each do |p|
  File.file?(p) or abort("zdots-otel-phi-compile: missing #{p}")
end

config   = YAML.load_file(base_path)
registry = YAML.load_file(patterns_path).fetch("patterns")

# `redact` drives the value scrubs (logs transform/phi body + traces value path).
# EXCLUDE structural-only patterns: they carry no regex/replace (positional PHI is
# handled by the dedicated structural branch below), so mapping p.fetch("regex")
# over them would KeyError. (Found 2026-06-20 by the live probe gate.)
redact   = registry.reject { |p| p["suppress"] || p["structural"] }
suppress = registry.select { |p| p["suppress"] }
abort("zdots-otel-phi-compile: registry has no patterns") if registry.empty?

# Escape a registry regex for embedding inside an OTTL double-quoted string
# literal (transform/filter). OTTL unescapes backslashes, so each literal
# backslash must be doubled; embedded quotes escaped. (The redaction processor
# reads blocked_values straight as Go regexps — those stay RAW, no escaping.)
def ottl_re(regex)
  regex.gsub("\\") { "\\\\" }.gsub('"') { '\\"' }
end

# Translate a sed-style replacement (\1) to OTTL/Go replacement ($1); guard any
# literal $ first so it is not read as a group reference.
def ottl_repl(replace)
  replace.gsub("$") { "$$" }.gsub(/\\(\d)/) { "$#{Regexp.last_match(1)}" }
end

# A value pattern emits TRACE statements iff it declares `trace_targets:`.
# Structural patterns are handled separately (they have no log-body role).
def trace_value_targets(pat)
  return [] if pat["structural"]
  Array(pat["trace_targets"])
end

# Trace value replacement. Same sed-\1 -> OTTL group-ref translation as ottl_repl,
# then rewrite each capture ref to the LOAD-SAFE BRACED double-$ form ($1 -> $${1}).
# EMPIRICAL (live probe gate, 2026-06-20): in OTTL replace_pattern the non-braced
# $$1 (-> $1 after confmap) does NOT render the capture group — it strips the prefix
# (the secret is removed but "--password" is lost, marker "--password [REDACTED]"
# missing). The braced $${1} (-> ${1}) DOES render. This vindicates the original
# TASK-XXX concern; rev-4's "bare $1 is fine" withdrawal was wrong for OTTL
# replace_pattern. The log path (ottl_repl, single-$) is unchanged here (separate
# follow-up); this trace escaper uses braces. We do NOT touch ottl_repl.
def ottl_repl_trace(replace)
  ottl_repl(replace).gsub(/\$(\d)/) { "$${#{Regexp.last_match(1)}}" }
end

# Structural replacements are authored DIRECTLY in OTTL group-ref form (${1}).
# Do NOT route them through ottl_repl/ottl_repl_trace (those translate sed \1 and
# would double an already-correct $). Here we (a) escape for the surrounding
# double-quoted OTTL string literal (double real backslashes, escape quotes) and
# (b) emit the load-safe DOUBLE-$ group ref: ${1} -> $${1}. A bare ${1} would
# HARD-ERROR at config load ("environment variable \"1\" has invalid name").
def ottl_repl_literal(replace)
  replace.gsub("\\") { "\\\\" }.gsub('"') { '\\"' }.gsub(/\$\{(\d+)\}/) { "$${#{Regexp.last_match(1)}}" }
end

# 1. redaction/phi — every attribute value, every signal. RAW regexps.
config["processors"]["redaction/phi"] = {
  "allow_all_keys" => true,
  # .uniq is MANDATORY: redaction/phi is the ALL-SIGNAL sweep (logs incl.).
  # Trace span-event coverage is derived in the compiler, NOT via duplicate
  # registry rows, so this set is identical to today; .uniq guarantees it.
  # p["regex"] (not fetch) + compact: structural-only patterns have no regex
  # and contribute no blocked_value (positional PHI is handled separately).
  "blocked_values" => registry.map { |p| p["regex"] }.compact.uniq,
  "summary"        => "silent",
}

# 2. transform/phi — log bodies only, guarded to string bodies.
config["processors"]["transform/phi"] = {
  "error_mode" => "ignore",
  "log_statements" => [
    {
      "context" => "log",
      "statements" => redact.map do |p|
        %(replace_pattern(body, "#{ottl_re(p.fetch('regex'))}", "#{ottl_repl(p.fetch('replace'))}") where IsString(body))
      end,
    },
  ],
}

# 2b. transform/phi/traces — span + spanevent attribute VALUE scrub (traces).
#     Sourced from the SAME value patterns (trace_targets) + structural rules.
#     For each target key the compiler emits BOTH a span and a spanevent
#     statement — span-event coverage is DERIVED HERE, not via duplicate registry
#     rows (so redaction/phi.blocked_values is untouched). Trace regexes are
#     passed VERBATIM through ottl_re (RE2 supports POSIX classes natively; no
#     translation — identical escaped regex to the log path). Replacement capture
#     refs are DOUBLED ($$1 / $${1}) via ottl_repl_trace / ottl_repl_literal so a
#     bare ${1} does not hard-error at config load. error_mode: propagate => fail
#     CLOSED on a runtime statement error; every statement is guarded
#     `!= nil and IsString(...)` so it only fires on malformed input. NOTE:
#     propagate is NOT proof of redaction — that is the --probe gate (§6).

# OTTL accessor for a span/log field. The span NAME (operation_name) and the log
# BODY are TOP-LEVEL OTTL paths (`name`, `body`), NOT attributes — so a key of
# "name"/"body" must compile to the bare path. Every other key is a span attribute.
# Without this, "name" would compile to attributes["name"] and silently never match,
# leaving the operation_name field (which carries the URL path for HTTP server spans)
# UNSCRUBBED — a live-confirmed PHI leak (2026-06-20: /clients/8675309 in O2
# operation_name while http.target was correctly /clients/{id}).
def ottl_accessor(key)
  %w[name body].include?(key) ? key : %(attributes["#{key}"])
end

# Helper: a guarded span/spanevent replace_pattern statement for one field key.
def trace_stmt(key, re, repl)
  acc = ottl_accessor(key)
  %(replace_pattern(#{acc}, "#{re}", "#{repl}") where #{acc} != nil and IsString(#{acc}))
end

span_statements      = []
spanevent_statements = []

# Value patterns -> a guarded replace_pattern per (target key) x (span, spanevent).
redact.each do |p|
  targets = trace_value_targets(p)
  next if targets.empty?
  re   = ottl_re(p.fetch("regex"))           # VERBATIM — same as the log path.
  repl = ottl_repl_trace(p.fetch("replace")) # $$1 — capture ref.
  targets.each do |k|
    stmt = trace_stmt(k, re, repl)
    span_statements      << stmt
    spanevent_statements << stmt
  end
end

# Structural URL-path scrubs (positional PHI; span context only). Outbound CLIENT
# spans carry the path in http.url / url.full — the structural `field` list covers
# those too (§9 residual (c)/(d)).
registry.each do |p|
  s = p["structural"] or next
  fields = Array(s.fetch("field"))
  # `span_name: true` extends the structural scrub to the span NAME (operation_name).
  # HTTP server spans name themselves with the (query-stripped) URL path, so the same
  # /<seg>/<id> positional PHI lands there as in http.target. ottl_accessor maps the
  # synthetic "name" key to the bare OTTL `name` path. Span context only (logs have
  # no span name); the keep/redact/restore sentinel triple applies unchanged.
  fields += ["name"] if s["span_name"]

  if s["mode"] == "redact_all_except"
    # REDACT-ALL + NON-PHI EXEMPTION. RE2 has NO lookahead, so "not these prefixes"
    # cannot be expressed inline. Emit a THREE-statement, ORDER-DEPENDENT sentinel
    # triple PER FIELD, generated from the declarative `exempt:` list:
    #   (1) keep:    save each exempt-prefixed id, carrying the DIGITS in a 2nd
    #                capture group, into a sentinel the redact regex cannot match.
    #   (2) redact:  shape every remaining /<seg>/<int> id to /{id}.
    #   (3) restore: turn the sentinel back into the original digits.
    # Verified on otelcol-contrib v0.148.0 (see §3c "Empirical proof").
    # Per-compile random nonce makes the keep sentinel UNFORGEABLE: a caller-injected
    # literal __KD_<digits>__ on http.target/http.url cannot match the restore regex
    # (which carries the nonce), so it can never resurrect a digit run into a clinical
    # position (adversarial-review finding 2026-06-20). Same nonce for keep+restore
    # within one compile; it changes per recompile (the gitignored generated file only).
    require "securerandom"
    nonce      = SecureRandom.hex(4)
    exempt_alt = Array(s.fetch("exempt")).map { |pre| Regexp.escape(pre) }.join("|")
    keep_re    = ottl_re("(/(?:#{exempt_alt})/)([0-9]+)")   # 2 groups: prefix, DIGITS
    keep_repl  = ottl_repl_literal("${1}__KD#{nonce}_${2}__") # -> $${1}__KD<nonce>_$${2}__
    red_re     = ottl_re(s.fetch("match"))                   # generic /<seg>(/<seg>)?/<id><delim>
    red_repl   = ottl_repl_literal(s.fetch("replace"))       # -> $${1}/{id}$${2}
    rest_re    = ottl_re("__KD#{nonce}_([0-9]+)__")          # nonce-scoped: only undoes OUR keep
    rest_repl  = ottl_repl_literal('${1}')                   # -> $${1}
    fields.each do |field|
      span_statements << trace_stmt(field, keep_re, keep_repl)  # (1) keep
      span_statements << trace_stmt(field, red_re,  red_repl)   # (2) redact
      span_statements << trace_stmt(field, rest_re, rest_repl)  # (3) restore
    end
  else
    # Plain structural: single statement, match verbatim (no exemption).
    re   = ottl_re(s.fetch("match"))
    repl = ottl_repl_literal(s.fetch("replace"))
    fields.each { |field| span_statements << trace_stmt(field, re, repl) }
  end
end

unless span_statements.empty? && spanevent_statements.empty?
  trace_groups = []
  trace_groups << { "context" => "span",      "statements" => span_statements }      unless span_statements.empty?
  trace_groups << { "context" => "spanevent", "statements" => spanevent_statements } unless spanevent_statements.empty?
  config["processors"]["transform/phi/traces"] = {
    # PHI gate: fail CLOSED on a runtime statement error (drop the batch, never
    # ship unscrubbed). Safe because of the per-statement IsString guards. This
    # does NOT fire on match-nothing — that case is caught by --probe (§6).
    "error_mode"       => "propagate",
    "trace_statements" => trace_groups,
  }
end

# 3. filter/phi — drop records carrying a suppress-flagged value (e.g. a
#    connection string with embedded credentials) outright, on logs and traces.
unless suppress.empty?
  log_conds  = suppress.map { |p| %(IsString(body) and IsMatch(body, "#{ottl_re(p.fetch('regex'))}")) }
  span_conds = suppress.map { |p| %(IsMatch(name, "#{ottl_re(p.fetch('regex'))}")) }
  config["processors"]["filter/phi"] = {
    "error_mode" => "ignore",
    "logs"   => { "log_record" => log_conds },
    "traces" => { "span" => span_conds },
  }
end

# 4. Prepend the scrub processors (scrub-first) into each pipeline.
#    Order per pipeline: filter (drop) -> transform (semantic markers) ->
#    redaction (mask residue). transform/phi is log-only; transform/phi/traces
#    is the NEW trace value/structural scrub; redaction is all-signal.
has_trace_transform = config["processors"].key?("transform/phi/traces")
pipelines = config.dig("service", "pipelines") || {}
pipelines.each do |name, p|
  pre = []
  pre << "filter/phi"           if (name == "logs" || name == "traces") && config["processors"].key?("filter/phi")
  pre << "transform/phi"        if name == "logs"
  pre << "transform/phi/traces" if name == "traces" && has_trace_transform
  pre << "redaction/phi"
  p["processors"] = pre + (p["processors"] || [])
end

header = <<~HDR
  # etc/otel-collector.generated.yaml — GENERATED by zdots-otel-phi-compile.
  # DO NOT EDIT. Edit etc/otel-collector.yaml (base) or etc/phi-patterns.yaml
  # (the pattern registry); this file is recompiled by `otel-collector serve`.
  # The redaction/transform/filter "*/phi" processors are the scrub-at-ingest
  # layer — sourced entirely from etc/phi-patterns.yaml (AGENTS.md §10).
HDR

yaml = header + YAML.dump(config)

target = check_only ? "#{out_path}.check.tmp" : out_path
File.write(target, yaml)

# Always parse-check what we wrote.
begin
  YAML.load_file(target)
rescue StandardError => e
  File.delete(target) if check_only && File.exist?(target)
  abort("zdots-otel-phi-compile: generated YAML failed to parse: #{e.message}")
end

# --- LIVE golden PHI-probe (runs on the real -o write path; see header). -------
# Proves a pattern actually SCRUBS, not merely that it parses (validate) or that
# it fails closed on runtime errors (error_mode: propagate). A pattern that
# matches NOTHING is invisible to both of those — only this catches it.
#
# IMPORTANT (round-3 MUST-FIX #3): otelcol-contrib v0.148.0 binds 127.0.0.1:8888
# for its Prometheus self-telemetry exporter even with NO telemetry block. The
# LIVE collector already holds :8888, so the probe config MUST disable internal
# metrics (service.telemetry.metrics.level: none), or the spawned probe collector
# dies with "address already in use" before the OTLP receiver opens. We also
# RESCUE boot/timeout failure and surface a clear error instead of a bare abort.
def run_phi_probe(gen_config, registry, binary)
  probes = registry.select { |p| p["probe"] }
  return true if probes.empty?
  binary ||= File.join(ENV.fetch("HOME"), ".local", "bin", "otelcol-contrib")
  unless File.executable?(binary)
    warn("zdots-otel-phi-compile: PROBE SKIPPED — collector binary not found (#{binary}); " \
         "run via `otel-collector validate` so the gate is enforced")
    return true   # do not block when the binary is genuinely absent (install path)
  end

  require "json"; require "tempfile"; require "net/http"; require "timeout"; require "socket"

  out  = Tempfile.new(["phi-probe-out", ".json"])
  cfg  = Tempfile.new(["phi-probe-cfg", ".yaml"])
  # Reuse the REAL compiled scrub processors; swap exporters to file-only + a
  # local OTLP receiver on an ephemeral port. (Parse the generated file, keep the
  # */phi + transform/tenant processors and the traces pipeline, repoint exporters.)
  gen = YAML.load_file(gen_config)
  port = 41_999
  gen["receivers"] = { "otlp" => { "protocols" => { "http" => { "endpoint" => "127.0.0.1:#{port}" } } } }
  gen["exporters"] = { "file/probe" => { "path" => out.path } }
  tp = gen.dig("service", "pipelines", "traces") or abort("probe: no traces pipeline")
  tp["receivers"] = ["otlp"]; tp["exporters"] = ["file/probe"]
  # CRITICAL: disable internal telemetry so we do NOT bind :8888 (the live
  # collector holds it). metrics.level: none stops the Prometheus reader entirely.
  gen["service"] = {
    "telemetry" => { "metrics" => { "level" => "none" }, "logs" => { "level" => "error" } },
    "pipelines" => { "traces" => tp },   # probe traces only
  }
  gen.delete("connectors")
  File.write(cfg.path, YAML.dump(gen))

  pid = nil
  begin
    pid = spawn(binary, "--config", cfg.path, %i[out err] => File::NULL)
    # wait for the receiver to come up; if the collector failed to boot (e.g. a
    # port bind error), the socket never opens and we time out -> clear message.
    Timeout.timeout(15) do
      loop do
        if (s = (TCPSocket.new("127.0.0.1", port) rescue nil))
          s.close; break
        end
        # detect an early crash so we don't wait the full 15s on a dead process
        if Process.waitpid(pid, Process::WNOHANG)
          raise "probe collector exited before opening :#{port} (boot failure)"
        end
        sleep 0.2
      end
    end
    probes.each do |p|
      body = p.fetch("probe")     # an OTLP/JSON resourceSpans payload (string)
      uri  = URI("http://127.0.0.1:#{port}/v1/traces")
      req  = Net::HTTP::Post.new(uri, "Content-Type" => "application/json")
      req.body = body
      Net::HTTP.start(uri.host, uri.port) { |h| h.request(req) }
    end
    sleep 2                       # small grace for export flush
  rescue Timeout::Error
    warn("zdots-otel-phi-compile: PHI PROBE FAILED — probe collector failed to boot " \
         "within 15s (check :#{port} bind / :8888 internal-telemetry collision)")
    return false
  rescue StandardError => e
    warn("zdots-otel-phi-compile: PHI PROBE FAILED — probe collector failed to boot: #{e.message}")
    return false
  ensure
    if pid
      (Process.kill("TERM", pid); Process.wait(pid)) rescue nil
    end
  end

  scrubbed = File.read(out.path)
  fails = []
  probes.each do |p|
    Array(p["expect_absent"]).each   { |v| fails << "#{p['name']}: leaked #{v.inspect}"        if scrubbed.include?(v) }
    Array(p["expect_redacted"]).each { |m| fails << "#{p['name']}: marker #{m.inspect} missing" unless scrubbed.include?(m) }
    Array(p["expect_kept"]).each     { |v| fails << "#{p['name']}: over-redacted, dropped #{v.inspect}" unless scrubbed.include?(v) }
  end
  out.close!; cfg.close!
  return true if fails.empty?
  warn("zdots-otel-phi-compile: PHI PROBE FAILED — refusing to ship:")
  fails.each { |f| warn("  - #{f}") }
  false
end

unless check_only || skip_probe
  binary = ENV["OTELCOL_BINARY"] || File.join(ENV.fetch("HOME"), ".local", "bin", "otelcol-contrib")
  run_phi_probe(out_path, registry, binary) or abort("zdots-otel-phi-compile: PHI probe gate failed")
end

exit 0 if probe_only   # --probe: gate only, do not re-announce

if check_only
  File.delete(target) if File.exist?(target)
  warn("zdots-otel-phi-compile: OK — #{redact.size} redact + #{suppress.size} suppress pattern(s) compile cleanly")
else
  warn("zdots-otel-phi-compile: wrote #{out_path} (#{redact.size} redact, #{suppress.size} suppress)")
end
