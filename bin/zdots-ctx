#!/usr/bin/env bash
# bin/zdots-ctx — Bridge to the PostgreSQL Intelligence Suite.
#
# RATIONALE:
# Serves as the primary interface for the shell to interact with the
# PostgreSQL-backed "Brain" (Methodology, Lessons Learnt, Session Memory).
#
# GRAMMAR:
#   status    Check connection and report database metadata
#   init-db   Create the database and apply initial schema
#   migrate   Apply pending SQL migrations from etc/db/migrations
#   query     [t] Search for methodology or lessons related to [t]
#   capture   Distill current session (traces/history) into a lesson
#   hydrate   Output methodologies for the current task (AI-targeted)
#   backup    Create a timestamped SQL dump in ~/my/backups
#   restore [f] Restore the database from dump file [f]

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
# Source the lifecycle engine for logging and output helpers
# shellcheck source=lib/lifecycle.bash
source "${ZDOTDIR}/lib/lifecycle.bash"

SVC_NAME="zdots-ctx"
MY_ROOT="${ZDOTS_MY_ROOT:-$HOME/my}"
# DATABASE_URL is expected from env.sh / .zdots.env

usage() {
  cat <<EOF
Usage: zdots-ctx <command> [--json]

Intelligence Suite Interface:
  status    Check connection and report database metadata
  init-db   Create the database and apply initial schema
  migrate   Apply pending SQL migrations from etc/db/migrations
  query     [t] Search for methodology or lessons related to [t]
  capture   Distill current session (traces/history) into a lesson
  hydrate   Output methodologies for the current task (AI-targeted)
  seed      Import existing standards from ~/my/standards
  backup    Create a timestamped SQL dump in ~/my/backups
  restore [f] Restore the database from dump file [f]

Options:
  --json      Output as JSON (valid for status, query, hydrate)
  -h, --help  Show this help

Environment:
  ZDOTS_MY_ROOT  Root of the identity monorepo (default: ~/my)
  DATABASE_URL   PostgreSQL connection string
EOF
}

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

_require_psql() {
  if ! command -v psql >/dev/null 2>&1; then
    _svc_die "psql client not found. Run: brew install postgresql@18"
  fi
}

_db_ping() {
  if [[ -z "${DATABASE_URL:-}" ]]; then
    return 1
  fi
  psql "$DATABASE_URL" -c "SELECT 1;" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Subcommand implementations
# ---------------------------------------------------------------------------

cmd_status() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  _require_psql

  local connected=false
  if _db_ping; then
    connected=true
  fi

  local db_name="unknown"
  local m_count=0 l_count=0 r_count=0
  if [[ "$connected" == "true" ]]; then
    db_name=$(psql "${DATABASE_URL}" -tAc "SELECT current_database();" 2>/dev/null || echo "unknown")
    m_count=$(psql "${DATABASE_URL}" -tAc "SELECT count(*) FROM methodologies;" 2>/dev/null || echo 0)
    l_count=$(psql "${DATABASE_URL}" -tAc "SELECT count(*) FROM lessons;" 2>/dev/null || echo 0)
    r_count=$(psql "${DATABASE_URL}" -tAc "SELECT count(*) FROM session_residue;" 2>/dev/null || echo 0)
  fi

  if $json; then
    printf '{\n'
    printf '  "connected": %s,\n' "$connected"
    printf '  "database": "%s",\n' "$db_name"
    printf '  "counts": {\n'
    printf '    "methodologies": %s,\n' "$m_count"
    printf '    "lessons": %s,\n'       "$l_count"
    printf '    "residue": %s\n'       "$r_count"
    printf '  },\n'
    printf '  "my_root": "%s",\n' "$MY_ROOT"
    printf '  "database_url": "%s"\n' "${DATABASE_URL:-}"
    printf '}\n'
    return
  fi

  if [[ "$connected" == "true" ]]; then
    _svc_ok "connected to database: ${db_name}"
    printf -- '%-16s %s\n' "methodologies:" "$m_count"
    printf -- '%-16s %s\n' "lessons:"       "$l_count"
    printf -- '%-16s %s\n' "residue:"       "$r_count"
    printf -- '%-16s %s\n' "my_root:"       "$MY_ROOT"
    return 0
  else
    _svc_warn "failed to connect to database at ${DATABASE_URL:-none}"
    printf -- '%-16s %s\n' "my_root:"       "$MY_ROOT"
    return 1
  fi
}

cmd_init_db() {
  _require_psql
  _svc_log "initializing intelligence suite database..."
  
  # Try to create the database if it doesn't exist
  # We use 'postgres' DB for the initial connection to run CREATE DATABASE
  local db_name
  db_name=$(echo "${DATABASE_URL}" | sed -E 's/.*\///')
  
  if ! psql "${DATABASE_URL}" -c "SELECT 1" >/dev/null 2>&1; then
    _svc_log "database '${db_name}' not found, attempting to create..."
    local base_url
    base_url=$(echo "${DATABASE_URL}" | sed -E 's/\/[^/]+$/\/postgres/')
    if ! psql "${base_url}" -c "CREATE DATABASE ${db_name};" >/dev/null 2>&1; then
      _svc_die "failed to create database '${db_name}'. Ensure Postgres is running and you have permissions."
    fi
    _svc_ok "database '${db_name}' created."
  else
    _svc_ok "database '${db_name}' already exists."
  fi

  cmd_migrate
}

cmd_migrate() {
  _require_psql
  _svc_log "applying migrations from etc/db/migrations..."
  
  # Bash-compatible globbing
  for sql in "${ZDOTDIR}/etc/db/migrations"/*.sql; do
    [[ -e "$sql" ]] || continue
    _svc_log "applying $(basename "$sql")..."
    if psql "${DATABASE_URL}" -f "$sql" >/dev/null 2>&1; then
      _svc_ok "$(basename "$sql") applied."
    else
      _svc_die "failed to apply $(basename "$sql")."
    fi
  done
  _svc_ok "all migrations applied."
}

cmd_backup() {
  if ! command -v pg_dump >/dev/null 2>&1; then
    _svc_die "pg_dump not found. Run: brew install postgresql@18"
  fi

  local backup_dir="${MY_ROOT}/backups"
  mkdir -p "$backup_dir"

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local db_name
  db_name=$(echo "${DATABASE_URL}" | sed -E 's/.*\///')
  local backup_file="${backup_dir}/${db_name}_${timestamp}.sql.gz"

  _svc_log "creating backup: ${backup_file}..."
  if pg_dump "${DATABASE_URL}" | gzip > "$backup_file"; then
    _svc_ok "backup complete."
    # Maintain last 10 backups
    ls -t "${backup_dir}/${db_name}"_*.sql.gz 2>/dev/null | tail -n +11 | xargs rm -f -- 2>/dev/null || true
  else
    _svc_die "backup failed."
  fi
}

cmd_restore() {
  local backup_file="${1:-}"
  if [[ -z "$backup_file" ]]; then
    _svc_die "usage: zdots-ctx restore <path-to-sql-gz>"
  fi

  if [[ ! -f "$backup_file" ]]; then
    _svc_die "backup file not found: $backup_file"
  fi

  _require_psql
  _svc_log "restoring from ${backup_file}..."
  
  # WARNING: This is destructive to the current database
  printf "WARNING: This will overwrite the current database. Proceed? [y/N] "
  local response
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    _svc_log "aborted."
    return 1
  fi

  local db_name
  db_name=$(echo "${DATABASE_URL}" | sed -E 's/.*\///')
  local base_url
  base_url=$(echo "${DATABASE_URL}" | sed -E 's/\/[^/]+$/\/postgres/')

  psql "${base_url}" -c "DROP DATABASE IF EXISTS ${db_name} (FORCE);" >/dev/null 2>&1
  psql "${base_url}" -c "CREATE DATABASE ${db_name};" >/dev/null 2>&1

  if gunzip -c "$backup_file" | psql "${DATABASE_URL}" >/dev/null 2>&1; then
    _svc_ok "restore complete."
  else
    _svc_die "restore failed."
  fi
}

cmd_query() {
  local term="${1:-}"
  if [[ -z "$term" ]]; then
    _svc_die "usage: zdots-ctx query <search-term>"
  fi

  _require_psql
  
  _svc_log "searching methodologies..."
  psql "${DATABASE_URL}" -c "
    SELECT slug, title 
    FROM methodologies 
    WHERE to_tsvector('english', title || ' ' || content) @@ plainto_tsquery('english', '${term}')
    OR title ILIKE '%${term}%'
    OR content ILIKE '%${term}%';
  "

  _svc_log "searching lessons..."
  psql "${DATABASE_URL}" -c "
    SELECT created_at::date as date, content 
    FROM lessons 
    WHERE to_tsvector('english', content || ' ' || coalesce(context, '')) @@ plainto_tsquery('english', '${term}')
    OR content ILIKE '%${term}%'
    OR context ILIKE '%${term}%';
  "
}

cmd_capture() {
  local sid="${ZDOTS_SESSION_ID:-}"
  if [[ -z "$sid" ]]; then
    _svc_die "ZDOTS_SESSION_ID not set. Session capture requires an active observable shell."
  fi

  _svc_log "capturing residue for session: ${sid}..."

  # 1. Extract recent history (last 50 commands)
  local history_snippet
  history_snippet=$(tail -n 50 "${HISTFILE:-$HOME/.zsh_history}" 2>/dev/null | sed 's/^: [0-9]*:[0-9];//' || echo "history not available")

  # 2. Extract traces for this session
  local trace_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"
  local trace_snippet="no traces found"
  if [[ -f "$trace_file" ]]; then
    trace_snippet=$(grep "\"sid\":\"${sid}\"" "$trace_file" | tail -n 100 || echo "no traces found")
  fi

  # 3. Construct the distillation prompt
  local prompt
  prompt=$(cat <<EOF
You are the Distiller for the Cerebral Control Plane.
Analyze the following shell session context and produce a structured "Lesson Learnt" or "Session Residue" summary.

SESSION_ID: ${sid}

RECENT_HISTORY:
${history_snippet}

SESSION_TRACES (Last 100):
${trace_snippet}

INSTRUCTIONS:
1. Identify the primary goal of this session.
2. Summarize the technical challenges encountered (especially those reflected in trace errors).
3. State the final result (did it succeed? what was fixed?).
4. Output the result as a single concise paragraph for a "Lesson" and a few bullet points for "Residue".
5. Use the following JSON format:
{
  "lesson": "Concise paragraph summarizing the key learning or fix.",
  "summary": "High-level summary of work done.",
  "intent": "What the user was trying to achieve.",
  "result": "Final outcome.",
  "tags": ["tag1", "tag2"]
}
EOF
)

  _svc_log "distilling with local AI..."
  local distillation
  if ! distillation=$(echo "$prompt" | ai-query --mode raw 2>/dev/null); then
    _svc_die "AI distillation failed. Ensure llama-server is running."
  fi

  # Clean up the AI output to ensure it's valid JSON
  distillation=$(echo "$distillation" | sed -n '/{/,/}/p')

  if [[ -z "$distillation" ]]; then
    _svc_die "AI returned empty or invalid response."
  fi

  if [[ "${1:-}" == "--json" ]]; then
    echo "$distillation"
    return
  fi

  # Propose the lesson to the user
  local lesson intent result
  lesson=$(echo "$distillation" | jq -r '.lesson' 2>/dev/null || echo "error parsing lesson")
  intent=$(echo "$distillation" | jq -r '.intent' 2>/dev/null || echo "error parsing intent")
  result=$(echo "$distillation" | jq -r '.result' 2>/dev/null || echo "error parsing result")

  printf -- "\n--- PROPOSED SESSION RESIDUE ---\n"
  printf "INTENT: %s\n" "$intent"
  printf "RESULT: %s\n" "$result"
  printf "LESSON: %s\n" "$lesson"
  printf -- "---------------------------------\n\n"

  printf "Save this residue to the intelligence suite? [y/N] "
  local response
  read -r response
  if [[ "$response" =~ ^[Yy]$ ]]; then
    _require_psql
    local tags; tags=$(echo "$distillation" | jq -r '.tags | join(",")' 2>/dev/null || echo "")
    
    # Insert into session_residue
    psql "${DATABASE_URL}" -c "
      INSERT INTO session_residue (trace_id, intent, result, summary, metadata)
      VALUES ('${sid}', '${intent//\'/''}', '${result//\'/''}', '${lesson//\'/''}', '${distillation//\'/''}'::jsonb)
      ON CONFLICT (trace_id) DO UPDATE 
      SET intent = EXCLUDED.intent, result = EXCLUDED.result, summary = EXCLUDED.summary, metadata = EXCLUDED.metadata;
    " >/dev/null

    # Also insert the lesson
    psql "${DATABASE_URL}" -c "
      INSERT INTO lessons (content, context, tags, source_trace_id)
      VALUES ('${lesson//\'/''}', '${intent//\'/''}', string_to_array('${tags}', ','), '${sid}');
    " >/dev/null

    _svc_ok "residue and lesson saved to database."
  else
    _svc_log "capture aborted."
  fi
}

cmd_hydrate() {
  local tag="${1:-}"
  local json=false
  [[ "${1:-}" == "--json" || "${2:-}" == "--json" ]] && json=true

  _require_psql

  _svc_log "hydrating AI context..."

  # Fetch methodologies
  local methodologies
  if [[ -n "$tag" && "$tag" != "--json" ]]; then
    methodologies=$(psql "${DATABASE_URL}" -tAc "SELECT title, content FROM methodologies WHERE '$tag' = ANY(tags);" 2>/dev/null)
  else
    methodologies=$(psql "${DATABASE_URL}" -tAc "SELECT title, content FROM methodologies LIMIT 5;" 2>/dev/null)
  fi

  # Fetch recent lessons
  local lessons
  lessons=$(psql "${DATABASE_URL}" -tAc "SELECT context, content FROM lessons ORDER BY created_at DESC LIMIT 5;" 2>/dev/null)

  if $json; then
    # We use a simple JSON structure for AI tool parsing
    psql "${DATABASE_URL}" -tAc "
      SELECT json_build_object(
        'methodologies', (SELECT json_agg(m) FROM (SELECT title, content, tags FROM methodologies) m),
        'recent_lessons', (SELECT json_agg(l) FROM (SELECT context, content, tags FROM lessons ORDER BY created_at DESC LIMIT 10) l)
      );
    "
    return
  fi

  # Text output (AI-targeted markdown)
  printf "The following context has been retrieved from the Cerebral Control Plane:\n\n"
  printf "### PREFERRED METHODOLOGIES\n"
  if [[ -n "$methodologies" ]]; then
    echo "$methodologies" | while IFS='|' read -r title content; do
      printf "#### %s\n%s\n\n" "$title" "$content"
    done
  else
    printf "None found.\n\n"
  fi

  printf "### RECENT LESSONS LEARNT\n"
  if [[ -n "$lessons" ]]; then
    echo "$lessons" | while IFS='|' read -r context content; do
      printf "* **Context**: %s\n  **Lesson**: %s\n\n" "$context" "$content"
    done
  else
    printf "None found.\n\n"
  fi
}

# ---------------------------------------------------------------------------
cmd_seed() {
  _require_psql
  local standards_dir="${MY_ROOT}/standards"
  if [[ ! -d "$standards_dir" ]]; then
    _svc_die "standards directory not found: $standards_dir"
  fi

  _svc_log "importing standards from ${standards_dir}..."

  for f in "${standards_dir}"/*.md; do
    [[ -e "$f" ]] || continue
    local slug title content
    slug=$(basename "$f" .md | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    title=$(head -n 1 "$f" | sed 's/^# //')
    content=$(cat "$f")

    _svc_log "seeding: ${slug}..."
    psql "${DATABASE_URL}" -c "
      INSERT INTO methodologies (slug, title, content)
      VALUES ('${slug}', '${title//\'/''}', '${content//\'/''}')
      ON CONFLICT (slug) DO UPDATE 
      SET title = EXCLUDED.title, content = EXCLUDED.content, updated_at = CURRENT_TIMESTAMP;
    " >/dev/null
  done
  _svc_ok "seeding complete."
}
# ---------------------------------------------------------------------------

case "${1:-}" in
  status)   shift; cmd_status "${@}" ;;
  init-db)  shift; cmd_init_db "${@}" ;;
  migrate)  shift; cmd_migrate "${@}" ;;
  query)    shift; cmd_query "${@}" ;;
  capture)  shift; cmd_capture "${@}" ;;
  hydrate)  shift; cmd_hydrate "${@}" ;;
  seed)     shift; cmd_seed "${@}" ;;
  backup)   shift; cmd_backup "${@}" ;;
  restore)  shift; cmd_restore "${@}" ;;
  -h|--help) usage; exit 0 ;;
  "")       usage >&2; exit 1 ;;
  *)        printf 'zdots-ctx: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
