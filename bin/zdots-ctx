#!/usr/bin/env bash
# bin/zdots-ctx — Bridge to the PostgreSQL Intelligence Suite.
#
# RATIONALE:
# Serves as the primary interface for the shell to interact with the
# PostgreSQL-backed "Brain" (Methodology, Lessons Learnt, Session Memory).
#
# GRAMMAR:
#   status    Check connection and report database metadata
#   init-db   Create the database and apply initial schema
#   migrate   Apply pending SQL migrations from etc/db/migrations
#   query [--semantic] <t>  Search methodologies or lessons for <t>
#   capture   Distill current session (traces/history) into a lesson
#   hydrate [tag] Get semantically relevant context for AI tasks
#   seed      Import existing standards from ~/my/standards
#   add-methodology <slug> <title> <content> [tags...]
#   add-lesson <content> [context] [tags...]
#   enqueue [--force] <type> <payload_json> [priority]
#   requeue <job_id>
#   jobs      List pending and recent jobs
#   worker    [--type T] Run a worker to process queued jobs
#   triage    Review and resolve permanently failed 'dead' jobs
#   clear-stale-jobs Reset 'running' jobs that have timed out
#   metrics-loop Export queue depth metrics to OTel continuously
#   backup    Create a timestamped SQL dump in ~/my/backups
#   restore [f] Restore the database from dump file [f]

set -eo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
# shellcheck source=lib/svc-health.bash
source "${ZDOTDIR}/lib/svc-health.bash"
# shellcheck source=lib/ai-invoke.bash
source "${ZDOTDIR}/lib/ai-invoke.bash"

# 1. Ensure basics (handle unbound variables for complex environment files)
[[ -z "${ZDOTS_DATABASE_URL:-}" ]] && source "${ZDOTDIR}/env.sh" || true

SVC_NAME="zdots-ctx"
MY_ROOT="${ZDOTS_MY_ROOT:-$HOME/my}"
_AI_ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"

usage() {
  cat <<EOF
Usage: zdots-ctx <command> [--json]

Knowledge Layer Interface:
  status    Check connection and report database metadata
  init-db   Create the database and apply initial schema
  migrate   Apply pending SQL migrations from etc/db/migrations
  query [--semantic] <t>  Search methodologies or lessons for <t>
  capture   Distill current session (traces/history) into a lesson
  hydrate [tag] Get semantically relevant context for AI tasks
  seed      Import existing standards from ~/my/standards
  add-methodology <slug> <title> <content> [tags...]
  add-lesson <content> [context] [tags...]
  ingest [--dry-run] <file.md | dir/> | --all  Ingest Knowledge Vault documents
  sync-history [--dry-run] [db-path]  Sync SQLite analytics → PostgreSQL
  enqueue [--force] <type> <payload_json> [priority]
  requeue <job_id>
  jobs      List pending and recent jobs
  worker    [--type T] Run a worker to process queued jobs
  triage    Review and resolve permanently failed 'dead' jobs
  clear-stale-jobs Reset 'running' jobs that have timed out
  metrics-loop Export queue depth metrics to OTel continuously
  backup    Create a timestamped SQL dump in ~/my/backups
  restore [f] Restore the database from dump file [f]

Options:
  --json      Output as JSON (valid for status, query, hydrate)
  -h, --help  Show this help

Environment:
  ZDOTS_MY_ROOT        Root of the identity monorepo (default: ~/my)
  ZDOTS_DATABASE_URL         App connection — defaults to postgresql://zdots_rw@/my
                       zdots_rw has DML + EXECUTE; all writes go through this interface
  ZDOTS_MIGRATION_URL  Superuser connection for migrations (default: postgresql:///my)
                       Used only by 'migrate' and 'init-db'; requires CREATE/ALTER/DROP
  ZDOTS_DATABASE_URL_OVERRIDE  Set to force ZDOTS_DATABASE_URL regardless of env sourcing
  ZDOTS_CMD_ANALYTICS  1 = capture every command to SQLite command_runs via 56-cmd-analytics.zsh
                       shell_hook_metrics from 55-phi-history.zsh shares the same buffer
                       sync-history pushes buffered rows to PostgreSQL (auto-fires on capture)
                       Default: 0; enable in .zdots.local; enforced 0 on work machines

Database access levels:
  zdots_rw   INSERT/UPDATE/DELETE/SELECT + stored procedures — app user (this tool)
  zdots_ro   SELECT only — safe for psql exploration: psql -U zdots_ro my
EOF
}

# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

_require_psql() {
  if ! command -v psql >/dev/null 2>&1; then
    _svc_die "psql client not found. Run: brew install postgresql@18"
  fi
}

_db_ping() {
  if [[ -z "${ZDOTS_DATABASE_URL:-}" ]]; then
    return 1
  fi
  psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT 1;" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Subcommand implementations
# ---------------------------------------------------------------------------

cmd_status() {
  "${ZDOTDIR}/sbin/zdots-brain" status "$@"
}

cmd_init_db() {
  _require_psql
  _svc_log "initializing intelligence suite database..."

  # Use the superuser URL for DDL operations — zdots_rw cannot CREATE DATABASE
  local migration_url="${ZDOTS_MIGRATION_URL:-postgresql:///my}"
  local db_name
  db_name=$(echo "${migration_url}" | sed -E 's/.*\///')

  if ! psql "${migration_url}" -X -t -A -q -c "SELECT 1" >/dev/null 2>&1; then
    _svc_log "database '${db_name}' not found, attempting to create..."
    local base_url
    base_url=$(echo "${migration_url}" | sed -E 's/\/[^/]+$/\/postgres/')
    if ! psql "${base_url}" -c "CREATE DATABASE ${db_name};" >/dev/null 2>&1; then
      _svc_die "failed to create database '${db_name}'. Ensure Postgres is running and you have permissions."
    fi
    _svc_ok "database '${db_name}' created."
  else
    _svc_ok "database '${db_name}' already exists."
  fi

  cmd_migrate
}

cmd_migrate() {
  zdots-ruby "${ZDOTDIR}/lib/zdots/migrator.rb"
}

cmd_query() {
  local semantic=false
  if [[ "${1:-}" == "--semantic" ]]; then
    semantic=true
    shift
  fi

  local term="${1:-}"
  if [[ -z "$term" ]]; then
    _svc_die "usage: zdots-ctx query [--semantic] <search-term>"
  fi

  if $semantic; then
    _AI_ENDPOINT=$(zdots_ai_gated_endpoint "zdots-ctx")
  fi

  local brain_flags=()
  $semantic && brain_flags+=("--semantic")
  "${ZDOTDIR}/sbin/zdots-brain" "${brain_flags[@]}" query "$term"
}

cmd_capture() {
  # PHI safety gate — capture is opt-in
  if [[ "${ZDOTS_CAPTURE_ENABLED:-0}" != "1" ]]; then
    zdots_audit_log "capture_blocked" "sid=${ZDOTS_SESSION_ID:-unknown}"
    printf 'zdots-ctx: capture disabled (ZDOTS_CAPTURE_ENABLED=0) — set to 1 in .zdots.local to enable\n' >&2
    exit 2
  fi

  local sid="${ZDOTS_SESSION_ID:-}"
  if [[ -z "$sid" ]]; then
    _svc_die "ZDOTS_SESSION_ID not set. Session capture requires an active observable shell."
  fi

  _svc_log "capturing residue for session: ${sid}..."

  # 1. Extract and scrub recent history (last 50 commands)
  local history_snippet
  history_snippet=$(tail -n 50 "${HISTFILE:-$HOME/.zsh_history}" 2>/dev/null \
    | sed 's/^: [0-9]*:[0-9];//' \
    | zdots_message_hygiene \
    || echo "history not available")

  # 2. Extract and scrub traces for this session
  local trace_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"
  local trace_snippet="no traces found"
  if [[ -f "$trace_file" ]]; then
    trace_snippet=$(grep "\"sid\":\"${sid}\"" "$trace_file" | tail -n 100 | zdots_message_hygiene || echo "no traces found")
  fi

  # 3. Construct the distillation prompt
  local prompt
  prompt=$(cat <<EOF
You are the Distiller for the Cerebral Control Plane.
Analyze the following shell session context and produce a structured "Lesson Learnt" or "Session Residue" summary.

SESSION_ID: ${sid}

RECENT_HISTORY:
${history_snippet}

SESSION_TRACES (Last 100):
${trace_snippet}

INSTRUCTIONS:
1. Identify the primary goal of this session.
2. Summarize the technical challenges encountered (especially those reflected in trace errors).
3. State the final result (did it succeed? what was fixed?).
4. Respond ONLY with a JSON object — no prose, no markdown, no code fences.

REQUIRED OUTPUT SCHEMA (all fields required, no extras):
{
  "lesson":  string  — 1-3 sentences: the key learning, fix, or insight from this session,
  "summary": string  — ≤25 words: what was done,
  "intent":  string  — ≤15 words: what the user was trying to achieve,
  "result":  string  — one of: "success", "partial", "failed", or a short phrase,
  "tags":    array   — 2-5 lowercase strings: relevant domain tags (e.g. "zsh", "pgvector", "ai", "security")
}

CONSTRAINTS:
- "lesson" must be a non-empty string (not null, not "").
- "tags" must be a JSON array with at least 1 element.
- Do not include additional fields beyond those listed above.
- Output the JSON object only. Begin with '{' and end with '}'.
EOF
)

  _svc_log "distilling with local AI..."
  local distillation
  if ! distillation=$(zdots_ai_distill "$prompt"); then
    _svc_die "AI distillation failed. Ensure llama-server is running (or set ZDOTS_AI_MODE=none to disable)."
  fi

  if [[ "${1:-}" == "--json" ]]; then
    echo "$distillation"
    return
  fi

  # Propose the lesson to the user.
  # No hygiene here — output already passed through aiq_sanitize_output (→ _mh_normalize)
  # in bin/ai-query; model can only echo content it received, which was PHI-scrubbed on input.
  local lesson intent result
  lesson=$(echo "$distillation" | jq -r '.lesson' 2>/dev/null || echo "error parsing lesson")
  intent=$(echo "$distillation" | jq -r '.intent' 2>/dev/null || echo "error parsing intent")
  result=$(echo "$distillation" | jq -r '.result' 2>/dev/null || echo "error parsing result")

  printf -- "\n--- PROPOSED SESSION RESIDUE ---\n"
  printf "INTENT: %s\n" "$intent"
  printf "RESULT: %s\n" "$result"
  printf "LESSON: %s\n" "$lesson"
  printf -- "---------------------------------\n\n"

  printf "Save this residue to the intelligence suite? [y/N] "
  local response
  read -r response
  if [[ "$response" =~ ^[Yy]$ ]]; then
    local lesson_id
    lesson_id=$(jq -n \
      --arg trace_id   "$sid" \
      --arg lesson     "$lesson" \
      --arg intent     "$intent" \
      --arg result     "$result" \
      --argjson tags   "$(echo "$distillation" | jq '.tags // []')" \
      --argjson meta   "$distillation" \
      '{trace_id: $trace_id, lesson: $lesson, intent: $intent, result: $result, tags: $tags, metadata: $meta}' \
      | "${ZDOTDIR}/sbin/zdots-brain" save-capture)

    zdots_audit_log "capture_invoked" "sid=${sid} lesson_id=${lesson_id:-none}"
    _svc_ok "residue and lesson saved to database."

    # Enqueue docs_sync so the async worker can update documentation from this session.
    "${ZDOTDIR}/sbin/zdots-brain" enqueue docs_sync \
      "$(jq -n --arg tid "$sid" '{"trace_id":$tid}')" 5 2>/dev/null \
      && _svc_log "enqueued docs_sync job." \
      || _svc_log "docs_sync enqueue failed (non-fatal)."

    # Sync buffered command analytics to PostgreSQL (non-fatal; SQLite is durable).
    if [[ "${ZDOTS_CMD_ANALYTICS:-0}" == "1" ]]; then
      cmd_sync_history 2>/dev/null \
        && _svc_log "command analytics synced." \
        || _svc_log "command analytics sync failed (non-fatal; SQLite buffer intact)."
    fi
  else
    _svc_log "capture aborted."
  fi
}

cmd_hydrate() {
  local tag=""
  local brain_flags=()

  for arg in "$@"; do
    case "$arg" in
      --json) brain_flags+=("--json") ;;
      *) [[ -z "$tag" ]] && tag="$arg" ;;
    esac
  done

  if [[ -n "$tag" ]]; then
    _AI_ENDPOINT=$(zdots_ai_gated_endpoint "zdots-ctx")
  fi

  "${ZDOTDIR}/sbin/zdots-brain" "${brain_flags[@]}" hydrate ${tag:+"$tag"}
}

cmd_add_methodology() {
  "${ZDOTDIR}/sbin/zdots-brain" add-methodology "$@"
}

cmd_add_lesson() {
  "${ZDOTDIR}/sbin/zdots-brain" add-lesson "$@"
}

cmd_ingest() {
  "${ZDOTDIR}/sbin/zdots-brain" ingest "$@"
}

# _drain_redis_to_sqlite — move Redis-buffered command_runs into SQLite so
# sync-history (which reads SQLite) sees a complete record.
#
# 56-cmd-analytics.zsh writes to Redis first (fast, synchronous) and falls
# back to SQLite only when Redis is unavailable.  This drain step bridges the
# two stores before every PostgreSQL sync.  Safe to call when Redis is down —
# redis-cli absence or connection failure returns silently.
_drain_redis_to_sqlite() {
  local db="${XDG_STATE_HOME:-$HOME/.local/state}/zdots/history.sqlite3"
  local rhost="${ZDOTS_REDIS_HOST:-127.0.0.1}"
  local rport="${ZDOTS_REDIS_PORT:-6379}"

  [[ -f "$db" ]]              || return 0
  command -v redis-cli >/dev/null 2>&1 || return 0
  command -v jq        >/dev/null 2>&1 || return 0

  # jq filter: read all newline-delimited JSON entries piped from redis-cli,
  # emit one SQL INSERT per valid entry with single-quote escaping for SQLite.
  local jq_filter
  jq_filter=$(cat << 'JQEOF'
[
  split("\n")[] | select(length > 0) |
  try (fromjson | select(.cmd != null and .cmd != "")) catch empty |
  {
    s: (.session_id // "" | gsub("'"; "''")),
    t: (.ts          // 0  | tostring),
    c: (.cwd         // "" | gsub("'"; "''")),
    m: (.cmd         // "" | gsub("'"; "''")),
    a: (.args        // "" | gsub("'"; "''")),
    e: (.exit_code   // 0  | tostring),
    d: (.duration_ms // 0  | tostring),
    p: (.profile     // "" | gsub("'"; "''"))
  } |
  "INSERT INTO command_runs(session_id,ts,cwd,cmd,args,exit_code,duration_ms,profile) VALUES('" +
  .s + "'," + .t + ",'" + .c + "','" + .m + "','" + .a + "'," + .e + "," + .d + ",'" + .p + "');"
] | join("\n")
JQEOF
  )

  local key drained_total=0
  while IFS= read -r key; do
    [[ -z "$key" ]] && continue

    local sql_batch
    sql_batch=$(redis-cli -h "$rhost" -p "$rport" LRANGE "$key" 0 -1 2>/dev/null \
                | jq -Rrs "$jq_filter" 2>/dev/null)
    [[ -z "$sql_batch" ]] && continue

    local count
    count=$(printf '%s' "$sql_batch" | grep -c "^INSERT" 2>/dev/null || echo 0)

    if printf 'BEGIN;\n%s\nCOMMIT;\n' "$sql_batch" | sqlite3 "$db" 2>/dev/null; then
      redis-cli -h "$rhost" -p "$rport" DEL "$key" >/dev/null 2>&1 || true
      drained_total=$(( drained_total + count ))
    fi
  done < <(redis-cli -h "$rhost" -p "$rport" KEYS "zdots:cmds:*" 2>/dev/null | grep -v '^$')

  (( drained_total > 0 )) && _svc_log "drained ${drained_total} Redis command(s) to SQLite"
  return 0
}

cmd_sync_history() {
  _drain_redis_to_sqlite
  "${ZDOTDIR}/sbin/zdots-brain" sync-history "$@"
}

cmd_enqueue() {
  "${ZDOTDIR}/sbin/zdots-brain" enqueue "$@"
}

cmd_requeue() {
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    _svc_die "usage: zdots-ctx requeue <job_id>"
  fi

  _require_psql
  _svc_log "re-queuing job ${id}..."
  psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT requeue_job('${id}');" >/dev/null
  _svc_ok "job reset to pending."
}

cmd_jobs() {
  "${ZDOTDIR}/sbin/zdots-brain" jobs "$@"
}

cmd_worker() {
  "${ZDOTDIR}/sbin/zdots-brain" worker "$@"
}

cmd_triage() {
  _require_psql
  _svc_log "checking for dead jobs..."
  
  local dead_jobs
  dead_jobs=$(psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT id, type, error_message, payload FROM jobs WHERE status = 'dead' ORDER BY updated_at ASC;")
  
  if [[ -z "$dead_jobs" ]]; then
    _svc_ok "no dead jobs to triage."
    return 0
  fi

  echo "$dead_jobs" | while IFS='|' read -r id type error payload; do
    printf "\n\033[1;31m=== DEAD JOB [%s] ===\033[0m\n" "${id:0:8}"
    printf "Type:    %s\n" "$type"
    printf "Payload: %s\n" "$payload"
    printf "Error:   %s\n" "$error"
    printf -- "---------------------------------\n"
    
    printf "AI Analysis:\n"
    local prompt
    prompt=$(cat <<EOF
You are an expert platform debugger. The following async job has failed permanently (reached max retries).
Type: $type
Payload: $payload
Error: $error

Analyze the failure and suggest 1-2 possible reasons and how to fix them. Be concise.
EOF
)
    echo "$prompt" | "${ZDOTDIR}/bin/ai-query" --mode raw 2>/dev/null | sed 's/^/  /' || echo "  (AI analysis failed)"

    printf "\nAction [r=requeue, d=delete, s=skip]: "
    local action
    read -r action </dev/tty || action="s"
    
    if [[ "$action" == "r" ]]; then
      psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT requeue_job('${id}');" >/dev/null
      _svc_ok "job reset to pending."
    elif [[ "$action" == "d" ]]; then
      psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "DELETE FROM jobs WHERE id = '${id}';" >/dev/null
      _svc_ok "job deleted."
    else
      _svc_log "skipped."
    fi
  done
}

cmd_clear_stale_jobs() {
  _require_psql
  local timeout_interval="${1:-3 minutes}"

  _svc_log "clearing jobs stuck in 'running' for more than ${timeout_interval}..."
  local count
  count=$(psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT clear_stale_jobs('${timeout_interval}'::interval);")
  _svc_ok "stale jobs updated to 'failed': ${count:-0} affected."
}

cmd_metrics_loop() {
  _require_psql
  
  local otlp_endpoint="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://127.0.0.1:4318}"
  local poll_interval="${1:-60}"
  
  _svc_log "starting metrics export loop (interval: ${poll_interval}s)..."
  _svc_log "target endpoint: ${otlp_endpoint}/v1/metrics"
  
  # Graceful shutdown trap
  trap '
    _svc_log "metrics loop interrupted. exiting..."
    exit 0
  ' SIGINT SIGTERM

  while true; do
    local pending_count dead_count
    pending_count=$(psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT count(*) FROM jobs WHERE status = 'pending';" 2>/dev/null || echo 0)
    dead_count=$(psql "${ZDOTS_DATABASE_URL}" -X -t -A -q -c "SELECT count(*) FROM jobs WHERE status = 'dead';" 2>/dev/null || echo 0)

    # Use python to get timeUnixNano (platform independent)
    local ts_nano
    if command -v python3 >/dev/null 2>&1; then
      ts_nano=$(python3 -c "import time; print(int(time.time() * 1e9))")
    elif command -v gdate >/dev/null 2>&1; then
      ts_nano=$(gdate +%s%N)
    else
      ts_nano=$(date +%s000000000)
    fi
    
    local payload
    payload=$(cat <<EOF
{
  "resourceMetrics": [
    {
      "resource": {
        "attributes": [
          { "key": "service.name", "value": { "stringValue": "zdots-ctx" } }
        ]
      },
      "scopeMetrics": [
        {
          "scope": { "name": "zdots.queue" },
          "metrics": [
            {
              "name": "zdots.jobs.pending",
              "description": "Number of pending jobs",
              "unit": "{jobs}",
              "gauge": {
                "dataPoints": [
                  { "asInt": "${pending_count}", "timeUnixNano": "${ts_nano}" }
                ]
              }
            },
            {
              "name": "zdots.jobs.dead",
              "description": "Number of dead jobs",
              "unit": "{jobs}",
              "gauge": {
                "dataPoints": [
                  { "asInt": "${dead_count}", "timeUnixNano": "${ts_nano}" }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
EOF
)

    curl -s -o /dev/null -X POST -H "Content-Type: application/json" -d "$payload" "${otlp_endpoint}/v1/metrics" || true
    
    sleep "${poll_interval}"
  done
}

cmd_backup() {
  if ! command -v pg_dump >/dev/null 2>&1; then
    _svc_die "pg_dump not found. Run: brew install postgresql@18"
  fi

  local backup_dir="${MY_ROOT}/backups"
  mkdir -p "$backup_dir"

  local timestamp
  timestamp=$(date +%Y%m%d_%H%M%S)
  local db_name
  db_name=$(echo "${ZDOTS_DATABASE_URL}" | sed -E 's/.*\///')
  local backup_file="${backup_dir}/${db_name}_${timestamp}.sql.gz"

  _svc_log "creating backup: ${backup_file}..."
  if pg_dump "${ZDOTS_DATABASE_URL}" | gzip > "$backup_file"; then
    _svc_ok "backup complete."
    # Maintain last 10 backups
    ls -t "${backup_dir}/${db_name}"_*.sql.gz 2>/dev/null | tail -n +11 | xargs rm -f -- 2>/dev/null || true
  else
    _svc_die "backup failed."
  fi
}

cmd_restore() {
  local backup_file="${1:-}"
  if [[ -z "$backup_file" ]]; then
    _svc_die "usage: zdots-ctx restore <path-to-sql-gz>"
  fi

  if [[ ! -f "$backup_file" ]]; then
    _svc_die "backup file not found: $backup_file"
  fi

  _require_psql
  _svc_log "restoring from ${backup_file}..."
  
  # WARNING: This is destructive to the current database
  printf "WARNING: This will overwrite the current database. Proceed? [y/N] "
  local response
  read -r response
  if [[ ! "$response" =~ ^[Yy]$ ]]; then
    _svc_log "aborted."
    return 1
  fi

  local db_name
  db_name=$(echo "${ZDOTS_DATABASE_URL}" | sed -E 's/.*\///')
  local base_url
  base_url=$(echo "${ZDOTS_DATABASE_URL}" | sed -E 's/\/[^/]+$/\/postgres/')

  psql "${base_url}" -c "DROP DATABASE IF EXISTS ${db_name} (FORCE);" >/dev/null 2>&1
  psql "${base_url}" -c "CREATE DATABASE ${db_name};" >/dev/null 2>&1

  if gunzip -c "$backup_file" | psql "${ZDOTS_DATABASE_URL}" >/dev/null 2>&1; then
    _svc_ok "restore complete."
  else
    _svc_die "restore failed."
  fi
}

cmd_seed() {
  local standards_dir="${MY_ROOT}/standards"
  if [[ ! -d "$standards_dir" ]]; then
    _svc_die "standards directory not found: $standards_dir"
  fi

  _svc_log "importing standards from ${standards_dir}..."

  for f in "${standards_dir}"/*.md; do
    [[ -e "$f" ]] || continue
    local slug title
    slug=$(basename "$f" .md | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    title=$(head -n 1 "$f" | sed 's/^# //')

    _svc_log "seeding: ${slug}..."
    "${ZDOTDIR}/sbin/zdots-brain" seed-methodology-file "$slug" "$title" "$f"
  done
  _svc_ok "seeding complete."
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  status)   shift; cmd_status "${@}" ;;
  init-db)  shift; cmd_init_db "${@}" ;;
  migrate)  shift; cmd_migrate "${@}" ;;
  query)    shift; cmd_query "${@}" ;;
  capture)  shift; cmd_capture "${@}" ;;
  hydrate)  shift; cmd_hydrate "${@}" ;;
  seed)     shift; cmd_seed "${@}" ;;
  add-methodology) shift; cmd_add_methodology "${@}" ;;
  add-lesson)      shift; cmd_add_lesson "${@}" ;;
  ingest)          shift; cmd_ingest "${@}" ;;
  sync-history)    shift; cmd_sync_history "${@}" ;;
  enqueue)         shift; cmd_enqueue "${@}" ;;
  requeue)         shift; cmd_requeue "${@}" ;;
  jobs)            shift; cmd_jobs "${@}" ;;
  worker)          shift; cmd_worker "${@}" ;;
  triage)          shift; cmd_triage "${@}" ;;
  clear-stale-jobs) shift; cmd_clear_stale_jobs "${@}" ;;
  metrics-loop)    shift; cmd_metrics_loop "${@}" ;;
  backup)   shift; cmd_backup "${@}" ;;
  restore)  shift; cmd_restore "${@}" ;;
  -h|--help) usage; exit 0 ;;
  "")       usage >&2; exit 1 ;;
  *)        printf 'zdots-ctx: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
