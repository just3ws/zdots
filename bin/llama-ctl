#!/usr/bin/env bash
# bin/llama-ctl — Manage the local llama.cpp inference server.
#
# RATIONALE:
# llama.cpp is the primary local AI runtime. This script installs the binary
# via Homebrew, manages the launchd service lifecycle, and handles model
# storage on a storage-constrained 256GB primary drive.
#
# CONFIG:
# All server flags and model profiles are driven by etc/ai-models.yaml.
# Edit that file, then run `llama-ctl install` to regenerate the plist and
# restart the server. No manual plist editing required.
#
# MODEL STORAGE:
# Models default to $ZDOTS_AI_MODELS_DIR (~/.local/share/llama-cpp/models).
# Override to an external drive: export ZDOTS_AI_MODELS_DIR=/Volumes/SSD/llama
#
# HARDWARE TUNING (M4 16GB — from etc/ai-models.yaml):
#   --n-gpu-layers 99       full Metal offload; all layers on GPU
#   --ctx-size 32768        ~2GB KV cache for 7B Q4 at q8_0 quantization
#   --parallel 2            two concurrent decode slots
#   --batch-size 2048       logical batch; covers long embedding inputs
#   --ubatch-size 2048      physical Metal kernel dispatch size; must match batch-size for embeddings
#   --cache-type-k q8_0     KV cache K: half the memory of f16
#   --cache-type-v q8_0     KV cache V: half the memory of f16
#   --cache-reuse 256       prefix KV reuse across requests (system prompt)
#   --predict 2048          per-request generation cap; prevents slot starvation
#   --flash-attn on         2-4x KV cache reduction on Apple Silicon
#   --embeddings            /v1/embeddings endpoint (OpenAI-compatible)
#   --metrics               Prometheus metrics at /metrics

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
CONFIG_FILE="$ZDOTDIR/etc/ai-models.yaml"
MODELS_DIR="${ZDOTS_AI_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llama-cpp/models}"
LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/llama-server.log"
PLIST_LABEL="com.zdots.llama-server"
PLIST_FILE="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
META_LIB="$ZDOTDIR/lib/metadata.bash"

SVC_NAME="llama-server"
# shellcheck source=lib/svc-launchd.bash
source "${ZDOTDIR}/lib/svc-launchd.bash"
# Source the model store
# shellcheck source=lib/model-store.bash
source "${ZDOTDIR}/lib/model-store.bash"

# Resolve all AI configuration via the unified metadata service.
# Single JSON fetch — no eval, no code injection risk.
_META_JSON=""
if [[ -f "$META_LIB" ]]; then
  _META_JSON=$(bash "$META_LIB" dump ai 2>/dev/null) || _META_JSON=""
fi

# Safe field accessor — jq parses the JSON, never executes it.
_meta_get() {
  local key="$1" default="${2:-}"
  [[ -z "$_META_JSON" ]] && { printf '%s' "$default"; return; }
  local val
  val=$(printf '%s' "$_META_JSON" | jq -r ".${key} | select(. != null) | tostring" 2>/dev/null)
  printf '%s' "${val:-$default}"
}

AI_PROFILE=$(_meta_get active_profile "standard")
AI_ENDPOINT=$(_meta_get endpoint "http://127.0.0.1:8080")

_has_yq() { command -v yq >/dev/null 2>&1; }

_yq_get() {
  yq "$1" "$CONFIG_FILE" 2>/dev/null
}

# _yq_field <path> <default> — like _meta_get but reads yq paths directly.
_yq_field() {
  local val; val=$(_yq_get "$1" 2>/dev/null)
  [[ "$val" == "null" || -z "$val" ]] && printf '%s' "${2:-}" || printf '%s' "$val"
}

usage() {
  cat <<EOF
Usage: llama-ctl <command> [--json]

Service Lifecycle:
  install           Install llama.cpp (Homebrew), write launchd plist, and
                    auto-start the server if the active model is present.
                    Re-run after any change to etc/ai-models.yaml.
  start             Load launchd service (RunAtLoad + KeepAlive)
  stop              Unload launchd service
  restart           stop, wait 1s, start
  status            launchd state + health endpoint + active model name
  health            Exit 0 if server is up, exit 1 if down
  logs              tail -f the server log
  validate          Validate etc/ai-models.yaml (requires yq)
  config            Dump all resolved server configuration values

Model Management:
  model-list        List downloaded GGUFs with disk sizes; marks active model
  model-download [--draft]  Download active profile's GGUF from HuggingFace (resumable).
                            --draft also downloads the speculative draft model if defined.
  model-switch <p>  Print step-by-step instructions to switch to profile <p>

Embedding Server (dedicated, port 8090):
  install-embed     Download Nomic embed model if needed; write com.zdots.llama-embed.plist; start server.
  start-embed       Load embed launchd service
  stop-embed        Unload embed launchd service
  status-embed      Status of the embedding server
  model-prune       Delete all GGUFs except the active profile's model — DESTRUCTIVE
  model-df          Disk usage summary for the model directory

Options:
  --json      Output as JSON (valid for status, health, config)
  -h, --help  Show this help

Config:
  etc/ai-models.yaml   Model profiles (model_file, ctx_size, n_gpu_layers, ...)
                       and server flags (batch sizes, KV cache, embeddings, ...)

Environment:
  ZDOTS_AI_PROFILE      Active profile; overrides default_profile from yaml
                        (default: value of .default_profile in etc/ai-models.yaml)
  ZDOTS_AI_MODELS_DIR   Model storage root
                        (default: \${XDG_DATA_HOME:-~/.local/share}/llama-cpp/models)
EOF
}

_binary() {
  # Only check the Homebrew-installed binary explicitly. Never use `command -v
  # llama-server` — our own script lives in $ZDOTDIR/bin/llama-server (higher
  # PATH precedence than Homebrew) and would resolve circularly.
  local prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
  if [[ -x "$prefix/bin/llama-server" ]]; then
    echo "$prefix/bin/llama-server"
  fi
  # Returns empty string if not installed.
}

_require_binary() {
  local bin; bin=$(_binary)
  if [[ -z "$bin" ]]; then
    echo "llama-ctl: error: llama.cpp not installed. Run 'llama-ctl install'." >&2
    exit 1
  fi
  echo "$bin"
}

_require_yq() {
  if ! _has_yq; then
    echo "llama-ctl: error: yq required for YAML parsing. Run: brew install yq" >&2
    exit 1
  fi
}

_profile_field() { _meta_get "$1" "${2:-}"; }
_server_field()  { _meta_get "$1" "${2:-}"; }

# ─── Resolved server configuration ───────────────────────────────────────────
# _resolve_config() reads _META_JSON once with a single jq invocation and
# populates the _CFG_* module-level variables below.  Both _register_plist and
# config_dump call it; repeated calls are no-ops (_CFG_RESOLVED guard).
_CFG_RESOLVED=0
_CFG_HOST="" _CFG_PORT="" _CFG_CTX_SIZE="" _CFG_N_GPU_LAYERS=""
_CFG_PARALLEL="" _CFG_BATCH_SIZE="" _CFG_UBATCH_SIZE=""
_CFG_CACHE_TYPE_K="" _CFG_CACHE_TYPE_V="" _CFG_N_PREDICT="" _CFG_CACHE_REUSE=""
_CFG_ALIAS="" _CFG_EMBEDDINGS="" _CFG_POOLING="" _CFG_FLASH_ATTN="" _CFG_METRICS=""
_CFG_TEMPERATURE="" _CFG_NO_THINKING="" _CFG_DRAFT_MODEL_FILE="" _CFG_SPEC_DRAFT_N_MAX=""

_resolve_config() {
  [[ "$_CFG_RESOLVED" -eq 1 ]] && return 0
  local -a _v
  mapfile -t _v < <(printf '%s' "${_META_JSON:-{\}}" | jq -r '
    (.host           // "127.0.0.1"),
    ((.port          // "8080")  | tostring),
    ((.ctx_size      // "4096")  | tostring),
    ((.n_gpu_layers  // "99")    | tostring),
    ((.parallel      // "2")     | tostring),
    ((.batch_size    // "2048")  | tostring),
    ((.ubatch_size   // "512")   | tostring),
    (.cache_type_k   // "f16"),
    (.cache_type_v   // "f16"),
    ((.n_predict     // "-1")    | tostring),
    ((.cache_reuse   // "0")     | tostring),
    (.alias          // ""),
    ((.embeddings    // false)   | tostring),
    (.pooling        // "mean"),
    ((.flash_attn    // false)   | tostring),
    ((.metrics       // false)   | tostring),
    (.temperature    // ""),
    ((.no_thinking   // false)   | tostring),
    (.draft_model_file  // ""),
    ((.spec_draft_n_max // "5")  | tostring)
  ' 2>/dev/null)
  _CFG_HOST="${_v[0]:-127.0.0.1}"
  _CFG_PORT="${_v[1]:-8080}"
  _CFG_CTX_SIZE="${_v[2]:-4096}"
  _CFG_N_GPU_LAYERS="${_v[3]:-99}"
  _CFG_PARALLEL="${_v[4]:-2}"
  _CFG_BATCH_SIZE="${_v[5]:-2048}"
  _CFG_UBATCH_SIZE="${_v[6]:-512}"
  _CFG_CACHE_TYPE_K="${_v[7]:-f16}"
  _CFG_CACHE_TYPE_V="${_v[8]:-f16}"
  _CFG_N_PREDICT="${_v[9]:--1}"
  _CFG_CACHE_REUSE="${_v[10]:-0}"
  _CFG_ALIAS="${_v[11]:-}"
  _CFG_EMBEDDINGS="${_v[12]:-false}"
  _CFG_POOLING="${_v[13]:-mean}"
  _CFG_FLASH_ATTN="${_v[14]:-false}"
  _CFG_METRICS="${_v[15]:-false}"
  _CFG_TEMPERATURE="${_v[16]:-}"
  _CFG_NO_THINKING="${_v[17]:-false}"
  _CFG_DRAFT_MODEL_FILE="${_v[18]:-}"
  _CFG_SPEC_DRAFT_N_MAX="${_v[19]:-5}"
  _CFG_RESOLVED=1
}

_active_model_file() {
  # Profile metadata takes precedence — ZDOTS_AI_MODEL_FILE is stale once
  # zdots_ai_init exports it from a previous profile run.
  local mf; mf=$(_meta_get model_file "")
  [[ -n "$mf" ]] && { echo "$mf"; return; }
  # Env var fallback: honoured only when no profile metadata is available.
  [[ -n "${ZDOTS_AI_MODEL_FILE:-}" ]] && { echo "$ZDOTS_AI_MODEL_FILE"; return; }
  # Last resort: first gguf in models dir
  find "$MODELS_DIR" -maxdepth 1 -name '*.gguf' 2>/dev/null | head -1 | xargs -I{} basename {} 2>/dev/null || true
}

_active_model_path() {
  local file; file=$(_active_model_file)
  [[ -n "$file" ]] && echo "$MODELS_DIR/$file" || echo ""
}

install_llama() {
  local bin; bin=$(_binary)
  if [[ -n "$bin" ]]; then
    local ver; ver=$("$bin" --version 2>&1 | grep '^version:' || echo "version unknown")
    printf 'llama-ctl: llama.cpp already installed (%s)\n' "$ver" >&2
  else
    printf 'llama-ctl: installing llama.cpp via Homebrew...\n' >&2
    brew install llama.cpp
  fi
  mkdir -p "$MODELS_DIR"
  chmod 700 "$MODELS_DIR"
  printf 'llama-ctl: model directory: %s\n' "$MODELS_DIR" >&2

  # Guard: model must be present before writing the plist.  Starting launchd
  # with a missing --model path causes a crash loop that requires manual unload.
  local _mp; _mp=$(_active_model_path)
  if [[ -z "$_mp" || ! -f "$_mp" ]]; then
    printf 'llama-ctl: model not found — run '"'"'llama-ctl model-download'"'"' then '"'"'llama-ctl install'"'"'\n' >&2
    exit 1
  fi

  # (Re-)register plist. Unload first if already loaded so the updated plist takes effect.
  if [[ -f "$PLIST_FILE" ]]; then
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
  fi
  _register_plist

  printf 'llama-ctl: loading service...\n' >&2
  launchctl bootstrap "gui/$(id -u)" "$PLIST_FILE"
  printf 'llama-ctl: server started\n' >&2
}

_register_plist() {
  local bin; bin=$(_require_binary)
  _resolve_config

  # Authoritative model guard — fail fast rather than write a crash-loop plist.
  local model_file; model_file=$(_active_model_file)
  local model_path="${MODELS_DIR}/${model_file:-}"
  if [[ -z "$model_file" || ! -f "$model_path" ]]; then
    printf 'llama-ctl: error: model not found: %s\n' "${model_path:-<not configured>}" >&2
    printf '  Run: llama-ctl model-download\n' >&2
    exit 1
  fi

  local -a args=(
    "--host"         "${_CFG_HOST}"
    "--port"         "${_CFG_PORT}"
    "--model"        "${model_path}"
    "--ctx-size"     "${_CFG_CTX_SIZE}"
    "--n-gpu-layers" "${_CFG_N_GPU_LAYERS}"
    "--parallel"     "${_CFG_PARALLEL}"
    "--batch-size"   "${_CFG_BATCH_SIZE}"
    "--ubatch-size"  "${_CFG_UBATCH_SIZE}"
    "--cache-type-k" "${_CFG_CACHE_TYPE_K}"
    "--cache-type-v" "${_CFG_CACHE_TYPE_V}"
  )

  [[ "$_CFG_EMBEDDINGS" == "true" ]] && args+=("--embeddings" "--pooling" "${_CFG_POOLING}")
  [[ "$_CFG_FLASH_ATTN" == "true" ]] && args+=("--flash-attn" "on")
  [[ "$_CFG_METRICS"    == "true" ]] && args+=("--metrics")
  [[ "$_CFG_N_PREDICT" != "-1" && -n "$_CFG_N_PREDICT" ]] && args+=("--predict" "${_CFG_N_PREDICT}")
  # cache-reuse conflicts with speculative decoding (KV position mismatch); skip when draft model present.
  if [[ -z "$_CFG_DRAFT_MODEL_FILE" || "$_CFG_DRAFT_MODEL_FILE" == "null" ]]; then
    [[ "$_CFG_CACHE_REUSE" != "0" && -n "$_CFG_CACHE_REUSE" ]] && args+=("--cache-reuse" "${_CFG_CACHE_REUSE}")
  fi
  [[ -n "$_CFG_ALIAS"       && "$_CFG_ALIAS"       != "null" ]] && args+=("--alias" "${_CFG_ALIAS}")
  [[ -n "$_CFG_TEMPERATURE" && "$_CFG_TEMPERATURE" != "null" ]] && args+=("--temp"  "${_CFG_TEMPERATURE}")
  [[ "$_CFG_NO_THINKING" == "true" ]] && args+=("--reasoning" "off")

  if [[ -n "$_CFG_DRAFT_MODEL_FILE" && "$_CFG_DRAFT_MODEL_FILE" != "null" ]]; then
    local draft_path="${MODELS_DIR}/${_CFG_DRAFT_MODEL_FILE}"
    if [[ -f "$draft_path" ]]; then
      args+=("--spec-draft-model" "${draft_path}")
      args+=("--spec-draft-n-max" "${_CFG_SPEC_DRAFT_N_MAX}")
      args+=("--spec-draft-type-k" "q8_0")
      args+=("--spec-draft-type-v" "q8_0")
    else
      echo "llama-ctl: note: draft model not found (${_CFG_DRAFT_MODEL_FILE}) — speculative decoding disabled." >&2
      echo "  Run: ZDOTS_AI_PROFILE=${AI_PROFILE} llama-ctl model-download --draft" >&2
    fi
  fi

  export ZDOTS_AI_PROFILE="${AI_PROFILE}"
  export ZDOTS_AI_MODELS_DIR="${MODELS_DIR}"
  ZDOTS_SVC_ENV_KEYS="HOME ZDOTDIR ZDOTS_AI_PROFILE ZDOTS_AI_MODELS_DIR" \
    zdots_svc_launchd_register "$PLIST_LABEL" "$PLIST_FILE" "$bin" "$LOG_FILE" "${args[@]}"
}

start_llama() {
  local bin; bin=$(_binary)
  if [[ -z "$bin" ]]; then
    printf 'llama-ctl: error: llama.cpp not installed — run: llama-ctl install\n' >&2
    exit 1
  fi
  local _mp; _mp=$(_active_model_path)
  if [[ -z "$_mp" || ! -f "$_mp" ]]; then
    printf 'llama-ctl: error: model not found — run '"'"'llama-ctl model-download'"'"' then '"'"'llama-ctl start'"'"'\n' >&2
    exit 1
  fi
  zdots_model_verify "$_mp" || exit 1
  zdots_svc_launchd_start "$PLIST_LABEL" "$PLIST_FILE"
}

stop_llama() {
  zdots_svc_launchd_stop "$PLIST_LABEL"
}

status_llama() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local state running pid healthy
  state=$(zdots_svc_launchd_status "$PLIST_LABEL")
  running=$(echo "$state" | awk '{print $1}')
  pid=$(echo "$state" | awk '{print $2}')
  
  zdots_svc_health_check_url "${AI_ENDPOINT}/health" && healthy=true || healthy=false

  zdots_svc_print_status "$json" "$running" "$pid" "$AI_ENDPOINT" "$LOG_FILE" \
    "profile=${AI_PROFILE}" \
    "active_model=$(_active_model_file)" \
    "healthy=${healthy}" \
    "launchd=$([[ -f "$PLIST_FILE" ]] && echo true || echo false)"
}

health_llama() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local healthy
  zdots_svc_health_check_url "${AI_ENDPOINT}/health" && healthy=true || healthy=false
  
  zdots_svc_print_health "$json" "$healthy" "$AI_ENDPOINT"
}


model_list() {
  local count=0
  while IFS= read -r -d '' f; do
    if [[ $count -eq 0 ]]; then
      echo "Downloaded models in $MODELS_DIR:"
      echo ""
    fi
    local size name active marker
    size=$(du -sh "$f" 2>/dev/null | cut -f1)
    name=$(basename "$f")
    active=$(_active_model_file)
    marker=""
    [[ "$name" == "$active" ]] && marker=" [active:${AI_PROFILE}]"
    printf "  %s  %s%s\n" "$size" "$name" "$marker"
    count=$((count + 1))
  done < <(find "$MODELS_DIR" -maxdepth 1 -name '*.gguf' -print0 2>/dev/null)

  if [[ $count -eq 0 ]]; then
    echo "llama-ctl: no models in $MODELS_DIR"
    return 0
  fi

  echo ""
  echo "Total:"
  du -sh "$MODELS_DIR" 2>/dev/null | cut -f1 | xargs -I{} echo "  {}"
}

model_download() {
  _require_yq
  local draft_only=false
  [[ "${1:-}" == "--draft" ]] && draft_only=true

  if ! $draft_only; then
    local hf_repo model_file
    hf_repo=$(_profile_field hf_repo "")
    model_file=$(_profile_field model_file "")

    if [[ -z "$hf_repo" || "$hf_repo" == "null" || -z "$model_file" || "$model_file" == "null" ]]; then
      echo "llama-ctl: error: no hf_repo or model_file for profile '${AI_PROFILE}'" >&2
      exit 1
    fi
    zdots_model_download "$hf_repo" "$model_file" "$MODELS_DIR"
  fi

  # Draft model download (if profile defines one).
  local draft_hf_repo draft_model_file
  draft_hf_repo=$(_profile_field draft_hf_repo "")
  draft_model_file=$(_profile_field draft_model_file "")
  if [[ -n "$draft_hf_repo" && "$draft_hf_repo" != "null" && \
        -n "$draft_model_file" && "$draft_model_file" != "null" ]]; then
    zdots_model_download "$draft_hf_repo" "$draft_model_file" "$MODELS_DIR"
  elif $draft_only; then
    echo "llama-ctl: error: no draft_hf_repo / draft_model_file for profile '${AI_PROFILE}'" >&2
    exit 1
  fi
}

model_switch() {
  local new_profile="${1:-}"
  if [[ -z "$new_profile" ]]; then
    echo "Usage: llama-ctl model-switch <profile>" >&2
    if _has_yq; then
      echo "Available profiles:" >&2
      _yq_get ".profiles | keys | .[]" | sed 's/^/  /' >&2
    fi
    exit 1
  fi

  if _has_yq; then
    local check; check=$(_yq_get ".profiles.${new_profile}.model_file")
    if [[ "$check" == "null" ]]; then
      echo "llama-ctl: error: unknown profile '${new_profile}'" >&2
      exit 1
    fi
  fi

  echo "llama-ctl: to switch to '${new_profile}':"
  echo ""
  echo "  1. Set in .zdots.env:"
  echo "       export ZDOTS_AI_PROFILE=${new_profile}"
  echo ""
  echo "  2. Download model:"
  echo "       ZDOTS_AI_PROFILE=${new_profile} llama-ctl model-download"
  echo ""
  echo "  3. Re-register and restart:"
  echo "       ZDOTS_AI_PROFILE=${new_profile} llama-ctl install"
  echo "       llama-ctl restart"
}

model_prune() {
  _require_yq
  local -a protect=()
  
  # Identify active models for ALL profiles to protect them
  while read -r p; do
    local file; file=$(_yq_get ".profiles.${p}.model_file")
    [[ -z "$file" || "$file" == "null" ]] && continue
    protect+=("$file")
  done < <(_yq_get ".profiles | keys | .[]")

  if [[ ${#protect[@]} -eq 0 ]]; then
    echo "llama-ctl: error: could not determine any active models to protect." >&2
    exit 1
  fi

  if [[ ! -d "$MODELS_DIR" ]]; then
    echo "model-store: no directory to prune: $MODELS_DIR"
    return 0
  fi

  local pruned=0
  while IFS= read -r -d '' f; do
    local name; name=$(basename "$f")
    local skip=false
    for p in "${protect[@]}"; do
      [[ "$name" == "$p" ]] && skip=true && break
    done
    $skip && continue

    echo "model-store: removing orphaned model: $name"
    rm -f "$f"
    pruned=$((pruned + 1))
  done < <(find "$MODELS_DIR" -maxdepth 1 -name "*.gguf" -print0 2>/dev/null)

  echo "model-store: pruned $pruned orphaned model(s) from $MODELS_DIR"
}

model_df() {
  printf '=== llama.cpp model storage ===\n'
  if [[ -d "$MODELS_DIR" ]]; then
    du -sh "$MODELS_DIR" 2>/dev/null
    printf '\n'
    model_list
  else
    printf '  %s does not exist yet.\n' "$MODELS_DIR"
  fi
}

validate_llama() {
  if ! _has_yq; then
    printf 'llama-ctl: error: yq required. Run: brew install yq\n' >&2
    exit 1
  fi
  printf 'llama-ctl: validating %s...\n' "$CONFIG_FILE" >&2
  if yq eval '.' "$CONFIG_FILE" > /dev/null; then
    printf 'llama-ctl: config OK\n'
  else
    printf 'llama-ctl: error: invalid YAML\n' >&2; exit 1
  fi
  # Check required top-level keys
  for key in profiles server default_profile; do
    local val; val=$(yq ".$key" "$CONFIG_FILE" 2>/dev/null)
    if [[ "$val" == "null" || -z "$val" ]]; then
      printf 'llama-ctl: error: missing required key: %s\n' "$key" >&2
      exit 1
    fi
  done
  printf 'llama-ctl: profile "%s" — ' "$AI_PROFILE"
  local mf; mf=$(_profile_field model_file "")
  if [[ -n "$mf" && "$mf" != "null" ]]; then
    printf 'model_file: %s\n' "$mf"
  else
    printf 'WARNING: no model_file for this profile\n' >&2
  fi
}

logs_llama() {
  zdots_svc_logs "$LOG_FILE"
}

# config_dump — print all resolved server configuration values.
#
# Outputs the fully-resolved parameters that llama-server is (or would be)
# started with: endpoint, model, context size, batch limits, KV cache policy,
# embedding settings, etc.  Other tools can read this to plan their own
# behaviour — for example an embedding client can read batch_size and
# ubatch_size to know the maximum safe input length without trial-and-error.
#
# Usage:
#   llama-ctl config           # human-readable key: value pairs
#   llama-ctl config --json    # machine-readable JSON
config_dump() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  _resolve_config

  local model_file model_path endpoint
  model_file=$(_active_model_file)
  model_path=$(_active_model_path)
  endpoint=$(_meta_get endpoint "http://127.0.0.1:8080")

  if $json; then
    local emb_j flash_j metrics_j
    emb_j=$(   [[ "$_CFG_EMBEDDINGS" == "true" ]] && echo "true" || echo "false")
    flash_j=$(  [[ "$_CFG_FLASH_ATTN" == "true" ]] && echo "true" || echo "false")
    metrics_j=$([[ "$_CFG_METRICS"   == "true" ]] && echo "true" || echo "false")
    printf '{\n'
    printf '  "profile":      "%s",\n' "$AI_PROFILE"
    printf '  "endpoint":     "%s",\n' "$endpoint"
    printf '  "host":         "%s",\n' "$_CFG_HOST"
    printf '  "port":         %s,\n'   "$_CFG_PORT"
    printf '  "model_file":   "%s",\n' "${model_file:-}"
    printf '  "model_path":   "%s",\n' "${model_path:-}"
    printf '  "alias":        "%s",\n' "${_CFG_ALIAS:-}"
    printf '  "ctx_size":     %s,\n'   "$_CFG_CTX_SIZE"
    printf '  "n_gpu_layers": %s,\n'   "$_CFG_N_GPU_LAYERS"
    printf '  "parallel":     %s,\n'   "$_CFG_PARALLEL"
    printf '  "batch_size":   %s,\n'   "$_CFG_BATCH_SIZE"
    printf '  "ubatch_size":  %s,\n'   "$_CFG_UBATCH_SIZE"
    printf '  "cache_type_k": "%s",\n' "$_CFG_CACHE_TYPE_K"
    printf '  "cache_type_v": "%s",\n' "$_CFG_CACHE_TYPE_V"
    printf '  "n_predict":    %s,\n'   "$_CFG_N_PREDICT"
    printf '  "cache_reuse":  %s,\n'   "$_CFG_CACHE_REUSE"
    printf '  "embeddings":   %s,\n'   "$emb_j"
    printf '  "pooling":      "%s",\n' "$_CFG_POOLING"
    printf '  "flash_attn":   %s,\n'   "$flash_j"
    printf '  "metrics":      %s,\n'   "$metrics_j"
    printf '  "_discovery": {\n'
    printf '    "model_name_rule":    "Always use alias in API calls — never model_file",\n'
    printf '    "max_embed_tokens":   %s,\n'  "$_CFG_UBATCH_SIZE"
    printf '    "mcp_server":         "%s/bin/llama-mcp",\n'  "$ZDOTDIR"
    printf '    "caps_command":       "%s/bin/llama-caps --json",\n' "$ZDOTDIR"
    printf '    "caps_md_command":    "%s/bin/llama-caps --md",\n'   "$ZDOTDIR"
    printf '    "validate_command":   "ruby %s/tests/llama_integration.rb --quick",\n' "$ZDOTDIR"
    printf '    "ruby_llm_kwargs":    {"assume_model_exists": true, "provider": "openai"},\n'
    printf '    "plist_staleness":    "Run llama-ctl install after any yaml change"\n'
    printf '  }\n'
    printf '}\n'
  else
    printf '%-16s %s\n' "profile:"      "$AI_PROFILE"
    printf '%-16s %s\n' "endpoint:"     "$endpoint"
    printf '%-16s %s\n' "model_file:"   "${model_file:-(not set)}"
    printf '%-16s %s\n' "alias:"        "${_CFG_ALIAS:-(none)}"
    printf '%-16s %s\n' "ctx_size:"     "$_CFG_CTX_SIZE"
    printf '%-16s %s\n' "n_gpu_layers:" "$_CFG_N_GPU_LAYERS"
    printf '%-16s %s\n' "parallel:"     "$_CFG_PARALLEL"
    printf '%-16s %s\n' "batch_size:"   "$_CFG_BATCH_SIZE"
    printf '%-16s %s\n' "ubatch_size:"  "$_CFG_UBATCH_SIZE"
    printf '%-16s %s\n' "cache_type_k:" "$_CFG_CACHE_TYPE_K"
    printf '%-16s %s\n' "cache_type_v:" "$_CFG_CACHE_TYPE_V"
    printf '%-16s %s\n' "n_predict:"    "$_CFG_N_PREDICT"
    printf '%-16s %s\n' "cache_reuse:"  "$_CFG_CACHE_REUSE"
    printf '%-16s %s\n' "embeddings:"   "$_CFG_EMBEDDINGS"
    printf '%-16s %s\n' "pooling:"      "$_CFG_POOLING"
    printf '%-16s %s\n' "flash_attn:"   "$_CFG_FLASH_ATTN"
    printf '%-16s %s\n' "metrics:"      "$_CFG_METRICS"
  fi
}

# ─── Embedding server (com.zdots.llama-embed, port 8090) ─────────────────────
EMBED_PLIST_LABEL="com.zdots.llama-embed"
EMBED_PLIST_FILE="$HOME/Library/LaunchAgents/${EMBED_PLIST_LABEL}.plist"
EMBED_LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/llama-embed.log"
EMBED_PROFILE="embed"
EMBED_ENDPOINT="http://127.0.0.1:8090"

_register_embed_plist() {
  local bin; bin=$(_require_binary)
  _require_yq

  local model_file; model_file=$(_yq_field ".profiles.${EMBED_PROFILE}.model_file" "")
  if [[ -z "$model_file" ]]; then
    printf 'llama-ctl: error: embed profile missing in %s\n' "$CONFIG_FILE" >&2; exit 1
  fi
  local model_path="${MODELS_DIR}/${model_file}"
  if [[ ! -f "$model_path" ]]; then
    printf 'llama-ctl: warning: embed model not found: %s\n' "$model_path" >&2
    printf '  Run: ZDOTS_AI_PROFILE=embed llama-ctl model-download\n' >&2
    model_path="${MODELS_DIR}/embed.gguf"
  fi

  local ctx_size;    ctx_size=$(   _yq_field ".profiles.${EMBED_PROFILE}.ctx_size"    "512")
  local n_gpu;       n_gpu=$(      _yq_field ".profiles.${EMBED_PROFILE}.n_gpu_layers" "99")
  local host;        host=$(       _yq_field ".embed_server.host"        "127.0.0.1")
  local port;        port=$(       _yq_field ".embed_server.port"        "8090")
  local parallel;    parallel=$(   _yq_field ".embed_server.parallel"    "1")
  local batch;       batch=$(      _yq_field ".embed_server.batch_size"  "2048")
  local ubatch;      ubatch=$(     _yq_field ".embed_server.ubatch_size" "2048")
  local ck;          ck=$(         _yq_field ".embed_server.cache_type_k" "f16")
  local cv;          cv=$(         _yq_field ".embed_server.cache_type_v" "f16")
  local alias_name;  alias_name=$( _yq_field ".embed_server.alias"       "embed")

  local -a args=(
    "--host"         "${host}"
    "--port"         "${port}"
    "--model"        "${model_path}"
    "--ctx-size"     "${ctx_size}"
    "--n-gpu-layers" "${n_gpu}"
    "--parallel"     "${parallel}"
    "--batch-size"   "${batch}"
    "--ubatch-size"  "${ubatch}"
    "--cache-type-k" "${ck}"
    "--cache-type-v" "${cv}"
    "--embeddings"
    "--pooling"      "mean"
    "--alias"        "${alias_name}"
    "--no-warmup"
  )

  ZDOTS_AI_PROFILE="${EMBED_PROFILE}" \
  ZDOTS_AI_MODELS_DIR="${MODELS_DIR}" \
  ZDOTS_SVC_ENV_KEYS="HOME ZDOTDIR ZDOTS_AI_PROFILE ZDOTS_AI_MODELS_DIR" \
    zdots_svc_launchd_register "${EMBED_PLIST_LABEL}" "${EMBED_PLIST_FILE}" \
      "$bin" "${EMBED_LOG_FILE}" "${args[@]}"
}

install_embed() {
  # Download model if needed.
  local model_file; model_file=$(_yq_field ".profiles.${EMBED_PROFILE}.model_file" "")
  if [[ -z "$model_file" ]]; then
    printf 'llama-ctl: error: embed profile not found in %s\n' "$CONFIG_FILE" >&2; exit 1
  fi
  local model_path="${MODELS_DIR}/${model_file}"
  if [[ ! -f "$model_path" ]]; then
    printf 'llama-ctl: embed model not found — downloading...\n' >&2
    ZDOTS_AI_PROFILE="${EMBED_PROFILE}" model_download
  fi

  # (Re-)register plist; unload first if already loaded.
  if [[ -f "$EMBED_PLIST_FILE" ]]; then
    launchctl bootout "gui/$(id -u)/${EMBED_PLIST_LABEL}" 2>/dev/null || true
  fi
  _register_embed_plist

  if [[ -f "$model_path" ]]; then
    printf 'llama-ctl: loading embed service...\n' >&2
    launchctl bootstrap "gui/$(id -u)" "$EMBED_PLIST_FILE"
    printf 'llama-ctl: embed server started on %s\n' "$EMBED_ENDPOINT" >&2
  else
    printf 'llama-ctl: embed model still missing — plist written but service not started\n' >&2
    printf '  Run: ZDOTS_AI_PROFILE=embed llama-ctl model-download && llama-ctl start-embed\n' >&2
  fi
}

start_embed()  { zdots_svc_launchd_start  "$EMBED_PLIST_LABEL" "$EMBED_PLIST_FILE"; }
stop_embed()   { zdots_svc_launchd_stop   "$EMBED_PLIST_LABEL"; }

status_embed() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true
  local state running pid healthy
  state=$(zdots_svc_launchd_status "$EMBED_PLIST_LABEL")
  running=$(echo "$state" | awk '{print $1}')
  pid=$(echo "$state" | awk '{print $2}')
  zdots_svc_health_check_url "${EMBED_ENDPOINT}/health" && healthy=true || healthy=false
  zdots_svc_print_status "$json" "$running" "$pid" "$EMBED_ENDPOINT" "$EMBED_LOG_FILE" \
    "profile=${EMBED_PROFILE}" \
    "healthy=${healthy}" \
    "launchd=$([[ -f "$EMBED_PLIST_FILE" ]] && echo true || echo false)"
}

# ─── case dispatcher ──────────────────────────────────────────────────────────
case "${1:-}" in
  install)        install_llama ;;
  start)          start_llama ;;
  stop)           stop_llama ;;
  restart)        zdots_svc_restart stop_llama start_llama ;;
  status)         shift; status_llama "${@}" ;;
  health)         shift; health_llama "${@}" ;;
  logs)           logs_llama ;;
  validate)       validate_llama ;;
  config)         shift; config_dump "${@}" ;;
  model-list)     model_list ;;
  model-download) shift; model_download "${@}" ;;
  model-verify)   _vp=$(_active_model_path); zdots_model_verify "${_vp:-}" ;;
  model-switch)   model_switch "${2:-}" ;;
  model-prune)    model_prune ;;
  model-df)       model_df ;;
  install-embed)  install_embed ;;
  start-embed)    start_embed ;;
  stop-embed)     stop_embed ;;
  status-embed)   shift; status_embed "${@}" ;;
  -h|--help)      usage; exit 0 ;;
  "")             usage >&2; exit 1 ;;
  *)              printf 'llama-ctl: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
