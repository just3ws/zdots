#!/usr/bin/env bash
# bin/zdots-watch — scheduled doctor loop with transition-only notify (Z-268).
#
# A LaunchAgent runs `run` daily; it executes `zdots-doctor --quiet` (plus
# `capabilities --json` for the contract-error count), parses the
# pass/warn/fail counts and the [warn]/[FAIL] line identities, and diffs them
# against the previous run's state in $XDG_STATE_HOME/zsh/zdots-watch.state.
# A macOS notification fires ONLY when health WORSENS — a new [FAIL], a new
# [warn] (incl. pass→warn/fail), or a higher capability contract error count.
# Improvements and steady state update the file silently. Local-only: no
# cloud, no repair verbs — continuous detection first (cc-burn-watch pattern).
#
# Usage:
#   zdots-watch run          one doctor cycle + notify-on-worsening (launchd calls this)
#   zdots-watch status       last recorded state + LaunchAgent load status (default)
#   zdots-watch --install    render + load the daily LaunchAgent (live paths — Z-263)
#   zdots-watch --uninstall  unload + remove it
#
# Knobs: ZDOTS_WATCH_INTERVAL (seconds, default 86400 = daily).

set -uo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
STATE_FILE="$STATE_DIR/zdots-watch.state"
LOG_FILE="$STATE_DIR/zdots-watch.log"
LABEL="com.zdots.zdots-watch"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
INTERVAL="${ZDOTS_WATCH_INTERVAL:-86400}"

usage() {
  cat <<EOF
Usage: zdots-watch [run|status|--install|--uninstall]

Scheduled zdots-doctor loop. Notifies (macOS) ONLY on worsening transitions:
a new [FAIL], a new [warn], or more capability contract errors than last run.
Improvements update state silently. State: $STATE_FILE

Commands:
  run          one doctor cycle + notify-on-worsening (what launchd calls)
  status       show last recorded state + LaunchAgent load status (default)
  --install    render + load the LaunchAgent (every ${INTERVAL}s; plist rendered
               with live paths at install time — never tracked)
  --uninstall  unload + remove the LaunchAgent
  -h, --help   show this help

Knobs: ZDOTS_WATCH_INTERVAL (seconds, default 86400).
EOF
}

_notify() {
  local title="$1" msg="$2"
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$title" -message "$msg" -group "$LABEL" -sound default >/dev/null 2>&1 || true
  else
    osascript -e "display notification \"${msg//\"/}\" with title \"${title//\"/}\"" >/dev/null 2>&1 || true
  fi
}

# Normalize doctor output (ANSI already stripped) into stable identity lines:
#   sev|label|first-word-of-message
# label = text before the first double-space (doctor's "label  message" form);
# first message word pins the subject (e.g. which launchd service flaps) while
# dropping volatile tails like "(runs=17)" that would cause notify churn.
_identities() {
  awk '
    /^[[:space:]]*\[(warn|WARN|FAIL)\]/ {
      sev = ($0 ~ /\[FAIL\]/) ? "fail" : "warn"
      line = $0
      sub(/^[[:space:]]*\[(warn|WARN|FAIL)\][[:space:]]*/, "", line)
      n = index(line, "  ")
      if (n > 0) { label = substr(line, 1, n - 1); rest = substr(line, n) } \
      else       { label = line; rest = "" }
      gsub(/^[[:space:]]+/, "", rest)
      split(rest, w, /[[:space:]]+/)
      id = sev "|" label
      if (w[1] != "") id = id "|" w[1]
      print id
    }' | sort -u
}

cmd_run() {
  mkdir -p "$STATE_DIR"
  local esc out clean rc=0
  esc=$(printf '\033')
  out="$("$ZDOTDIR/bin/zdots-doctor" --quiet 2>&1)" || rc=$?
  clean="$(printf '%s\n' "$out" | sed "s/${esc}\[[0-9;]*m//g")"

  # Counts from the authoritative summary line (two forms).
  local pass=0 warnc=0 failc=0
  read -r pass warnc failc <<EOF
$(printf '%s\n' "$clean" | awk '
  /^zdots doctor:/ {
    line = $0; n = 0
    while (match(line, /[0-9]+/)) { n++; v[n] = substr(line, RSTART, RLENGTH); line = substr(line, RSTART + RLENGTH) }
    if ($0 ~ /all .* checks passed/) { print v[1], 0, 0 } else { print v[1], v[2], v[3] }
    found = 1
  }
  END { if (!found) print 0, 0, 0 }')
EOF

  local new_ids
  new_ids="$(printf '%s\n' "$clean" | _identities)"

  # Capability contract errors (cheap peer signal; "?" = unavailable, skipped).
  local caps
  caps="$("$ZDOTDIR/bin/capabilities" --json 2>/dev/null | jq -r '.health_errors // 0' 2>/dev/null)" || caps="?"
  [[ "$caps" =~ ^[0-9]+$ ]] || caps="?"

  local ts seeded=0 old_ids="" old_caps="?"
  ts="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  if [[ -r "$STATE_FILE" ]]; then
    old_ids="$(grep -E '^(warn|fail)\|' "$STATE_FILE" 2>/dev/null || true)"
    old_caps="$(sed -n 's/^caps_errors=//p' "$STATE_FILE" | head -1)"
  else
    seeded=1
  fi

  # Worsening = identity present now but not last run (covers pass→warn,
  # pass→fail, warn→fail since severity is part of the identity).
  local appeared=""
  appeared="$(comm -13 <(printf '%s\n' "$old_ids" | sort -u) <(printf '%s\n' "$new_ids" | sort -u) | grep -v '^$' || true)"

  local caps_worse=0
  [[ "$caps" =~ ^[0-9]+$ && "$old_caps" =~ ^[0-9]+$ ]] && (( caps > old_caps )) && caps_worse=1

  # Persist new state atomically before any notification.
  local tmp="$STATE_FILE.tmp.$$"
  {
    printf '# zdots-watch state — written by `zdots-watch run`; do not edit\n'
    printf 'ts=%s\n'          "$ts"
    printf 'rc=%s\n'          "$rc"
    printf 'pass=%s\n'        "$pass"
    printf 'warn=%s\n'        "$warnc"
    printf 'fail=%s\n'        "$failc"
    printf 'caps_errors=%s\n' "$caps"
    [[ -n "$new_ids" ]] && printf '%s\n' "$new_ids"
  } >"$tmp" && mv -f "$tmp" "$STATE_FILE"

  if (( seeded )); then
    printf '[%s] seeded pass=%s warn=%s fail=%s caps=%s\n' "$ts" "$pass" "$warnc" "$failc" "$caps" >>"$LOG_FILE" 2>/dev/null || true
    printf 'zdots-watch: state seeded (%s passed · %s warn · %s fail · caps_errors=%s) — no notification on first run\n' \
      "$pass" "$warnc" "$failc" "$caps"
    return 0
  fi

  if [[ -n "$appeared" || "$caps_worse" -eq 1 ]]; then
    local n shown msg=""
    n="$(printf '%s\n' "$appeared" | grep -c . || true)"
    if [[ -n "$appeared" ]]; then
      shown="$(printf '%s\n' "$appeared" | head -3 | tr '|' ' ' | paste -sd ';' -)"
      msg="${n} new: ${shown}"
      (( n > 3 )) && msg="$msg (+$((n - 3)) more)"
    fi
    (( caps_worse )) && msg="${msg:+$msg — }capability errors ${old_caps}→${caps}"
    _notify "zdots watch · health worsened" "${msg} — run: zdots-doctor"
    printf '[%s] worsened: %s (pass=%s warn=%s fail=%s caps=%s)\n' "$ts" "$msg" "$pass" "$warnc" "$failc" "$caps" >>"$LOG_FILE" 2>/dev/null || true
    printf 'zdots-watch: worsened — %s\n' "$msg"
  else
    printf '[%s] steady pass=%s warn=%s fail=%s caps=%s\n' "$ts" "$pass" "$warnc" "$failc" "$caps" >>"$LOG_FILE" 2>/dev/null || true
    printf 'zdots-watch: no worsening transitions (%s passed · %s warn · %s fail · caps_errors=%s)\n' \
      "$pass" "$warnc" "$failc" "$caps"
  fi
}

cmd_status() {
  if launchctl list 2>/dev/null | grep -q "$LABEL"; then
    printf 'zdots-watch: loaded (interval %ss)\n' "$INTERVAL"
  else
    printf 'zdots-watch: not loaded. Run: zdots-watch --install\n'
  fi
  if [[ -r "$STATE_FILE" ]]; then
    printf 'last run: %s\n' "$(sed -n 's/^ts=//p' "$STATE_FILE" | head -1)"
    printf '  %s passed · %s warn · %s fail · caps_errors=%s (doctor rc=%s)\n' \
      "$(sed -n 's/^pass=//p' "$STATE_FILE" | head -1)" \
      "$(sed -n 's/^warn=//p' "$STATE_FILE" | head -1)" \
      "$(sed -n 's/^fail=//p' "$STATE_FILE" | head -1)" \
      "$(sed -n 's/^caps_errors=//p' "$STATE_FILE" | head -1)" \
      "$(sed -n 's/^rc=//p' "$STATE_FILE" | head -1)"
    grep -E '^(warn|fail)\|' "$STATE_FILE" 2>/dev/null | tr '|' ' ' | sed 's/^/  open: /' || true
  else
    printf 'no state yet. Run: zdots-watch run\n'
  fi
}

cmd_install() {
  mkdir -p "$HOME/Library/LaunchAgents" "$STATE_DIR"
  # Z-263: render the plist HERE with the live \$HOME-derived paths expanded —
  # never a tracked plist with a hardcoded /Users path.
  local extra_env=""
  [[ -n "${ZDOTS_CONTEXT:-}" ]] && extra_env="<key>ZDOTS_CONTEXT</key><string>${ZDOTS_CONTEXT}</string>"
  cat >"$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${ZDOTDIR}/bin/zdots-watch</string>
    <string>run</string>
  </array>
  <key>StartInterval</key><integer>${INTERVAL}</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>${LOG_FILE}</string>
  <key>StandardErrorPath</key><string>${LOG_FILE}</string>
  <key>EnvironmentVariables</key>
  <dict><key>ZDOTDIR</key><string>${ZDOTDIR}</string><key>PATH</key><string>${ZDOTDIR}/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>${extra_env}</dict>
</dict>
</plist>
PLIST_EOF
  launchctl unload "$PLIST" 2>/dev/null || true
  launchctl load "$PLIST" && printf 'zdots-watch: installed (every %ss). Notifies only on worsening doctor transitions.\n' "$INTERVAL"
}

cmd_uninstall() {
  launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST" && printf 'zdots-watch: uninstalled.\n'
}

case "${1:-}" in
  run)                   cmd_run ;;
  status|"")             cmd_status ;;
  install|--install)     cmd_install ;;
  uninstall|--uninstall) cmd_uninstall ;;
  -h|--help)             usage; exit 0 ;;
  *)                     printf 'zdots-watch: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
