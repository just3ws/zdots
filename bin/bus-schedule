#!/usr/bin/env bash
# bin/bus-schedule — Fast, accessible snapshot & status guide of the local message bus.
#
# Provides human and AI agents with an instant, zero-cost overview of the bus:
# - Active channels and current "bus route" stops
# - Live unread counts, mentions, pending questions, and stale lines
# - Background coordinator daemon health (busdriver)
# - Direct links and commands to inspect or participate
#
# GRAMMAR:
#   bus-schedule [--json] [--dump-dir DIR] [--channel CH]

set -euo pipefail
trap "" PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
BRAIN="${ZDOTDIR}/sbin/zdots-brain"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
SNAPSHOT_DIR="${STATE_DIR}/bus-schedule"

JSON=false
CHANNEL=""
DUMP_DIR=""

usage() {
  cat <<EOF
Usage: bus-schedule [options]

The Agent Frontpage & Route Guide for the local message bus.

Options:
  --json           Output machine-readable JSON snapshot
  --channel NAME   Focus snapshot on a single channel/stop
  --dump-dir DIR   Export Markdown/JSON snapshot files to directory
  -h, --help       Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=true; shift ;;
    --channel) CHANNEL="$2"; shift 2 ;;
    --dump-dir) DUMP_DIR="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf "bus-schedule: unknown option: %s\n" "$1" >&2; usage >&2; exit 1 ;;
  esac
done

mkdir -p "$SNAPSHOT_DIR"

WHOAMI=$("${BRAIN}" bus-whoami 2>/dev/null || echo "anonymous")
COORDINATOR_STATE="stopped"
if command -v bus-coordinator-ctl >/dev/null 2>&1; then
  if bus-coordinator-ctl health >/dev/null 2>&1; then
    COORDINATOR_STATE="running"
  fi
fi

CHATS_JSON=$("${BRAIN}" bus-chats ${CHANNEL:+"$CHANNEL"} --json 2>/dev/null || echo "[]")
CONVOS_JSON=$("${BRAIN}" bus-conversations ${CHANNEL:+"$CHANNEL"} --json 2>/dev/null || echo "[]")
PASSENGERS_JSON=$("${BRAIN}" bus-passengers --json 2>/dev/null || echo "[]")
LOGBOOK_JSON=$("${BRAIN}" bus-logbook ${CHANNEL:+"$CHANNEL"} --json 2>/dev/null || echo "[]")

INDEX_MD="${SNAPSHOT_DIR}/ROUTE.md"
INDEX_JSON="${SNAPSHOT_DIR}/schedule.json"

cat << "HEADER" > "$INDEX_MD"
# 🚌 The Local Message Bus Schedule & Route Guide

The message bus is the asynchronous communication substrate for agents and humans on this machine.
Persistence: PostgreSQL (\`my\` database). Live push: Redis pub/sub. Coordinator: \`busdriver\`.

```mermaid
flowchart LR
    subgraph Route ["The Route & Stops"]
        phx["phalanxduel\n(Game & Telemetry)"] --> gen["general\n(Platform & Ops)"]
        gen --> zd["zdots\n(Core Control Plane)"]
        zd --> my["my\n(Knowledge & Brain)"]
        my --> ing["ingest-*\n(Pipelines)"]
        ing --> jl["job-leads\n(Career Datamart)"]
        jl --> phx
    end

    driver["🚌 busdriver\n(informational only)"] -. watches & reports .-> Route
```

HEADER

cat << METRICS >> "$INDEX_MD"
- **Snapshot Time**: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
- **Active Observer**: \`${WHOAMI}\`
- **Busdriver Daemon**: \`${COORDINATOR_STATE}\`
- **Web Console**: [https://my.localhost/bus](https://my.localhost/bus)
- **Route Guide File**: [${INDEX_MD}](file://${INDEX_MD})

---

## Active Stops & Channel State

| Channel | Unread | Status | Last Active | Last Sender | Latest Message Snippet |
|---------|--------|--------|-------------|-------------|-------------------------|
METRICS

printf '%s\n' "$CHATS_JSON" | jq -r '.[] | "| [`\(.channel)`](https://my.localhost/bus#\(.channel)) | \(.unread) | **\(.status)** | \(.last_active) | `\(.last_sender)` | \(.snippet) |"' >> "$INDEX_MD"

cat << "CONVOS_HEADER" >> "$INDEX_MD"

---

## 💬 Active Conversations & Thread Activity
CONVOS_HEADER

printf '%s\n' "$CONVOS_JSON" | jq -r '
if length == 0 then
  "\n_(No active conversation threads detected)_\n"
else
  .[] | 
  "\n### [`#" + .channel + "`](https://my.localhost/bus#" + .channel + ")" + (if .topic then " — " + .topic else "" end) + "\n\n" +
  (
    .threads[] |
    "> **@" + .sender + "** (" + .age + ")" + (if .type then " `[" + .type + "]`" else "" end) + ":\n" +
    "> " + (.body | split("\n")[0]) + "\n" +
    (
      .replies | map("> ↳ **@" + .sender + "** (" + .age + ")" + (if .type then " `[" + .type + "]`" else "" end) + ": " + (.body | split("\n")[0]) + "\n") | join("")
    ) + "\n"
  )
end' >> "$INDEX_MD"

cat << "PASSENGERS_HEADER" >> "$INDEX_MD"
---

## 👥 Passenger & Agent Roster

| Participant | Kind | Last Seen | Token Auth | Since |
|-------------|------|-----------|------------|-------|
PASSENGERS_HEADER

printf '%s\n' "$PASSENGERS_JSON" | jq -r '.[] | "| `\(.name)` | \(.kind) | \(.last_seen) | \(if .has_token then "✓ active" else "—" end) | \(.created_at[0:10]) |"' >> "$INDEX_MD"

cat << "LOGBOOK_HEADER" >> "$INDEX_MD"

---

## 📋 Recent Logbook & Documented Issues

| Channel | Type | Reporter | Age | Summary |
|---------|------|----------|-----|---------|
LOGBOOK_HEADER

printf '%s\n' "$LOGBOOK_JSON" | jq -r '
if length == 0 then
  "| — | — | — | — | (empty) |\n"
else
  .[0:10][] | "| [`#\(.channel)`](https://my.localhost/bus#\(.channel)) | `\(.type)` | `\(.sender)` | \(.age) | \(.body | gsub("\n"; " ") | .[0:60]) |"
end' >> "$INDEX_MD"

cat << "FOOTER" >> "$INDEX_MD"

---

## Essential Driver Commands for AI Agents & Humans

```bash
# Check messages, unread questions & conversations
bus stops --unread
bus stops --waiting
bus stop phalanxduel
bus conversations               # view multi-agent conversation wire
bus passengers                  # participant roster & activity

# Read and participate in conversation threads
bus read <channel> [--as <participant>]
bus reply <channel> <thread_id> "reply..."
bus ack <channel> <msg_id>

# Post an update, note, or ask a question
bus ask <channel> "question..." # ask @busdriver on channel
bus hail "question..."          # hail @busdriver directly
bus note <channel> "note..."    # post a note to channel
bus log <channel> "issue..."    # document issue to busdriver & channel
bus post <channel> "update..." [--type STATUS]

# Tap on the sign (Busdriver rules)
bus sign                        # or: bus tap

# File an issue / logbook ticket directly
zdots-issue "Short description of bug or request"
```
FOOTER

printf '%s\n' "$CHATS_JSON" | jq \
  --arg snapshot_at "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
  --arg observer "$WHOAMI" \
  --arg coordinator "$COORDINATOR_STATE" \
  --arg route_guide "$INDEX_MD" \
  --argjson convos "$CONVOS_JSON" \
  --argjson passengers "$PASSENGERS_JSON" \
  --argjson logbook "$LOGBOOK_JSON" \
  '{
    snapshot_at: $snapshot_at,
    observer: $observer,
    busdriver: $coordinator,
    route_guide_path: $route_guide,
    channels: .,
    conversations: $convos,
    passengers: $passengers,
    logbook: $logbook
  }' > "$INDEX_JSON"

if [[ -n "$DUMP_DIR" ]]; then
  mkdir -p "$DUMP_DIR"
  cp "$INDEX_MD" "$DUMP_DIR/BUS_SCHEDULE.md"
  cp "$INDEX_JSON" "$DUMP_DIR/bus_schedule.json"
fi

if $JSON; then
  cat "$INDEX_JSON"
elif [[ -t 1 && "${TERM:-}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
  perl -pe 's/\[([^\]]+)\]\((https?:\/\/[^\)]+|file:\/\/[^\)]+)\)/\e]8;;$2\e\\$1\e]8;;\e\\/g' "$INDEX_MD"
else
  cat "$INDEX_MD"
fi
