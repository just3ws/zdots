#!/usr/bin/env sh
# ---
# id: capabilities
if [ -f "${ZDOTDIR:-$HOME/.config/zsh}/.zdots.env" ]; then 
  . "${ZDOTDIR:-$HOME/.config/zsh}/.zdots.env" 
fi
# title: "Zdots Capabilities Report"
# purpose: High-signal environment health and contract validator.
# rationale: Provides an upfront Ground Truth report to ensure the environment matches its manifest and is safe for operation.
# ---
# bin/capabilities — High-signal environment health and contract validator.
#
# RATIONALE:
# In a modular shell environment with dynamic providers (DDD/SOLID), it is easy 
# to lose track of what implementation is active. This tool provides an upfront 
# "Ground Truth" report, ensuring the environment matches its manifest (.zdots.env).
# It is used as the first gate in CI to fail fast if the environment is misconfigured.
#
# PURPOSE:
# 1. Validate service provider existence (Contract Testing).
# 2. Report on observability health (OTel resource and trace files).
# 3. Verify path precedence and tool availability.

set -eu

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
RESET='\033[0m'

usage() {
  cat <<EOF
Usage: capabilities [--json] [-h|--help]

Environment health and service contract validator.
Checks service providers, critical paths, observability, Knowledge Layer,
and tooling reality against the .zdots.env manifest.

Options:
  --json      Machine-readable JSON output
  -h, --help  Show this help
EOF
}

OUTPUT_FORMAT="text"
for _arg in "$@"; do
  case "$_arg" in
    --json)      OUTPUT_FORMAT="json" ;;
    -h|--help)   usage; exit 0 ;;
    *)           printf 'capabilities: unknown option: %s\n' "$_arg" >&2; usage >&2; exit 1 ;;
  esac
done
unset _arg

if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo "${BOLD}Zdots Environment Capabilities Report${RESET}"
  echo "----------------------------------------"

  # 1. Identity
  echo "${CYAN}Session ID:${RESET}  ${ZDOTS_SESSION_ID:-<unset>}"
  echo "${CYAN}Profile:${RESET}     ${ZDOTS_ENV_PROFILE:-unknown}"
  echo "${CYAN}OS:${RESET}          $(uname -s) ($(uname -m))"
  echo "${CYAN}CI/ACT:${RESET}      ${ACT:-false} / ${CI:-false}"
fi

if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo ""
  echo "${BOLD}Service Composition:${RESET}"
fi
_z_services="PKG_MANAGER NODE_RUNTIME PYTHON_RUNTIME TRACE AI WHISPER"

errors=0
for s in $_z_services; do
  var="ZDOTS_SERVICE_$s"
  provider=""
  service_dir=""
  eval "provider=\${$var:-none}"
  
  # Map service names to directory names
  case "$s" in
    PKG_MANAGER) service_dir="pkg" ;;
    NODE_RUNTIME) service_dir="node" ;;
    PYTHON_RUNTIME) service_dir="python" ;;
    TRACE) service_dir="trace" ;;
    AI) service_dir="ai" ;;
    WHISPER) service_dir="ai" ;;
    *) service_dir=$(echo "$s" | tr '[:upper:]' '[:lower:]' | sed 's/_//g') ;;
  esac
  provider_file="${ZDOTDIR}/providers/${service_dir}/${provider}.zsh"
  
  if [ "$provider" = "none" ]; then
    _status="${YELLOW}∅ none${RESET}"
  elif [ -f "$provider_file" ]; then
    _status="${GREEN}✓ $provider${RESET}"
  else
    _status="${RED}✗ $provider (missing provider file: providers/${service_dir}/${provider}.zsh)${RESET}"
    errors=$((errors + 1))
  fi
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    printf "  %-15s : %b\n" "$s" "$_status"
  fi
done

if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo ""
  echo "${BOLD}Critical Paths:${RESET}"
fi
# Provide defaults for XDG variables if not set
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${ZDOTDIR:=$(pwd)}"

# Format: label:path
_paths="ZDOTDIR:$ZDOTDIR XDG_CONFIG_HOME:$XDG_CONFIG_HOME XDG_STATE_HOME:$XDG_STATE_HOME HOMEBREW_PREFIX:${HOMEBREW_PREFIX:-<unset>}"

for p in $_paths; do
  label="${p%%:*}"
  val="${p#*:}"
  if [ -d "$val" ]; then
    _p_status="${GREEN}exists${RESET}"
  else
    _p_status="${YELLOW}missing${RESET}"
  fi
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    printf "  %-15s : %-20s [%b]\n" "$label" "$val" "$_p_status"
  fi
done

# Disk Space Check
_avail=$(df -h / | tail -n 1 | awk '{print $(NF-2)}' || echo "unknown")
if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo "  ${CYAN}Disk Available:${RESET}  $_avail"
fi

# Terminal State
if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo ""
  echo "${BOLD}Terminal State:${RESET}"

  # stdin/stdout/stderr TTY status
  if [ -t 0 ]; then _tty_stdin="${GREEN}yes${RESET}"; else _tty_stdin="${YELLOW}no${RESET}"; fi
  if [ -t 1 ]; then _tty_stdout="${GREEN}yes${RESET}"; else _tty_stdout="${YELLOW}no${RESET}"; fi
  if [ -t 2 ]; then _tty_stderr="${GREEN}yes${RESET}"; else _tty_stderr="${YELLOW}no${RESET}"; fi
  printf "  %-15s : %b\n" "stdin TTY" "$_tty_stdin"
  printf "  %-15s : %b\n" "stdout TTY" "$_tty_stdout"
  printf "  %-15s : %b\n" "stderr TTY" "$_tty_stderr"

  printf "  %-15s : %b%s%b\n" "TERM" "$CYAN" "${TERM:-unset}" "$RESET"
  printf "  %-15s : %b%s%b\n" "TERM_PROGRAM" "$CYAN" "${TERM_PROGRAM:-unset}" "$RESET"

  # Multiplexer detection
  _mux="none"
  if [ -n "${TMUX:-}" ]; then
    _mux="tmux"
  else
    case "${TERM:-}" in
      screen*|tmux*) _mux="screen/tmux (TERM)" ;;
    esac
  fi
  printf "  %-15s : %b%s%b\n" "Multiplexer" "$CYAN" "$_mux" "$RESET"

  printf "  %-15s : %b%sx%s%b\n" "Dimensions" "$CYAN" "${LINES:-?}" "${COLUMNS:-?}" "$RESET"
fi

# 4. Observability Health
if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo ""
  echo "${BOLD}Observability Health:${RESET}"
fi
_z_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/zsh"
_z_trace_file="${_z_state_dir}/traces.jsonl"
_ts="unknown"
if [ -f "$_z_trace_file" ]; then
  _z_last_trace="$(tail -n 1 "$_z_trace_file")"
  # Extract timestamp via sed
  _ts=$(echo "$_z_last_trace" | sed 's/.*"ts":"\([^"]*\)".*/\1/')
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    echo "  ${CYAN}Trace File:${RESET}   $_z_trace_file [${GREEN}exists${RESET}]"
    echo "  ${CYAN}Last Trace:${RESET}   $_ts"
  fi
else
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    echo "  ${CYAN}Trace File:${RESET}   $_z_trace_file [${YELLOW}missing${RESET}]"
  fi
fi
# OTel Resource Info
if [ -n "${_ZDOTS_OTEL_RESOURCE_JSON:-}" ]; then
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    echo "  ${CYAN}OTel Resource:${RESET}"
    if command -v jq >/dev/null 2>&1; then
      echo "$_ZDOTS_OTEL_RESOURCE_JSON" | jq -r '.attributes[] | "    - \(.key): \(.value | to_entries[0].value)"'
    else
      # Fallback if jq is missing (less pretty)
      echo "$_ZDOTS_OTEL_RESOURCE_JSON" | sed 's/[{}]//g' | tr ',' '\n'
    fi
  fi
fi

# AI Service Info
if [ -n "${ZDOTS_SERVICE_AI:-}" ] && [ "$ZDOTS_SERVICE_AI" != "none" ]; then
  # Probe the AI server live — _ZDOTS_AI_SERVER_UP is set at shell init and
  # goes stale if the server is started/stopped after the session begins.
  _ai_endpoint="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"
  if curl -sf -m 2 "${_ai_endpoint}/health" >/dev/null 2>&1; then
    _ai_live=1
  else
    _ai_live=0
  fi
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    printf "  %bAI Service:%b    %s [model: %s]\n" "$CYAN" "$RESET" "$ZDOTS_SERVICE_AI" "${ZDOTS_AI_MODEL:-unknown}"
    if [ "$_ai_live" = "1" ]; then
      printf "  %bAI Server:%b     %bonline%b\n" "$CYAN" "$RESET" "$GREEN" "$RESET"
    else
      printf "  %bAI Server:%b     %boffline/unavailable%b\n" "$CYAN" "$RESET" "$YELLOW" "$RESET"
    fi
  fi
fi

# 5. Knowledge Layer & MCP
if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo ""
  echo "${BOLD}Knowledge Layer:${RESET}"
fi

_ctx_live=0
_ctx_db="unknown"
_ctx_pending=0
_bin_ctx="${ZDOTDIR}/bin/zdots-ctx"
if [ -x "$_bin_ctx" ]; then
  # Simple grep/awk to avoid complex bashisms in sh-shebang file
  _ctx_status=$("$_bin_ctx" status --json 2>/dev/null || echo '{"connected":false}')
  if echo "$_ctx_status" | grep -q '"connected": true'; then
    _ctx_live=1
    _ctx_db=$(echo "$_ctx_status" | sed -n 's/.*"database": "\([^"]*\)".*/\1/p')
    _ctx_pending=$(echo "$_ctx_status" | grep -o '"pending_jobs": [0-9]*' | awk '{print $2}')
    _ctx_pending=${_ctx_pending:-0}
  fi
fi

if [ "$OUTPUT_FORMAT" = "text" ]; then
  if [ "$_ctx_live" = "1" ]; then
    printf "  %bKnowledge DB:%b  %bonline (%s) [%s pending jobs]%b\n" "$CYAN" "$RESET" "$GREEN" "$_ctx_db" "$_ctx_pending" "$RESET"
  else
    printf "  %bKnowledge DB:%b  %boffline/uninitialized%b\n" "$CYAN" "$RESET" "$YELLOW" "$RESET"
  fi

  # Check MCP servers
  for m in llama-mcp ctx-mcp; do
    if [ -x "${ZDOTDIR}/bin/$m" ]; then
      printf "  %-15s : %bonline%b\n" "mcp:$m" "$GREEN" "$RESET"
    else
      printf "  %-15s : %bmissing/not executable%b\n" "mcp:$m" "$RED" "$RESET"
      errors=$((errors + 1))
    fi
  done
fi

# 6. Tool Verification (The "Reality")
if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo ""
  echo "${BOLD}Tooling Reality:${RESET}"
fi
_tools="zsh git brew mise node npm python3"
for t in $_tools; do
  # Use a more robust way to check command that doesn't trigger set -e
  if _path=$(command -v "$t" 2>/dev/null); then
    if [ "$OUTPUT_FORMAT" = "text" ]; then
      printf "  %-15s : %b%s%b\n" "$t" "$GREEN" "$_path" "$RESET"
    fi
  else
    if [ "$OUTPUT_FORMAT" = "text" ]; then
      printf "  %-15s : %bnot found%b\n" "$t" "$YELLOW" "$RESET"
    fi
  fi
done

if [ "$OUTPUT_FORMAT" = "json" ]; then
  # Compute TTY status for JSON
  _json_stdin_tty="false"; [ -t 0 ] && _json_stdin_tty="true"
  _json_stdout_tty="false"; [ -t 1 ] && _json_stdout_tty="true"
  _json_stderr_tty="false"; [ -t 2 ] && _json_stderr_tty="true"
  _json_mux="none"
  if [ -n "${TMUX:-}" ]; then
    _json_mux="tmux"
  else
    case "${TERM:-}" in
      screen*|tmux*) _json_mux="screen/tmux" ;;
    esac
  fi

  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg sid "${ZDOTS_SESSION_ID:-}" \
      --arg profile "${ZDOTS_ENV_PROFILE:-unknown}" \
      --arg os "$(uname -s)" \
      --arg arch "$(uname -m)" \
      --arg disk "$_avail" \
      --arg ai_status "${_ai_live:-0}" \
      --arg ai_model "${ZDOTS_AI_MODEL:-unknown}" \
      --arg trace_file "$_z_trace_file" \
      --arg last_trace "$_ts" \
      --arg ctx_live "$_ctx_live" \
      --arg ctx_db "$_ctx_db" \
      --arg ctx_pending "$_ctx_pending" \
      --arg mcp_llama "$([ -x "${ZDOTDIR}/bin/llama-mcp" ] && echo 1 || echo 0)" \
      --arg mcp_ctx "$([ -x "${ZDOTDIR}/bin/ctx-mcp" ] && echo 1 || echo 0)" \
      --arg errors "$errors" \
      --arg stdin_tty "$_json_stdin_tty" \
      --arg stdout_tty "$_json_stdout_tty" \
      --arg stderr_tty "$_json_stderr_tty" \
      --arg term "${TERM:-unset}" \
      --arg term_program "${TERM_PROGRAM:-unset}" \
      --arg multiplexer "$_json_mux" \
      --arg lines "${LINES:-?}" \
      --arg columns "${COLUMNS:-?}" \
      '{
        session_id: $sid,
        profile: $profile,
        os: $os,
        arch: $arch,
        disk_available: $disk,
        terminal: {
          stdin_tty: ($stdin_tty == "true"),
          stdout_tty: ($stdout_tty == "true"),
          stderr_tty: ($stderr_tty == "true"),
          term: $term,
          term_program: $term_program,
          multiplexer: $multiplexer,
          dimensions: ($lines + "x" + $columns)
        },
        ai: {
          status: ($ai_status | tonumber),
          model: $ai_model
        },
        observability: {
          trace_file: $trace_file,
          last_trace: $last_trace
        },
        brain: {
          intelligence_live: ($ctx_live | tonumber),
          intelligence_db:   $ctx_db,
          intelligence_pending: ($ctx_pending | tonumber),
          mcp_llama:         ($mcp_llama | tonumber),
          mcp_ctx:           ($mcp_ctx | tonumber)
        },
        health_errors: ($errors | tonumber)
      }'
  else
    printf '{"session_id":"%s","profile":"%s","os":"%s","health_errors":%d}\n' \
      "${ZDOTS_SESSION_ID:-}" "${ZDOTS_ENV_PROFILE:-unknown}" "$(uname -s)" "$errors"
  fi
fi

if [ "$OUTPUT_FORMAT" = "text" ]; then
  echo "----------------------------------------"
fi

# 6. Self-Reporting (OTel Platform Node)
if command -v otel-cli >/dev/null 2>&1; then
  _status="unset"
  [ "$errors" -eq 0 ] && _status="ok" || _status="error"

  (
    otel-cli span \
      --name "platform.health" \
      --attrs "profile=${ZDOTS_ENV_PROFILE:-unknown},os=$(uname -s),disk.avail=$_avail,ai.status=${_ZDOTS_AI_SERVER_UP:-0}" \
      --force-trace-id "${ZDOTS_TRACE_ID:-00000000000000000000000000000000}" \
      --status "$_status" \
      >/dev/null 2>&1
  ) &
fi

# Cleanup
unset _avail _p_status _z_services _z_state_dir _z_trace_file _z_last_trace _ts _m_status _tools _path _status _tty_stdin _tty_stdout _tty_stderr _mux _json_stdin_tty _json_stdout_tty _json_stderr_tty _json_mux

if [ "$errors" -gt 0 ]; then
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    echo "${RED}Health Check Failed: $errors service contract violation(s) detected.${RESET}"
  fi
  exit 1
else
  if [ "$OUTPUT_FORMAT" = "text" ]; then
    echo "${GREEN}Health Check Passed: Service contract is valid.${RESET}"
  fi
  exit 0
fi

