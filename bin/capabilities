#!/usr/bin/env zsh
# Zdots Capability Discovery API
# Optimized for high-density AI agent orientation.
# Use --json for machine-readable structured data.

if [[ "$1" == "--json" ]]; then
  # High-density JSON discovery (WSDL-style)
  cat <<JSON
{
  "env": { "zsh": "$ZSH_VERSION", "os": "$OSTYPE", "theme": "${ZDOTS_THEME:-default}" },
  "infra": {
    "defer": $(( $+functions[zsh-defer] )),
    "zoxide": $(( $+functions[z] )),
    "atuin": $(( $+functions[atuin] )),
    "fzf_tab": $(( $+widgets[fzf-tab-complete] )),
    "fzf": $(( $+widgets[fzf-history-widget] )),
    "lscolors": "$([[ -n "$LS_COLORS" ]] && echo "cached")"
  },
  "agent_tools": {
    "context": "repomix",
    "stats": "tokei",
    "symbols": "ctags",
    "refactor": "sd",
    "structural_search": "sg",
    "token_optimizer": "rtk",
    "backlog": "backlog",
    "bench": "hyperfine",
    "ai_pipe": "ai"
  },
  "dsl": {
    "pipelines": { "G": "grep", "GI": "grep -i", "L": "less", "W": "wc -l", "Y": "pbcopy", "J": "jq", "X": "xargs" },
    "shortcuts": {
      "p": "pnpm", "fd": "fly", "lg": "lazygit", "br": "broot", "he": "history_enquire",
      "cl": "claude", "gm": "gemini", "bench": "hyperfine", "top": "btm"
    }
  },
  "make": ["check", "map", "stats", "refactor", "context", "search", "tags"]
}
JSON
  exit 0
fi

# Human-readable / Text-signal fallback
echo "--- ENV ---"
echo "ZSH: $ZSH_VERSION | OS: $OSTYPE | THEME: ${ZDOTS_THEME:-default}"

echo "\n--- INFRA ---"
features=()
(( $+functions[zsh-defer] )) && features+=("defer")
(( $+functions[z] )) && features+=("zoxide")
(( $+functions[atuin] )) && features+=("atuin")
(( $+widgets[fzf-tab-complete] )) && features+=("fzf-tab")
(( $+widgets[fzf-history-widget] )) && features+=("fzf")
echo "ACTIVE: ${features[*]}"

echo "\n--- AGENT TOOLS (Standardized) ---"
atools=()
for t in rtk repomix tokei ctags sg dasel yq backlog usage sd television glow uv; do
  command -v $t >/dev/null && atools+=($t)
done
echo "BIN: ${atools[*]}"

echo "\n--- DSL & PIPELINES ---"
echo "G(| grep), GI(| grep -i), L(| less), W(| wc -l), Y(| pbcopy), J(| jq), X(| xargs)"
echo "p(pnpm), pr(run), pi(install), pt(test), pv(verify:all)"
echo "fd(fly), fl(logs), fds(staging), fdp(production)"
echo "lg(lazygit), br(broot), he(history_enquire), k(klear)"
echo "cl(claude), gm(gemini), gup(pull --rebase), gpfl(push --force)"
echo "bsl(brew services), top(btm), bench(hyperfine), ai(ai pipe)"

echo "\n--- MAKE API ---"
echo "TARGETS: check, map, stats, refactor, context, search, tags"
