#!/usr/bin/env zsh
# bin/capabilities — Visual report and health check for environment & services

set -eu
setopt pipefail

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
RESET='\033[0m'

echo "${BOLD}Zdots Environment Capabilities Report${RESET}"
echo "----------------------------------------"

# 1. Identity
echo "${CYAN}Session ID:${RESET}  ${ZDOTS_SESSION_ID:-<unset>}"
echo "${CYAN}Profile:${RESET}     ${ZDOTS_ENV_PROFILE:-unknown}"
echo "${CYAN}OS:${RESET}          $(uname -s) ($(uname -m))"
echo "${CYAN}CI/ACT:${RESET}      ${ACT:-false} / ${CI:-false}"

# 2. Service Composition (The "Contract")
echo "\n${BOLD}Service Composition:${RESET}"
_z_services=(
  "PKG_MANAGER"
  "NODE_RUNTIME"
  "PYTHON_RUNTIME"
  "TRACE"
  "AI"
)

errors=0
for s in $_z_services; do
  var="ZDOTS_SERVICE_$s"
  # Use a more direct eval to avoid subshell-induced exit in some zsh versions/configs
  eval "provider=\${$var:-none}"
  
  # Map service names to directory names
  case "$s" in
    PKG_MANAGER) service_dir="pkg" ;;
    NODE_RUNTIME) service_dir="node" ;;
    PYTHON_RUNTIME) service_dir="python" ;;
    TRACE) service_dir="trace" ;;
    AI) service_dir="ai" ;;
    *) service_dir=$(echo "$s" | tr '[:upper:]' '[:lower:]' | sed 's/_//g') ;;
  esac
  provider_file="$ZDOTDIR/providers/${service_dir}/${provider}.zsh"
  
  if [[ "$provider" == "none" ]]; then
    _status="${YELLOW}∅ none${RESET}"
  elif [[ -f "$provider_file" ]]; then
    _status="${GREEN}✓ $provider${RESET}"
  else
    _status="${RED}✗ $provider (missing provider file: providers/${service_dir}/${provider}.zsh)${RESET}"
    ((errors++))
  fi
  printf "  %-15s : %b\n" "$s" "$_status"
done
unset _z_services _status service_dir

# 3. Path Health
echo "\n${BOLD}Critical Paths:${RESET}"
paths=(
  "ZDOTDIR:$ZDOTDIR"
  "XDG_CONFIG_HOME:$XDG_CONFIG_HOME"
  "XDG_STATE_HOME:$XDG_STATE_HOME"
  "HOMEBREW_PREFIX:${HOMEBREW_PREFIX:-<unset>}"
)

for p in $paths; do
  label="${p%%:*}"
  val="${p#*:}"
  if [[ -d "$val" ]]; then
    _p_status="${GREEN}exists${RESET}"
  else
    _p_status="${YELLOW}missing${RESET}"
  fi
  printf "  %-15s : %-20s [%b]\n" "$label" "$val" "$_p_status"
done
unset _p_status

# 4. Observability Health
echo "\n${BOLD}Observability Health:${RESET}"
_z_trace_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"
if [[ -f "$_z_trace_file" ]]; then
  _z_last_trace="$(tail -n 1 "$_z_trace_file")"
  echo "  ${CYAN}Trace File:${RESET}   $_z_trace_file [${GREEN}exists${RESET}]"
  echo "  ${CYAN}Last Trace:${RESET}   $(echo "$_z_last_trace" | sed 's/.*"ts":"\([^"]*\)".*/\1/')"
else
  echo "  ${CYAN}Trace File:${RESET}   $_z_trace_file [${YELLOW}missing${RESET}]"
fi

# OTel Resource Info
if [[ -n "${_ZDOTS_OTEL_RESOURCE_JSON:-}" ]]; then
  echo "  ${CYAN}OTel Resource:${RESET}"
  echo "$_ZDOTS_OTEL_RESOURCE_JSON" | sed 's/{"key":"\([^"]*\)","value":{"[^"]*":"\([^"]*\)"}}/\n    - \1: \2/g' | sed 's/{"key":"\([^"]*\)","value":{"intValue":\([0-9]*\)}}/\n    - \1: \2/g' | sed 's/{"key":"\([^"]*\)","value":{"boolValue":\([^}]*\)}}/\n    - \1: \2/g' | sed 's/[{}]//g' | sed 's/"attributes":\[//g' | sed 's/\]//g' | sed 's/,,/,/g' | tr ',' '\n'
fi

# AI Service Info
if [[ -n "${ZDOTS_SERVICE_AI:-}" && "$ZDOTS_SERVICE_AI" != "none" ]]; then
  echo "  ${CYAN}AI Service:${RESET}    $ZDOTS_SERVICE_AI [model: ${ZDOTS_AI_MODEL:-unknown}]"
  if [[ "${_ZDOTS_AI_SERVER_UP:-0}" == "1" ]]; then
    echo "  ${CYAN}AI Server:${RESET}     ${GREEN}online${RESET}"
  else
    echo "  ${CYAN}AI Server:${RESET}     ${YELLOW}offline/unavailable${RESET}"
  fi
fi
unset _z_trace_file _z_last_trace

# 5. Tool Verification (The "Reality")
echo "\n${BOLD}Tooling Reality:${RESET}"
tools=(zsh git brew mise node npm python3)
for t in $tools; do
  if path=$(command -v "$t" 2>/dev/null); then
    printf "  %-15s : %s\n" "$t" "${GREEN}$path${RESET}"
  else
    printf "  %-15s : %s\n" "$t" "${YELLOW}not found${RESET}"
  fi
done

echo "----------------------------------------"
if (( errors > 0 )); then
  echo "${RED}Health Check Failed: $errors service contract violation(s) detected.${RESET}"
  exit 1
else
  echo "${GREEN}Health Check Passed: Service contract is valid.${RESET}"
  exit 0
fi
