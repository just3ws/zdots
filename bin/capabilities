#!/usr/bin/env zsh
# High-density environment capability card for AI agents.
# Optimized for token efficiency.

# 1. Core Runtime
echo "--- ENV ---"
echo "ZSH: $ZSH_VERSION | OS: $OSTYPE | THEME: ${ZDOTS_THEME:-default}"
echo "PERF: $([[ -f ~/.cache/zsh/zcompdump-$ZSH_VERSION ]] && stat -f "%Sm" -t "%Y-%m-%d %H:%M" ~/.cache/zsh/zcompdump-$ZSH_VERSION || echo "no-cache")"

# 2. Shell Infrastructure
echo "\n--- INFRA ---"
features=()
(( $+functions[zsh-defer] )) && features+=("defer")
(( $+functions[z] )) && features+=("zoxide")
(( $+functions[atuin] )) && features+=("atuin")
(( $+widgets[fzf-tab-complete] )) && features+=("fzf-tab")
(( $+widgets[fzf-history-widget] )) && features+=("fzf")
[[ -n "$LS_COLORS" ]] && features+=("lscolors-cached")
echo "ACTIVE: ${features[*]}"

# 3. Agent Efficiency Tools
echo "\n--- AGENT-TOOLS ---"
atools=()
for t in rtk repomix tokei ctags sg dasel yq backlog usage; do
  command -v $t >/dev/null && atools+=($t)
done
echo "BIN: ${atools[*]}"

# 4. Pipeline DSL (Expansion Context)
echo "\n--- PIPELINE DSL ---"
echo "G(| grep), GI(| grep -i), L(| less), W(| wc -l), S(| sort), U(| uniq), Y(| pbcopy), J(| jq), X(| xargs)"

# 5. Command Shortcuts (Expansion Context)
echo "\n--- SHORTCUTS ---"
echo "p(pnpm), pr(run), pi(install), pt(test), pv(verify:all)"
echo "fd(fly deploy), fl(fly logs), fds(fly staging), fdp(fly production)"
echo "lg(lazygit), top(btm), bench(hyperfine), he(history_enquire), k(klear)"
echo "cl(claude), gm(gemini), gup(pull --rebase), gpfl(push --force-with-lease)"
echo "bsl(brew services list), bss(brew start), bso(brew stop), bsr(brew restart)"
echo "dps(docker ps), dpa(docker ps -a), di(docker images), dlf(docker logs -f)"
