#!/usr/bin/env bash
# bin/cc-hook-session — Claude Code SessionStart context injector.
#
# Emits a compact zdots brief to stdout; Claude Code adds SessionStart stdout
# to the session context. Gives Claude the same orientation Pi gets via
# pi-ctx-brief — AI boundary mode, service posture, KB pointers — without a
# heavy hydration. Fully fail-open and time-bounded so it never delays startup.

set -u
ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

# Shared, account-agnostic home/work + AI-mode resolver.
context="home"; ai_mode="local"
if [[ -r "${ZDOTDIR}/lib/cc-context.bash" ]]; then
  source "${ZDOTDIR}/lib/cc-context.bash"
  context="$(cc_context)"
  ai_mode="$(cc_ai_mode)"
fi

printf '## zdots session brief (Claude Code)\n'
if [[ "$context" == "work" ]]; then
  printf 'CONTEXT: WORK machine (PHI-adjacent). Claude Code is HELP-ONLY here:\n'
  printf '  - do NOT git commit or push — the guard hook blocks it; assist with the\n'
  printf '    integration, leave commits to a normal terminal.\n'
  printf '  - local-only AI is enforced (ZDOTS_AI_MODE=local via .zdots.work).\n'
else
  printf 'CONTEXT: HOME (powerstation) — full access.\n'
fi
printf 'ai-boundary: mode=%s — Claude Code is a CLOUD tool; it bypasses the local\n' "$ai_mode"
printf '  phi_scrub/ai_boundary pipeline. Do NOT read .zdots.secrets, .env, keys,\n'
printf '  or paste PHI/credentials into prompts. See CLAUDE.md + AGENTS.md (PHI mode).\n'

# zsynod forum: if this Claude Code session was launched into a seat (convene
# exports ZSYNOD_MEMBER), orient into the forum immediately.
if [[ -n "${ZSYNOD_MEMBER:-}" ]]; then
  printf 'zsynod: you are member "%s" in the forum (charter: docs/zsynod-charter.md).\n' "$ZSYNOD_MEMBER"
  printf '  catch up: zsynod status · participate: zsynod speak|second|vote <P#> · record handoffs.\n'
  printf '  honor §6 (shared): PHI boundary · append-only ledger · complete handoffs · scope · right-size · token economy — be brief; the strongest most of all.\n'
fi

# Reuse the existing brief if available and quick; bound it hard at 3s.
if [[ -x "${ZDOTDIR}/bin/pi-ctx-brief" ]] && command -v jq >/dev/null 2>&1; then
  _brief="$( (perl -e 'alarm 3; exec @ARGV' "${ZDOTDIR}/bin/pi-ctx-brief") 2>/dev/null )" || true
  [[ -n "${_brief:-}" ]] && printf '%s\n' "$_brief"
fi

# graphify code-graph nudge — only if this repo has a graph; compares the graph's
# built_at_commit to HEAD and suggests /graphify if stale. Fail-open, no LLM.
if [[ -f "graphify-out/graph.json" ]] && command -v jq >/dev/null 2>&1; then
  _g_commit="$(jq -r '.built_at_commit // empty' graphify-out/graph.json 2>/dev/null || true)"
  _head="$(git rev-parse HEAD 2>/dev/null || true)"
  if [[ -n "$_g_commit" && -n "$_head" && "${_g_commit:0:8}" != "${_head:0:8}" ]]; then
    printf 'graphify: code graph is stale (built %s, HEAD %s) — run /graphify to refresh.\n' "${_g_commit:0:8}" "${_head:0:8}"
  else
    printf 'graphify: code graph available — /graphify query|explain|path|affected (~130x fewer tokens than reading).\n'
  fi
fi

# runtime digest (Z-135 P4) — push recent platform health from OpenObserve into
# the session so Claude opens already aware of what's failing. Reads back through
# zdots-o2-query (telemetry is scrubbed at the ingest edge; the digest surfaces
# only counts + service/operation names, never log bodies). Fully bounded and
# fail-open: if O2 is down or slow, it prints nothing and never delays startup.
_bounded() { perl -e 'alarm shift; exec @ARGV' "$@" 2>/dev/null; }  # _bounded SECS cmd...
_o2q="${ZDOTDIR}/bin/zdots-o2-query"
_o2_url="${ZDOTS_O2_ENDPOINT:-http://127.0.0.1:5080}"
_win="${ZDOTS_CC_DIGEST_SINCE:-6h}"
if [[ -x "$_o2q" ]] && command -v jq >/dev/null 2>&1 && command -v perl >/dev/null 2>&1 \
   && curl -sf -m 1 "${_o2_url}/healthz" >/dev/null 2>&1; then
  _err="$(_bounded 3 "$_o2q" errors    --json --since "$_win" -n 500 --no-scrub || true)"; _err="${_err:-[]}"
  _fail="$(_bounded 3 "$_o2q" failures --json --since "$_win" -n 500 --no-scrub || true)"; _fail="${_fail:-[]}"
  _ec="$(printf '%s' "$_err"  | jq 'length' 2>/dev/null || echo 0)"
  _fc="$(printf '%s' "$_fail" | jq 'length' 2>/dev/null || echo 0)"
  if [[ "${_ec:-0}" -eq 0 && "${_fc:-0}" -eq 0 ]]; then
    printf 'runtime (last %s, OpenObserve): clean — 0 error logs, 0 failed spans.\n' "$_win"
  else
    _etop="$(printf '%s' "$_err"  | jq -r 'map(.service//"?")|group_by(.)|map({s:.[0],n:length})|sort_by(-.n)|.[0:3]|map("\(.s) \(.n)")|join(", ")' 2>/dev/null || true)"
    _ftop="$(printf '%s' "$_fail" | jq -r '[.[].op//"?"]|unique|.[0:3]|join(", ")' 2>/dev/null || true)"
    printf 'runtime (last %s, OpenObserve): %s error logs' "$_win" "$_ec"
    [[ -n "$_etop" ]] && printf ' (top: %s)' "$_etop"
    printf ' · %s failed spans' "$_fc"
    [[ -n "$_ftop" ]] && printf ' (%s)' "$_ftop"
    printf '.\n  drill in: zdots-o2-query errors|failures|trace <id>  (read-only, scrubbed at ingest).\n'
  fi
fi

exit 0
