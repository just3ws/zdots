#!/usr/bin/env bash
# ---
# id: zdots-update-local
# title: "Zdots Local State Reconciler"
# purpose: Reconcile machine-local generated state after pulling repo updates.
# rationale: Provides a narrow post-pull updater without bootstrap's broad machine setup.
# ---
# bin/zdots-update-local — Safe post-pull reconciliation. Run via: make update-local

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
DRY_RUN=0
SKIP_BREW=0
SKIP_MISE=0
SKIP_LLAMA=0
SKIP_OTEL=0
SKIP_FABRIC=0
SKIP_CHECK=0
PHASE_TOTAL=7
PHASE_INDEX=0
CURRENT_PHASE="preflight"
RUN_ID="$(date '+%Y%m%dT%H%M%S')-$$"

usage() {
  cat <<EOF
Usage: zdots-update-local [OPTIONS]

Reconcile machine-local generated state after pulling zdots updates.
This is intentionally narrower than bin/bootstrap: it does not restore adots,
rewrite home dotfiles, install certs, edit nginx, or initialize databases.

Steps:
  1. brew bundle --file Brewfile.home|Brewfile.work
  2. mise install --cd ZDOTDIR
  3. llama-ctl install
  4. llama-ctl install-embed
  5. fabric-ai --updatepatterns
  6. otel-collector validate
  7. make check-fast

Options:
  -n, --dry-run     Print commands without running them
  --skip-brew       Skip brew bundle
  --skip-mise       Skip mise install
  --skip-llama      Skip llama plist regeneration
  --skip-fabric     Skip fabric-ai pattern update
  --skip-otel       Skip otel-collector validation
  --skip-check      Skip make check-fast
  -h, --help        Show this help

Logs:
  ${XDG_STATE_HOME:-~/.local/state}/zsh/zdots-update-local-*.log
  ${XDG_STATE_HOME:-~/.local/state}/zsh/zdots-update-local-*.summary.md
  Override directory with ZDOTS_LOG_DIR.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    --skip-brew)  SKIP_BREW=1 ;;
    --skip-mise)  SKIP_MISE=1 ;;
    --skip-llama) SKIP_LLAMA=1 ;;
    --skip-fabric) SKIP_FABRIC=1 ;;
    --skip-otel)  SKIP_OTEL=1 ;;
    --skip-check) SKIP_CHECK=1 ;;
    -h|--help)    usage; exit 0 ;;
    *)            printf 'zdots-update-local: unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

if [[ ! -d "$ZDOTDIR" ]]; then
  printf 'zdots-update-local: error: ZDOTDIR does not exist: %s\n' "$ZDOTDIR" >&2
  exit 1
fi

cd "$ZDOTDIR"

LOG_DIR="${ZDOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zsh}"
mkdir -p "$LOG_DIR"
LOG_FILE="${ZDOTS_UPDATE_LOCAL_LOG:-$LOG_DIR/zdots-update-local-${RUN_ID}.log}"
SUMMARY_FILE="${LOG_FILE%.log}.summary.md"
LATEST_LOG="$LOG_DIR/zdots-update-local-latest.log"
ln -sf "$LOG_FILE" "$LATEST_LOG" 2>/dev/null || true
if [[ "${ZDOTS_TRANSCRIPT_TEE:-1}" == "1" ]] && command -v tee >/dev/null 2>&1 && command -v mkfifo >/dev/null 2>&1; then
  LOG_FIFO="${LOG_FILE}.fifo"
  rm -f "$LOG_FIFO"
  mkfifo "$LOG_FIFO"
  tee -a "$LOG_FILE" < "$LOG_FIFO" &
  exec > "$LOG_FIFO" 2>&1
  rm -f "$LOG_FIFO"
else
  exec >> "$LOG_FILE" 2>&1
fi

timestamp() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

log() {
  printf '%s zdots-update-local: %s\n' "$(timestamp)" "$*" >&2
}

summary() {
  printf '%s\n' "$*" >> "$SUMMARY_FILE"
}

phase() {
  PHASE_INDEX=$((PHASE_INDEX + 1))
  CURRENT_PHASE="$1"
  printf '\n==> zdots-update-local phase %02d/%02d: %s\n' "$PHASE_INDEX" "$PHASE_TOTAL" "$CURRENT_PHASE" >&2
  summary "- phase ${PHASE_INDEX}/${PHASE_TOTAL}: ${CURRENT_PHASE}"
}

finish() {
  status=$?
  if [[ "$status" -eq 0 ]]; then
    log "complete status=0 log=$LOG_FILE summary=$SUMMARY_FILE"
    summary "- result: complete"
  else
    log "failed status=$status phase=$CURRENT_PHASE log=$LOG_FILE summary=$SUMMARY_FILE"
    summary "- result: failed status=${status} phase=${CURRENT_PHASE}"
  fi
  exit "$status"
}
trap finish EXIT

{
  printf '# zdots-update-local run\n'
  printf -- '- started: %s\n' "$(timestamp)"
  printf -- '- repo: %s\n' "$ZDOTDIR"
  printf -- '- log: %s\n' "$LOG_FILE"
  printf -- '- latest: %s\n' "$LATEST_LOG"
  printf -- '- context: %s\n' "${ZDOTS_CONTEXT:-home}"
  printf -- '- dry_run: %s\n' "$DRY_RUN"
} > "$SUMMARY_FILE"

run() {
  log "run: $*"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    if "$@"; then
      log "ok: $*"
    else
      status=$?
      log "failed status=$status command=$*"
      return "$status"
    fi
  else
    log "dry-run: skipped execution"
  fi
}

warn() {
  log "warning: $*"
}

log "run_id=$RUN_ID repo=$ZDOTDIR log=$LOG_FILE summary=$SUMMARY_FILE"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  log "commit=$(git rev-parse --short HEAD)"
fi

phase "brew: reconcile selected Brewfile"
if [[ "$SKIP_BREW" -eq 0 ]]; then
  if command -v brew >/dev/null 2>&1; then
    case "${ZDOTS_CONTEXT:-home}" in
      work) brewfile="$ZDOTDIR/Brewfile.work" ;;
      *)    brewfile="$ZDOTDIR/Brewfile.home" ;;
    esac
    case "${HOMEBREW_BUNDLE_FILE:-}" in
      ""|"$ZDOTDIR/Brewfile"|"$ZDOTDIR/Brewfile.home"|"$ZDOTDIR/Brewfile.work") ;;
      *) brewfile="$HOMEBREW_BUNDLE_FILE" ;;
    esac
    run brew bundle --file "$brewfile"
  else
    warn "brew not found; skipping brew bundle"
  fi
else
  warn "skipping brew phase (--skip-brew)"
fi

phase "mise: install pinned runtimes"
if [[ "$SKIP_MISE" -eq 0 ]]; then
  if command -v mise >/dev/null 2>&1; then
    run mise install --cd "$ZDOTDIR"
  else
    warn "mise not found; skipping mise install"
  fi
else
  warn "skipping mise phase (--skip-mise)"
fi

phase "llama: regenerate launchd plists"
if [[ "$SKIP_LLAMA" -eq 0 ]]; then
  if [[ -x "$ZDOTDIR/bin/llama-ctl" ]]; then
    run "$ZDOTDIR/bin/llama-ctl" install
    run "$ZDOTDIR/bin/llama-ctl" install-embed
  else
    warn "bin/llama-ctl not executable; skipping llama plist regeneration"
  fi
else
  warn "skipping llama phase (--skip-llama)"
fi

phase "fabric: refresh local pattern library"
if [[ "$SKIP_FABRIC" -eq 0 ]]; then
  if command -v fabric-ai >/dev/null 2>&1; then
    # Ensure config exists for local LLM
    FABRIC_CONF="$HOME/.config/fabric"
    if [[ ! -f "$FABRIC_CONF/.env" ]]; then
      run mkdir -p "$FABRIC_CONF"
      if [[ "$DRY_RUN" -eq 0 ]]; then
        printf "OPENAI_API_KEY=local\nOPENAI_BASE_URL=http://127.0.0.1:11500/v1\nDEFAULT_MODEL=qwen3-8b\n" > "$FABRIC_CONF/.env"
      fi
    fi
    run fabric-ai --updatepatterns
  else
    warn "fabric-ai not found; skipping pattern update"
  fi
else
  warn "skipping fabric phase (--skip-fabric)"
fi

phase "otel: validate collector config"
if [[ "$SKIP_OTEL" -eq 0 ]]; then
  if [[ -x "$ZDOTDIR/bin/otel-collector" ]]; then
    run "$ZDOTDIR/bin/otel-collector" validate
  else
    warn "bin/otel-collector not executable; skipping otel validation"
  fi
else
  warn "skipping otel phase (--skip-otel)"
fi

phase "checks: make check-fast"
if [[ "$SKIP_CHECK" -eq 0 ]]; then
  if command -v make >/dev/null 2>&1; then
    run make check-fast
  else
    warn "make not found; skipping check-fast"
  fi
else
  warn "skipping check phase (--skip-check)"
fi

phase "handoff: log location for Pi/HI analysis"
log "handoff: feed this to Pi or HI: $SUMMARY_FILE then $LOG_FILE"
