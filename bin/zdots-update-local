#!/usr/bin/env bash
# ---
# id: zdots-update-local
# title: "Zdots Local State Reconciler"
# purpose: Reconcile machine-local generated state after pulling repo updates.
# rationale: Provides a narrow post-pull updater without bootstrap's broad machine setup.
# ---
# bin/zdots-update-local — Safe post-pull reconciliation. Run via: make update-local

set -euo pipefail

# SIGPIPE: write failures from broken pipes (e.g. | head) exit cleanly.
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
DRY_RUN=0
SKIP_BREW=0
SKIP_MISE=0
SKIP_LLAMA=0
SKIP_OTEL=0
SKIP_FABRIC=0
SKIP_AIDER=0
SKIP_GEMINI=0
SKIP_CHECK=0
PHASE_TOTAL=10
PHASE_INDEX=0
PHASE_DONE=0
PHASE_NAMES=()
CURRENT_PHASE="preflight"
STEP_INDEX=0
CURRENT_STEP="preflight"
RUN_ID="$(date '+%Y%m%dT%H%M%S')-$$"

usage() {
  cat <<EOF
Usage: zdots-update-local [OPTIONS]

Reconcile machine-local generated state after pulling zdots updates.
This is intentionally narrower than bin/bootstrap: it does not restore adots,
rewrite home dotfiles, install certs, edit nginx, or initialize databases.

Steps:
  1. brew bundle --file Brewfile.home|Brewfile.work
  2. mise install --cd ZDOTDIR
  3. llama-ctl install + install-embed (launchd plists)
  4. fabric-ai --updatepatterns
  5. pi: reconcile ~/.pi/agent/settings.json + models.json
  6. aider: write ~/.aider.model.metadata.json (context window for openai/local)
  7. gemini-mcp: idempotent gemini-mcp-register (skipped if gemini not installed)
  8. otel-collector validate
  9. make check-fast

Options:
  -n, --dry-run     Print commands without running them
  --skip-brew       Skip brew bundle
  --skip-mise       Skip mise install
  --skip-llama      Skip llama plist regeneration
  --skip-fabric     Skip fabric-ai pattern update
  --skip-aider      Skip Aider model metadata reconciliation
  --skip-gemini     Skip Gemini MCP registration
  --skip-otel       Skip otel-collector validation
  --skip-check      Skip make check-fast
  -h, --help        Show this help

Logs:
  ${XDG_STATE_HOME:-~/.local/state}/zsh/zdots-update-local-*.log
  ${XDG_STATE_HOME:-~/.local/state}/zsh/zdots-update-local-*.summary.md
  Override directory with ZDOTS_LOG_DIR.

Diagnostics:
  zdots-log-analyze update
  zdots-log-analyze update --ai
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    --skip-brew)  SKIP_BREW=1 ;;
    --skip-mise)  SKIP_MISE=1 ;;
    --skip-llama) SKIP_LLAMA=1 ;;
    --skip-fabric) SKIP_FABRIC=1 ;;
    --skip-aider) SKIP_AIDER=1 ;;
    --skip-gemini) SKIP_GEMINI=1 ;;
    --skip-otel)  SKIP_OTEL=1 ;;
    --skip-check) SKIP_CHECK=1 ;;
    -h|--help)    usage; exit 0 ;;
    *)            printf 'zdots-update-local: unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

if [[ ! -d "$ZDOTDIR" ]]; then
  printf 'zdots-update-local: error: ZDOTDIR does not exist: %s\n' "$ZDOTDIR" >&2
  exit 1
fi

cd "$ZDOTDIR"

LOG_DIR="${ZDOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zsh}"
mkdir -p "$LOG_DIR"
LOG_FILE="${ZDOTS_UPDATE_LOCAL_LOG:-$LOG_DIR/zdots-update-local-${RUN_ID}.log}"
SUMMARY_FILE="${LOG_FILE%.log}.summary.md"
LATEST_LOG="$LOG_DIR/zdots-update-local-latest.log"
ln -sf "$LOG_FILE" "$LATEST_LOG" 2>/dev/null || true
if [[ "${ZDOTS_TRANSCRIPT_TEE:-1}" == "1" ]] && command -v tee >/dev/null 2>&1 && command -v mkfifo >/dev/null 2>&1; then
  LOG_FIFO="${LOG_FILE}.fifo"
  rm -f "$LOG_FIFO"
  mkfifo "$LOG_FIFO"
  tee -a "$LOG_FILE" < "$LOG_FIFO" &
  exec > "$LOG_FIFO" 2>&1
  rm -f "$LOG_FIFO"
else
  exec >> "$LOG_FILE" 2>&1
fi

timestamp() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

log() {
  printf '%s zdots-update-local: %s\n' "$(timestamp)" "$*" >&2
}

summary() {
  printf '%s\n' "$*" >> "$SUMMARY_FILE"
}

phase() {
  # If a previous phase ran, we got here — it succeeded.
  if (( PHASE_INDEX > 0 )); then
    PHASE_DONE=$PHASE_INDEX
    printf '  [ok] phase %02d/%02d: %s\n' "$PHASE_INDEX" "$PHASE_TOTAL" "$CURRENT_PHASE" >&2
    summary "  - result: ok"
  fi
  PHASE_INDEX=$((PHASE_INDEX + 1))
  STEP_INDEX=0
  CURRENT_PHASE="$1"
  CURRENT_STEP="phase-start"
  PHASE_NAMES+=("$1")
  printf '\n==> zdots-update-local phase %02d/%02d: %s\n' "$PHASE_INDEX" "$PHASE_TOTAL" "$CURRENT_PHASE" >&2
  summary ""
  summary "- phase ${PHASE_INDEX}/${PHASE_TOTAL}: ${CURRENT_PHASE}"
}

step() {
  STEP_INDEX=$((STEP_INDEX + 1))
  CURRENT_STEP="$1"
  printf '  --> zdots-update-local step %02d.%02d: %s\n' "$PHASE_INDEX" "$STEP_INDEX" "$CURRENT_STEP" >&2
  summary "  - step ${PHASE_INDEX}.${STEP_INDEX}: ${CURRENT_STEP}"
}

finish() {
  local exit_status=$?

  # Emit result for the final phase.
  if [[ "$exit_status" -eq 0 ]]; then
    PHASE_DONE=$PHASE_INDEX
    printf '  [ok] phase %02d/%02d: %s\n' "$PHASE_INDEX" "$PHASE_TOTAL" "$CURRENT_PHASE" >&2
    summary "  - result: ok"
  elif (( PHASE_INDEX > 0 )); then
    printf '  [FAIL] phase %02d/%02d: %s — step: %s\n' \
      "$PHASE_INDEX" "$PHASE_TOTAL" "$CURRENT_PHASE" "$CURRENT_STEP" >&2
    summary "  - result: FAILED (step: ${CURRENT_STEP})"
  fi

  # Phase summary table.
  printf '\n==> Run summary: %d/%d phases completed\n' "$PHASE_DONE" "$PHASE_TOTAL" >&2
  summary ""
  summary "## Run summary: ${PHASE_DONE}/${PHASE_TOTAL} phases completed"
  summary ""
  local i
  for (( i=0; i<${#PHASE_NAMES[@]}; i++ )); do
    local num=$(( i + 1 )) name="${PHASE_NAMES[$i]}" marker
    if (( num <= PHASE_DONE )); then
      marker="[ok]  "; else marker="[FAIL]"; fi
    printf '  %s %02d/%02d: %s\n' "$marker" "$num" "$PHASE_TOTAL" "$name" >&2
    summary "- ${marker} ${num}/${PHASE_TOTAL}: ${name}"
  done
  local reached=${#PHASE_NAMES[@]}
  if (( reached < PHASE_TOTAL && exit_status != 0 )); then
    local not_reached=$(( PHASE_TOTAL - reached ))
    printf '  [----] %d phase(s) not reached\n' "$not_reached" >&2
    summary "- [----] ${not_reached} phase(s) not reached"
  fi

  # On failure, append a log excerpt to the summary for Pi/HI analysis.
  if [[ "$exit_status" -ne 0 ]]; then
    summary ""
    summary "## Failure context (last 40 log lines)"
    summary '```'
    tail -40 "$LOG_FILE" 2>/dev/null >> "$SUMMARY_FILE" || true
    summary '```'
    printf '\nFull log: %s\n' "$LOG_FILE" >&2
  fi

  summary ""
  if [[ "$exit_status" -eq 0 ]]; then
    log "complete status=0 log=$LOG_FILE summary=$SUMMARY_FILE"
    summary "**result: complete**"
  else
    log "failed status=$exit_status phase=$CURRENT_PHASE step=$CURRENT_STEP log=$LOG_FILE summary=$SUMMARY_FILE"
    summary "**result: FAILED** status=${exit_status} phase=${CURRENT_PHASE} step=${CURRENT_STEP}"
  fi
  exit "$exit_status"
}
trap finish EXIT

{
  printf '# zdots-update-local run\n'
  printf -- '- started: %s\n' "$(timestamp)"
  printf -- '- repo: %s\n' "$ZDOTDIR"
  printf -- '- log: %s\n' "$LOG_FILE"
  printf -- '- latest: %s\n' "$LATEST_LOG"
  printf -- '- context: %s\n' "${ZDOTS_CONTEXT:-home}"
  printf -- '- dry_run: %s\n' "$DRY_RUN"
} > "$SUMMARY_FILE"

run() {
  log "run phase=$CURRENT_PHASE step=$CURRENT_STEP command=$*"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    if "$@"; then
      log "ok phase=$CURRENT_PHASE step=$CURRENT_STEP command=$*"
    else
      status=$?
      log "failed status=$status phase=$CURRENT_PHASE step=$CURRENT_STEP command=$*"
      return "$status"
    fi
  else
    log "dry-run phase=$CURRENT_PHASE step=$CURRENT_STEP skipped command=$*"
  fi
}

warn() {
  log "warning: $*"
}

log "run_id=$RUN_ID repo=$ZDOTDIR log=$LOG_FILE summary=$SUMMARY_FILE"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  log "commit=$(git rev-parse --short HEAD)"
fi

phase "brew: reconcile selected Brewfile"
if [[ "$SKIP_BREW" -eq 0 ]]; then
  step "detect Homebrew"
  if command -v brew >/dev/null 2>&1; then
    step "select context Brewfile"
    case "${ZDOTS_CONTEXT:-home}" in
      work) brewfile="$ZDOTDIR/Brewfile.work" ;;
      *)    brewfile="$ZDOTDIR/Brewfile.home" ;;
    esac
    case "${HOMEBREW_BUNDLE_FILE:-}" in
      ""|"$ZDOTDIR/Brewfile"|"$ZDOTDIR/Brewfile.home"|"$ZDOTDIR/Brewfile.work") ;;
      *) brewfile="$HOMEBREW_BUNDLE_FILE" ;;
    esac
    log "selected Brewfile=$brewfile context=${ZDOTS_CONTEXT:-home}"
    step "run brew bundle"
    run brew bundle --file "$brewfile"
  else
    warn "brew not found; skipping brew bundle"
  fi
else
  warn "skipping brew phase (--skip-brew)"
fi

phase "mise: install pinned runtimes"
if [[ "$SKIP_MISE" -eq 0 ]]; then
  step "detect mise"
  if command -v mise >/dev/null 2>&1; then
    step "install pinned runtimes"
    run mise install --cd "$ZDOTDIR"
  else
    warn "mise not found; skipping mise install"
  fi
else
  warn "skipping mise phase (--skip-mise)"
fi

phase "llama: regenerate launchd plists"
if [[ "$SKIP_LLAMA" -eq 0 ]]; then
  step "detect llama-ctl"
  if [[ -x "$ZDOTDIR/bin/llama-ctl" ]]; then
    step "ensure draft model present"
    _models_dir="${ZDOTS_AI_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llama-cpp/models}"
    _draft_file="Qwen_Qwen3-0.6B-Q4_K_M.gguf"
    if [[ -f "$_models_dir/$_draft_file" ]]; then
      log "draft model already present: $_draft_file"
    else
      log "draft model missing — downloading: $_draft_file"
      run "$ZDOTDIR/bin/llama-ctl" model-download --draft
    fi
    unset _models_dir _draft_file
    step "install chat launchd service"
    run "$ZDOTDIR/bin/llama-ctl" install
    step "install embedding launchd service"
    run "$ZDOTDIR/bin/llama-ctl" install-embed
  else
    warn "bin/llama-ctl not executable; skipping llama plist regeneration"
  fi
else
  warn "skipping llama phase (--skip-llama)"
fi

phase "fabric: refresh local pattern library"
if [[ "$SKIP_FABRIC" -eq 0 ]]; then
  step "detect fabric-ai"
  if command -v fabric-ai >/dev/null 2>&1; then
    # Ensure config exists for local LLM
    FABRIC_CONF="$HOME/.config/fabric"
    step "ensure local Fabric config"
    if [[ ! -f "$FABRIC_CONF/.env" ]]; then
      run mkdir -p "$FABRIC_CONF"
      if [[ "$DRY_RUN" -eq 0 ]]; then
        printf "OPENAI_API_KEY=local\nOPENAI_BASE_URL=http://127.0.0.1:11500/v1\nDEFAULT_MODEL=qwen3-8b\n" > "$FABRIC_CONF/.env"
        log "wrote Fabric config $FABRIC_CONF/.env"
      fi
    fi
    step "update Fabric patterns"
    run fabric-ai --updatepatterns
  else
    warn "fabric-ai not found; skipping pattern update"
  fi
else
  warn "skipping fabric phase (--skip-fabric)"
fi

phase "pi: reconcile local llama.cpp model config"
step "locate pi CLI"
PI_AGENT_DIR="$HOME/.pi/agent"
pi_bin="$(command -v pi 2>/dev/null || true)"
if [[ -z "$pi_bin" ]]; then
  pi_bin="$(find "$HOME/.local/share/mise/installs/node" -path '*/bin/pi' -type f 2>/dev/null | sort -V | tail -1 || true)"
fi
if [[ -n "$pi_bin" ]]; then
  AI_BASE="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}/v1"
  log "pi binary=$pi_bin"
  step "ensure Pi agent directory"
  run mkdir -p "$PI_AGENT_DIR"
  step "reconcile Pi settings"
  if [[ ! -f "$PI_AGENT_DIR/settings.json" ]]; then
    if [[ "$DRY_RUN" -eq 0 ]]; then
      cat > "$PI_AGENT_DIR/settings.json" <<'PISETTINGS'
{
  "defaultModel": "local",
  "defaultProvider": "llamacpp",
  "defaultThinkingLevel": "off"
}
PISETTINGS
      log "created ~/.pi/agent/settings.json"
    else
      log "dry-run: would create ~/.pi/agent/settings.json"
    fi
  else
    # Enforce defaultThinkingLevel=off — thinking mode burns the full 32k window on 7B.
    thinking=$(jq -r '.defaultThinkingLevel // empty' "$PI_AGENT_DIR/settings.json" 2>/dev/null || true)
    if [[ "$thinking" != "off" ]]; then
      if [[ "$DRY_RUN" -eq 0 ]]; then
        tmp=$(mktemp)
        jq '.defaultThinkingLevel = "off"' "$PI_AGENT_DIR/settings.json" > "$tmp" \
          && mv "$tmp" "$PI_AGENT_DIR/settings.json"
        log "enforced defaultThinkingLevel=off in ~/.pi/agent/settings.json (was: ${thinking:-unset})"
      else
        log "dry-run: would set defaultThinkingLevel=off (currently: ${thinking:-unset})"
      fi
    else
      log "Pi settings already correct (defaultThinkingLevel=off)"
    fi
  fi
  step "reconcile Pi model endpoint"
  if [[ ! -f "$PI_AGENT_DIR/models.json" ]] || ! grep -Fq "\"baseUrl\": \"${AI_BASE}\"" "$PI_AGENT_DIR/models.json"; then
    if [[ "$DRY_RUN" -eq 0 ]]; then
      [[ -f "$PI_AGENT_DIR/models.json" ]] && cp "$PI_AGENT_DIR/models.json" "$PI_AGENT_DIR/models.json.bak"
      cat > "$PI_AGENT_DIR/models.json" <<PIMODELS
{
  "providers": {
    "llamacpp": {
      "api": "openai-completions",
      "apiKey": "local",
      "baseUrl": "${AI_BASE}",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "supportsUsageInStreaming": false,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "local",
          "name": "Qwen3-8B (llama.cpp)",
          "contextWindow": 32768,
          "maxTokens": 2048,
          "input": ["text"],
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
PIMODELS
      log "wrote ~/.pi/agent/models.json endpoint=$AI_BASE"
    else
      log "dry-run: would write ~/.pi/agent/models.json endpoint=$AI_BASE"
    fi
  else
    log "Pi models.json already targets $AI_BASE"
  fi
else
  warn "pi not found; skipping Pi config reconciliation"
fi
unset PI_AGENT_DIR pi_bin AI_BASE

phase "aider: reconcile model metadata for context-window budgeting"
if [[ "$SKIP_AIDER" -eq 0 ]]; then
  step "detect aider"
  _aider_bin="$(command -v aider 2>/dev/null \
    || find "${HOME}/.local/share/uv/tools/aider-chat/bin" -name 'aider' -type f 2>/dev/null | head -1 \
    || true)"
  if [[ -n "$_aider_bin" ]]; then
    METADATA_FILE="${HOME}/.aider.model.metadata.json"
    # Derive context window from Pi models.json if available; fall back to 32768.
    CONTEXT_WINDOW=32768
    MAX_OUTPUT=2048
    step "write model metadata"
    # Idempotency: regenerate if the file is missing or the context window changed.
    CURRENT_CTX=""
    [[ -f "$METADATA_FILE" ]] \
      && CURRENT_CTX=$(jq -r '."openai/local".max_input_tokens // empty' "$METADATA_FILE" 2>/dev/null || true)
    if [[ "$CURRENT_CTX" != "$CONTEXT_WINDOW" ]]; then
      if [[ "$DRY_RUN" -eq 0 ]]; then
        cat > "$METADATA_FILE" <<AIDER_META
{
  "openai/local": {
    "max_input_tokens": ${CONTEXT_WINDOW},
    "max_output_tokens": ${MAX_OUTPUT},
    "litellm_provider": "openai",
    "mode": "chat"
  }
}
AIDER_META
        log "wrote $METADATA_FILE context_window=${CONTEXT_WINDOW}"
      else
        log "dry-run: would write $METADATA_FILE context_window=${CONTEXT_WINDOW}"
      fi
    else
      log "aider metadata already correct context_window=${CONTEXT_WINDOW}"
    fi
    unset METADATA_FILE CONTEXT_WINDOW MAX_OUTPUT CURRENT_CTX
  else
    warn "aider not found; skipping model metadata"
  fi
  unset _aider_bin
else
  warn "skipping aider phase (--skip-aider)"
fi

phase "gemini-mcp: register zdots MCP servers with Gemini CLI"
if [[ "$SKIP_GEMINI" -eq 0 ]]; then
  step "detect gemini CLI"
  if command -v gemini >/dev/null 2>&1; then
    step "run gemini-mcp-register (idempotent)"
    run "${ZDOTDIR}/bin/gemini-mcp-register"
  else
    log "gemini CLI not found; skipping MCP registration"
  fi
else
  warn "skipping gemini-mcp phase (--skip-gemini)"
fi

phase "otel: validate collector config"
if [[ "$SKIP_OTEL" -eq 0 ]]; then
  step "detect otel-collector"
  if [[ -x "$ZDOTDIR/bin/otel-collector" ]]; then
    step "validate otel collector config"
    run "$ZDOTDIR/bin/otel-collector" validate
  else
    warn "bin/otel-collector not executable; skipping otel validation"
  fi
else
  warn "skipping otel phase (--skip-otel)"
fi

phase "checks: make check-fast"
if [[ "$SKIP_CHECK" -eq 0 ]]; then
  step "detect make"
  if command -v make >/dev/null 2>&1; then
    step "run fast check suite"
    run make check-fast
  else
    warn "make not found; skipping check-fast"
  fi
else
  warn "skipping check phase (--skip-check)"
fi

phase "handoff: log location for Pi/HI analysis"
step "emit log handoff"
log "handoff: feed this to Pi or HI: $SUMMARY_FILE then $LOG_FILE"
