#!/usr/bin/env bash
# bin/secret-scan — High-signal security validator with CI diagnostics

set -uo pipefail # -e omitted intentionally: grep exits non-zero on no-match

# SIGPIPE: write failures from broken pipes exit cleanly.
trap '' PIPE

# CI/Diagnostic Harness
DEBUG="${ZDOTS_DEBUG:-0}"
[[ "${GITHUB_ACTIONS:-false}" == "true" ]] && DEBUG=1

log_diag() {
  [[ "$DEBUG" == "1" ]] && echo "secret-scan: [DIAG] $*" >&2
}

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT" || exit

# Prefer the Go zdots-secret-scan (RE2 registry, externalized patterns). The
# binary is committed for this fleet (darwin/arm64); where it can't execute —
# e.g. CI Linux without a rebuild — rc 126 (cannot exec) / 127 (missing) trigger
# the bash fallback below. Any other rc is the scan's real verdict, so we honor
# it directly. A finding (rc 1) thus comes straight from the Go tool.
_go_scan="$REPO_ROOT/bin/zdots-secret-scan"
if [[ -x "$_go_scan" ]]; then
  ZDOTDIR="${ZDOTDIR:-$REPO_ROOT}" "$_go_scan"
  _rc=$?
  if [[ "$_rc" -ne 126 && "$_rc" -ne 127 ]]; then
    exit "$_rc"
  fi
  log_diag "Go zdots-secret-scan unavailable on this platform (rc=$_rc); using bash fallback"
fi

if ! command -v rg >/dev/null 2>&1; then
  log_diag "ripgrep not found, falling back to grep"
  USE_RG=0
else
  USE_RG=1
fi

PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'gh[pousr]_[A-Za-z0-9_]{20,}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'AIza[0-9A-Za-z_-]{35}'
  'ya29\.[0-9A-Za-z_-]+'
  'sk-[A-Za-z0-9]{20,}'
  '-----BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY-----'
  # Inline hex key assignments — catches ZDOTS_DB_ENCRYPTION_KEY and similar
  # Matches: VAR_KEY="<32+ hex chars>" or VAR_KEY=<32+ hex chars>
  '[A-Z_]+(?:KEY|SECRET|PASSWORD|TOKEN)\s*=\s*["\x27]?[0-9a-fA-F]{32,}["\x27]?'
)

out_file="$(mktemp)"

run_scan() {
  local pattern="$1"
  shift
  local -a extra_args=("$@")
  
  log_diag "Checking pattern: $pattern"

  # Define files/directories to exclude from all scans
  local -a excludes=(
    ':!.zdots.secrets.example'
    ':!tests/'
    ':!docs/'
    ':!bin/secret-scan'
    ':!cmd/zdots-secret-scan/'   # Go successor: source + test fixtures hold pattern strings
    ':!etc/secret-patterns.yaml' # the secret registry literally lists the patterns
  )

  if [[ "$USE_RG" == "1" ]]; then
    # We use || true to prevent non-zero exit codes from stopping the script
    git ls-files -z -- "${excludes[@]}" | xargs -0 rg -H -n -i "${extra_args[@]}" "$pattern" >>"$out_file" 2>/dev/null || true
  else
    git ls-files -z -- "${excludes[@]}" | xargs -0 grep -H -n -i -E "${extra_args[@]}" "$pattern" >>"$out_file" 2>/dev/null || true
  fi
}

# 1. Run high-confidence patterns
for pattern in "${PATTERNS[@]}"; do
  run_scan "$pattern"
done

# 2. Final Report
if [[ -s "$out_file" ]]; then
  echo "secret-scan: FAILURE — potential secrets detected:" >&2
  cat "$out_file" >&2
  rm -f "$out_file"
  exit 1
fi

rm -f "$out_file"
log_diag "Scan completed successfully."
echo "secret-scan: OK"
exit 0
