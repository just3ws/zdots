#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

if ! command -v rg >/dev/null 2>&1; then
  echo "secret-scan: rg is required" >&2
  exit 1
fi

PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'gh[pousr]_[A-Za-z0-9_]{20,}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'AIza[0-9A-Za-z_-]{35}'
  'ya29\.[0-9A-Za-z_-]+'
  'sk-[A-Za-z0-9]{20,}'
  '-----BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY-----'
  '\b[A-Za-z_][A-Za-z0-9_]*(api[_-]?key|secret|token|password|passwd|authorization|bearer)[A-Za-z0-9_]*\b[[:space:]]*[:=]'
)

found=0
out_file="$(mktemp)"
for pattern in "${PATTERNS[@]}"; do
  if git ls-files -z | xargs -0 rg -n --pcre2 -I -i "$pattern" >"$out_file" 2>/dev/null; then
    if [[ "$found" -eq 0 ]]; then
      echo "secret-scan: potential secrets detected:" >&2
    fi
    cat "$out_file" >&2
    found=1
  fi
done
rm -f "$out_file"

if [[ "$found" -eq 1 ]]; then
  exit 1
fi

echo "secret-scan: OK"
