#!/usr/bin/env bash
# bin/secret-scan — High-signal security validator with CI diagnostics

set -uo pipefail # Removed -e to handle grep exit codes manually

# CI/Diagnostic Harness
DEBUG="${ZDOTS_DEBUG:-0}"
[[ "${GITHUB_ACTIONS:-false}" == "true" ]] && DEBUG=1

log_diag() {
  [[ "$DEBUG" == "1" ]] && echo "secret-scan: [DIAG] $*" >&2
}

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT" || exit

if ! command -v rg >/dev/null 2>&1; then
  log_diag "ripgrep not found, falling back to grep"
  USE_RG=0
else
  USE_RG=1
fi

PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'gh[pousr]_[A-Za-z0-9_]{20,}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'AIza[0-9A-Za-z_-]{35}'
  'ya29\.[0-9A-Za-z_-]+'
  'sk-[A-Za-z0-9]{20,}'
  '-----BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY-----'
)

BROAD_PATTERN='\b[A-Za-z_][A-Za-z0-9_]*(api[_-]?key|secret|token|password|passwd|authorization|bearer)[A-Za-z0-9_]*\b[[:space:]]*[:=]'

out_file="$(mktemp)"

run_scan() {
  local pattern="$1"
  shift
  local -a extra_args=("$@")
  
  log_diag "Checking pattern: $pattern"

  if [[ "$USE_RG" == "1" ]]; then
    # We use || true to prevent non-zero exit codes from stopping the script
    git ls-files -z | xargs -0 rg -H -n -i "${extra_args[@]}" "$pattern" >>"$out_file" 2>/dev/null || true
  else
    git ls-files -z | xargs -0 grep -H -n -i -E "${extra_args[@]}" "$pattern" >>"$out_file" 2>/dev/null || true
  fi
}

# 1. Run high-confidence patterns
for pattern in "${PATTERNS[@]}"; do
  run_scan "$pattern"
done

# 2. Run broad pattern with exclusions
log_diag "Checking broad pattern with exclusions"
if [[ "$USE_RG" == "1" ]]; then
  # We exclude bin/secret-scan itself from the broad check to avoid false positives on its own patterns
  git ls-files -z | xargs -0 rg -H -n -i "$BROAD_PATTERN" 2>/dev/null | \
    rg -v 'bin/secret-scan:' | \
    rg -v '\$\{\{[[:space:]]*(secrets\.|github\.token|steps\.)' | \
    rg -v "GITHUB_TOKEN:[[:space:]]*(''|\"\")" >>"$out_file" 2>/dev/null || true
else
  git ls-files -z | xargs -0 grep -H -n -i -E "$BROAD_PATTERN" 2>/dev/null | \
    grep -v 'bin/secret-scan:' | \
    grep -v -E '\$\{\{[[:space:]]*(secrets\.|github\.token|steps\.)' | \
    grep -v -E "GITHUB_TOKEN:[[:space:]]*(''|\"\")" >>"$out_file" 2>/dev/null || true
fi

# 3. Final Report
if [[ -s "$out_file" ]]; then
  echo "secret-scan: FAILURE — potential secrets detected:" >&2
  cat "$out_file" >&2
  rm -f "$out_file"
  exit 1
fi

rm -f "$out_file"
log_diag "Scan completed successfully."
echo "secret-scan: OK"
exit 0
