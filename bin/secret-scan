#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

if ! command -v rg >/dev/null 2>&1; then
  echo "secret-scan: warning: rg not found, falling back to grep (less precise)" >&2
  USE_RG=0
else
  USE_RG=1
fi

PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'gh[pousr]_[A-Za-z0-9_]{20,}'
  'github_pat_[A-Za-z0-9_]{20,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'AIza[0-9A-Za-z_-]{35}'
  'ya29\.[0-9A-Za-z_-]+'
  'sk-[A-Za-z0-9]{20,}'
  '-----BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY-----'
)

# Broad pattern for general secret detection (assignments)
BROAD_PATTERN='\b[A-Za-z_][A-Za-z0-9_]*(api[_-]?key|secret|token|password|passwd|authorization|bearer)[A-Za-z0-9_]*\b[[:space:]]*[:=]'

found=0
out_file="$(mktemp)"

run_scan() {
  local pattern="$1"
  shift
  local -a extra_args=("$@")

  if [[ "$USE_RG" == "1" ]]; then
    if git ls-files -z | xargs -0 rg -n -I -i "${extra_args[@]}" "$pattern" >>"$out_file" 2>/dev/null; then
      return 0
    fi
  else
    if git ls-files -z | xargs -0 grep -n -I -i -E "${extra_args[@]}" "$pattern" >>"$out_file" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

# Run specific patterns (high confidence)
for pattern in "${PATTERNS[@]}"; do
  run_scan "$pattern"
done

# Run broad pattern, but exclude known safe patterns and files
# We ignore lines containing '${{ secrets.' or '${{ github.token }}' which are common in GHA
if [[ "$USE_RG" == "1" ]]; then
  git ls-files -z | xargs -0 rg -n -I -i -v '\$\{\{[[:space:]]*(secrets\.|github\.token|steps\.)' | rg -i "$BROAD_PATTERN" >>"$out_file" 2>/dev/null || true
else
  # Fallback for grep is harder to pipe like this accurately, so we just skip the broad pattern on GHA files for now if rg is missing
  git ls-files -z | grep -v '.github/workflows/' | xargs -0 grep -n -I -i -E "$BROAD_PATTERN" >>"$out_file" 2>/dev/null || true
fi

if [[ -s "$out_file" ]]; then
  echo "secret-scan: potential secrets detected:" >&2
  cat "$out_file" >&2
  found=1
fi
rm -f "$out_file"
rm -f "$out_file"

if [[ "$found" -eq 1 ]]; then
  exit 1
fi

echo "secret-scan: OK"
