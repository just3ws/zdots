#!/usr/bin/env zsh
# ---
# id: history-analyze
# title: "Zdots History Analysis Engine"
# purpose: Analyzes shell activity to suggest performance and security optimizations.
# rationale: Uses local AI models to process raw JSONL traces, reducing data before sending to frontier models or Grafana.
# ---
# bin/history-analyze — High-performance shell activity analyzer.

# 1. Boot Environment (Establish Control Plane Context)
if [[ -r "${ZDOTDIR:-$HOME/.config/zsh}/.zshenv" ]]; then
  source "${ZDOTDIR:-$HOME/.config/zsh}/.zshenv"
fi

# Configuration
TRACE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"

usage() {
  cat <<EOF
Usage: history-analyze [options]

Options:
  --ai      Use local AI to generate optimizations from history
  --limit N Limit analysis to the last N events (default: 500)
  --help    Show this message
EOF
}

# 2. Primal Analysis (Core grep/awk)
analyze_basic() {
  local limit="$1"
  print -P "%B--- Basic Shell Activity (Last $limit events) ---%b"
  
  # Top 10 Commands
  echo ""
  echo "Top 10 Commands:"
  grep '"event":"exec"' "$TRACE_FILE" | tail -n "$limit" | \
    sed 's/.*"data":"\([^"]*\)".*/\1/' | \
    sort | uniq -c | sort -nr | head -n 10
}

# 3. AI-Powered Data Reduction (The "Dream")
analyze_ai() {
  local limit="$1"
  
  # Ensure AI service is initialized
  if [[ -n "$(command -v zdots_ai_init)" ]]; then
    zdots_ai_init
  fi

  # Check if AI service is provided by the control plane
  if [[ -z "$(command -v zdots_ai_infer)" ]]; then
    echo "history-analyze: error: AI service provider not found." >&2
    echo "Check ZDOTS_SERVICE_AI in .zdots.env" >&2
    return 1
  fi

  echo "history-analyze: reducing data via local AI (${ZDOTS_AI_MODEL:-unknown})..."
  
  # Extract relevant exec traces for AI consumption
  local data=$(grep '"event":"exec"' "$TRACE_FILE" | tail -n "$limit" | sed 's/.*"data":"\([^"]*\)".*/\1/')
  
  local system_prompt="You are a shell performance expert. Analyze the provided command history and suggest exactly 3 optimizations (e.g., new aliases, tools to defer, or security warnings). Be extremely concise. Respond in Markdown bullets."
  
  zdots_ai_infer "Command History:\n$data" "$system_prompt"
}

# Main
LIMIT=500
USE_AI=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ai) USE_AI=1 ;;
    --limit) LIMIT="$2"; shift ;;
    --help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
  shift
done

if [[ ! -f "$TRACE_FILE" ]]; then
  echo "history-analyze: error: trace file not found at $TRACE_FILE" >&2
  exit 1
fi

analyze_basic "$LIMIT"

if [[ "$USE_AI" == "1" ]]; then
  analyze_ai "$LIMIT"
fi
