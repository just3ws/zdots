#!/usr/bin/env sh
# ---
# id: history-analyze
# title: "Zdots History Analysis Engine"
# purpose: Analyzes shell activity to suggest performance and security optimizations.
# rationale: Uses local AI models to process raw JSONL traces, reducing data before sending to frontier models or Grafana.
# ---
# bin/history-analyze — High-performance shell activity analyzer.

set -eu

# Configuration
TRACE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"

usage() {
  cat <<EOF
Usage: history-analyze [options]

Options:
  --ai      Use local AI to generate optimizations from history
  --limit N Limit analysis to the last N events (default: 500)
  --help    Show this message
EOF
}

# 1. Primal Analysis (Core sh/grep)
analyze_basic() {
  _limit="$1"
  echo "--- Basic Shell Activity (Last $_limit events) ---"
  
  # Top 10 Commands
  echo ""
  echo "Top 10 Commands:"
  grep '"event":"exec"' "$TRACE_FILE" | tail -n "$_limit" | \
    sed 's/.*"data":"\([^"]*\)".*/\1/' | \
    sort | uniq -c | sort -nr | head -n 10
}

# 2. AI-Powered Data Reduction (The "Dream")
analyze_ai() {
  _limit="$1"
  # We check for the function, not the command, as it's provided by Zsh
  if ! command -v zdots_ai_infer >/dev/null 2>&1; then
    echo "history-analyze: error: AI service not found. Run in Zsh or check .zdots.env" >&2
    return 1
  fi

  echo "history-analyze: reducing data via local AI..."
  
  # Extract relevant exec traces for AI consumption
  _data=$(grep '"event":"exec"' "$TRACE_FILE" | tail -n "$_limit" | sed 's/.*"data":"\([^"]*\)".*/\1/')
  
  _system_prompt="You are a shell performance expert. Analyze the provided command history and suggest exactly 3 optimizations (e.g., new aliases, tools to defer, or security warnings). Be extremely concise."
  
  zdots_ai_infer "Command History:\n$_data" "$_system_prompt"
}

# Main
LIMIT=500
USE_AI=0

while [ $# -gt 0 ]; do
  case "$1" in
    --ai) USE_AI=1 ;;
    --limit) LIMIT="$2"; shift ;;
    --help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
  shift
done

if [ ! -f "$TRACE_FILE" ]; then
  echo "history-analyze: error: trace file not found at $TRACE_FILE" >&2
  exit 1
fi

analyze_basic "$LIMIT"

if [ "$USE_AI" -eq 1 ]; then
  analyze_ai "$LIMIT"
fi
