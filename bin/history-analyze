#!/usr/bin/env bash
# ---
# id: history-analyze
# title: "Shell Activity Analyzer"
# purpose: Analyze shell command history for patterns, inefficiencies, and alias candidates.
# rationale: Pulls from atuin (full history) and the OTel trace file (exit codes, timing).
#            Local AI via ai-query suggests optimizations without sending data to cloud models.
# ---
# bin/history-analyze — Analyze shell history for insights and optimization opportunities.
#
# Usage:
#   history-analyze                   # basic frequency report (no AI)
#   history-analyze --ai              # + AI optimization suggestions
#   history-analyze --aliases         # + alias candidates for long repeated commands
#   history-analyze --failures        # + commands that frequently fail (exit ≠ 0)
#   history-analyze --limit N         # limit to last N history entries (default: 500)
#   history-analyze --help

set -euo pipefail
trap '' PIPE

ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
AI_QUERY="${ZDOTDIR}/bin/ai-query"
TRACE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"

usage() {
  cat <<EOF
Usage: history-analyze [--ai] [--aliases] [--failures] [--limit N] [--help]

Analyze shell command history for patterns, inefficiencies, and alias candidates.

Options:
  --ai        AI-generated optimization suggestions (requires llama.cpp running)
  --aliases   Suggest aliases for long, frequently-typed commands
  --failures  Show commands that exit non-zero most often (from OTel trace file)
  --limit N   History entries to analyze (default: 500; applies to atuin queries)
  --help      Show this message

Data sources:
  atuin       Full command history (used for frequency, alias, and AI analysis)
  OTel traces $TRACE_FILE (used for --failures; requires active OTel pipeline)
EOF
}

OPT_AI=false
OPT_ALIASES=false
OPT_FAILURES=false
LIMIT=500

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ai)       OPT_AI=true ;;
    --aliases)  OPT_ALIASES=true ;;
    --failures) OPT_FAILURES=true ;;
    --limit)    LIMIT="$2"; shift ;;
    --help)     usage; exit 0 ;;
    *) printf 'history-analyze: unknown option: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_header() { printf '\n\033[1m%s\033[0m\n' "$1"; }
_ai_check() {
  if [[ ! -x "$AI_QUERY" ]]; then
    printf 'history-analyze: ai-query not found at %s\n' "$AI_QUERY" >&2; return 1
  fi
  if ! curl -sf -m 2 "${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}/health" >/dev/null 2>&1; then
    printf 'history-analyze: llama.cpp is not running. Start with: llama-ctl start\n' >&2; return 1
  fi
}

# ---------------------------------------------------------------------------
# 1. Basic frequency report (always runs)
# ---------------------------------------------------------------------------
if ! command -v atuin >/dev/null 2>&1; then
  printf 'history-analyze: atuin not found — install with: brew install atuin\n' >&2
  exit 1
fi

_header "Top Commands (last $LIMIT)"
atuin search --limit "$LIMIT" --cmd-only -- "" 2>/dev/null \
  | sort | uniq -c | sort -rn | head -20 \
  | awk '{printf "  %5d  %s\n", $1, $2}'

_header "Unique Commands Used"
COUNT=$(atuin search --limit "$LIMIT" --cmd-only -- "" 2>/dev/null | sort -u | wc -l | tr -d ' ')
printf '  %s distinct commands in last %s entries\n' "$COUNT" "$LIMIT"

# ---------------------------------------------------------------------------
# 2. Failure analysis from OTel trace file
# ---------------------------------------------------------------------------
if $OPT_FAILURES; then
  _header "Frequently Failing Commands (exit ≠ 0)"
  if [[ ! -f "$TRACE_FILE" ]]; then
    printf '  OTel trace file not found: %s\n' "$TRACE_FILE"
    printf '  (requires active OTel pipeline — check: otel-collector status)\n'
  else
    # Extract exec events with non-zero exit codes
    grep '"event":"exec"' "$TRACE_FILE" 2>/dev/null \
      | grep -v '"exit":0\b\|"exit":"0"' \
      | sed 's/.*"data":"\([^"]*\)".*/\1/' \
      | sort | uniq -c | sort -rn | head -15 \
      | awk '{printf "  %5d  %s\n", $1, $2}' \
      || printf '  (no failures found in trace file)\n'
  fi
fi

# ---------------------------------------------------------------------------
# 3. Alias suggestions
# ---------------------------------------------------------------------------
if $OPT_ALIASES; then
  _header "Alias Candidates (long commands, run ≥3 times)"
  if ! _ai_check; then
    # Fallback: heuristic only, no AI
    atuin search --limit "$LIMIT" --cmd-only -- "" 2>/dev/null \
      | awk 'length > 35' \
      | sort | uniq -c | sort -rn \
      | awk '$1 >= 3 {printf "  %5d  %s\n", $1, substr($0, index($0,$2))}' \
      | head -15
  else
    CANDIDATES=$(atuin search --limit "$LIMIT" --cmd-only -- "" 2>/dev/null \
      | awk 'length > 35' \
      | sort | uniq -c | sort -rn \
      | awk '$1 >= 3 {print $1, substr($0, index($0,$2))}' \
      | head -20)

    if [[ -z "$CANDIDATES" ]]; then
      printf '  (no candidates found — try --limit with a larger value)\n'
    else
      PROMPT="Suggest concise zsh aliases for these frequently-typed shell commands.
Each line is: <count> <command>
Rules:
- Only suggest aliases for commands that are genuinely worth shortening
- Alias name: short (2-6 chars), mnemonic, no conflicts with common tools
- Format each suggestion as: alias <name>='<command>'  # <what it does>
- Skip commands that are already short or that vary too much to alias
- Output only the alias lines, nothing else"

      printf '%s' "$CANDIDATES" | "$AI_QUERY" --mode safe-extract "$PROMPT"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# 4. AI optimization suggestions
# ---------------------------------------------------------------------------
if $OPT_AI; then
  _header "AI Optimization Suggestions"
  if ! _ai_check; then exit 1; fi

  # Strip bash-format timestamp lines (#...) and group by first word so the
  # AI sees clean "count command" pairs — not raw history noise.
  HISTORY=$(atuin search --limit "$LIMIT" --cmd-only -- "" 2>/dev/null \
    | grep -v '^[[:space:]]*#' \
    | awk 'NF>0{print $1}' \
    | sort | uniq -c | sort -rn | head -40)

  if [[ -z "$HISTORY" ]]; then
    printf '  (no history available)\n'
  else
    PROMPT="Below is a developer's command frequency list. Each line is:
  <run_count> <command_name>

RULES — you must follow these exactly:
1. Only discuss commands that appear in the list above. Do not mention any command not in this data.
2. Suggest exactly 3-5 improvements. Each improvement must name the specific command from the list.
3. Format: markdown bullet. Start each with the command name in backticks.
4. For each: one sentence on the pattern, one concrete action (alias, function, or tool swap).
5. If the history is too short or uniform to find 3 patterns, say so rather than inventing patterns.

Data:"

    if command -v rtk >/dev/null 2>&1; then
      printf '%s' "$HISTORY" | rtk | "$AI_QUERY" --mode safe-extract "$PROMPT"
    else
      printf '%s' "$HISTORY" | "$AI_QUERY" --mode safe-extract "$PROMPT"
    fi
  fi
fi
