#!/usr/bin/env bash
# cc-home — launch Claude Code in home directory with personal OS context
#
# Usage:
#   cc-home [prompt]
#
# Behavior:
#   - Changes to $HOME
#   - Sources session_start hook (loads both zdots + adots capabilities)
#   - Prints context (peers, capabilities count, ready status)
#   - Launches Claude Code with optional prompt
#
# Examples:
#   cc-home                                      # launch, no prompt
#   cc-home "help me understand the architecture"
#   cc-home "fix the PHI scrubber bug"

set -euo pipefail

# Ensure we're in $HOME
cd "$HOME" || exit 1

# Source session_start hook to load capabilities and peer status
ZDOTS_DIR="${ZDOTS_DIR:-$HOME/.config/zsh}"
ADOTS_DIR="${ADOTS_DIR:-$HOME/.config/adots}"

# Source session_start: it sets ZDOTS_HEALTHY / ADOTS_HEALTHY / PERSONAL_OS_READY
# and populates ZDOTS_CAPABILITIES + ADOTS_ALL_CAPABILITIES when sourced. Toggle
# set -e off across the source so hook internals can't abort the launcher.
if [[ -f "$ZDOTS_DIR/.claude/hooks/session_start" ]]; then
  set +e
  # shellcheck source=/dev/null
  source "$ZDOTS_DIR/.claude/hooks/session_start" 2>/dev/null || true
  set -e
fi

# Peer status from the hook's probes — do not re-run the doctors here.
glyph() { [[ "${1:-0}" == "1" ]] && printf '✓' || printf '❌'; }
zdots_status="$(glyph "${ZDOTS_HEALTHY:-0}")"
adots_status="$(glyph "${ADOTS_HEALTHY:-0}")"
if [[ -n "${ZDOTS_CAPABILITIES[*]:-}" ]]; then zdots_count="${#ZDOTS_CAPABILITIES[@]}"; else zdots_count=0; fi
if [[ -n "${ADOTS_ALL_CAPABILITIES[*]:-}" ]]; then adots_count="${#ADOTS_ALL_CAPABILITIES[@]}"; else adots_count=0; fi

# Attest each advertised command: ✓ if on PATH, ✗ if it would 404. A banner that
# promises commands the agent can't run is worse than one that admits the gap.
attest() {
  local cmd="$1" desc="$2" mark
  if command -v "$cmd" >/dev/null 2>&1; then mark="✓"; else mark="✗"; fi
  printf '  %s  %-26s %s\n' "$mark" "$cmd" "$desc"
}

# Print context banner
cat <<EOF

╔════════════════════════════════════════════════════════════════╗
║           Personal OS — Claude Code Session Start              ║
╚════════════════════════════════════════════════════════════════╝

📍 Location: $HOME (personal workspace)

Peer Status:
  zdots (infrastructure):     $zdots_status   ($zdots_count capabilities)
  adots (home management):    $adots_status   ($adots_count capabilities)

Architecture:
  • zdots manages: services, observability, knowledge layer, CLI tools
  • adots manages: home directory structure, profiles, dotfiles
  • Both peers are monitored together; both healthy = PERSONAL_OS_READY
EOF

echo ""
echo "Available Commands (✓ = on PATH, ✗ = declared but not installed):"
attest "zdots-ctx"    "# query/export knowledge base"
attest "zsvc"         "# service control (llama, postgres, ...)"
attest "zdots-doctor" "# check infrastructure health"
attest "adots-doctor" "# check home layout health"
attest "adots"        "# pull/push home dotfile changes"
attest "adots-profile" "# manage machine profiles"

cat <<EOF

Documentation:
  Read: docs/agents/personal-os-abstraction.md (agent decision guide)

Session Context:
  • PERSONAL_OS_READY=${PERSONAL_OS_READY:-0} (1=both healthy, 0=degraded)
  • ZDOTS_DIR=$ZDOTS_DIR
  • ADOTS_DIR=$ADOTS_DIR

EOF

# Launch Claude Code
if [[ $# -gt 0 ]]; then
  # With prompt
  claude "$@"
else
  # Interactive
  claude
fi
