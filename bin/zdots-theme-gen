#!/usr/bin/env ruby
# frozen_string_literal: true
#
# zdots-theme-gen — generate every surface theme artifact from ONE palette source.
#
# A colorscheme's palette lives in exactly one file: etc/themes/<slug>.yaml. This
# renders it into every surface (iTerm2 preset, ghostty, bat/tmTheme, zsh syntax
# highlighting, vivid, lazygit, Alfred, dashboard CSS tokens, mermaid). Change a
# hex in the source, regenerate, and every surface follows — no 15-file hand sweep,
# no silent drift. See docs/styleguide/colorschemes.md.
#
# Usage:
#   zdots-theme-gen [slug]            generate all surfaces for slug (default: kanagawa-wave)
#   zdots-theme-gen [slug] --check    exit 1 if any generated artifact is stale vs source
#   zdots-theme-gen [slug] --only F   generate only output whose `out:` is F
#   zdots-theme-gen --list            list configured schemes
#
# Attribution for the bundled scheme lives in its source YAML header and in
# docs/styleguide/colorschemes.md. Palettes are facts, not code; upstream credit
# is preserved there.
require "yaml"
require "json"
require "fileutils"

ROOT      = File.expand_path("..", __dir__)
THEME_DIR = File.join(ROOT, "etc", "themes")
TMPL_DIR  = File.join(THEME_DIR, "templates")

def die(msg) = abort("zdots-theme-gen: #{msg}")

# --- palette helpers -------------------------------------------------------
def rgb(hex)  = hex.scan(/../).map { |h| h.to_i(16) }              # "1A1B2F" -> [26,27,47]
def comp(v)   = format("%.6f", v / 255.0)                          # 26 -> "0.101961"

# --- builtins (deterministic from palette) ---------------------------------

# iTerm2 .itermcolors plist. Keys are string-sorted (matches iTerm's own export:
# Ansi 0,1,10,11..15,2..9 then the named slots alphabetically). Within each color
# dict: Color Space, Alpha, Blue, Green, Red. Indentation is tabs.
def emit_itermcolors(t)
  colors = {}
  t["ansi"].each_with_index { |name, i| colors["Ansi #{i} Color"] = t.fetch("palette").fetch(name) }
  t.fetch("iterm_slots").each { |slot, name| colors["#{slot} Color"] = t.fetch("palette").fetch(name) }

  body = colors.keys.sort.map do |key|
    r, g, b = rgb(colors[key])
    <<~DICT.chomp
      \t<key>#{key}</key>
      \t<dict>
      \t\t<key>Color Space</key>
      \t\t<string>sRGB</string>
      \t\t<key>Alpha Component</key>
      \t\t<real>1</real>
      \t\t<key>Blue Component</key>
      \t\t<real>#{comp(b)}</real>
      \t\t<key>Green Component</key>
      \t\t<real>#{comp(g)}</real>
      \t\t<key>Red Component</key>
      \t\t<real>#{comp(r)}</real>
      \t</dict>
    DICT
  end.join("\n")

  <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    #{body}
    </dict>
    </plist>
  PLIST
end

def emit_ghostty(t)
  pal = t.fetch("palette")
  lines = ["# #{t['title']} theme for Ghostty",
           "# Install: copy to ~/.config/ghostty/themes/#{t['slug']}, then set `theme = #{t['slug']}`.",
           "# Palette from #{t['source']}."]
  t["ansi"].each_with_index { |name, i| lines << "palette = #{i}=##{pal.fetch(name).downcase}" }
  t.fetch("ghostty_slots").each { |k, name| lines << "#{k} = ##{pal.fetch(name).downcase}" }
  lines.join("\n") + "\n"
end

# Dashboard semantic tokens — the partial my.localhost app.css and zdots-statusd
# import instead of hardcoding hex. New artifact (no legacy counterpart).
def emit_css_tokens(t)
  pal = t.fetch("palette")
  vars = t.fetch("tokens").map { |var, name| "  --#{var}: ##{pal.fetch(name)};" }
  (t["token_literals"] || {}).each { |var, val| vars << "  --#{var}: #{val};" }
  <<~CSS
    /* #{t['title']} — semantic tokens. GENERATED by zdots-theme-gen from
       etc/themes/#{t['slug']}.yaml. Do not edit by hand; edit the source + regenerate. */
    :root {
    #{vars.join("\n")}
    }
  CSS
end

def emit_mermaid(t)
  pal = t.fetch("palette")
  vars = (t["mermaid_literals"] || {}).dup
  t.fetch("mermaid").each { |k, name| vars[k] = "##{pal.fetch(name)}" }
  JSON.pretty_generate("theme" => "base", "themeVariables" => vars) + "\n"
end

BUILTINS = {
  "itermcolors" => method(:emit_itermcolors),
  "ghostty"     => method(:emit_ghostty),
  "css_tokens"  => method(:emit_css_tokens),
  "mermaid"     => method(:emit_mermaid),
}.freeze

# --- template renderer -----------------------------------------------------
# Placeholders: {{name}} -> UPPER hex (no '#'); {{name:lc}} -> lower hex.
# The template supplies any '#', alpha suffix, and surrounding structure.
def render_template(t, tmpl)
  pal = t.fetch("palette")
  File.read(File.join(TMPL_DIR, tmpl)).gsub(/\{\{([A-Za-z0-9]+)(?::(lc))?\}\}/) do
    name, filt = Regexp.last_match(1), Regexp.last_match(2)
    hex = pal[name] or die("template #{tmpl}: unknown palette name '#{name}'")
    filt == "lc" ? hex.downcase : hex
  end
end

# --- driver ----------------------------------------------------------------
args  = ARGV.dup
check = args.delete("--check")
list  = args.delete("--list")
only  = (i = args.index("--only")) ? args.delete_at(i + 1).tap { args.delete_at(i) } : nil

if list
  Dir[File.join(THEME_DIR, "*.yaml")].sort.each { |f| puts File.basename(f, ".yaml") }
  exit 0
end

slug = args.first || "kanagawa-wave"
src  = File.join(THEME_DIR, "#{slug}.yaml")
File.exist?(src) or die("no theme source: #{src}")
t = YAML.safe_load_file(src)
out_dir = File.join(ROOT, "assets", slug)

drift = []
(t["outputs"] || []).each do |o|
  next if only && o["out"] != only
  content =
    case o["type"]
    when "builtin"  then (BUILTINS[o["emit"]] || die("unknown builtin '#{o['emit']}'")).call(t)
    when "template" then render_template(t, o["tmpl"])
    else die("unknown output type '#{o['type']}'")
    end
  dest = File.join(out_dir, o["out"])

  if check
    current = File.exist?(dest) ? File.read(dest) : nil
    drift << o["out"] if current != content
  else
    FileUtils.mkdir_p(out_dir) unless Dir.exist?(out_dir)
    File.write(dest, content)
    puts "  wrote assets/#{slug}/#{o['out']}"
  end
end

if check
  if drift.empty?
    puts "zdots-theme-gen: #{slug} — all #{(t['outputs'] || []).size} surfaces in sync"
    exit 0
  end
  warn "zdots-theme-gen: #{slug} — STALE: #{drift.join(', ')} (run: zdots-theme-gen #{slug})"
  exit 1
end
puts "zdots-theme-gen: #{slug} — generated #{(t['outputs'] || []).size} surfaces into assets/#{slug}/"
