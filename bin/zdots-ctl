#!/usr/bin/env bash
# bin/zdots-ctl — Zdots platform orchestrator and health checker
#
# Brings the entire local platform up or down in dependency order,
# validates each step, and provides a single break-glass reset command.
# Also runs a "brew doctor"-style deep environment check.
#
# Dependency order (up):
#   1. Colima (VM)
#      └── LGTM stack (docker-compose in Colima)
#            └── otel-collector (bare-metal, forwards to LGTM)
#   2. llama-ctl / AI server (independent, launchd)
#   3. llama-ctl embed server (independent, launchd, port 11501)

set -euo pipefail
trap '' PIPE

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"

# shellcheck source=lib/svc-health.bash
source "${ZDOTDIR}/lib/svc-health.bash"
# 1. Ensure environment is loaded (no set -u to avoid .zdots.env errors)
[[ -z "${DATABASE_URL:-}" ]] && source "${ZDOTDIR}/env.sh" || true
# shellcheck source=lib/trace_log.bash
source "${ZDOTDIR}/lib/trace_log.bash"

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

# Service catalog + health/state probes — the single source of truth shared
# with bin/zsvc. Endpoints below derive from the registry descriptor.
# shellcheck source=lib/svc-registry.bash
source "${ZDOTDIR}/lib/svc-registry.bash"

AI_ENDPOINT="${ZDOTS_SVC_ENDPOINT[llama]}"
EMBED_ENDPOINT="${ZDOTS_SVC_ENDPOINT[embed]}"
OTLP_ENDPOINT="${ZDOTS_SVC_ENDPOINT[otel]}"
GRAFANA_URL="${ZDOTS_SVC_ENDPOINT[grafana]}"
REDIS_HOST="${ZDOTS_REDIS_HOST:-127.0.0.1}"
REDIS_PORT="${ZDOTS_REDIS_PORT:-6379}"
WAIT_TIMEOUT="${ZDOTS_BOOT_TIMEOUT:-90}"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

_info()    { printf 'zdots-ctl: %s\n'       "$*" >&2; }
_ok()      { printf 'zdots-ctl: [ok]  %s\n' "$*" >&2; }
_warn()    { printf 'zdots-ctl: [!!]  %s\n' "$*" >&2; }
_die()     { printf 'zdots-ctl: [err] %s\n' "$*" >&2; exit 1; }
_section() { printf '\nzdots-ctl: ── %s ──\n' "$*" >&2; }

# check subcommand report helpers — write to STDOUT so output is pipeable
_pass() { printf '  [PASS] %s\n'      "$*"; }
_fail() { printf '  [FAIL] %s\n'      "$*"; }
_chkwarn() { printf '  [WARN] %s\n'   "$*"; }
_fix()  { printf '         fix: %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Live probes — Enforce opaque service control seam
# ---------------------------------------------------------------------------

# Liveness probes derive from the shared registry (zdots_svc_healthy) — one
# definition per service, shared with zsvc. _ai_socket_up is the one ctl-only
# probe (socket-listening, distinct from the HTTP /health check).
_ai_up()         { zdots_svc_healthy llama; }
_ai_socket_up()  { zdots_svc_loopback_listening "$AI_ENDPOINT"; }
_embed_up()      { zdots_svc_healthy embed; }
_otel_up()       { zdots_svc_healthy otel; }
_grafana_up()    { zdots_svc_healthy grafana; }
_colima_up()     { zdots_svc_healthy colima; }
_ctx_up()        { zdots_svc_healthy ctx; }
_redis_up()      { zdots_svc_healthy redis; }
_worker_up()     { zdots_svc_healthy worker; }

_wait_for() {
  local label="$1" url="$2" timeout="${3:-$WAIT_TIMEOUT}"
  local elapsed=0
  printf 'zdots-ctl: waiting for %s' "$label" >&2
  while ! curl -sf -m 2 "$url" >/dev/null 2>&1; do
    if [[ $elapsed -ge $timeout ]]; then
      printf '\n' >&2
      _die "timed out after ${timeout}s waiting for ${label} (${url})"
    fi
    printf '.' >&2
    sleep 3
    elapsed=$((elapsed + 3))
  done
  printf ' ready\n' >&2
}

# ---------------------------------------------------------------------------
# Lifecycle commands
# ---------------------------------------------------------------------------

cmd_up() {
  _section "Bringing platform up"
  zdots_trace_log "platform_up" "start"

  # 1. Colima + LGTM stack
  if _grafana_up; then
    _ok "LGTM stack already up (Grafana reachable)"
  else
    _info "starting LGTM stack (Colima + Grafana/Loki/Tempo/Mimir)..."
    "$BIN/local-ci" start
    _wait_for "Grafana" "${GRAFANA_URL}/api/health"
    _ok "LGTM stack up"
  fi

  # 2. otel-collector (needs LGTM to forward to)
  if _otel_up; then
    _ok "otel-collector already running"
  else
    _info "starting otel-collector..."
    "$BIN/otel-collector" start
    sleep 2
    if _otel_up; then
      _ok "otel-collector up"
    else
      _warn "otel-collector did not start — run: otel-collector install"
    fi
  fi

  # 3. AI server (independent)
  if _ai_up; then
    _ok "AI server already up"
  else
    _info "starting AI server..."
    "$BIN/llama-ctl" start
    _wait_for "AI server" "${AI_ENDPOINT}/health" 60
    _ok "AI server up"
  fi

  # 4. Embed server (independent, port 11501) — optional (RAG/capture only).
  #    Non-fatal: start-embed now waits for readiness and returns non-zero on
  #    timeout, so a slow embed under memory pressure reports cleanly instead of
  #    aborting the whole platform bring-up (the old _wait_for here was fatal).
  if _embed_up; then
    _ok "embed server already up"
  else
    _info "starting embed server..."
    if "$BIN/llama-ctl" start-embed; then
      _ok "embed server up"
    else
      _warn "embed server not ready (RAG/capture disabled) — likely memory pressure"
      _warn "  retry: zsvc restart embed | diagnose: zsvc diag embed | budget: ZDOTS_EMBED_WAIT=120"
    fi
  fi

  # 5. Worker (drains the job queue; depends on DB + AI + embed being up)
  if _worker_up; then
    _ok "worker already running"
  else
    _info "starting worker..."
    "$BIN/zdots-worker" start
    sleep 2
    if _worker_up; then
      _ok "worker up"
    else
      _warn "worker did not start — run: zdots-worker install"
    fi
  fi

  _section "Platform status"
  cmd_status
  zdots_trace_log "platform_up" "complete"
}

cmd_down() {
  _section "Bringing platform down"
  zdots_trace_log "platform_down" "start"
  # Reverse dependency order
  _info "stopping worker..."
  "$BIN/zdots-worker" stop 2>/dev/null || true
  _info "stopping otel-collector..."
  "$BIN/otel-collector" stop 2>/dev/null || true
  _info "stopping embed server..."
  "$BIN/llama-ctl" stop-embed 2>/dev/null || true
  _info "stopping AI server..."
  "$BIN/llama-ctl" stop 2>/dev/null || true
  _info "stopping LGTM stack and Colima..."
  "$BIN/local-ci" stop 2>/dev/null || true
  _ok "platform down"
  zdots_trace_log "platform_down" "complete"
}

cmd_reset() {
  _section "Resetting platform"
  cmd_down
  sleep 2
  cmd_up
}

cmd_install() {
  _section "Installing platform (first-time setup)"
  _info "installing llama.cpp..."
  "$BIN/llama-ctl" install
  _info "installing embed server..."
  "$BIN/llama-ctl" install-embed
  _info "installing otel-collector..."
  "$BIN/otel-collector" install
  _info "installing worker..."
  "$BIN/zdots-worker" install
  _section "Starting platform"
  cmd_up
  _section "Validating environment"
  "$BIN/capabilities"
}

cmd_status() {
  local json=false
  [[ "${1:-}" == "--json" ]] && json=true

  local lgtm_up ai_up ai_socket_up embed_up otel_up colima_up ctx_up redis_up worker_up
  _grafana_up && lgtm_up=true   || lgtm_up=false
  _ai_up      && ai_up=true     || ai_up=false
  _ai_socket_up && ai_socket_up=true || ai_socket_up=false
  _embed_up   && embed_up=true  || embed_up=false
  _otel_up    && otel_up=true   || otel_up=false
  _colima_up  && colima_up=true || colima_up=false
  _ctx_up     && ctx_up=true    || ctx_up=false
  _redis_up   && redis_up=true  || redis_up=false
  _worker_up  && worker_up=true || worker_up=false

  local ai_model="unknown"
  if [[ "$ai_up" == "true" ]]; then
    ai_model=$(curl -sf -m 2 "${AI_ENDPOINT}/v1/models" 2>/dev/null \
      | jq -r '.data[0].id // "local"' 2>/dev/null || echo "local")
  fi

  if $json; then
    printf '{"colima":%s,"lgtm":%s,"otel_collector":%s,"ai_server":%s,"ai_http_healthy":%s,"ai_socket_listening":%s,"embed_server":%s,"ai_model":"%s","intelligence_suite":%s,"cache":%s,"worker":%s,"grafana_url":"%s","ai_endpoint":"%s","embed_endpoint":"%s","otlp_endpoint":"%s","redis_host":"%s","redis_port":%s}\n' \
      "$colima_up" "$lgtm_up" "$otel_up" "$ai_up" "$ai_up" "$ai_socket_up" "$embed_up" "$ai_model" "$ctx_up" "$redis_up" "$worker_up" \
      "$GRAFANA_URL" "$AI_ENDPOINT" "$EMBED_ENDPOINT" "$OTLP_ENDPOINT" "$REDIS_HOST" "$REDIS_PORT"
    return
  fi

  local tick cross
  tick='✓' cross='✗'
  _sym() { [[ "$1" == "true" ]] && printf '%s' "$tick" || printf '%s' "$cross"; }

  printf 'zdots-ctl: platform status\n'
  printf '  %-20s %s  %s\n' "colima"         "$(_sym "$colima_up")" "$([ "$colima_up" = true ] && echo up || echo down)"
  printf '  %-20s %s  %s\n' "LGTM stack"     "$(_sym "$lgtm_up")"  "$GRAFANA_URL"
  printf '  %-20s %s  %s\n' "otel-collector" "$(_sym "$otel_up")"  "$OTLP_ENDPOINT"
  printf '  %-20s %s  %s (socket: %s)\n' "AI server" "$(_sym "$ai_up")" "$AI_ENDPOINT" "$ai_socket_up"
  printf '  %-20s %s  %s\n' "embed server"   "$(_sym "$embed_up")" "$EMBED_ENDPOINT"
  printf '  %-20s %s  %s\n' "intelligence"   "$(_sym "$ctx_up")"   "postgres"
  printf '  %-20s %s  %s\n' "cache"          "$(_sym "$redis_up")" "${REDIS_HOST}:${REDIS_PORT}"
  printf '  %-20s %s  %s\n' "worker"         "$(_sym "$worker_up")" "jobs queue (my)"

  if [[ "$lgtm_up" == false || "$ai_up" == false || "$embed_up" == false || "$otel_up" == false ]]; then
    printf '\nzdots-ctl: to start all: zdots-ctl up\n'
  fi
}

# ---------------------------------------------------------------------------
# check — "brew doctor" / ":checkhealth" style deep diagnostic
# ---------------------------------------------------------------------------
#
# Each check is independent. Output goes to STDOUT for piping.
# Exits 0 if all checks pass or warn; exits 1 if any check fails.

cmd_check() {
  local errors=0 warnings=0
  zdots_trace_log "platform_check" "start"

  _chk_pass() { _pass "$1"; }
  _chk_warn() { _chkwarn "$1"; warnings=$((warnings + 1)); }
  _chk_fail() { _fail "$1"; errors=$((errors + 1)); }

  printf 'zdots-ctl check — %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"

  # ── Required tools ─────────────────────────────────────────────────────────
  printf 'Required tools\n'
  for tool in brew git curl jq yq colima docker llama-server otelcol-contrib nginx mkcert; do
    if command -v "$tool" >/dev/null 2>&1; then
      _chk_pass "$tool  $(command -v "$tool")"
    elif [[ "$tool" == "nginx" ]] && curl -sI --max-time 1 http://127.0.0.1 2>/dev/null | grep -qi '^Server: nginx'; then
      # nginx run as root (sudo brew services) — binary not in user PATH; detect via HTTP probe
      _chk_pass "$tool  running as system service (port 80)"
    else
      _chk_fail "$tool  not found"
      _fix "brew install $tool"
    fi
  done

  # ── Config files ───────────────────────────────────────────────────────────
  printf '\nConfig files\n'

  _check_file() {
    local label="$1" path="$2" fix="$3"
    if [[ -f "$path" ]]; then
      _chk_pass "$label  $path"
    else
      _chk_fail "$label  missing: $path"
      [[ -n "$fix" ]] && _fix "$fix"
    fi
  }

  _check_file "ai-models.yaml"      "$ZDOTDIR/etc/ai-models.yaml"         ""
  _check_file "otel-collector.yaml" "$ZDOTDIR/etc/otel-collector.yaml"    ""
  _check_file "docker-compose.lgtm" "$ZDOTDIR/etc/docker-compose.lgtm.yaml" ""

  local llama_plist="$HOME/Library/LaunchAgents/com.zdots.llama-server.plist"
  local embed_plist="$HOME/Library/LaunchAgents/com.zdots.llama-embed.plist"
  local otel_plist="$HOME/Library/LaunchAgents/com.zdots.otel-collector.plist"
  if [[ -f "$llama_plist" ]]; then
    _chk_pass "llama-server plist  $llama_plist"
  else
    _chk_warn "llama-server plist  not registered"
    _fix "llama-ctl install"
  fi
  if [[ -f "$embed_plist" ]]; then
    _chk_pass "llama-embed plist   $embed_plist"
  else
    _chk_warn "llama-embed plist   not registered (embed server / RAG disabled)"
    _fix "ZDOTS_AI_PROFILE=embed llama-ctl model-download && llama-ctl install-embed"
  fi
  if [[ -f "$otel_plist" ]]; then
    _chk_pass "otel-collector plist  $otel_plist"
  else
    _chk_warn "otel-collector plist  not registered"
    _fix "otel-collector install"
  fi

  # ── YAML validity ──────────────────────────────────────────────────────────
  printf '\nConfig validity\n'
  if command -v yq >/dev/null 2>&1; then
    local f
    for f in "$ZDOTDIR/etc/ai-models.yaml" "$ZDOTDIR/etc/otel-collector.yaml"; do
      if [[ -f "$f" ]]; then
        if yq eval '.' "$f" >/dev/null 2>&1; then
          _chk_pass "$(basename "$f")  valid YAML"
        else
          _chk_fail "$(basename "$f")  invalid YAML"
          _fix "yq eval . $f"
        fi
      fi
    done
  else
    _chk_warn "yq not available — skipping YAML validation"
    _fix "brew install yq"
  fi

  # ── Model storage ──────────────────────────────────────────────────────────
  printf '\nModel storage\n'
  local models_dir="${ZDOTS_AI_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llama-cpp/models}"
  if [[ -d "$models_dir" ]]; then
    local model_count
    model_count=$(find "$models_dir" -name "*.gguf" 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$model_count" -gt 0 ]]; then
      _chk_pass "models dir  $models_dir ($model_count GGUF file(s))"
    else
      _chk_warn "models dir exists but no .gguf files found"
      _fix "llama-ctl model-download"
    fi
  else
    _chk_warn "models dir not found: $models_dir"
    _fix "llama-ctl model-download  (will create dir)"
  fi

  # Disk space warning (storage-constrained machine)
  local avail_kb
  avail_kb=$(df -k / 2>/dev/null | tail -1 | awk '{print $4}')
  local avail_gb=$(( avail_kb / 1024 / 1024 ))
  if [[ $avail_gb -lt 5 ]]; then
    _chk_fail "disk available: ${avail_gb}GB — critically low"
    _fix "llama-ctl model-prune && docker-reclaim -f"
  elif [[ $avail_gb -lt 15 ]]; then
    _chk_warn "disk available: ${avail_gb}GB — getting low"
    _fix "docker-reclaim  (dry run first)"
  else
    _chk_pass "disk available: ${avail_gb}GB"
  fi

  # ── Service health ─────────────────────────────────────────────────────────
  printf '\nService health\n'

  if _colima_up; then
    _chk_pass "Colima  running"
  else
    _chk_warn "Colima  not running"
    _fix "zdots-ctl up"
  fi

  if _grafana_up; then
    _chk_pass "LGTM stack  Grafana reachable ($GRAFANA_URL)"
  else
    _chk_warn "LGTM stack  Grafana unreachable"
    _fix "zdots-ctl up"
  fi

  if _otel_up; then
    _chk_pass "otel-collector  running"
  else
    _chk_warn "otel-collector  not running"
    _fix "zdots-ctl up"
  fi

  if _worker_up; then
    _chk_pass "worker  running (draining job queue)"
  else
    _chk_warn "worker  not running — enqueued jobs will not process"
    _fix "zsvc start worker  (or: zdots-ctl up)"
  fi

  if _ai_up; then
    _chk_pass "AI server  reachable ($AI_ENDPOINT)"
  else
    _chk_warn "AI server  unreachable"
    _fix "zdots-ctl up"
  fi

  local embed_endpoint="${ZDOTS_AI_EMBED_ENDPOINT:-http://127.0.0.1:11501}"
  local embed_plist_f="$HOME/Library/LaunchAgents/com.zdots.llama-embed.plist"
  if curl -sf -m 2 "${embed_endpoint}/health" >/dev/null 2>&1; then
    _chk_pass "embed server  reachable ($embed_endpoint)"
  elif [[ -f "$embed_plist_f" ]]; then
    # Registered but not answering: under memory pressure this is almost always
    # still-loading or an OOM kill, not a missing install — point at diag/retry.
    _chk_warn "embed server  registered but not serving — likely still loading or OOM (RAG/capture disabled)"
    _fix "zsvc diag embed   (then: zsvc restart embed, or ZDOTS_EMBED_WAIT=120 zsvc start embed)"
  else
    _chk_warn "embed server  not installed — RAG/capture disabled"
    _fix "ZDOTS_AI_PROFILE=embed llama-ctl model-download && llama-ctl install-embed"
  fi

  # ── AI server network sandbox (darwin) ────────────────────────────────────
  if [[ "$(uname -s)" == "Darwin" ]]; then
    local _llama_plist="$HOME/Library/LaunchAgents/com.zdots.llama-server.plist"
    if [[ -f "$_llama_plist" ]]; then
      if grep -q '<string>127.0.0.1</string>' "$_llama_plist" \
        && ! grep -qE '<string>(0\.0\.0\.0|\*)</string>' "$_llama_plist"; then
        _chk_pass "llama-server plist  bound to 127.0.0.1"
      else
        _chk_fail "llama-server plist  may bind to all interfaces — run: llama-ctl install"
      fi
    fi

    # Runtime socket check — only if server is up
    if _ai_socket_up; then
      local _ai_port; _ai_port=$(printf '%s' "${AI_ENDPOINT:-http://127.0.0.1:11500}" | grep -oE '[0-9]+$')
      local _non_lo
      _non_lo=$(lsof -nP -i "TCP:${_ai_port}" -sTCP:LISTEN 2>/dev/null \
        | awk '$1 ~ /^llama-ser/ {print $9}' | grep -v '^127\.' || true)
      if [[ -n "$_non_lo" ]]; then
        _chk_fail "llama-server  socket exposed on non-loopback: $_non_lo"
      else
        _chk_pass "llama-server  socket bound to loopback only"
      fi
    fi

    # Models directory permissions
    local _models_dir="${ZDOTS_AI_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llama-cpp/models}"
    if [[ -d "$_models_dir" ]]; then
      local _mperm; _mperm=$(stat -f '%OLp' "$_models_dir" 2>/dev/null || echo "???")
      if [[ "$_mperm" == "700" ]]; then
        _chk_pass "llama models dir  700 ($_models_dir)"
      else
        _chk_warn "llama models dir  permissions $_mperm (expected 700)"
        _fix "chmod 700 $_models_dir"
      fi
    fi
  fi

  if _ctx_up; then
    _chk_pass "intelligence  connected (postgres)"
  else
    _chk_warn "intelligence  unreachable (check ~/my/config or DATABASE_URL)"
    _fix "zdots-ctx status"
  fi

  if _redis_up; then
    _chk_pass "cache  Redis reachable (${REDIS_HOST}:${REDIS_PORT})"
  else
    _chk_warn "cache  Redis unreachable — analytics writes fall back to SQLite"
    _fix "brew services start redis"
  fi

  # ── Local proxy (nginx + mkcert + /etc/hosts) ─────────────────────────────
  printf '\nLocal proxy\n'

  # nginx should run on port 80 (managed via launchctl, not brew services).
  # Always probe via HTTP — binary not in user PATH when managed via sudo brew
  # services. Never gate on symlink existence; symlinks are unreliable across
  # brew upgrades (may be removed or root-owned after sudo service restart).
  local nginx_server_header
  nginx_server_header=$(curl -sI --max-time 2 http://127.0.0.1 2>/dev/null | grep -i '^Server:' | head -1) || true
  if echo "$nginx_server_header" | grep -qi nginx; then
    _chk_pass "nginx  running on port 80"
    # Config valid by definition when serving — sudo nginx -t can't run non-interactively
    _chk_pass "nginx config  valid (inferred — service is running)"
  else
    _chk_warn "nginx  not running"
    _fix "sudo brew services start nginx"
      # Only validate config when nginx is stopped — helps diagnose startup failures
      local nginx_t_rc=0
      sudo nginx -t >/dev/null 2>&1 || nginx_t_rc=$?
      if [[ $nginx_t_rc -eq 0 ]]; then
        _chk_pass "nginx config  valid (nginx stopped but config is clean)"
      elif [[ $nginx_t_rc -ne 126 ]]; then
        _chk_fail "nginx config  invalid"
        _fix "sudo nginx -t  (see errors above)"
      fi
  fi

  # mkcert local CA trusted in system keychain
  if command -v mkcert >/dev/null 2>&1; then
    local mkcert_root; mkcert_root=$(mkcert -CAROOT 2>/dev/null) || true
    if [[ -f "${mkcert_root}/rootCA.pem" ]]; then
      if security verify-cert -c "${mkcert_root}/rootCA.pem" >/dev/null 2>&1; then
        _chk_pass "mkcert CA  trusted in system keychain"
      else
        _chk_warn "mkcert CA  present but NOT trusted — HTTPS certs will show browser warnings"
        _fix "mkcert -install  (needs macOS password)"
      fi
    else
      _chk_warn "mkcert CA  not generated yet"
      _fix "mkcert -install"
    fi
    # TLS cert files present
    local brew_pfx; brew_pfx=$(brew --prefix 2>/dev/null) || brew_pfx="/opt/homebrew"
    local cert_file="${brew_pfx}/etc/nginx/certs/zdots-local.pem"
    if [[ -f "$cert_file" ]]; then
      _chk_pass "nginx TLS certs  present ($cert_file)"
    else
      _chk_warn "nginx TLS certs  missing"
      _fix "run bin/bootstrap  or: mkcert -cert-file ${cert_file} -key-file ${brew_pfx}/etc/nginx/certs/zdots-local-key.pem llama.local embed.local grafana.local lgtm.local o2.local my.local dev.my.local localhost 127.0.0.1"
    fi
  else
    _chk_warn "mkcert  not installed"
    _fix "brew install mkcert && mkcert -install"
  fi

  # /etc/hosts entries for nginx virtual hosts
  local _missing_hosts=""
  for _h in llama.local embed.local grafana.local; do
    grep -qF "$_h" /etc/hosts 2>/dev/null || _missing_hosts="$_missing_hosts $_h"
  done
  if [[ -z "$_missing_hosts" ]]; then
    _chk_pass "/etc/hosts  llama.local embed.local grafana.local all present"
  else
    _chk_warn "/etc/hosts  missing entries:${_missing_hosts}"
    for _h in $_missing_hosts; do
      _fix "sudo sh -c 'echo \"127.0.0.1 ${_h}\" >> /etc/hosts'"
    done
  fi
  unset _missing_hosts _h

  # ── AI router structural check (fast — no model call) ─────────────────────
  printf '\nAI router\n'
  local _ask="${ZDOTDIR}/bin/zdots-ask"
  local _quiz="${ZDOTDIR}/bin/zdots-quiz"
  local _prompts_dir="${ZDOTDIR}/etc/prompts"
  if [[ ! -x "$_ask" ]]; then
    _chk_fail "zdots-ask  not found or not executable: $_ask"
  else
    _chk_pass "zdots-ask  executable"
  fi
  local _missing_prompts=0
  for _d in default shell ruby phi; do
    if [[ ! -f "${_prompts_dir}/zdots-${_d}.md" ]]; then
      _chk_fail "prompt  zdots-${_d}.md missing"
      _missing_prompts=$(( _missing_prompts + 1 ))
    fi
  done
  if (( _missing_prompts == 0 )); then
    _chk_pass "prompts  all 4 domain prompts present"
  fi
  # Verify domain detection without hitting the model
  if [[ -x "$_ask" ]]; then
    local _det
    _det=$(ZDOTS_AI_MODE=none "${_ask}" --dry-run "write a ZLE widget" 2>/dev/null | grep '^.zdots-ask. domain=' | cut -d= -f2 | cut -d' ' -f1 || true)
    if [[ "$_det" == "shell" ]]; then
      _chk_pass "router  domain detection correct (shell detected for ZLE prompt)"
    else
      _chk_warn "router  domain detection returned '${_det:-empty}' for ZLE prompt (expected 'shell')"
    fi
  fi
  if [[ -x "$_quiz" ]]; then
    _chk_pass "zdots-quiz  executable (run 'zdots-quiz --quick' to probe model capability)"
  else
    _chk_warn "zdots-quiz  not found: $_quiz"
  fi

  # ── AI integration smoke test ──────────────────────────────────────────────
  printf '\nAI integration\n'
  local _llama_test="$ZDOTDIR/tests/llama_integration.rb"
  if ! command -v zdots-ruby >/dev/null 2>&1; then
    _chk_warn "zdots-ruby not in PATH — AI integration test skipped"
    _fix "ensure $ZDOTDIR/bin is in PATH"
  elif [[ ! -f "$_llama_test" ]]; then
    _chk_warn "AI integration test not found: $_llama_test"
  elif ! zdots-ruby -e 'require "ruby_llm"' >/dev/null 2>&1; then
    _chk_warn "ruby_llm gem not available — AI integration test skipped"
    _fix "cd $ZDOTDIR && bundle install"
  elif ! zdots_svc_healthy llama; then
    _chk_warn "AI integration test skipped (server not running)"
    _fix "zdots-ctl up"
  else
    # Wait for inference readiness before running the test — /health returning
    # OK does not mean the model has finished loading or that GPU memory is stable.
    local _infer_ready=false _infer_elapsed=0
    while (( _infer_elapsed < 30 )); do
      local _probe
      _probe=$(curl -s -m 10 "${AI_ENDPOINT}/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d '{"model":"local","messages":[{"role":"user","content":"hi"}],"max_tokens":1}' \
        2>/dev/null || true)
      if printf '%s' "$_probe" | grep -q '"content"'; then
        _infer_ready=true; break
      fi
      sleep 5; _infer_elapsed=$(( _infer_elapsed + 5 ))
    done
    unset _probe _infer_elapsed

    local _ai_out
    if ! $_infer_ready; then
      _chk_fail "AI integration  server up but inference not responding after 30s readiness wait"
      _fix "zsvc logs llama  (check for GPU OOM or startup errors)"
    elif _ai_out=$(timeout 90 zdots-ruby "$_llama_test" --quick 2>/dev/null); then
      _chk_pass "AI integration  chat (RubyLLM) + embeddings (embed server) verified"
    else
      _chk_fail "AI integration  RubyLLM × llama.cpp test failed"
      _fix "zdots-ruby $ZDOTDIR/tests/llama_integration.rb  (full output)"
    fi
  fi

  # ── OTel pipeline smoke test ───────────────────────────────────────────────
  printf '\nOTel pipeline\n'
  if _otel_up; then
    # Send a minimal OTLP payload; a 2xx response means the pipeline is accepting spans
    local otlp_code
    otlp_code=$(curl -s -o /dev/null -w '%{http_code}' -m 3 \
      -X POST "${OTLP_ENDPOINT}/v1/traces" \
      -H 'Content-Type: application/json' \
      -d '{"resourceSpans":[]}' 2>/dev/null || echo "000")
    if [[ "$otlp_code" == "200" ]]; then
      _chk_pass "OTLP endpoint  accepting spans ($OTLP_ENDPOINT/v1/traces)"
    elif zdots_svc_loopback_listening "$OTLP_ENDPOINT"; then
      _chk_pass "OTLP endpoint  listening on loopback ($OTLP_ENDPOINT)"
    else
      _chk_warn "OTLP endpoint  responded $otlp_code (expected 200)"
      _fix "otel-collector logs  — check for pipeline errors"
    fi
  else
    _chk_warn "OTLP pipeline  skipped (collector not running)"
    _fix "zdots-ctl up"
  fi

  # ── Trace file ────────────────────────────────────────────────────────────
  printf '\nShell traces\n'
  local trace_file="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/traces.jsonl"
  if [[ -f "$trace_file" ]]; then
    local line_count
    line_count=$(wc -l < "$trace_file" | tr -d ' ')
    _chk_pass "trace file  $trace_file ($line_count entries)"
  else
    _chk_warn "trace file  not found: $trace_file"
    _fix "open a new shell session to start tracing"
  fi

  # ── PHI audit log (darwin) ────────────────────────────────────────────────
  if [[ "$(uname -s)" == "Darwin" ]]; then
    printf '\nPHI audit log\n'
    local _audit_out
    _audit_out=$(log show --predicate 'subsystem == "com.zdots"' --last 24h --style compact 2>/dev/null | grep -v '^Filtering' | tail -1)
    if [[ -n "$_audit_out" ]]; then
      _chk_pass "unified log  entries present (last: ${_audit_out:0:80}...)"
    else
      _chk_warn "unified log  no com.zdots entries in last 24h (expected after shell activity)"
      _fix "log show --predicate 'subsystem == \"com.zdots\"' --last 24h"
    fi

    # Model hash integrity (if manifest exists)
    local _manifest="$ZDOTDIR/lib/llama-models.sha256"
    if [[ -f "$_manifest" ]]; then
      printf '\nModel provenance\n'
      local _models_dir="${ZDOTS_AI_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llama-cpp/models}"
      local _any_fail=0
      while IFS= read -r line; do
        [[ "$line" =~ ^# || -z "$line" ]] && continue
        local _hash _fname
        _hash=$(printf '%s' "$line" | awk '{print $1}')
        _fname=$(printf '%s' "$line" | awk '{print $2}')
        local _fpath="$_models_dir/$_fname"
        if [[ ! -f "$_fpath" ]]; then
          _chk_warn "model  $_fname not downloaded"
          continue
        fi
        local _actual; _actual=$(shasum -a 256 "$_fpath" | awk '{print $1}')
        if [[ "$_actual" == "$_hash" ]]; then
          _chk_pass "model  $_fname hash OK"
        else
          _chk_fail "model  $_fname SHA256 MISMATCH"
          _any_fail=1
        fi
      done < "$_manifest"
    fi
  fi

  # ── macOS security posture (darwin + ZDOTS_CONTEXT=work only) ────────────
  if [[ "$(uname -s)" == "Darwin" && "${ZDOTS_CONTEXT:-home}" == "work" ]]; then
    printf '\nmacOS security posture (ZDOTS_CONTEXT=work)\n'

    # FileVault — hard failure; disk encryption is a PHI prerequisite
    if fdesetup status 2>/dev/null | grep -q "FileVault is On"; then
      _chk_pass "FileVault  enabled"
    else
      _chk_fail "FileVault  NOT enabled — required for PHI work"
      _fix "sudo fdesetup enable"
      errors=$((errors + 1))
    fi

    # SIP — hard failure; kernel integrity is a PHI prerequisite
    if csrutil status 2>/dev/null | grep -q "enabled"; then
      _chk_pass "SIP  enabled"
    else
      _chk_fail "SIP  NOT enabled — required for PHI work"
      _fix "Boot to Recovery OS and run: csrutil enable"
      errors=$((errors + 1))
    fi

    # Application Firewall — warning; operator may have network-level controls
    local fw_state
    fw_state=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null || echo "unknown")
    if [[ "$fw_state" == *"enabled"* ]]; then
      _chk_pass "Application Firewall  enabled"
    else
      if [[ -z "${ZDOTS_SKIP_FIREWALL_CHECK:-}" ]]; then
        _chk_warn "Application Firewall  not enabled (set ZDOTS_SKIP_FIREWALL_CHECK=1 to suppress)"
        _fix "sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on"
      fi
    fi

    # PHI safety env vars
    if [[ "${ZDOTS_AI_MODE:-local}" == "local" || "${ZDOTS_AI_MODE:-local}" == "none" ]]; then
      _chk_pass "AI mode  ${ZDOTS_AI_MODE:-local} (no cloud endpoints)"
    else
      _chk_warn "AI mode  ${ZDOTS_AI_MODE} — cloud endpoints active on work machine"
    fi
    if [[ "${ZDOTS_CAPTURE_ENABLED:-0}" == "0" ]]; then
      _chk_pass "Capture  disabled (ZDOTS_CAPTURE_ENABLED=0)"
    else
      _chk_warn "Capture  ENABLED on work machine — ensure PHI scrubber and DB encryption are active"
    fi
    if [[ "${ZDOTS_HISTORY_REDACT:-1}" == "1" ]]; then
      _chk_pass "History redaction  enabled"
    else
      _chk_warn "History redaction  DISABLED on work machine (ZDOTS_HISTORY_REDACT=0)"
    fi

    # Secrets file should be absent — Keychain is the source of truth on macOS
    if [[ -f "${ZDOTDIR}/.zdots.secrets" ]]; then
      _chk_warn "Secrets file  .zdots.secrets still present — run: zdots-keychain migrate && zdots-keychain verify, then delete the file"
      warnings=$((warnings + 1))
    else
      _chk_pass "Secrets file  absent (Keychain-only mode)"
    fi

    # Encryption key reachable
    if [[ -n "${ZDOTS_DB_ENCRYPTION_KEY:-}" ]]; then
      _chk_pass "DB encryption key  present (${#ZDOTS_DB_ENCRYPTION_KEY} chars)"
    else
      _chk_fail "DB encryption key  ZDOTS_DB_ENCRYPTION_KEY not set — run: zdots-keychain add ZDOTS_DB_ENCRYPTION_KEY <value>"
      errors=$((errors + 1))
    fi
  fi

  # ── Summary ───────────────────────────────────────────────────────────────
  printf '\n'
  if [[ $errors -eq 0 && $warnings -eq 0 ]]; then
    printf 'zdots-ctl check: all checks passed\n'
  elif [[ $errors -eq 0 ]]; then
    printf 'zdots-ctl check: passed with %d warning(s)\n' "$warnings"
  else
    printf 'zdots-ctl check: %d failure(s), %d warning(s)\n' "$errors" "$warnings"
  fi

  zdots_trace_log "platform_check" "complete errors=$errors warnings=$warnings"
  [[ $errors -eq 0 ]]
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat <<EOF
Usage: zdots-ctl <command> [options]

Platform Lifecycle:
  up        Start all services in dependency order (idempotent)
  down      Stop all services cleanly (reverse dependency order)
  reset     down + up — full platform restart
  install   First-time setup: install binaries, register launchd agents, start

Diagnostics:
  check     Deep environment check — tools, configs, services, disk, OTel pipeline
  status    Live service status (quick)
  status --json  Same as JSON

Dependency order (up):
  1. Colima + LGTM stack  (local-ci start)
  2. otel-collector       (otel-collector start)
  3. AI server            (llama-ctl start)
  4. Embed server         (llama-ctl start-embed)

Readiness:
  zsvc list                       Verify service registration
  bats tests/platform_e2e.bats    Live branch-readiness suite
  docs/platform-service-plane.md  Lifecycle diagrams and isolation playbook

Environment:
  ZDOTS_BOOT_TIMEOUT   Seconds to wait per service health check (default: 90)
  ZDOTS_AI_ENDPOINT    AI server base URL (default: http://127.0.0.1:11500)

Options:
  -h, --help    Show this help
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
  up)        cmd_up ;;
  down)      cmd_down ;;
  reset)     cmd_reset ;;
  install)   cmd_install ;;
  check)     cmd_check ;;
  status)    shift; cmd_status "${@}" ;;
  -h|--help) usage; exit 0 ;;
  "")        usage >&2; exit 1 ;;
  *)         printf 'zdots-ctl: unknown command: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
