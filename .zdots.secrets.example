# .zdots.secrets.example — Template for sensitive environment variables
# Copy this to .zdots.secrets and fill in your tokens.
#
# DO NOT COMMIT .zdots.secrets TO VERSION CONTROL.
# The .gitignore in this repository is already configured to ignore it.

# 1. GitHub Tokens (Targeted)
# These allow you to use different tokens for different tools, reducing surface area.

# Used by Homebrew for API rate limits and some formulas.
# Permissions: metadata:read (minimum)
# export HOMEBREW_GITHUB_API_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Used by Mise to download plugins and bypass rate limits.
# Permissions: contents:read (minimum)
# export MISE_GITHUB_TOKEN="ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

# 2. General Fallback
# If neither of the above are set, you can set a general GITHUB_TOKEN.
# Many other tools (gh, git, etc.) will also pick this up.
# export GITHUB_TOKEN="ghp_zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"

# 3. Other Secrets
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."

# 4. Intelligence Suite (Postgres)
# Only required if your local setup needs specific credentials.
# export DATABASE_URL="postgresql://user:pass@localhost:5432/my"
