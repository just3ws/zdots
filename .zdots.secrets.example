# .zdots.secrets.example — Template for the Keychain-backed secrets loader.
#
# SETUP (fresh machine):
#   1. Copy this file to .zdots.secrets
#   2. Add your secrets to macOS Keychain:
#        zdots-keychain add VARNAME value
#   3. Verify: zdots-keychain verify
#
# Secrets are stored in the login Keychain under service "zdots".
# This file never contains literal values — safe to inspect, never commit .zdots.secrets.

_zdots_kc() { /usr/bin/security find-generic-password -s zdots -a "$1" -w 2>/dev/null; }

# GitHub tokens — add to Keychain when needed:
#   zdots-keychain add HOMEBREW_GITHUB_API_TOKEN ghp_...
#   zdots-keychain add GITHUB_TOKEN ghp_...
#   zdots-keychain add MISE_GITHUB_TOKEN ghp_...
# export HOMEBREW_GITHUB_API_TOKEN="$(_zdots_kc HOMEBREW_GITHUB_API_TOKEN)"
# export GITHUB_TOKEN="$(_zdots_kc GITHUB_TOKEN)"
# export MISE_GITHUB_TOKEN="$(_zdots_kc MISE_GITHUB_TOKEN)"

# AI API keys — add when ZDOTS_AI_MODE=cloud:
#   zdots-keychain add ANTHROPIC_API_KEY sk-ant-...
#   zdots-keychain add OPENAI_API_KEY sk-...
# export ANTHROPIC_API_KEY="$(_zdots_kc ANTHROPIC_API_KEY)"
# export OPENAI_API_KEY="$(_zdots_kc OPENAI_API_KEY)"

# MaxMind GeoIP:
# export MAXMIND_ACCOUNT_ID="$(_zdots_kc MAXMIND_ACCOUNT_ID)"
# export MAXMIND_LICENSE_KEY="$(_zdots_kc MAXMIND_LICENSE_KEY)"
# export MAXMIND_EDITION_IDS='GeoLite2-City GeoLite2-Country GeoLite2-ASN'

# HuggingFace:
# export HUGGINGFACE_TOKEN="$(_zdots_kc HUGGINGFACE_TOKEN)"

unset -f _zdots_kc
