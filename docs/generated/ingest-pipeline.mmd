flowchart TD
  queued([queued]) --> primed
  primed["primed — primer_text from title+description (local LLM filter)"]
  primed --> raw
  raw["raw — transcribe audio (whisper; chunk fan-out if long)"]
  raw --> cleaned
  cleaned["cleaned — apply known_terms corrections"]
  cleaned --> boundaries
  boundaries["boundaries — mark theme-song intro/outro + interview start/end (timestamped ASR)"]
  boundaries --> distilled
  distilled["distilled — LLM knowledge briefing (local, or scoped cloud)"]
  distilled --> timeline
  timeline["timeline — extract curated timeline of moments (LLM)"]
  timeline --> diarized
  diarized["diarized — acoustic speaker turns (pyannote; opt-in ZDOTS_DIARIZE)"]
  diarized --> embedded
  embedded["embedded — slice transcript into knowledge_chunks and embed (pgvector)"]
  embedded --> published
  published["published — auto-publish timeline clips to social APIs (FFmpeg)"]
  published --> done([done])
