{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.zdots.secrets)",
      "Read(./.zdots.secrets.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)"
    ],
    "allow": [
      "Bash(zsvc:*)",
      "Bash(zdots-ctl:*)",
      "Bash(zdots-doctor:*)",
      "Bash(zdots-ctx:*)",
      "Bash(zdots-index-tools:*)",
      "Bash(zdots-issue:*)",
      "Bash(zdots-ask:*)",
      "Bash(zdots-update-local:*)",
      "Bash(zdots-log-analyze:*)",
      "Bash(zdots-worker:*)",
      "Bash(colima-status:*)",
      "Bash(capabilities:*)",
      "Bash(agent-guide:*)",
      "Bash(ai-query:*)",
      "Bash(rtk:*)",
      "Bash(docker-reclaim:*)",
      "Bash(cc-doctor:*)",
      "Bash(llama-ctl:*)",
      "Bash(openobserve-ctl:*)",
      "Bash(otel-collector:*)",
      "Bash(otel-smoke:*)",
      "Bash(zdots-endpoints:*)",
      "Bash(graphify:*)",
      "Bash(mise:*)",
      "Bash(launchctl list:*)",
      "Bash(launchctl print:*)",
      "Bash(colima status:*)",
      "Bash(limactl list:*)",
      "Bash(nginx -t)",
      "Bash(psql:*)",
      "Bash(redis-cli ping:*)",
      "Bash(curl -sf http://127.0.0.1:*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(command -v:*)",
      "Bash(sh -n:*)",
      "Bash(zsh -n:*)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(bats:*)",
      "Bash(make check:*)",
      "Bash(make check-fast:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ast-grep:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh api:*)",
      "Bash(gh repo view:*)",
      "mcp__backlog__task_list",
      "mcp__backlog__task_view",
      "mcp__ctx__ctx_query",
      "mcp__ctx__ctx_status",
      "Read(~/.local/state/zsh/**)",
      "Read(~/.local/share/llama-cpp/models/**)",
      "Read(~/Library/LaunchAgents/**)",
      "Read(/opt/homebrew/etc/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/cc-hook-guard\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/cc-hook-lint\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/bin/cc-hook-session\"" }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR/bin/cc-statusline\""
  }
}
