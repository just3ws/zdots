# vim:ft=zsh

source "$HOME/.xdgrc"
source "$HOME/.editorrc"

export ZDOTDIR="$HOME/.config/zsh"
if [[ ! -d $ZDOTDIR ]] ; then
  mkdir -p "$ZDOTDIR"
fi

export ANDROID_SDK_ROOT='/usr/local/share/android-sdk'
export XML_CATALOG_FILES=/usr/local/etc/xml/catalog

export ARCHFLAGS='-arch x86_64'

export HOMEBREW_CASK_OPTS='--appdir=/Applications'
export HOMEBREW_GITHUB_API_TOKEN='8d9c345e648f16107c2c2e888fc3c9a2ce87e7a9'
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSECURE_REDIRECT=1

export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'
export LC_COLLATE='en_US.UTF-8'
export LC_CTYPE='en_US.UTF-8'
export LC_MESSAGES='en_US.UTF-8'
export LC_MONETARY='en_US.UTF-8'
export LC_NUMERIC='en_US.UTF-8'
export LC_TIME='en_US.UTF-8'

export JAVA_HOME='/Library/Java/JavaVirtualMachines/jdk-9.0.4.jdk/Contents/Home'
export MAVEN_OPTS='-Xms2048m -Xmx4096m -XX:PermSize=2048m'

export PERL5LIB='/usr/local/lib/perl5/site_perl':$PERL5LIB
export PERL_MB_OPT='--install_base "/Users/mike/perl5"'
export PERL_MM_OPT="INSTALL_BASE='$HOME/perl5'"

export PYTHONIOENCODING='UTF-8'
export PYENV_VIRTUALENV_DISABLE_PROMPT=1
export PYENV_SHELL=zsh
export PYENV_VIRTUALENV_INIT=1;

fpath=(
  $ZDOTDIR/functions/enabled/
  /usr/local/share/zsh-completions/
  $fpath
)

for fn in $ZDOTDIR/functions/enabled/*(.x); do
  autoload -Uz "$(basename $fn)"
done

rbenv () {
  local command
  command="$1"
  if [ "$#" -gt 0 ]
  then
    shift
  fi
  case "$command" in
    (rehash | shell | use) eval "$(rbenv "sh-$command" "$@")" ;;
    (*) command rbenv "$command" "$@" ;;
  esac
}

source '/usr/local/Cellar/pyenv/1.2.2/libexec/../completions/pyenv.zsh'
command pyenv rehash 2>/dev/null

_pyenv_virtualenv_hook () {
  local ret=$?
  if [ -n "$VIRTUAL_ENV" ]; then
    eval "$(pyenv sh-activate --quiet || pyenv sh-deactivate --quiet || true)" || true
  else
    eval "$(pyenv sh-activate --quiet || true)" || true
  fi
  return $ret
};

typeset -g -a precmd_functions
if [[ -z $precmd_functions[(r)_pyenv_virtualenv_hook] ]]; then
  precmd_functions=(_pyenv_virtualenv_hook $precmd_functions);
fi

pyenv () {
  local command
  command="$1"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$command" in
  rehash|shell)
    eval "$(pyenv "sh-$command" "$@")";;
  *)
    command pyenv "$command" "$@";;
  esac
}

path=(
  /usr/local/opt/rbenv/shims
  $HOME/.pyenv/shims
  $HOME/.pyenv/plugins/pyenv-virtualenv/shims
  /usr/local/{bin,sbin}
  /usr/{bin,sbin}
  /{bin,sbin}
  $path
)

typeset -gU cdpath fignore fpath mailpath path
