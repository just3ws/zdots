brew "jq"
brew "k6"
brew "lazygit"
brew "litecli"      # SQLite REPL with autocomplete
brew "llama.cpp"    # local inference — no data leaves machine
brew "lnav"
brew "lua-language-server"
brew "luacheck"
brew "luarocks"
brew "mactop"
brew "mkcert"
brew "mermaid-cli"
brew "usage"
brew "mise"
brew "mmv"
brew "mysql-client"
brew "ncdu"
brew "tree-sitter"
brew "neovim"
brew "nginx"          # local reverse proxy — TLS via mkcert
                      # NOTE: start with launchctl, NOT brew services (brew services takes root ownership):
                      #   sudo launchctl load /Library/LaunchDaemons/homebrew.mxcl.nginx.plist
brew "nvtop"
brew "ollama"         # local inference — no data leaves machine
brew "openai-whisper" # local speech recognition — weights run on-device
brew "openapi"
brew "openjdk"
brew "openapi-diff"
brew "openapi-generator"
brew "openapi-tui"
brew "ossp-uuid"
brew "otel-cli"
brew "pandoc"
brew "pgcli"        # PostgreSQL REPL with autocomplete
brew "pgvector"
brew "pipx"
brew "pnpm"
brew "postgresql@18", restart_service: :changed
brew "powerlevel10k"
brew "pre-commit"
brew "prettier"
brew "pv"
brew "ranger"
brew "redis", restart_service: :changed
brew "rename"
brew "repomix"
brew "ripgrep"
brew "rsync"
brew "rtk"        # token optimization for local LLM workflows
brew "ruby-lsp"
brew "rustup"
brew "sd"
brew "sqlite-utils" # CLI analytics on SQLite
brew "sentry-cli"
brew "sesh"
brew "shfmt"
