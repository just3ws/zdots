cask "rectangle"
cask "slack"
cask "stats"
cask "tailscale-app"
cask "vimr"
cask "visual-studio-code"
cask "zoom"

vscode "github.copilot-chat"

uv "aider-chat"   # LLM coding assistant — configurable to local endpoints

