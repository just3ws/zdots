# Brewfile.work — work machine configuration
#
# Install: brew bundle --file=Brewfile.work
#
# Excludes vs Brewfile (home):
#   - AI desktop apps and CLI agents (Claude, ChatGPT, Codex, Gemini, Kimi,
#     fabric-ai, aider, itermai) — not cleared for work yet
#   - Local inference (llama.cpp, ollama, whisper variants)
#   - Deployment platforms (railway, flyctl)
#   - Personal/entertainment (deezer, antigravity, yt-dlp, gource, julia,
#     vimr, ungoogled-chromium, libreoffice)
#   - Zdots-specific personal tooling (rtk, models tap, taproom, gogcli)

tap "bysiber/cleardisk"
tap "dracula/install"
tap "romkatv/powerlevel10k"
tap "supabase/tap"

brew "ack"
brew "act"
brew "shellcheck"
brew "actionlint"
brew "ansifilter"
brew "openssl@3"
brew "tmux"
brew "aoe"
