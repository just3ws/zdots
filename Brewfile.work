brew "atuin"
brew "sqlite"
brew "node"
brew "backlog-md"
brew "bash"
brew "bat"
brew "bats-core"
brew "bandwhich"    # network traffic per process — verify AI local-only boundary at OS level
brew "bottom"
brew "boxes"
brew "broot"
brew "btop"
brew "librsvg"
brew "chafa"
brew "cmake"
brew "colima"
brew "coreutils"
brew "csvlens"
