# gh-dash is a gh extension, not a Homebrew formula: gh extension install dlvhdr/gh-dash
brew "git-cliff"
brew "lazydocker"
# otelcol-contrib is intentionally absent — custom binary managed by
# bin/otel-collector install (not available via Homebrew)
brew "arimxyer/tap/models"    # local model management

cask "1password"
cask "1password-cli"
cask "alfred"
cask "bysiber/cleardisk/cleardisk"
cask "cmux"
cask "daisydisk"
cask "dash"
cask "dbeaver-community"
cask "dracula/install/dracula-terminal"
cask "dracula/install/dracula-xcode"
cask "firefox"
cask "font-fira-code-nerd-font"
cask "font-meslo-lg-nerd-font"
