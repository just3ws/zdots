# Brewfile.work — work machine configuration
#
# Install: brew bundle --file=Brewfile.work
#
# Principle: tools that run locally or can be pointed at local endpoints
#            are fine. Excluded = the product IS the cloud service
#            (ChatGPT, Claude app, Gemini, railway, flyctl, etc.) or is
#            purely personal (deezer, antigravity, gource, julia).
#
# To add a tool when cleared, uncomment from the "pending" section below
# or add it here directly.

tap "arimxyer/tap"            # local AI model management
tap "bysiber/cleardisk"
tap "dracula/install"
tap "romkatv/powerlevel10k"
tap "supabase/tap"

brew "ack"
brew "act"
brew "shellcheck"
brew "actionlint"
brew "ansifilter"
brew "openssl@3"
brew "tmux"
brew "aoe"
brew "ast-grep"
brew "atuin"
brew "sqlite"
brew "node"
brew "backlog-md"
brew "bash"
brew "bat"
brew "bats-core"
brew "bandwhich"    # network traffic per process — verify AI local-only boundary at OS level
brew "bottom"
brew "boxes"
brew "broot"
brew "btop"
brew "librsvg"
brew "chafa"
brew "cmake"
brew "colima"
brew "coreutils"
brew "csvlens"
brew "curl"
brew "dasel"
brew "dashing"
brew "diff-so-fancy"
brew "direnv"
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "docker-compose-langserver"
brew "entr"
brew "eza"
brew "fabric-ai"  # LLM pipeline tool — configurable to local endpoints
brew "fd"
brew "fdupes"
brew "fish"
brew "fswatch"
brew "fx"
brew "fzf"
brew "geoipupdate"
brew "gh"
brew "git"
brew "git-absorb"
brew "git-delta"
brew "git-lfs"
brew "gitleaks"
brew "gitlint"
brew "glow"
brew "gnupg"
brew "go"
brew "graphicsmagick"
brew "graphviz"
brew "grep"
brew "hadolint"
brew "htop"
brew "hyperfine"
