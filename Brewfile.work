brew "trivy"
brew "trufflehog"
brew "universal-ctags"
brew "uv"
brew "visidata"     # TUI spreadsheet for SQLite/PostgreSQL
brew "vivid"
brew "watch"
brew "watchexec"
brew "wget"
brew "whisper-cpp"    # local speech recognition — runs on-device
brew "whisperkit-cli" # local speech recognition — runs on-device
brew "xcodegen"
brew "xmlstarlet"
brew "yamllint"
brew "yarn"
brew "yq"
brew "yt-dlp"     # media ingestion — feeds local Whisper pipelines
brew "zoxide"
brew "zsh"
brew "zsh-autopair"
brew "zsh-autosuggestions"
brew "zsh-completions"
brew "zsh-history-enquirer"
brew "zsh-history-substring-search"
brew "zsh-syntax-highlighting"
brew "zsh-vi-mode"
brew "zsh-you-should-use"
