# Brewfile.work — work machine configuration.
#
# Install: brew bundle --file=Brewfile.work
# Shared core lives in Brewfile.common (included below).
#
# Principle: tools that run locally or point at local endpoints are fine.
# Excluded = the product IS the cloud service, or is purely personal.
# Claude is cleared for work (home/work parity); PHI deny-list + cc-hook-guard apply.

instance_eval(File.read(File.expand_path("Brewfile.common", File.dirname(__FILE__))))

# ── work-only packages ──
tap "hashicorp/tap"           # Terraform and other HashiCorp tools

                      # NOTE: start with launchctl, NOT brew services (brew services takes root ownership):
                      #   sudo launchctl load /Library/LaunchDaemons/homebrew.mxcl.nginx.plist
# gh-dash is a gh extension, not a Homebrew formula: gh extension install dlvhdr/gh-dash
# otelcol-contrib is intentionally absent — custom binary managed by
# bin/otel-collector install (not available via Homebrew)

cask "openvpn-connect"   # corporate VPN client — network access to work infrastructure

vscode "github.copilot-chat"

uv "aider-chat"   # LLM coding assistant — configurable to local endpoints

npm "@earendil-works/pi-coding-agent"

# OpenCode — terminal agentic coding seat (homebrew-core). Seated in the synod
# per committed P18; drive it via `zopencode` (pinned to the local llama.cpp
# endpoint, PHI guard parity). Principal-evaluated; pi stays the lightweight seat.

# Claude — cleared for work; home/work parity (mirrors Brewfile.home).
# Provides the cl/claude CLI used as the zsynod frontier seat, plus the
# desktop suite. Local-LLM defaults and the PHI deny-list still apply.
vscode "saoudrizwan.claude-dev"

# ---------------------------------------------------------------------------
# AWS — work infrastructure tooling
# ---------------------------------------------------------------------------
# Work-only. Excluded from Brewfile.home: no personal AWS footprint, and
# mixing org-specific configs (default profiles, account IDs, regions) with
# a personal machine creates credential-leak and audit-trail risk.
#
# Credential discipline is doubled here because PHI in healthcare stacks
# typically lives in AWS services (S3, RDS, Secrets Manager). The tools
# below are CLI/local only — no cloud desktop apps.

brew "awscli"
# Primary AWS CLI v2. Everything else in this section depends on it.
# Config lives in ~/.aws/config (profiles only, no keys); keys are managed
# by aws-vault (see below). Region + output format: set per-profile.

brew "aws-vault"
# Stores AWS credentials in macOS Keychain — never in ~/.aws/credentials
# plaintext. On a PHI-adjacent machine this is non-negotiable. Usage:
#   aws-vault add <profile>         # store creds (once)
#   aws-vault exec <profile> -- aws s3 ls
# Pairs with `granted` for SSO workflows.

brew "granted"
# Multi-account credential switching for SSO/IdC workloads. Replaces manual
# `export AWS_PROFILE=...` juggling across accounts and regions. Integrates
# with aws-vault backend; pops a browser for SSO login, caches session.
#   assume <profile>                # switch active profile in current shell
#   assume --sso                    # trigger SSO login flow

cask "session-manager-plugin"
# Required for `aws ssm start-session` to reach EC2/ECS tasks without open
# SSH ports. PHI-safe: encrypted channel, no inbound firewall rules, all
# sessions logged to CloudTrail automatically. Install this and you never
# need a bastion host or SSH key distribution for operational access.
#   aws ssm start-session --target i-0abc123          # shell on EC2
#   aws ssm start-session --target i-0abc123 \        # port-forward RDS
#     --document-name AWS-StartPortForwardingSession \
#     --parameters '{"portNumber":["5432"],"localPortNumber":["5432"]}'

brew "cfn-lint"
# CloudFormation template linter. Catches syntax errors, deprecated resource
# properties, and missing fields before deploy. Also flags common PHI-risk
# misconfigurations: missing S3 encryption, public bucket ACLs, unencrypted
# RDS. Run as a pre-commit hook or in CI.
#   cfn-lint template.yaml          # lint a template
#   cfn-lint **/*.yaml --format json | jq .

brew "checkov"
# IaC security scanner for Terraform, CloudFormation, and CDK. Runs ~1000
# built-in policies; particularly useful for flagging PHI-relevant risks:
# unencrypted S3/RDS/DynamoDB, public-access settings, missing KMS keys,
# overly permissive IAM. Integrates with pre-commit and CI.
#   checkov -d infra/               # scan a directory of TF/CFN files
#   checkov -f template.yaml --framework cloudformation

brew "terraform"
# Industry-standard IaC tool. Work-only because personal infrastructure uses
# managed platforms with no Terraform footprint. Use with aws-vault:
#   aws-vault exec <profile> -- terraform plan
# State should live in a remote backend (S3 + DynamoDB lock), never locally.

