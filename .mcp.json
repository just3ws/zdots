{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "backlog": {
      "type": "stdio",
      "command": "backlog",
      "args": ["mcp", "start"],
      "env": {}
    },
    "ctx": {
      "type": "stdio",
      "command": "${HOME}/.config/zsh/bin/ctx-mcp",
      "env": {
        "ZDOTDIR": "${HOME}/.config/zsh"
      }
    },
    "llama": {
      "type": "stdio",
      "command": "${HOME}/.config/zsh/bin/llama-mcp",
      "env": {
        "ZDOTDIR": "${HOME}/.config/zsh",
        "ZDOTS_AI_ENDPOINT": "http://127.0.0.1:11500",
        "PATH": "${HOME}/.config/zsh/bin:${HOME}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "ccusage": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@ccusage/mcp@latest"],
      "env": {
        "PATH": "${HOME}/.config/zsh/bin:${HOME}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {
        "PATH": "${HOME}/.config/zsh/bin:${HOME}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "o2": {
      "type": "stdio",
      "command": "${HOME}/.config/zsh/bin/o2-mcp",
      "env": {
        "ZDOTDIR": "${HOME}/.config/zsh"
      }
    }
  }
}
