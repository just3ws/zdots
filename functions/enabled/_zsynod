#compdef zsynod
# Completion for zsynod — the AI collaborators' forum.

_zsynod() {
  local -a subs
  subs=(
    'init:seed roster + genesis'
    'members:list members and lanes'
    'status:round, chair, open proposals + tallies'
    'chair:show the current rotating chair'
    'propose:open a proposal'
    'speak:contribute to discussion'
    'second:lightweight concur (counts as aye)'
    'vote:cast aye|nay|abstain'
    'commit:stamp committed iff quorum'
    'ratify:principal-authority commit (--as mike)'
    'handoff:record a handoff to a member'
    'committee:form a named special committee'
    'committees:list named special committees'
    'log:show ledger entries'
    'minutes:regenerate minutes.md'
    'view:regenerate + display the minutes'
    'history:chronological discussion record over time (optional Z-NNN/P# filter)'
    'tick:one deliberation turn over a backlog issue (pi; --frontier adds codex+gemini)'
    'ask:pose a question to the forum'
    'tail:tail a member transcript'
    'console:interactive principal cockpit'
    'verify:re-walk the hash chain'
    'convene:open the tmux forum room (singleton)'
    'attach:attach to the convened room'
    'goto:jump to a seat window'
    'room:list the room windows'
    'adjourn:close the forum (transcripts kept)'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'zsynod command' subs
    return
  fi
  _arguments \
    '--as[act as member]:member:(claude gemini codex antigravity pi aider mike)' \
    '--body[proposal body]:text' \
    '--round[round number]:n' \
    '--note[vote note]:text' \
    '--to[handoff receiver]:member:(claude gemini codex antigravity pi aider)' \
    '--task[handoff task]:text' \
    '--state[handoff state]:text' \
    '--ref[proposal reference]:id' \
    '--purpose[committee purpose]:text' \
    '--session[named session or committee id]:id' \
    '--participants[comma-separated participants]:members' \
    '--frontier[use frontier participants]' \
    '--topic[backlog issue id for a deliberation tick]:id' \
    '--meeting[meeting type]:type' \
    '--json[machine-readable log]' \
    '(-f --follow)'{-f,--follow}'[follow transcript (tail -f)]' \
    '(-n --lines)'{-n,--lines}'[transcript lines]:n' \
    '(-h --help)'{-h,--help}'[show help]'
}

_zsynod "$@"
