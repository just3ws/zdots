#!/usr/bin/env zsh
# upgrade-mise — Ensure mise runtimes match global config.
# Dynamically installs/updates based on ~/.config/mise/config.toml

setopt localoptions errexit pipefail
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"

run_cmd() {
  print -r -- "+ $*"
  [[ "$dry_run" == "1" ]] && return 0
  "$@"
}

if command -v mise >/dev/null 2>&1; then
  echo "Updating mise runtimes..."

  # 1. mise self-update if not brew-managed
  if command -v brew >/dev/null 2>&1; then
    if ! brew list mise >/dev/null 2>&1; then
      run_cmd mise self-update || true
    fi
  else
    run_cmd mise self-update || true
  fi

  # 2. Install all tools defined in global/local configs
  # This will ensure ruby@3.4.8 and others are present
  run_cmd mise install

  # 3. Prune old versions
  run_cmd mise prune --yes
fi
