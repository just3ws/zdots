#!/usr/bin/env zsh

local option="$1"

if [ -z "$option" ]
then
  wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" cd
  return $?
fi

case "$option" in
  (ac*)
    wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" cd actions
    ;;
  (bi*)
    wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" cd binder
    ;;
  (co*)
    wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" cd core
    ;;
  (da*)
    wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" cd dashboard
    ;;
  (op*)
    wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" cd ops
    ;;
  (drop*) 
    if [[ ! -z "$HOME/Dropbox/mike/projects/wwworkremote/" ]]; then 
      mkdir -p "$HOME/Dropbox/mike/projects/wwworkremote/"
    fi

    cd "$HOME/Dropbox/mike/projects/wwworkremote/"
    ;;
  (bbi) w3r-all-do 'bundle check || bundle install' ;;
  (bbu) w3r-all-do 'bundle update' ;;
  (ppi) w3r-all-do 'pip install -r requirements.txt' ;;
  (ppu) w3r-all-do 'pip install -U -r requirements.txt' ;;
  (gfa) w3r-all-do 'git fetch --all --prune --verbose' ;;
  (gbr) w3r-all-do 'git rev-parse --abbrev-ref head' ;;
  (ggc) w3r-all-do 'git gc --aggressive' ;;
  (gpu) w3r-all-do 'git pull --rebase --autostash' ;;
  (gss|status) w3r-all-do 'git status --short' ;;
  (rc)
    wsp w3r "$W3RPATH" "$W3RPATH/.w3rrc" "$HOME/.local/share/w3r-all-do/history" rc
    ;;
  (*) echo
    echo "No args will \`cd\` to the $W3RPATH."
    echo
    echo "actions   => cd \"$W3RPATH/actions/\""
    echo "binder    => cd \"$W3RPATH/binder/\""
    echo "core      => cd \"$W3RPATH/core/\""
    echo "dashboard => cd \"$W3RPATH/dashboard/\""
    echo "ops       => cd \"$W3RPATH/ops/\""
    echo "dropbox   => cd \"$HOME/Dropbox/mike/projects/wwworkremote/\""
    echo "rc        => cat \"$W3RPATH/.w3rrc\""
    echo
    echo "bbi       => w3r-all-do 'bundle check || bundle install'"
    echo "bbu       => w3r-all-do 'bundle update'"
    echo "ppi       => w3r-all-do 'pip install -r requirements.txt'"
    echo "ppu       => w3r-all-do 'pip install -U -r requirements.txt'"
    echo "gfa       => w3r-all-do 'git fetch --all --prune --verbose'"
    echo "gbr       => w3r-all-do 'git rev-parse --abbrev-ref head'"
    echo "ggc       => w3r-all-do 'git gc --aggressive'"
    echo "gpu       => w3r-all-do 'git pull --rebase --autostash'"
    echo "gss       => w3r-all-do 'git status --short'"
    echo
    echo "I don't know what to do with: '$@'"
    echo
    return 1 ;;
esac

return 0
