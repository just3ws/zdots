#!/usr/bin/env zsh

/usr/local/bin/pip3 install --no-cache-dir --upgrade pip
/usr/local/bin/pip3 install --no-cache-dir --upgrade setuptools
/usr/local/bin/pip3 install --no-cache-dir --upgrade wheel
/usr/local/bin/pip3 install --no-cache-dir --upgrade neovim
/usr/local/bin/pip3 install --no-cache-dir --upgrade jedi
/usr/local/bin/pip3 install --no-cache-dir --upgrade solargraph-utils.py

while read pip ; do
  /usr/local/bin/pip3 install --no-cache-dir --upgrade "$pip"
done < <(cat $HOME/.config/upgrade/pip3)

