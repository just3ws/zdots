#compdef zai
# Completion for zai — the engine router. Engine flags are mutually exclusive
# and self-describing; the rest of the line is the free-text task.

_zai() {
  _arguments -s \
    '(- *)'{-h,--help}'[show help]' \
    '(--apple --pi --aider)--local[local llama.cpp via zdots-ask (default)]' \
    '(--local --pi --aider)--apple[zapfel — Apple on-device model, quick text]' \
    '(--local --apple --aider)--pi[zpi — explore / read / plan]' \
    '(--local --apple --pi)--aider[zaider — edit / patch / commit]' \
    '--dry-run[print the routing decision; run nothing]' \
    '*:task:'
}

_zai "$@"
