#!/usr/bin/env zsh

# Scoped options for function only (won't exit your interactive shell).
setopt localoptions errexit pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "cleanup-homebrew: brew not found, skipping." >&2
  return 0
fi

brew autoremove
brew cleanup --prune=all
brew cleanup -s
