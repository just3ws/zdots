#!/usr/bin/env zsh

set -euo pipefail

aggressive_upgrade="${ZDOTS_HOMEBREW_AGGRESSIVE:-0}"
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"

run_cmd() {
  print -r -- "+ $*"
  if [[ "$dry_run" == "1" ]]; then
    return 0
  fi
  "$@"
}

run_cmd brew update --verbose

if [[ "$aggressive_upgrade" == "1" ]]; then
  run_cmd brew upgrade --greedy --verbose
else
  run_cmd brew upgrade --verbose
fi

if [[ -f "$ZDOTDIR/Brewfile" ]]; then
  if [[ "$dry_run" == "1" ]]; then
    run_cmd brew bundle check --file "$ZDOTDIR/Brewfile"
    run_cmd brew bundle --file "$ZDOTDIR/Brewfile"
  else
    run_cmd brew bundle check --file "$ZDOTDIR/Brewfile" || run_cmd brew bundle --file "$ZDOTDIR/Brewfile"
  fi
fi

run_cmd cleanup-homebrew
