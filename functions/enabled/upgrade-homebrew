#!/usr/bin/env zsh

# Scoped options for function only (won't exit your interactive shell).
setopt localoptions errexit pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'EOF'
Usage: upgrade-homebrew

Update Homebrew metadata, upgrade packages, reconcile the selected Brewfile,
and run cleanup-homebrew.

Environment:
  ZDOTS_CONTEXT=home|work         Selects Brewfile.home or Brewfile.work
  HOMEBREW_BUNDLE_FILE=path      Custom bundle override
  ZDOTS_UPGRADE_DRY_RUN=1        Print phases and commands without execution
  ZDOTS_HOMEBREW_AGGRESSIVE=1    Use brew upgrade --greedy
  ZDOTS_LOG_DIR=path             Override transcript directory

Logs:
  ${XDG_STATE_HOME:-~/.local/state}/zsh/upgrade-homebrew-*.log
  ${XDG_STATE_HOME:-~/.local/state}/zsh/upgrade-homebrew-*.summary.md

Diagnostics:
  zdots-log-analyze upgrade
  zdots-log-analyze upgrade --ai
EOF
  return 0
fi

aggressive_upgrade="${ZDOTS_HOMEBREW_AGGRESSIVE:-0}"
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"
run_id="$(date '+%Y%m%dT%H%M%S')-$$"
log_dir="${ZDOTS_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zsh}"
mkdir -p "$log_dir"
log_file="${ZDOTS_UPGRADE_HOMEBREW_LOG:-$log_dir/upgrade-homebrew-${run_id}.log}"
summary_file="${log_file%.log}.summary.md"
latest_log="$log_dir/upgrade-homebrew-latest.log"
ln -sf "$log_file" "$latest_log" 2>/dev/null || true
phase_index=0
phase_total=6
current_phase="preflight"

case "${ZDOTS_CONTEXT:-home}" in
  work) brewfile="$ZDOTDIR/Brewfile.work" ;;
  *)    brewfile="$ZDOTDIR/Brewfile.home" ;;
esac
case "${HOMEBREW_BUNDLE_FILE:-}" in
  ""|"$ZDOTDIR/Brewfile"|"$ZDOTDIR/Brewfile.home"|"$ZDOTDIR/Brewfile.work") ;;
  *) brewfile="$HOMEBREW_BUNDLE_FILE" ;;
esac

timestamp() {
  date '+%Y-%m-%dT%H:%M:%S%z'
}

log_msg() {
  print -r -- "$(timestamp) upgrade-homebrew: $*" | tee -a "$log_file"
}

summary_msg() {
  print -r -- "$*" >> "$summary_file"
}

phase() {
  phase_index=$((phase_index + 1))
  current_phase="$1"
  print -r -- ""
  print -r -- "==> upgrade-homebrew phase ${phase_index}/${phase_total}: ${current_phase}" | tee -a "$log_file"
  summary_msg "- phase ${phase_index}/${phase_total}: ${current_phase}"
}

{
  print -r -- "# upgrade-homebrew run"
  print -r -- "- started: $(timestamp)"
  print -r -- "- log: $log_file"
  print -r -- "- latest: $latest_log"
  print -r -- "- context: ${ZDOTS_CONTEXT:-home}"
  print -r -- "- brewfile: $brewfile"
  print -r -- "- dry_run: $dry_run"
  print -r -- "- aggressive: $aggressive_upgrade"
} > "$summary_file"
log_msg "run_id=$run_id log=$log_file summary=$summary_file brewfile=$brewfile dry_run=$dry_run aggressive=$aggressive_upgrade"

run_cmd() {
  log_msg "run: $*"
  if [[ "$dry_run" == "1" ]]; then
    log_msg "dry-run: skipped execution"
    return 0
  fi
  "$@" 2>&1 | tee -a "$log_file"
  local cmd_status=$pipestatus[1]
  if [[ "$cmd_status" == "0" ]]; then
    log_msg "ok: $*"
  else
    log_msg "failed status=$cmd_status command=$*"
  fi
  return "$cmd_status"
}

brewfile_has() {
  [[ -f "$brewfile" ]] && grep -Eq "^[[:space:]]*${1}" "$brewfile"
}

trust_declared_homebrew_targets() {
  command -v brew >/dev/null 2>&1 || return 0
  brew trust --help >/dev/null 2>&1 || return 0

  local -a formulae casks
  formulae=()
  casks=()

  brewfile_has 'brew "arimxyer/tap/models"' && formulae+=(arimxyer/tap/models)
  brewfile_has 'brew "gromgit/brewtils/taproom"' && formulae+=(gromgit/brewtils/taproom)
  brewfile_has 'brew "powerlevel10k"' && formulae+=(romkatv/powerlevel10k/powerlevel10k)

  brewfile_has 'cask "bysiber/cleardisk/cleardisk"' && casks+=(bysiber/cleardisk/cleardisk)
  brewfile_has 'cask "dracula/install/dracula-terminal"' && casks+=(dracula/install/dracula-terminal)
  brewfile_has 'cask "dracula/install/dracula-xcode"' && casks+=(dracula/install/dracula-xcode)

  (( $#formulae )) && run_cmd brew trust --formula "${formulae[@]}"
  (( $#casks )) && run_cmd brew trust --cask "${casks[@]}"
}

export HOMEBREW_REQUIRE_TAP_TRUST=1

phase "brew trust: allow selected non-core dependencies"
trust_declared_homebrew_targets

phase "brew metadata: update formula and cask indices"
run_cmd brew update --verbose

phase "brew packages: upgrade installed formulae"
if [[ "$aggressive_upgrade" == "1" ]]; then
  run_cmd brew upgrade --greedy --verbose
else
  run_cmd brew upgrade --verbose
fi

phase "bundle: reconcile selected Brewfile"
if [[ -f "$brewfile" ]]; then
  if [[ "$dry_run" == "1" ]]; then
    run_cmd brew bundle check --file "$brewfile"
    run_cmd brew bundle --file "$brewfile"
  else
    run_cmd brew bundle check --file "$brewfile" || run_cmd brew bundle --file "$brewfile"
  fi
else
  log_msg "warning: selected Brewfile missing: $brewfile"
fi

phase "cleanup: remove stale Homebrew artifacts"
run_cmd cleanup-homebrew

phase "handoff: log location for Pi/HI analysis"
log_msg "complete status=0 log=$log_file summary=$summary_file"
summary_msg "- result: complete"
summary_msg "- handoff: feed summary first, then transcript log"
