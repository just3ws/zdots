#!/usr/bin/env zsh
# upgrade-rust — Update Rust toolchain and global cargo binaries.

setopt localoptions errexit pipefail
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"

run_cmd() {
  print -r -- "+ $*"
  [[ "$dry_run" == "1" ]] && return 0
  "$@"
}

if command -v rustup >/dev/null 2>&1; then
  echo "Updating Rust toolchain..."
  run_cmd rustup update
fi

if command -v cargo >/dev/null 2>&1; then
  if command -v cargo-install-update >/dev/null 2>&1; then
    echo "Updating global cargo binaries..."
    run_cmd cargo install-update -a
  else
    echo "Tip: Install 'cargo-update' to automate global binary updates."
  fi
fi
