#compdef zdots-ctl
# Completion for zdots-ctl — full-platform orchestration.

_zdots-ctl() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a cmds
  cmds=(
    'check:deep health diagnostic — run first when something is wrong'
    'status:live status of all services'
    'up:start everything in dependency order'
    'down:stop everything cleanly'
    'reset:full restart (down then up)'
    'install:first-time setup on a new workstation'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[show usage]' \
    '1:command:->cmd' \
    '*::arg:->args'

  case "$state" in
    cmd) _describe -t commands 'zdots-ctl command' cmds ;;
  esac
}

_zdots-ctl "$@"
