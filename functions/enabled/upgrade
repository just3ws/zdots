#!/usr/bin/env zsh
# upgrade — Master Orchestrator for Rolling System Upgrades.
# Central entry point for all sub-upgrade modules.

# Use localoptions so errexit doesn't leak to the interactive shell.
setopt localoptions pipefail

# Track status for summary
typeset -A module_status

# 1. Message Helper (Consistent UI)
message () {
  local text="$1"
  local boxes_bin
  boxes_bin="$(command -v boxes 2>/dev/null)"
  echo
  if [[ -n "$boxes_bin" ]]; then
    echo " $text" | "$boxes_bin" -d shell
  else
    echo "=== $text ==="
  fi
  echo
}

# 2. Execution Helper
run_upgrade_module() {
  local module="$1"
  local name="$2"
  
  # Ensure the function is autoloaded if it exists in fpath
  autoload -Uz "$module" 2>/dev/null || true
  
  if (( $+functions[$module] )); then
    message "$name"
    # Run the module and capture exit code without crashing the orchestrator
    if "$module"; then
      module_status[$name]="OK"
    else
      module_status[$name]="FAILED"
      echo "Error: $name failed with exit code $?" >&2
    fi
  else
    echo "Skipping $name (module $module not found)"
    module_status[$name]="SKIPPED"
  fi
}

message 'UPGRADE START'

# 3. Core System & Infrastructure
run_upgrade_module "upgrade-homebrew" "HOMEBREW & CASKS"
run_upgrade_module "upgrade-macos"    "MACOS SYSTEM"

# 4. Runtimes & Toolchains
run_upgrade_module "upgrade-mise"     "MISE RUNTIMES"
run_upgrade_module "upgrade-rust"     "RUST/CARGO"
run_upgrade_module "upgrade-node"     "NODE/PNPM GLOBALS"

# 5. AI & Special Tools
run_upgrade_module "upgrade-ai"       "AI AGENTS & MODELS"

# 6. Repo Maintenance
run_upgrade_module "upgrade-repo"     "REPO HYGIENE"

# 7. Summary Report
echo
message 'UPGRADE SUMMARY'
for name in "${(k)module_status[@]}"; do
  printf "%-25s : %s\n" "$name" "$module_status[$name]"
done

message 'UPGRADE DONE'

