#!/usr/bin/env zsh

echo
echo ' UPGRADE START' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

echo
echo ' HOMEBREW' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

brew upgrade
brew cleanup
brew prune

echo
echo ' MACOS' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

mas upgrade

echo
echo ' RUBY' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

/usr/local/bin/gem update --system
/usr/local/bin/gem install bundler --pre
/usr/local/bin/gem install neovim

while read gem ; do
  /usr/local/bin/gem install "$gem" --force
done < <(cat $HOME/.defaults/gems)

/usr/local/bin/gem update

echo
echo ' PYTHON2' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

/usr/local/bin/pip2 install pip setuptools --upgrade
/usr/local/bin/pip2 install neovim --upgrade

while read pip ; do
  /usr/local/bin/pip2 install "$pip" --upgrade
done < <(cat $HOME/.defaults/pip2)

echo
echo ' PYTHON3' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

/usr/local/bin/pip2 install pip setuptools wheel --upgrade
/usr/local/bin/pip2 install neovim --upgrade

while read pip ; do
  /usr/local/bin/pip3 install "$pip" --upgrade
done < <(cat $HOME/.defaults/pip3)

echo
echo ' NODE' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

/usr/local/bin/npm install --global npm
/usr/local/bin/npm install --global neovim

while read package ; do
  /usr/local/bin/npm install --global "$package"
done < <(cat $HOME/.defaults/npm-packages)

npm upgrade --global

echo
echo ' VIM' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

/usr/local/bin/mvim -v -c ":call minpac#update() | :call minpac#clean() | :qa"
/usr/local/bin/nvim -c ":call minpac#update() | :call minpac#clean() | :qa"

local cwd="$(pwd)"

cd $HOME/.config/vdots/pack/minpac/start/omnisharp-vim
git submodule update --init --recursive
cd $HOME/.config/vdots/pack/minpac/start/omnisharp-vim/server
msbuild

cd $HOME/.config/vdots/pack/minpac/start/YouCompleteMe
git submodule update --init --recursive
./install.py --all

# {{{ [VIM - color_coded]
# cd $HOME/.config/vdots/pack/minpac/start/color_coded
# rm -f CMakeCache.txt
# mkdir -p build && cd build
# cmake ..
# make && make install # Compiling with GCC is preferred, ironically
# # Clang works on OS X, but has mixed success on Linux and the BSDs

# # Cleanup afterward; frees several hundred megabytes
# make clean && make clean_clang
# }}}

cd "$cwd"

echo
echo ' ANTIGEN' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

antigen update
antigen cleanup

echo
echo ' UPGRADE DONE' | /usr/local/bin/boxes -d ccel | /usr/local/bin/boxes -d shell
echo

