#!/usr/bin/env zsh
# upgrade-node — Update global pnpm and npm packages.

setopt localoptions errexit pipefail
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"

run_cmd() {
  print -r -- "+ $*"
  [[ "$dry_run" == "1" ]] && return 0
  "$@"
}

if command -v pnpm >/dev/null 2>&1; then
  echo "Updating pnpm itself..."
  # pnpm v10+ requires self-update or corepack if managed by it
  if [[ "$(pnpm --version | cut -d. -f1)" -ge 10 ]]; then
    if corepack pnpm --version >/dev/null 2>&1; then
      run_cmd corepack prepare pnpm@latest --activate
    else
      run_cmd pnpm self-update
    fi
  else
    run_cmd pnpm add -g pnpm
  fi

  echo "Updating global pnpm packages..."
  # ponytail: pnpm-specific rc so allow-build doesn't leak into npm as an unknown key.
  # upgrade: drop the split rc when npm stops erroring on unknown keys, or a 3rd tool needs its own.
  NPM_CONFIG_USERCONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/pnpm/npmrc" run_cmd pnpm update -g
fi

if command -v npm >/dev/null 2>&1; then
  # Allow known packages with postinstall scripts (add to this list when new ones warn)
  [[ "$dry_run" != "1" ]] && npm config set allow-scripts=@anthropic-ai/claude-code,@google/genai,protobufjs --location=user 2>/dev/null || true
  echo "Updating global npm packages..."
  run_cmd npm update -g
fi
