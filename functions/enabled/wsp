#!/usr/bin/env zsh

wsp() {
  if [[ "$1" == "init" ]]; then
    shift
    wsp-init "$@"
    return $?
  fi

  local name="$1"
  local root="$2"
  local rc_file="$3"
  local history_file="$4"
  local action="$5"

  if [[ -z "$name" || -z "$root" || -z "$rc_file" || -z "$history_file" ]]; then
    echo "usage: wsp <name> <root> <rc_file> <history_file> [action] [args...]" >&2
    return 1
  fi

  if [[ -z "$action" ]]; then
    action="cd"
  fi

  case "$action" in
    (ensure)
      wsp-ensure "$root" "$rc_file" "$history_file" || return 1
      ;;
    (cd)
      wsp-ensure "$root" "$rc_file" "$history_file" || return 1
      shift 5
      if [[ -n "$1" ]]; then
        mkdir -p "$root/$1" || return 1
        cd "$root/$1" || return 1
      else
        cd "$root" || return 1
      fi
      ;;
    (rc)
      wsp-ensure "$root" "$rc_file" "$history_file" || return 1
      cat "$rc_file"
      ;;
    (all-do)
      wsp-ensure "$root" "$rc_file" "$history_file" || return 1
      shift 5
      if [[ $# -eq 0 ]]; then
        echo "ws: all-do requires a command" >&2
        return 1
      fi
      wsp-run-all "$name" "$root" "$rc_file" "$history_file" "$@"
      ;;
    (*)
      echo "wsp: unknown action '${action}'" >&2
      return 1
      ;;
  esac
}

wsp-ensure() {
  local root="$1"
  local rc_file="$2"
  local history_file="$3"

  if [[ -z "$root" ]]; then
    echo "wsp: root is empty" >&2
    return 1
  fi

  mkdir -p "$root" || return 1

  if [[ ! -e "$rc_file" ]]; then
    mkdir -p "${rc_file:h}" || return 1
    : > "$rc_file" || return 1
  fi

  mkdir -p "${history_file:h}" || return 1
}

wsp-iso8601-local() {
  if command -v gdate >/dev/null 2>&1; then
    gdate +'%Y-%m-%dT%H:%M:%SZ'
  else
    date +'%Y-%m-%dT%H:%M:%SZ'
  fi
}

wsp-init() {
  local name="$1"
  local root="$2"

  if [[ -z "$name" || -z "$root" ]]; then
    echo "usage: wsp init <name> <path>" >&2
    return 1
  fi

  local upper="${(U)name}"
  local root_var="${upper}PATH"
  local root_path="${root:A}"
  local rc_file="${root_path}/.${name}rc"
  local history_file="$HOME/.local/share/${name}-all-do/history"
  local func_file="$ZDOTDIR/functions/enabled/${name}"

  mkdir -p "$root_path" || return 1
  mkdir -p "${history_file:h}" || return 1

  if [[ ! -e "$rc_file" ]]; then
    : > "$rc_file" || return 1
  fi

  if [[ -e "$func_file" ]]; then
    echo "wsp: function already exists at $func_file" >&2
    return 1
  fi

  cat > "$func_file" <<EOF
#!/usr/bin/env zsh

local option="\$1"

if [ -z "\$option" ]; then
  wsp ${name} "\$${root_var}" "\$${root_var}/.${name}rc" "\$HOME/.local/share/${name}-all-do/history" cd
  return \$?
fi

case "\$option" in
  (rc)
    wsp ${name} "\$${root_var}" "\$${root_var}/.${name}rc" "\$HOME/.local/share/${name}-all-do/history" rc
    ;;
  (all)
    shift
    wsp ${name} "\$${root_var}" "\$${root_var}/.${name}rc" "\$HOME/.local/share/${name}-all-do/history" all-do "\$@"
    ;;
  (*)
    echo
    echo "No args will \`cd\` to the \$${root_var}."
    echo
    echo "rc      => cat \"\$${root_var}/.${name}rc\""
    echo "all     => wsp ${name} ... all-do <cmd>"
    echo
    echo "I don't know what to do with: '\$@'"
    echo
    return 1
    ;;
esac

return 0
EOF

  chmod +x "$func_file" || return 1

  if [[ -z "${WSP_NO_ENV:-}" ]]; then
    if ! rg -q "export ${root_var}=" "$ZDOTDIR/.zshenv"; then
      {
        echo
        echo "export ${root_var}=\"${root_path}\""
      } >> "$ZDOTDIR/.zshenv"
    fi
  fi

  echo "wsp: created ${func_file} and ${rc_file}"
  if [[ -z "${WSP_NO_ENV:-}" ]]; then
    echo "wsp: added export ${root_var} to ${ZDOTDIR}/.zshenv"
  else
    echo "wsp: skipped export ${root_var} (WSP_NO_ENV set)"
  fi
}

wsp-run-all() {
  local name="$1"
  local root="$2"
  local rc_file="$3"
  local history_file="$4"
  shift 4

  local cmd="$@"

  echo "$(wsp-iso8601-local) ; $cmd" >>! "$history_file"

  local directory repo
  while IFS= read -r directory || [[ -n "$directory" ]]; do
    directory="${directory%%$'\r'}"
    [[ -z "$directory" ]] && continue
    [[ "$directory" == \#* ]] && continue

    repo="$directory"
    cd "$root/$directory" || continue

    local segment_repo='%F{8}[%f%F{11}REPO%f%F{8}=%f%B$repo%b%F{8}]%f'
    local segment_branch='%F{8}[%f%F{11}BRANCH%f%F{8}=%f%B$(git rev-parse --abbrev-ref HEAD)%b%F{8}]%f'
    local segment_cmd='%F{8}[%f%F{11}CMD%f%F{8}=%f%B$cmd%b%F{8}]%f'

    print -P "$segment_repo $segment_branch $segment_cmd\n"

    eval "$cmd"

    cd "$root" || return 1
    echo
  done < "$rc_file"

  return 0
}

# First invocation via autoload executes this file body once.
# Re-dispatch to wsp so behavior is correct on initial call.
if [[ "$funcstack[1]" == "wsp" ]]; then
  wsp "$@"
fi
