#!/usr/bin/env zsh
# upgrade-ai — Update AI agents, CLI tools, and local models.

setopt localoptions errexit pipefail
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"

run_cmd() {
  print -r -- "+ $*"
  [[ "$dry_run" == "1" ]] && return 0
  "$@"
}

# 1. Claude Code
if command -v claude >/dev/null 2>&1; then
  echo "Updating Claude Code..."
  run_cmd npm install -g @anthropic-ai/claude-code
fi

# 2. Ollama Models
if command -v ollama >/dev/null 2>&1; then
  echo "Updating Ollama library..."
  # Ollama itself is brew-managed, but models need explicit pulls to update
  # We'll update the most common base models
  for model in llama3 qwen2.5 mistral; do
    run_cmd ollama pull "$model"
  done
fi

# 3. Fabric
if command -v fabric >/dev/null 2>&1; then
  echo "Updating Fabric patterns..."
  run_cmd fabric --update
fi
