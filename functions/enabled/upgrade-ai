#!/usr/bin/env zsh
# upgrade-ai — Update AI agents, CLI tools, and local models.

setopt localoptions errexit pipefail
dry_run="${ZDOTS_UPGRADE_DRY_RUN:-0}"

run_cmd() {
  print -r -- "+ $*"
  [[ "$dry_run" == "1" ]] && return 0
  "$@"
}

# 1. Claude Code
if command -v claude >/dev/null 2>&1; then
  echo "Updating Claude Code..."
  run_cmd npm install -g @anthropic-ai/claude-code
fi

# 2. Ollama Models
if command -v ollama >/dev/null 2>&1; then
  echo "Checking Ollama models..."
  # Only attempt to update if the server is running
  if ollama list >/dev/null 2>&1; then
    # Get list of installed models (NAME column, skip header)
    local models
    models=$(ollama list | awk 'NR>1 {print $1}')
    if [[ -n "$models" ]]; then
      echo "$models" | while read -r model; do
        echo "Updating Ollama model: $model..."
        run_cmd ollama pull "$model"
      done
    else
      echo "No Ollama models found to update."
    fi
  else
    echo "Ollama server not running; skipping model updates."
  fi
fi

# 3. Fabric
if command -v fabric >/dev/null 2>&1; then
  echo "Updating Fabric patterns..."
  run_cmd fabric --update
fi
