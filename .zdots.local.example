# .zdots.local — Machine-local identity and overrides
#
# This file is sourced AFTER .zdots.env and .zdots.secrets.
# It is gitignored and never committed. Copy this file to .zdots.local
# and fill in values for this specific machine.
#
#   cp .zdots.local.example .zdots.local
#
# Values set here override anything from .zdots.env.

# ---------------------------------------------------------------------------
# Machine context — REQUIRED on every machine.
# Options: home | work
# work: enforces ZDOTS_AI_MODE=local, ZDOTS_CAPTURE_ENABLED=0,
#       ZDOTS_HISTORY_REDACT=1, and triggers SIP/FileVault checks in
#       zdots-ctl check. Do not leave as 'home' on a regulated machine.
# ---------------------------------------------------------------------------
ZDOTS_CONTEXT=home

# ---------------------------------------------------------------------------
# Database
# Default ZDOTS_MIGRATION_URL uses peer auth as the OS user (postgresql:///my).
# This works on macOS/Homebrew where the installing user is a PG superuser.
# Override here if your setup differs (e.g., different PG port, named user).
# ---------------------------------------------------------------------------
# ZDOTS_MIGRATION_URL=postgresql:///my

# ---------------------------------------------------------------------------
# AI security boundary (NON-NEGOTIABLE on a new machine)
#
# local  — ZDOTS_AI_ENDPOINT only. No cloud API keys. Safe default.
# cloud  — Enables cloud APIs. Keys MUST live in .zdots.secrets, not here.
#
# Do NOT change this to "cloud" until:
#   1. Security review is complete for this machine
#   2. Cloud API keys are stored in .zdots.secrets (gitignored)
#   3. You understand what data will leave this machine
# ---------------------------------------------------------------------------
ZDOTS_AI_MODE=local

# AI endpoint — local (default) or a trusted machine on your LAN.
# Aider (zaider), ai-query, and zdots-ctx all read this single variable.
#
# Examples:
#   local llama.cpp:              http://127.0.0.1:8080   (default)
#   remote powerful workstation:  http://powerstation.local:8080
#   remote Pi/NAS:                http://192.168.1.100:11434
# ---------------------------------------------------------------------------
# ZDOTS_AI_ENDPOINT=http://127.0.0.1:8080
# ZDOTS_AI_PROFILE=standard

# ---------------------------------------------------------------------------
# PHI safety controls (relevant when ZDOTS_CONTEXT=work or near regulated data)
# ---------------------------------------------------------------------------

# Session capture — disabled by default (see: zdots-ctx capture).
# Set to 1 only after confirming the PHI scrubber and DB encryption are in place.
# ZDOTS_CAPTURE_ENABLED=1

# History redaction — on by default (1). Set to 0 to disable (not recommended
# on machines that may handle PHI).
# ZDOTS_HISTORY_REDACT=1

# Site-specific redaction patterns (Zsh array, ERE syntax for sed).
# Added on top of the built-in SSN / MRN / DOB patterns.
# Each entry is an ERE pattern; matching tokens are replaced with [REDACTED].
# Examples:
#   Patient account numbers:   'ACC[0-9]{8}'
#   Internal employee IDs:     'EMP-[A-Z]{2}[0-9]{5}'
#   Ticket identifiers:        'JIRA-[0-9]+'
# ZDOTS_HISTORY_REDACT_PATTERNS=(
#   'ACC[0-9]{8}'
#   'EMP-[A-Z]{2}[0-9]{5}'
# )

# ---------------------------------------------------------------------------
# Work context overrides (only relevant when ZDOTS_CONTEXT=work)
# Keep corporate identity and network config here, not in the shared repo.
# ---------------------------------------------------------------------------
# GIT_AUTHOR_EMAIL=firstname.lastname@company.com
# GIT_COMMITTER_EMAIL=firstname.lastname@company.com
# HTTP_PROXY=http://corporate-proxy:8080
# HTTPS_PROXY=http://corporate-proxy:8080
# NO_PROXY=localhost,127.0.0.1,.internal,.corp
