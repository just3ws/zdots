# .zdots.env — Dependency Manifest & Environment Baseline

# 1. Environment Identity
# Options: macos-standard, linux-minimal, ci-act
export ZDOTS_ENV_PROFILE="${ZDOTS_ENV_PROFILE:-macos-standard}"

# 2. Service Providers (Dependency Injection)
# These define which concrete implementation to use for each "service".
# Available options are files in providers/pkg/ and providers/node/

if [ "$ZDOTS_ENV_PROFILE" = "macos-standard" ]; then
  export ZDOTS_SERVICE_PKG_MANAGER="homebrew"
  export ZDOTS_SERVICE_NODE_RUNTIME="mise"
  export ZDOTS_SERVICE_PYTHON_RUNTIME="mise"
  export ZDOTS_SERVICE_TRACE="otlp"
  export ZDOTS_SERVICE_AI="llama-cpp"
  export ZDOTS_SERVICE_WHISPER="whisper-cpp"
  export ZDOTS_AI_PROFILE="standard"
  export ZDOTS_TELEMETRY_ENABLED="${ZDOTS_TELEMETRY_ENABLED:-1}"
  export HOMEBREW_PREFIX="/opt/homebrew"
  # External model storage: override to point at an external drive to spare primary disk.
  # Defaults to XDG_DATA_HOME (~/.local/share/llama-cpp/models).
  export ZDOTS_AI_MODELS_DIR="${ZDOTS_AI_MODELS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/llama-cpp/models}"

  # Intelligence Suite (Cerebral Control Plane)
  export ZDOTS_MY_ROOT="${HOME}/my"
  export ZDOTS_MIGRATION_URL="${ZDOTS_MIGRATION_URL:-postgresql:///my}"
  export ZDOTS_DATABASE_URL="${ZDOTS_DATABASE_URL:-postgresql://zdots_rw@/my}"
elif [ "$ZDOTS_ENV_PROFILE" = "ci-act" ]; then
  export ZDOTS_SERVICE_PKG_MANAGER="none"
  export ZDOTS_SERVICE_NODE_RUNTIME="system"
  export ZDOTS_SERVICE_PYTHON_RUNTIME="system"
  export ZDOTS_SERVICE_TRACE="none"
  export ZDOTS_SERVICE_AI="none"
  export ZDOTS_SERVICE_WHISPER="none"
  export ZDOTS_TELEMETRY_ENABLED="0"
  export HOMEBREW_PREFIX=""
fi

# 3. Environment-specific overrides
# For act/CI, we force specific paths to prevent local leaks.
if [ "$GITHUB_ACTIONS" = "true" ] || [ "$ACT" = "true" ]; then
  export ZDOTS_ENV_PROFILE="ci-act"
fi
