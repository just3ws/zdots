# etc/pages/_config.yml.template — shared GitHub Pages config for all my systems.
#
# Rendered by `zdots-pages build` with @@TOKENS@@ substituted per repo, so every
# project's site (<owner>.github.io/<repo>) shares one theme, nav, and footer.
# GitHub Pages builds this server-side via the jekyll-remote-theme plugin — no
# local Jekyll/Ruby toolchain required.

title: "@@TITLE@@"
description: "@@DESCRIPTION@@"
remote_theme: just-the-docs/just-the-docs

# Project Pages live under /<repo>/ — baseurl makes links resolve correctly.
baseurl: "/@@REPO@@"
url: "https://@@OWNER@@.github.io"

# just-the-docs options — consistent across every system.
search_enabled: true
heading_anchors: true
color_scheme: dark
aux_links:
  "Source on GitHub":
    - "https://github.com/@@OWNER@@/@@REPO@@"
aux_links_new_tab: true

# jekyll-remote-theme is on the GitHub Pages plugin allowlist.
# jekyll-relative-links rewrites [x](Page.md) links so they resolve on the Pages
# site (the GitHub wiki already resolves them natively).
plugins:
  - jekyll-remote-theme
  - jekyll-seo-tag
  - jekyll-relative-links

# Build hygiene — never publish drafts or the project's own tooling.
exclude:
  - Gemfile
  - Gemfile.lock
  - vendor
  - .gh-pages

footer_content: "@@OWNER@@ systems · generated by zdots-pages"
