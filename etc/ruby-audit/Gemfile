# frozen_string_literal: true

# etc/ruby-audit/Gemfile — self-contained gem bundle for the ruby-audit suite.
#
# This Gemfile is intentionally isolated from the main zdots Gemfile.
# ruby-audit installs and runs from this bundle regardless of what Ruby
# version manager (mise, rbenv, brew, system) is in use on the host.
#
# First-time setup: ruby-audit --setup
# Or manually:      BUNDLE_GEMFILE=etc/ruby-audit/Gemfile bundle install

