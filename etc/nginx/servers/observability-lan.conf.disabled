# Observability LAN vhost template.
# Installed as observability-lan.conf only by `observability-mode lan`.

upstream observability_openobserve_backend {
    server 127.0.0.1:5080;
    keepalive 2;
}

upstream observability_jaeger_backend {
    server 127.0.0.1:16686;
    keepalive 2;
}

server {
    listen 80;
    server_name observability.lan.phalanxduel.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name observability.lan.phalanxduel.com;
    include ssl_params.conf;

    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    client_max_body_size 100m;

    location /jaeger/ {
        proxy_pass http://observability_jaeger_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        proxy_pass http://observability_openobserve_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
