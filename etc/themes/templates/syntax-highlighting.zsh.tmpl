# Kanagawa Wave (Default) Theme for zsh-syntax-highlighting
# Values derived from rebelot/kanagawa.nvim wave palette.

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main cursor)
typeset -gA ZSH_HIGHLIGHT_STYLES

# Core Palette (Kanagawa Wave)
# Foreground:  #{{fujiWhite}} (fujiWhite)
# Background:  #{{sumiInk3}} (sumiInk3, platform-tuned bluer)
# Selection:   #{{waveBlue2}} (waveBlue2)
# Comment:     #{{fujiGray}} (fujiGray)
# Aqua/Cyan:   #{{waveAqua2}} (waveAqua2)
# Green:       #{{springGreen}} (springGreen)
# Yellow:      #{{carpYellow}} (carpYellow)
# Orange:      #{{surimiOrange}} (surimiOrange)
# Pink:        #{{sakuraPink}} (sakuraPink)
# Violet:      #{{oniViolet}} (oniViolet)
# Blue:        #{{crystalBlue}} (crystalBlue)
# Red:         #{{peachRed}} (peachRed)

## Comments
ZSH_HIGHLIGHT_STYLES[comment]='fg=#{{fujiGray}}'

## Functions/methods
ZSH_HIGHLIGHT_STYLES[alias]='fg=#{{springGreen}}'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg=#{{springGreen}}'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg=#{{springGreen}}'
ZSH_HIGHLIGHT_STYLES[function]='fg=#{{springGreen}}'
ZSH_HIGHLIGHT_STYLES[command]='fg=#{{springGreen}}'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#{{springGreen}},italic'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=#{{surimiOrange}},italic'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#{{surimiOrange}}'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#{{surimiOrange}}'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#{{oniViolet}}'

## Built ins
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#{{waveAqua2}}'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#{{waveAqua2}}'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg=#{{waveAqua2}}'

## Punctuation
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#{{sakuraPink}}'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter-unquoted]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimiter]='fg=#{{sakuraPink}}'
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]='fg=#{{sakuraPink}}'
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg=#{{sakuraPink}}'

## Strings
ZSH_HIGHLIGHT_STYLES[command-substitution-quoted]='fg=#{{carpYellow}}'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter-quoted]='fg=#{{carpYellow}}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#{{carpYellow}}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument-unclosed]='fg=#{{peachRed}}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#{{carpYellow}}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument-unclosed]='fg=#{{peachRed}}'
ZSH_HIGHLIGHT_STYLES[rc-quote]='fg=#{{carpYellow}}'

## Variables
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument-unclosed]='fg=#{{peachRed}}'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[assign]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=#{{fujiWhite}}'

## Miscellaneous
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#{{peachRed}}'
ZSH_HIGHLIGHT_STYLES[path]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[path_pathseparator]='fg=#{{sakuraPink}}'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[path_prefix_pathseparator]='fg=#{{sakuraPink}}'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=#{{oniViolet}}'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-unclosed]='fg=#{{peachRed}}'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[arg0]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[default]='fg=#{{fujiWhite}}'
ZSH_HIGHLIGHT_STYLES[cursor]='standout'

# zsh-autosuggestions
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#{{sumiInk6}}'
