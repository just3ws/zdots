# etc/defaults.env — Single Source of Truth for zdots Platform Defaults (ADR-0005)
#
# Loaded first by env.sh (before .zdots.env, adots profile, .zdots.local, .zdots.work)
# and parsed as fallback by Go (cmd/zdots-core/internal/config) and Ruby.
#
# Rules:
#   - Simple POSIX `export KEY="${KEY:-literal}"` lines only (no conditionals/subshells).
#   - Caller environment always wins; profile and .zdots.local override cleanly.
#   - Never store secrets, tokens, or machine-specific paths here.

# AI inference & embeddings (loopback)
export ZDOTS_AI_HOST="${ZDOTS_AI_HOST:-127.0.0.1}"
export ZDOTS_AI_PORT="${ZDOTS_AI_PORT:-11500}"
export ZDOTS_AI_ENDPOINT="${ZDOTS_AI_ENDPOINT:-http://127.0.0.1:11500}"
export ZDOTS_AI_EMBED_PORT="${ZDOTS_AI_EMBED_PORT:-11501}"
export ZDOTS_AI_EMBED_ENDPOINT="${ZDOTS_AI_EMBED_ENDPOINT:-http://127.0.0.1:11501}"
export ZDOTS_AI_MODE="${ZDOTS_AI_MODE:-local}"

# Observability (OpenObserve, Jaeger, OTel Collector)
export ZDOTS_O2_HOST="${ZDOTS_O2_HOST:-127.0.0.1}"
export ZDOTS_O2_PORT="${ZDOTS_O2_PORT:-5080}"
export ZDOTS_O2_ENDPOINT="${ZDOTS_O2_ENDPOINT:-http://127.0.0.1:5080}"
export ZDOTS_JAEGER_HOST="${ZDOTS_JAEGER_HOST:-127.0.0.1}"
export ZDOTS_JAEGER_UI_PORT="${ZDOTS_JAEGER_UI_PORT:-16686}"
export ZDOTS_JAEGER_ENDPOINT="${ZDOTS_JAEGER_ENDPOINT:-http://127.0.0.1:16686}"
export ZDOTS_OTEL_HTTP_PORT="${ZDOTS_OTEL_HTTP_PORT:-4318}"
export ZDOTS_OTEL_ENDPOINT="${ZDOTS_OTEL_ENDPOINT:-http://127.0.0.1:4318}"

# Cache & Knowledge Layer
export ZDOTS_REDIS_HOST="${ZDOTS_REDIS_HOST:-127.0.0.1}"
export ZDOTS_REDIS_PORT="${ZDOTS_REDIS_PORT:-6379}"
export ZDOTS_DATABASE_URL="${ZDOTS_DATABASE_URL:-postgresql://zdots_rw@/my}"
export ZDOTS_MIGRATION_URL="${ZDOTS_MIGRATION_URL:-postgresql:///my}"

# Storage & Hygiene
export ZDOTS_STORAGE_RESERVE_GB="${ZDOTS_STORAGE_RESERVE_GB:-45}"
