# vim:ft=zsh
#
# Aliases suggested by Claude based on shell history analysis.
# Sourced from .aliasrc

# git commit -am was used ~236 times in history with no shorthand.
# Usage: gcam "Fix the flaky test"
alias gcam='git commit -am'

# git commit -m appeared ~15 times for commits with staged changes.
# Usage: gcm "Add migration for users table"
alias gcm='git commit -m'

# brew uninstall --cask --zap --force appeared ~37 times in full.
# Usage: brew-nuke firefox visual-studio-code
alias brew-nuke='brew uninstall --cask --zap --force'

# gem update --system && gem update appeared ~13 times as a chain.
# Usage: gem-upgrade
alias gem-upgrade='gem update --system && gem update'

# be rails db:migrate:reset appeared ~12 times, often chained further.
# Usage: dbreset
# Usage: dbreset db:seed
alias dbreset='be rails db:migrate:reset'

# xattr -dr com.apple.quarantine appeared ~4 times for unsigned apps.
# Usage: unquarantine /Applications/qView.app
alias unquarantine='xattr -dr com.apple.quarantine'

# find . -type f -iname '...' appeared ~68 times in history.
# Case-insensitive file search by partial name from current dir or a given path.
# Usage: ff pronto
# Usage: ff schema db/
ff() { find "${2:-.}" -type f -iname "*$1*" }

# docker compose up with full recreate appeared ~6 times with all the flags.
# Usage: dcup
# Usage: dcup -d postgres redis  (append extra args)
alias dcup='docker compose up --force-recreate --remove-orphans --detach'

# docker compose down appeared alongside dcup in the same sessions.
# Usage: dcdown
alias dcdown='docker compose down'

# mv Screenshot* ~/Pictures/Screenshots appeared ~7 times with varying globs.
# Sweeps screenshots off the Desktop in one shot.
# Usage: screenshots
screenshots() {
  local dest="$HOME/Pictures/Screenshots"
  mkdir -p "$dest"
  mv "$HOME/Desktop"/Screenshot* "$dest/" 2>/dev/null
  mv "$HOME/Desktop"/Screen\ Shot* "$dest/" 2>/dev/null
  echo "Screenshots moved to $dest"
}

# "vm" mistyped for "vim" appeared a few times in history.
# Usage: vm file.rb  (just works)
alias vm='vim'
