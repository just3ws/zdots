#!/usr/bin/env bash
# ---
# id: zdots-ruby-legacy-setup
# title: "Zdots Legacy Rails Setup"
# purpose: Configure Bundler for successful gem installation on modern macOS.
# rationale: Links C extensions to Homebrew dependencies without running services.
# ---

set -eo pipefail

usage() {
  cat <<'EOF'
Usage: zdots-ruby-legacy-setup

Run from a legacy Rails project root. Writes local Bundler build settings for
Nokogiri, libxml-ruby, and mysql2 using Homebrew dependency prefixes.
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [[ ! -f "Gemfile" ]]; then
  echo "Error: Gemfile not found. Run this in a Rails project root." >&2
  exit 1
fi

echo "==> Configuring Bundler for build-only setup..."

bundle config build.nokogiri \
  --with-xslt-dir="$(brew --prefix libxslt)" \
  --with-xml2-dir="$(brew --prefix libxml2)" \
  --with-xml2-include="$(brew --prefix libxml2)/include/libxml2"

bundle config build.libxml-ruby \
  --with-xml2-dir="$(brew --prefix libxml2)" \
  --with-xml2-include="$(brew --prefix libxml2)/include/libxml2"

bundle config build.mysql2 --with-mysql-dir="$(brew --prefix mariadb-connector-c)"

echo "==> Bundler config set. You can now run 'bundle install'."
